  <interface>
    <field id="itemContent" type="node" alias="infoPanel.itemContent" />
    <field id="currentEpisode" type="node" alias="infoPanel.currentEpisode" />
    <field id="width" type="float" />
    <field id="descriptionWidth" type="float" value="0" />
    <field id="minHeight" alias="minHeightTransparentRectangle.height" />
    <field id="layoutChanged" type="boolean" alwaysNotify="true" alias="infoPanel.layoutChanged" />
  </interface>

  <children>
    <Rectangle
      id="minHeightTransparentRectangle"
      width="1"
      color="0x00000000" />
    <LayoutGroup
      id="metadataGroup"
      itemSpacings="[15]">
      <ExpandedTileMetadata
        id="infoPanel"
        width="960"
        variant="detailScreenInfoPanel" />

      <LayoutGroup
        id="additionalInfoItemsContainer"
        layoutDirection="vert"
        itemSpacings="[3]">
      </LayoutGroup>
    </LayoutGroup>


  </children>
</component>