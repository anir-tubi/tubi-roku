<?xml version="1.0" encoding="utf-8" ?>
<!--
 - IconButton
 -
 - Display an Icon to the right of a label with a background that will change based on the width of the text
 -
 -->
<component name="IconButton" extends="Group">

  <script type="text/brightscript" uri="IconButton.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="text" type="string" />
    <field id="icon" type="string" />
  </interface>

  <children>
    <Poster
      id="Background"
      width="127"
      height="60"
      uri="pkg:/images/live_news_button_fhd.9.png"
      blendColor="0x1C1F29ff"
      loadSync="true"
      visible="true" />
    <LayoutGroup
      id="OverlayGroup"
      translation="[12,12]"
      itemSpacings="[12]"
      layoutDirection="horiz">
      <Poster
        id="Icon"
        width="36"
        height="36"
        visible="true"/>
      <Label
        id="Title"
        width="0"
        height="44"
        vertAlign="center"
        color="0xFFFFFFFF">
        <Font
          id="TitleFont"
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="24" />
      </Label>
    </LayoutGroup>
  </children>

</component>
