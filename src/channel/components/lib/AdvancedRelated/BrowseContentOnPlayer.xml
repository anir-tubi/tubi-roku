<?xml version="1.0" encoding="utf-8" ?>
<!-- Also referred to as YMAL UI -->
<component name="BrowseContentOnPlayer" extends="Group">
  <script type="text/brightscript" uri="BrowseContentOnPlayer.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="content" type="node"/>
      <field id="updateContent" type="boolean" alwaysNotify="true"/>
      <!-- show or hide the Info panel component -->
      <field id="showInfoPanel" type="boolean" alwaysNotify="true"/>
      <!-- shows the YMAL patially -->
      <field id="show" type="boolean" alwaysNotify="true"/>
      <!-- hides the YMAL -->
      <field id="hide" type="boolean" alwaysNotify="true"/>
      <!-- opens the YMAL in full screen -->
      <field id="open" type="boolean" alwaysNotify="true"/>
      <!-- closes the YMAL so it is only shown as a peek -->
      <field id="close" type="boolean" alwaysNotify="true"/>
      <!-- show the YMAL in full screen -->
      <field id="showInFullScreen" type="boolean" alwaysNotify="true"/>
      <!-- The analytics page type value associated with the parent page of this Related component.   -->
      <field id="associatedPageName" type="string" value="video_page"/>
       <!-- hides or shows the loading Spinner -->
      <field id="isLoading" type="boolean" alias="Spinner.visible" />

      <field id="jumpToRowItem" alias="CategoryGridList.jumpToRowItem" />

    <!-- OUTPUTS -->
      <field id="isRelatedContentFocused" type="boolean" alwaysNotify="true"/>

      <!-- selectedRelatedContentItemUpdated should be observed instead of this field -->
      <field id="selectedRelatedContentItem" type="node" />

      <!-- set to true when selectedRelatedContentItem is updated-->
      <field id="selectedRelatedContentItemUpdated" type="boolean" alwaysNotify="true" />

      <field id="itemFocused" alias="CategoryGridList.itemFocused"/>
      <!-- Holds the information needed to populate a navigate_within_page event. This will
           be observed by the contentController via videoHelpers
           which will be responsible for sending navigate_within_page events.
      -->
      <field id="navigateWithinPageInfo" type="assocarray"/>
      <field id="selectedPosition" alias="CategoryGridList.selectedPosition" />
      <field id="trackingComponentInfo" type="assocarray"/>
      <field id="currFocusRow" alias="CategoryGridList.currFocusRow" />
  </interface>

  <children>

    <Group
      id="YmalGroup"
      opacity="0.0"
      translation="[0,0]">

      <InfoPanel
        id="Info"
        translation="[0,81]"
        mode="item"
        width="993"
        maxHeight="312"
        maxTitleLines="3"
        opacity="0.0"/>

      <Group
        id="YmalRow"
        opacity="0.2"
        translation="[0,400]">

        <CategoryGridList
          id="CategoryGridList"/>

        <Spinner
          id="Spinner"
          visible="false"
          showShade="true"
          width="1920"
          height="200"
          translation="[-180,0]"/>
      </Group>

    </Group>

  </children>
</component>