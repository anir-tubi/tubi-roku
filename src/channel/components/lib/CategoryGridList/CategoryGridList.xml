<?xml version="1.0" encoding="utf-8" ?>

<component name="CategoryGridList" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/CategoryGridList/CategoryGridList.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/NodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />


  <interface>
    <!-- INPUT -->
    <!--
    - 'content' should be a category list without content items, structured as:
    - <CategoryContentNode>
    -   <CategoryContentNode title="category1" />
    -   <CategoryContentNode title="category2" />
    -   <CategoryContentNode title="category3" />
    -   ...
    - </CategoryContentNode>
    -->
    <field id="content" type="node"/>

    <field id="animateToCategory" alias="RowList.animateToItem"/>
    <field id="jumpToRowItem" alias="RowList.jumpToRowItem"/>
    
    <!-- set when we need to purge and reload history and queue -->
    <field id="dirtyUserCategories" type="boolean" value="false" alwaysNotify="true"/>
    
    <!-- incoming metadata from MetadataFetchTask -->
    <field id="metadataFetchTaskBatch" type="assocarray" />

    <!-- incoming metadata from MetadataFetchTask for single categories (non batched). These are currently not used. -->
    <field id="remainingInCategoryResponse" type="assocarray" />
    <field id="wholeCategoryResponse" type="assocarray" />
    
    <!-- if a fetch error occurred, error is set with the following information
     -      {
     -        code: response.code
     -        failReason: response.failReason
     -      }
    -->
    <field id="error" type="assocarray" alwaysNotify="true" />

    <!-- inbound interface so the UI can be updated based on if the category grid lists occupy
     -   the full width of the category screen (ie. the category menu is not showing).
     -   Assumes there are only 2 possible widths for the CategoryGridList, full width and not full width.
     -->
    <field id="isFullWidth" type="boolean" value="true" />


    <!-- OUTPUT -->
    <field id="itemSelected" type="node" alwaysNotify="true"/>
    <field id="itemFocused" type="node" alwaysNotify="true"/>
    <!-- array with the [x, y], where x is the category index and y is the content index -->
    <field id="cursorPosition" alias="RowList.rowItemFocused" />

    <!-- first category is loaded -->
    <field id="firstPosterLoaded" type="boolean" value="false" />


    <field id="currFocusRow" alias="RowList.currFocusRow" />
    <field id="currCategoryId" type="string" />

    <!-- holds an array of integers the indexes represent the category order, and the vaule represents the totalCount of the category.
         When it is updated, category screen will update the total counts in the category menu
     -->
    <field id="categoryTotalCounts" type="intarray"/>

  </interface>
  
  <children>
    <RowList
      id="RowList"
      itemComponentName="CategoryGridPoster"
      rowTitleComponentName="CategoryGridRowLabel"
      itemSize="[1835,364]"
      itemSpacing="[0,28]"
      numRows="2"
      rowSpacings="[28]"
      rowItemSize="[[210,300]]"
      rowItemSpacing="[[1920,0],[10,0]]"
      showRowLabel="[false, true]"
      showRowCounter="[false]"
      fadeFocusFeedbackWhenAutoScrolling="true"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/selector-fhd.9.png"/>

    <Timer
      id="RowListItemDebounce"
      duration="0.5"/>
    <Timer
      id="AnimateToCategoryDebounce"
      duration="0.5"/>
  </children>
</component>
      
