<?xml version="1.0" encoding="utf-8" ?>

<component name="CategoryGridList" extends="Group">
  <script type="text/brightscript" uri="CategoryGridList.brs" />
  <script type="text/brightscript" uri="../FocusMixin.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <!-- required by TubiMetadataTranslate.brs -->
  <script type="text/brightscript" uri="../../../source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/ArrayUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeOffsetUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FIFAMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs" />

  <interface>
    <!-- INPUT -->
      <!-- The content that actually populates the RowList. Content should be structured as:
      <CategoryContentNode>
        <CategoryContentNode title="category1" />
          <ContentNode title="item1" />
          <ContentNode title="item2" />
        <CategoryContentNode title="category2" />
          <ContentNode title="item3" />
          <ContentNode title="item4" />
        <CategoryContentNode title="category3" />
        ...
      </CategoryContentNode> -->
      <field id="content" type="node"/>

      <!-- contentUpdated will be set when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- set the RowList.rowHeights and RowList.rowItemSize arrays since the category order has changed. -->
      <field id="repopulateContent" type="boolean" alwaysNotify="true"/>

      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got added, helps to set focus to correct row -->
      <field id="rowAdded" type="string"/>

      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got removed, helps to set focus to correct row -->
      <field id="rowRemoved" type="string"/>

      <!-- What kind of filter if any does this list use? For example, "tv", "movies", "latino" -->
      <field id="contentMode" value="" type="string"/>

      <!-- Indicates if that when the server is contacted, it should indcate that the app is in kidsMode. -->
      <field id="shouldKidsModeBeSentToServer" type="boolean"/>

      <field id="animateToCategory" alias="RowList.animateToItem"/>

      <!-- An array that should include up to 2 elements, the 1st element is the ID of the content to jump to, the 2nd optional element is the ID of the container within which the content item should be found -->
      <field id="jumpToRowItemByID" type="array" alwaysNotify="true"/>
      <field id="jumpToRowItem" alias="RowList.jumpToRowItem"/>

      <!-- incoming metadata from GeneralTask
               type is node, so that it takes less time to send data from one file to another file when comparing to assocarray
           -->
      <field id="categoryResponseInBatch" type="node" />

      <!-- incoming metadata from MetadataFetchTask for single categories (non batched). These are currently not used. -->
      <field id="remainingInCategoryResponse" type="assocarray" />

      <field id="wholeCategoryResponse" type="assocarray" />

      <!-- if a fetch error occurred, error is set with the following information
       -      {
       -        code: response.code
       -        failReason: response.failReason
       -      }
      -->
      <field id="error" type="assocarray" alwaysNotify="true" />

      <!-- inbound interface so the UI can be updated based on if the category grid lists occupy
       -   the full width of the category screen (ie. the category menu is not showing).
       -   Assumes there are only 2 possible widths for the CategoryGridList, full width and not full width.
       -->
      <field id="isFullWidth" type="boolean" value="true" />

      <!-- set to true if the user is signed in and we want to change the experience based on that -->
      <field id="signedIn" type="boolean" value="false" />


    <!-- OUTPUT -->
      <field id="itemSelected" type="node"/>

      <field id="itemFocused" type="node" />

      <field id="oldItemFocused" type="node" />

      <!-- set to the tubi content of the new row container (row of contentFocused) which was focused on -->
      <field id="rowFocused" type="node" alwaysNotify="true" />

      <!-- array with the [x, y], where x is the category index and y is the content index -->
      <field id="cursorPosition" type="vector2d" value="[-1,-1]"/>

      <field id="oldCursorPosition" type="vector2d" value="[-1,-1]"/>

      <field id="selectedPosition" alias="RowList.rowItemSelected" />

      <field id="focusedPosition" alias="RowList.rowItemFocused" />

      <!-- in the case that focus is not being set on the RowList, inform that content is loaded
           and infoPanel should be updated. Typically happens on kids mode toggle.
      -->
      <field id="reloadedItemToBeFocused" type="node" />

      <field id="currFocusRow" alias="RowList.currFocusRow" />
      <field id="currFocusColumn" alias="RowList.currFocusColumn" />
      <field id="scrollingstatus" alias="RowList.scrollingstatus" />

      <field id="currCategoryId" type="string" />

      <field id="oldCategoryId" type="string" />

      <field id="loadCategoriesIndex" type="integer" alwaysNotify="true" />

  </interface>

  <children>
    <RowList
      id="RowList"
      itemComponentName="StarterGridItem"
      rowTitleComponentName="CategoryGridRowLabel"
      itemSize="[1776,364]"
      numRows="2"
      rowItemSpacing="[[16,0]]"
      showRowCounter="[false]"
      fadeFocusFeedbackWhenAutoScrolling="true"
      focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"/>
    <Timer
      id="RowListItemDebounce"
      duration="0.5"/>
    <Timer
      id="AnimateToCategoryDebounce"
      duration="0.5"/>
  </children>
</component>
