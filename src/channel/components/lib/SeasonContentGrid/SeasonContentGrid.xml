<?xml version="1.0" encoding="utf-8" ?>

<component name="SeasonContentGrid" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/SeasonContentGrid/SeasonContentGrid.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- Incoming interface for encapsulation in a ScrollingList -->
    <field id="focusPercent" type="float" value="0.0"/>
    <field id="listHasFocus" type="boolean" value="false" />
    <field id="content" type="node" alwaysNotify="true"/>

    <!-- Incoming interface for sending info to the internal ContentGrid -->
    <field id="itemToFocus" alias="ContentGrid.animateToItem"/>
    <field id="isFirstInList" alias="ContentGrid.isFirstInList"/>
    
    <!-- Outgoing interface proxying the internal ContentGrid -->
    <field id="itemSelected" alias="ContentGrid.itemSelected"/>
    <field id="itemFocused" alias="ContentGrid.itemFocused"/>
    <field id="cursorPosition" alias="ContentGrid.cursorPosition"/>
    <field id="cursorIndex" alias="ContentGrid.cursorIndex"/>
    <field id="focusChangeDuration" alias="ContentGrid.focusChangeDuration"/>
    <field id="firstPosterLoaded" alias="ContentGrid.firstPosterLoaded"/>
  </interface>
  
  <children>
    <Rectangle
      id="ForceBackgroundSize"
      color="0x00000000"
      width="1395"
      height="369"
      translation="[0,0]"/>
    <!-- force height so that even before we get content to fill the ContentGrid, boundingRect() will return the
         correct height.
    -->
    <Group
      id="SeasonName"
      translation="[0,0]">
    <Label
      id="FocusedSeasonName"
      height="40"
      width="1000"
      translation="[0,0]"
      color="0xFF501AFF"
      opacity="0.0">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    <Label
      id="UnfocusedSeasonName"
      height="40"
      width="1000"
      translation="[0,0]"
      color="0xFFFFFFFF"
      opacity="1.0">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    </Group>
    
    <ContentGrid
      id="ContentGrid"
      numRows="1"
      fillDirection="W"
      visible="true"
      translation="[7,53]"
      itemSpacing="[10,10]"
      scrollBounds="[0,0,430,0]"
      posterBounds="[0,0,1835,300]"
      itemSize="[430,256]"
      itemComponentName="FeaturePosterWithProgress"/>
  </children>
</component>
