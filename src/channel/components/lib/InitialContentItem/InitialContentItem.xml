<?xml version="1.0" encoding="utf-8" ?>
<component name = "InitialContentItem" extends="Group" >
  <script type="text/brightscript" uri="InitialContentItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <interface>
    <!-- INPUTS -->
    <field id="itemContent" type="node" />
    <field id="width" type="float" alias="focusedBackgroundPoster.width, experienceLogo.width" />
    <field id="height" type="float" alias="focusedBackgroundPoster.height" />
    <field id="gridHasFocus" alias="focusedBackgroundPoster.visible" type="boolean" />
    <field id="focusPercent" alias="focusedBackgroundPoster.opacity" />
    <field id="index" type="integer" />
  </interface>

  <children>
    <Group id="parentGroup">
      <!-- Have to do negative translation and static size because of shadow making larger than item's bounds -->
      <Poster
        id="unfocusedBackgroundPoster"
        width="240"
        height="240"
        translation="[-12, -6]" />
      <Poster
        id="focusedBackgroundPoster"
        uri="pkg:/images/icts_item_focused.png" />
      <ExperienceLogo id="experienceLogo"
        tubiLogoWidth="78"
        tubiLogoHeight="34"
        fontSize="27"
        translation="[0, 60]" />
    </Group>
  </children>
</component>
