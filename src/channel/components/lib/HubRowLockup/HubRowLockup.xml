<?xml version="1.0" encoding="utf-8"?>
<component name="HubRowLockup" extends="Group">

  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="HubRowLockup.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="focusPercent" type="float" />
    <field id="rowHasFocus" type="boolean" />

    <!-- Fires when the explore button is selected -->
    <field id="wasSelected" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <LayoutGroup
      id="lockupLayout"
      layoutDirection="vert"
      itemSpacings="[21, 21, 33]">

      <Rectangle
        id="hubLogoRectangle"
        width="507"
        height="231"
        color="0x00000000">
        <Poster
          id="hubLogo"
          loadWidth="507"
          loadHeight="231"
          loadDisplayMode="limitSize"
          loadSync="true" />
      </Rectangle>

      <Label
        id="hubTitleLabel"
        width="636" />

      <Label
        id="hubSynopsisLabel"
        width="615"
        wrap="true"
        maxLines="2" />

      <EnhancedButton
        id="exploreButton"
        height="105" />

    </LayoutGroup>
  </children>

</component>