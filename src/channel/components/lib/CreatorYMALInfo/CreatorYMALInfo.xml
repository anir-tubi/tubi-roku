<?xml version="1.0" encoding="utf-8"?>
<component name="CreatorYMALInfo" extends="Group">
  <script type="text/brightscript" uri="CreatorYMALInfo.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />

  <interface>
    <field id="content" type="node" />
  </interface>

  <children>
    <LayoutGroup itemSpacings="[12]">
      <Label
        id="titleLabel" />

      <LayoutGroup
        id="metadataRow"
        vertAlignment="center"
        layoutDirection="horiz"
        itemSpacings="[12]">
        <Label
          id="genresLabel" />

        <Group
          id="rating">
          <Poster
            id="ratingBackground"
            height="30"
            uri="pkg:/images/rating_background_video_tile_$$RES$$.9.png"
            loadDisplayMode="scaleToFit"
            loadSync="true" />
          <Label
            id="ratingLabel"
            height="30"
            width="0"
            numLines="1"
            wrap="false"
            horizAlign="center"
            vertAlign="center">
          </Label>
        </Group>

        <Poster
          id="subtitlesIcon"
          uri="pkg:/images/icon-closed-caption.webp"
          width="36"
          height="36"
          visible="false" />
      </LayoutGroup>

      <Label
        id="descriptionLabel"
        width="1056"
        wrap="true" />
    </LayoutGroup>
  </children>
</component>
