<?xml version="1.0" encoding="utf-8" ?>
<component name="ProgramGuide" extends="Group" >
  <script type="text/brightscript" uri="ProgramGuide.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->

    <!--content-->
    <field id="content" type="node"/>

    <!-- contentUpdated will be set when the new content is ready to be displayed on the screen. -->
    <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

    <!-- Set the ID that the TimeGrid should jump to when displayed on the linear TV video player. Second element in the array is not used in case of EPG -->
    <field id="jumpToLinearChannelID" type="array" alwaysNotify="true"/>

    <!-- Set to true when EPG overlay present on the fullplayer -->
    <field id="shouldSendComponentInteractionEventOnJumpToLinearChannelId" type="boolean" value="false"/>

    <!--Select the TimeGrid mode. These values are available in constants 'EPGChannelPlayMode'
        1: playItemOnSelect: update the channel that should be playing based on the item being selected
        2: playItemOnFocus: update the channel that should be playing based on the item being focused
      -->
    <field id="EPGChannelPlayMode" value="playItemOnSelect" type="string" alwaysNotify="true" />

    <!-- EPGFullMode  true : 3 and half rows visible with floating focus
                        false : 1 and half  = rows visible with fixedFocus-->
    <field id="EPGFullMode" type="boolean" value="true"/>

    <field id="jumpToRowItem" alias="ProgramGrid.jumpToRowItem" />

    <field id="jumpToChannelItem"  type="integer" alwaysNotify="true" />

    <field id="setFocusedToPlay"  type="boolean" alwaysNotify="true" />


    <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "linear_browse_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
    <field id="trackingPageInfo" type="assocarray" alwaysNotify="true"/>


    <!-- OUTPUTS -->
    <field id="linearChannelSelected" type="node" alwaysNotify="true"/>

    <field id="linearChannelFocused" type="node"/>

    <!--Since linearChannelFocused will get updated everytime minsLeftTimer is run, to protect unwanted trigging of observer, this field is used-->
    <field id="linearChannelFocusedUpdated" type="boolean" alwaysNotify="true"/>

    <!-- present the ready node to play -->
    <field id="linearChannelToPlay" type="node" />

    <!--Since LinearChannelToPlay will get updated everytime minsLeftTimer is run, to protect unwanted trigging of observer, this field is used-->
    <field id="linearChannelToPlayUpdated" type="boolean" alwaysNotify="true"/>

    <!--this field will be used to move the channelGrid when program grid moves-->
    <field id="currFocusRow" alias="ProgramGrid.currFocusRow" />

    <field id="okPressed" type="boolean" alwaysNotify="true"/>

    <!--this field will be used for long presses to dismiss the timer-->
    <field id="scrollingStatus" type="boolean"/>


    <field id="rowItemfocused" alias="ProgramGrid.rowItemFocused" />

    <!-- Holds the information needed to populate a component_interaction event. This will
           be observed by the contentController via epgScreenHelper
           which will be responsible for sending component_interaction events.
      -->
    <field id="componentInteractionInfo" type="assocarray"/>

    <!-- Holds the information needed to populate a navigate_within_page event. This will
           be observed by the contentController via epgScreenHelper
           which will be responsible for sending navigate_within_page events.
      -->
    <field id="navigateWithinPageInfo" type="assocarray"/>

    <!-- Holds the information about the channel that has been just liked or disliked
                "contentId": channel_Id of the liked or disliked channel
                "action": like / dislike
                "containerId": channel container/parent Id.
  }
    -->
    <field id="channelLikeDislikeInfo" type="assocarray" />

  </interface>

  <children>
    <Poster
      translation="[0,0]"
      width="1728"
      height="558"
      uri="pkg:/images/epgBackgroud.png"/>

    <LayoutGroup
      id="backToLive"
      layoutDirection="horiz"
      translation="[12,0]"
      itemSpacings="[20]"
      opacity="0">

      <Poster
        id="leftIcon"
        width="21"
        height="21"
        uri="pkg:/images/left-arrow.png"/>

      <Label
        id="backToLiveText"
        width="200  "
        height="24"
        text="Back to Live"
        opacity="1"
        horizAlign="left"
        vertAlign="center"
        maxLines="1"
        numLines="1"
        ellipsizeOnBoundary="true">
        <Font
          id="backToLiveTextFont"
          role="font"
          uri="pkg:/fonts/Vaud-medium.ttf"
          size="20" />
      </Label>
    </LayoutGroup>

    <Label
      id="headerText"
      translation="[0,51]"
      height="36"
      width="1000"
      horizAlign="left"
      vertAlign="center"
      opacity="1.0"
      maxLines="1"
      numLines="1"
      ellipsizeOnBoundary="true">
      <Font
        id="headerTextFont"
        role="font"
        uri="pkg:/fonts/Vaud-Bold.ttf"
        size="36" />
    </Label>

    <CommunicatingMarkupGrid
      id="channelsGrid"
      translation="[0, 96]"
      numRows="4"
      itemSize="[186,108]"
      itemSpacing="[0,12]"
      focusFootprintBitmapUri="pkg:/images/ratingBackground.9.png"
      focusBitmapUri="pkg:/images/epg-selector-fhd.9.png"
      drawFocusFeedbackOnTop="true"
      fadeFocusFeedbackWhenAutoScrolling="true"
      scrollSpeed="3"
      itemComponentName="ProgramGuideChannelItem"
      vertFocusAnimationStyle="fixedFocus"/>

    <CustomEPGRowList
      id="ProgramGrid"
      translation="[198,96]"
      numRows="4"
      itemSize="[1776,108]"
      rowItemSize="[[500,108]]"
      itemSpacing="[12,12]"
      drawFocusFeedbackOnTop="true"
      rowSpacings="[12]"
      rowItemSpacing="[[12,0]]"
      showRowCounter="[false]"
      rowFocusAnimationStyle="fixedFocus"
      focusFootprintBitmapUri="pkg:/images/ratingBackground.9.png"
      focusBitmapUri="pkg:/images/epg-selector-fhd.9.png"
      itemComponentName="ProgramGuideMenuItem"
      variableWidthItems="[true]"
      maintainHorizFocusPosition="false"
      fadeFocusFeedbackWhenAutoScrolling="true"
      scrollSpeed="3"
      vertFocusAnimationStyle="fixedFocus"/>

    <Timer
      id="updateMinsLeftTimer"
      duration="60"
      repeat="true"/>
  </children>
</component>
