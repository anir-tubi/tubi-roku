<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Items used in a Program Grid rowlist (program cards) for showing EPG TimeGrid.
 -->
<component name="ProgramGuideMenuItem" extends="Group" >
  <script type="text/brightscript" uri="ProgramGuideMenuItem.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemContent" type="node" />

    <field id="focusPercent" type="float" />

    <field id="rowFocusPercent" type="float" />

    <field id="index" type="integer" />

  </interface>

  <children>
    <Poster
      id="staticOverlay"
      height="108"
      width="291"
      opacity="1"
      uri="pkg:/images/timeProgress.png"/>

    <Poster
      id="cellRect"
      height="108"
      opacity="1"
      uri="pkg:/images/ratingBackground.9.png"/>

    <Label
      id="timeString"
      translation="[24,18]"
      height="30"
      horizAlign="left"
      vertAlign="center"
      maxLines="1"
      numLines="1"
      ellipsizeOnBoundary="true">
      <Font
        id="timeStringFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="24" />
    </Label>

    <LayoutGroup
      id="titleLockGroup"
      layoutDirection="horiz"
      translation="[24,54]"
      itemSpacings="[12]">

      <Label
        id="programString"
        translation="[24,54]"
        height="36"
        opacity="0.45"
        horizAlign="left"
        ellipsizeOnBoundary="true"
        maxLines="1"
        vertAlign="center">
        <Font
          id="titleFont"
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="30"/>
      </Label>
    </LayoutGroup>
  </children>
</component>
