<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Items used in a Channel MarkupGrid (channel Icons) for showing EPG TimeGrid.
 -->
<component name="ProgramGuideChannelItem" extends="Group" >
  <script type="text/brightscript" uri="ProgramGuideChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />

    <field id="focusPercent" type="float" />

    <field id="rowFocusPercent" type="float" />

  </interface>

  <children>
    <Poster
      id="channelPosterBG"
      height="108"
      width="186"
      opacity="1"
      uri="pkg:/images/ratingBackground.9.png"/>
    <Poster
      id="ChannelPoster"
      loadingBitmapUri="pkg:/images/placeholder.jpg"
      failedBitmapUri="pkg:/images/logo-white-large.png"
      opacity="0.24"
      height="72"
      width="72"
      loadheight="72"
      loadwidth="72"
      translation="[51,12]"
      loadDisplayMode="scaleToFit"/>
  </children>
</component>
