<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Items used in a Channel MarkupGrid (channel Icons) for showing EPG TimeGrid.
 -->
<component name="ProgramGuideChannelItem" extends="Group" >
  <script type="text/brightscript" uri="ProgramGuideChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />

    <field id="focusPercent" type="float" />

    <field id="itemHasFocus" type="boolean" />


  </interface>

  <children>
    <Poster
      id="emptyStar"
      translation="[15,15]"
      height="21"
      width="21"
      visible="false"
      uri="pkg:/images/icon-empty-star.webp"/>
    <Poster
      id="filledStar"
      translation="[15,15]"
      height="21"
      width="21"
      visible="false"
      uri="pkg:/images/icon-filled-star.webp"/>


    <Poster
      id="channelPosterBG"
      height="108"
      width="186"
      opacity="1"
      uri="pkg:/images/ratingBackground.9.png"/>
    <Poster
      id="ChannelPoster"
      loadingBitmapUri="pkg:/images/placeholder.jpg"
      failedBitmapUri="pkg:/images/logo-large.webp"
      opacity="0.24"
      height="84"
      width="84"
      loadheight="84"
      loadwidth="84"
      translation="[51,12]"
      loadDisplayMode="scaleToFit"/>
  </children>
</component>
