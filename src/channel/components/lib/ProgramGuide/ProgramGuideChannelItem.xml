<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Items used in a Channel MarkupGrid (channel Icons) for showing EPG TimeGrid.
 -->
<component name="ProgramGuideChannelItem" extends="Group" >
  <script type="text/brightscript" uri="ProgramGuideChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigLib.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/StatsigExperimentMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="float" />
    <field id="focusPercent" type="float" />

  </interface>

  <children>
    <Poster
      id="channelPosterBG"
      height="108"
      width="186"
      opacity="1"
      uri="pkg:/images/ratingBackground.9.png"/>
    <Poster
      id="starIcon"
      width="24"
      height="24"
      opacity="0"
      translation="[3,3]"
      uri="pkg:/images/icon-empty-star.webp"/>
    <Poster
      id="ChannelPoster"
      loadingBitmapUri="pkg:/images/placeholder.jpg"
      failedBitmapUri="pkg:/images/logo-large.webp"
      opacity="0.24"
      height="84"
      width="84"
      loadheight="84"
      loadwidth="84"
      translation="[51,12]"
      loadDisplayMode="scaleToFit"/>
  </children>
</component>
