<?xml version="1.0" encoding="utf-8" ?>
<!--
 - InfoPanel
 -
 - This is a panel of metadata about a piece of content or
 - a content category.  There are 6 modes:
 -    1) 'category' - shows only title and description
 -    2) 'item' - shows short content item description with releasedate, rating, etc.
 -    3) 'movie' - shows full details including cast and crew
 -    4) 'series' - shows full details including cast and crew
 -    5) 'season' - shows full details including cast and crew
 -    6) 'episode' - shows full details including cast and crew
 -
 -
 - The InfoPanel has 6 'regions' whose text are mapped as follows:
 -    Title - Uses content.title
 -    Episode - Uses content.episode_title
 -    CategoryDetails - uses content.getChildCount()
 -    TwoLineInfo - uses content.releasedate, content.length, content.rating, content.category/categories, 
 -    Description - uses content.description
 -    DirectorGroup - uses content.director/directors
 -    StarringGroup - uses content.actor/actors
 -
 -->
<component name="InfoPanel" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/InfoPanel/InfoPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />  
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />


  <interface>
    <!-- INPUTS -->
    <field id="title" alias="Title.text" />
    <field id="episodeTitle" alias="Episode.text" />
    <field id="releaseDate" type="string" />
    <field id="length" type="integer" />
    <field id="hasCC" type="boolean" />
    <field id="rating" type="string" />
    <field id="genres" type="stringarray" />
    <field id="description" type="string" />
    <field id="directors" type="stringarray" />
    <field id="starring" type="stringarray" />
    <field id="seasonEpisodeCount" type="integer" />
    <field id="categoryContentCount" type="integer" />
    <field id="calculateHeight" type="boolean" alwaysNotify="true" />


    <!-- mode is either: 'category', 'item', 'movie', 'series', 'season', 'episode' -->
    <field id="mode" type="string" value="category" />

    <!-- maxHeight is the area in which the content should be centered -->
    <field id="maxHeight" type="int" value="0" />
    <field id="maxTitleLines" alias="Title.maxLines"/>
    <field id="numTitleLines" alias="Title.numLines"/>
    <field id="titleFontSize" alias="TitleFont.size"/>
    <field id="width" type="float" value="875" />
    <field id="ratingVisible" alias="Rating.visible"/>
  </interface>

  <children>
    <LayoutGroup
      id="Offset"
      layoutDirection="vert"
      translation="[0,0]">

      <Label
        id="Title"
        width="875"
        wrap="true"
        maxLines="1"
        color="0xFFFFFFFF"
        vertAlign="bottom">
        <Font
          id="TitleFont"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="67" />
      </Label>

      <Label
        id="Episode">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="33" />
      </Label>

      <LayoutGroup
        id="CategoryDetails"
        layoutDirection="vert"
        itemSpacings="[10]"
        opacity="0.5"
        visible="true">
        <Label
          id="CategoryLine1">
          <Font
            id="Vaud27px"
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
        <!-- This is supposed to say "Updated Wednesday" or some other data we don't have yet.
        <Label
          id="CategoryLine2"
          font="dictionary:Vaud22px"/>
        -->
      </LayoutGroup>
      
      <LayoutGroup
        id="SeasonDetails"
        layoutDirection="vert"
        itemSpacings="[10]"
        opacity="0.5"
        visible="true">
        <Label
          id="SeasonLine1"
          font="dictionary:Vaud27px" />
      </LayoutGroup>
      
      <LayoutGroup
        id="TwoLineInfo"
        layoutDirection="vert"
        itemSpacings="[8]"
        visible="true" >
        <LayoutGroup
          id="FirstLineGroup"
          layoutDirection="horiz"
          vertAlignment="center" >
          <Label
            id="Line1"
            opacity="0.5"
            font="dictionary:Vaud27px" />
          <Rectangle
            id="ClosedCaptionRectangle"
            height="36"
            width="72"
            color="0x00000000">
            <Poster
              id="ClosedCaptionPoster"
              height="36"
              loadHeight="36"
              loadDisplayMode="scaleToFit"
              translation="[3,0]"
              loadSync="true"
              uri="pkg://images/icon-closed-caption.png" />
          </Rectangle>
          <Rectangle
            height="40"
            width="72"
            color="0x00000000">
            <Poster
              id="Rating"
              height="36"
              loadHeight="36"
              loadDisplayMode="scaleToFit"
              loadSync="true"
              translation="[0,0]" />
          </Rectangle>
        </LayoutGroup>
        <Label
          id="Line2"
          opacity="0.5"
          width="875"
          ellipsizeOnBoundary="true"
          font="dictionary:Vaud27px"/>
      </LayoutGroup>
      
      <Label
        id="Description"
        width="875"
        lineSpacing="16"
        maxLines="5"
        wrap="true"
        color="0xFFFFFFFF"
        font="dictionary:Vaud27px" />

      <LayoutGroup
        id="DirectorGroup"
        layoutDirection="horiz"
        vertAlignment="bottom"
        itemSpacings="[5,5]">
        <Label
          id="DirectorTag"
          text="Directed by"
          font="dictionary:Vaud27px"
          visible="true" 
          opacity="0.5"/>
        <!-- this layout group pushes the separator rectangle up 2 pixels -->
        <LayoutGroup
          layoutDirection="vert">
          <Rectangle 
            id="DirectorRect"
            opacity="0.2"
            width="43"
            height="2"/>
          <Rectangle 
            opacity="0.0"
            width="43"
            height="5"/>
        </LayoutGroup>
        <Label
          id="Director"
          font="dictionary:Vaud27px"
          color="0xFFFFFFFF"
          ellipsizeOnBoundary="true"
          width="710"        
          visible="true" />
      </LayoutGroup>

      <LayoutGroup
        id="StarringGroup"
        layoutDirection="horiz"
        vertAlignment="bottom"
        itemSpacings="[5,5]">
        <Label
          id="StarringTag"
          text="Starring"
          font="dictionary:Vaud27px"
          visible="true" 
          opacity="0.5"/>
        <LayoutGroup
          layoutDirection="vert">
          <Rectangle 
            id="StarringRect"
            opacity="0.2"
            width="84"
            height="2"/>
          <Rectangle 
            opacity="0.0"
            width="77"
            height="5"/>
        </LayoutGroup>
        <Label
          id="Starring"
          font="dictionary:Vaud27px"
          color="0xFFFFFFFF"
          ellipsizeOnBoundary="true"
          width="710"
          visible="true" />
      </LayoutGroup>
    </LayoutGroup>
  </children>

</component>
