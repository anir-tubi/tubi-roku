<?xml version="1.0" encoding="utf-8" ?>
<!--
 - InfoPanel
 -
 - This is a panel of metadata about a piece of content or
 - a content category.  There are 10 modes, which are secified as emun in constants (constants.ui.infoPanelModes):
 -    1) 'category' - shows only title and description
 -    2) 'item' - shows short content item description with releasedate, rating, etc.
 -    3) 'movie' - shows full details including cast and crew
 -    4) 'series' - shows full details including cast and crew
 -    5) 'season' - shows full details including cast and crew
 -    6) 'episode' - shows full details including cast and crew
 -    7) 'continue_watching' - shows title and description
 -    8) 'linear' - shows title and description
 -    9) 'vitg' - shows nothng
 -   10) 'epg' - shows image, title, description, year aired, program timings, cc, ratings, genre and tags
 -
 -
 - The InfoPanel has 6 'regions' whose text are mapped as follows:
 -    Title - Uses content.title
 -    Episode - Uses content.episode_title
 -    CategoryDetails - uses content.getChildCount()
 -    TwoLineInfo - uses content.releasedate, content.length, content.rating, content.category/categories,
 -    Description - uses content.description
 -    DirectorGroup - uses content.director/directors
 -    StarringGroup - uses content.actor/actors
 -
 -->
<component name="InfoPanel" extends="Group">

  <script type="text/brightscript" uri="InfoPanel.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="title" alias="Title.text" />
    <field id="titleLogoUri" type="string" />
    <field id="headerImageUri" type="string" />
    <field id="episodeTitle" alias="Episode.text" />
    <field id="genres" type="stringarray" />
    <field id="description" type="string" />
    <field id="directors" type="stringarray" />
    <field id="starring" type="stringarray" />
    <field id="seasonEpisodeCount" type="integer" />
    <field id="categoryContentCount" type="integer" />
    <field id="fullscreenCountdown" type="integer" value="0"/>
    <field id="calculateHeight" type="boolean" alwaysNotify="true" />

    <!-- handles changes to FirstLineGroup, has a structure like
      {
        releaseDate: "1924"   'The year the video was released
        length: 0             'The length of the video in seconds
        hasCC: true           'Indicates if the video has captions
        rating: "R"           'The rating of the video, can be "G", "NR", "PG-13", "PG", "R", "TV-14", "TV-G",
                               "TV-MA", "TV-PG", "TV-Y", "TV-Y7"  or lowercase
        partnerLogoUri: ""    'The URI used to display the partner/channel logo
        availabilityEnds: "2019-03-31T00:00:00Z"
        DescriptorCode: "L V"  'This is rating descriptor code for a program'
      }
      Handling these at once is more efficient than handling them all individually
     -->
    <field id="lineOneData" type="assocarray" />

    <!-- mode is either: 'category', 'item', 'movie', 'series', 'season', 'episode' -->
    <field id="mode" type="string"/>

    <!-- maxHeight is the area in which the content should be centered -->
    <field id="maxHeight" type="int" value="0" />
    <field id="maxTitleLines" alias="Title.maxLines"/>
    <field id="numTitleLines" alias="Title.numLines"/>
    <field id="titleFontSize" alias="TitleFont.size"/>
    <field id="width" type="float" value="960" />
    <field id="ratingVisible" alias="Rating.visible"/>

    <!-- OUTPUTS -->
    <field id="descriptionSelected" type="boolean" alwaysNotify="true" />

    <!-- Parent can use this to determine whether it makes sense to give InfoPanel focus -->
    <field id="isDescriptionEllipsized" alias="Description.isTextEllipsized" />
  </interface>

  <children>
    <LayoutGroup
      id="infoPanelGroup"
      layoutDirection="horiz"
      horizAlignment="left"
      translation="[0,0]"
      itemSpacings="[12]">
      <Poster
        id="HeaderImage"
        loadingBitmapUri="pkg:/images/placeholder.jpg"
        width="186"
        height="264"
        visible="false"
        translation="[0,0]"
        loadDisplayMode="scaleToFit"/>

      <LayoutGroup
        id="Offset"
        layoutDirection="vert"
        horizAlignment="custom"
        translation="[0,0]">

        <Poster
          id="LiveVideoIndicator"
          uri="pkg:/images/icon-live.png"
          width="94"
          height="37"
          visible="true"/>

        <LayoutGroup
          id="TitleGroup"
          layoutDirection="horiz"
          vertAlignment="center"
          itemSpacings="[20]"
          addItemSpacingAfterChild="true">
          <Poster
            id="TitleLogo"
            visible="false"
            height="80"
            width="80"
            loadDisplayMode="scaleToFit" />
          <Label
            id="Title"
            width="1140"
            wrap="true"
            maxLines="2"
            color="0xFFFFFFFF"
            vertAlign="bottom">
            <Font
              id="TitleFont"
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="47" />
          </Label>
        </LayoutGroup>


        <Label
          id="Episode">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="33" />
        </Label>

        <LayoutGroup
          id="CategoryDetails"
          layoutDirection="vert"
          itemSpacings="[10]"
          opacity="0.5"
          visible="true">
          <Label
            id="CategoryLine1">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
          <!-- This is supposed to say "Updated Wednesday" or some other data we don't have yet.
          <Label
            id="CategoryLine2"
            font="dictionary:Vaud22px"/>
          -->
        </LayoutGroup>

        <LayoutGroup
          id="SeasonDetails"
          layoutDirection="vert"
          itemSpacings="[10]"
          opacity="0.5"
          visible="true">
          <Label
            id="SeasonLine1">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
        </LayoutGroup>

        <LayoutGroup
          id="TwoLineInfo"
          layoutDirection="vert"
          itemSpacings="[8]"
          visible="true" >
          <LayoutGroup
            id="FirstLineGroup"
            layoutDirection="horiz"
            vertAlignment="center"
            itemSpacings="[10]"
            addItemSpacingAfterChild="true">
            <Label
              id="Line1"
              opacity="0.5">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </Label>
            <Poster
              id="ClosedCaptionPoster"
              height="36"
              width="56"
              loadDisplayMode="scaleToFit"
              loadSync="true"/>
            <Group
              id="Rating"
              visible="false">
              <Poster
                id="RatingBackground"
                height="36"
                uri="pkg:/images/ratingBackground.9.png"
                loadDisplayMode="scaleToFit"
                loadSync="true"/>
              <Label
                id="RatingLabel"
                height="36"
                width="0"
                opacity="0.8"
                color="0xFFFFFFFF"
                numLines="1"
                wrap="false"
                translation="[0,3]"
                horizAlign="center"
                vertAlign="center">
                <Font
                  role="font"
                  uri="pkg:/fonts/Vaud-Bold.ttf"
                  size="22" />
              </Label>
            </Group>
            <Label
              id="DescriptorCode"
              visible="false">
              <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="22" />
            </Label>
            <Label
              id="ExpireWarning">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </Label>
            <Poster
              id="PartnerLogo"
              height="36"
              loadHeight="36"
              loadDisplayMode="scaleToFit"/>
          </LayoutGroup>
          <LayoutGroup
            id="SecondLineGroup"
            layoutDirection="horiz"
            vertAlignment="center"
            itemSpacings="[10]"
            addItemSpacingAfterChild="true">
            <Label
              id="Line2"
              opacity="0.5"
              width="1140"
              ellipsizeOnBoundary="true">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </Label>
          </LayoutGroup>
        </LayoutGroup>

        <Group
          id="DescriptionGroup"
          translation="[-25,0]">
          <Poster
            id="DescriptionFocusButton"
            uri="pkg:/images/menu-focus-fhd.9.png"
            width="1140"
            height="300"
            visible="false"/>
          <Label
            id="Description"
            width="1140"
            lineSpacing="16"
            maxLines="5"
            wrap="true"
            color="0xFFFFFFFF"
            translation="[25,15]"
            visible="false">
            <Font
              id="DescriptionFont"
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
        </Group>

        <LayoutGroup
          id="DirectorGroup"
          layoutDirection="horiz"
          vertAlignment="bottom"
          itemSpacings="[5]"
          visible="false">
          <LayoutGroup
            id="DirectorPrefix"
            layoutDirection="horiz"
            itemSpacings="[5]"
            vertAlignment="bottom">
            <Label
              id="DirectorTag"
              opacity="0.5">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </Label>
            <!-- this layout group pushes the separator rectangle up 2 pixels -->
            <LayoutGroup
              layoutDirection="vert">
              <Rectangle
                id="DirectorRect"
                opacity="0.2"
                width="43"
                height="2"/>
              <Rectangle
                opacity="0.0"
                height="5"/>
            </LayoutGroup>
          </LayoutGroup>
          <Label
            id="Director"
            color="0xFFFFFFFF"
            ellipsizeOnBoundary="true"
            width="710">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
        </LayoutGroup>

        <LayoutGroup
          id="StarringGroup"
          layoutDirection="horiz"
          vertAlignment="bottom"
          itemSpacings="[5]"
          visible="false" >
          <LayoutGroup
            id="StarringPrefix"
            layoutDirection="horiz"
            itemSpacings="[5]"
            vertAlignment="bottom">
            <Label
              id="StarringTag"
              opacity="0.5">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </Label>
            <LayoutGroup
              layoutDirection="vert">
              <Rectangle
                id="StarringRect"
                opacity="0.2"
                width="84"
                height="2"/>
              <Rectangle
                opacity="0.0"
                width="1"
                height="5"/>
            </LayoutGroup>
          </LayoutGroup>
          <Label
            id="Starring"
            color="0xFFFFFFFF"
            ellipsizeOnBoundary="true"
            width="710">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
        </LayoutGroup>
      </LayoutGroup>
    </LayoutGroup>

    <LayoutGroup
      id="PlayerCountdownGroup"
      layoutDirection="horiz"
      vertAlignment="bottom"
      itemSpacings="[15]"
      opacity=".64"
      visible="false" >
      <Poster
        id="FullscreenIcon"
        uri="pkg:/images/icon-fullScreen.png"
        width="30"
        height="26"
        loadDisplayMode="scaleToFit"
        loadSync="true"/>
      <Label
        id="CountdownText"
        color="0xFFFFFFFF">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </LayoutGroup>
  </children>
</component>
