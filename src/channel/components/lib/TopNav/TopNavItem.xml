<?xml version="1.0" encoding="utf-8" ?>
<component name="TopNavItem" extends="Group" >
  <script type="text/brightscript" uri="TopNavItem.brs" />
  <script type="text/brightscript" uri="../AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="itemContent" type="node" />
    <field id="height" type="float"/>
    <field id="width" type="float"/>
    <field id="boundingRect" type="assocarray"/>
  </interface>

  <children>
    <Poster
      id="selectedBackground"
      height="60"
      opacity="0"
      uri="pkg:/images/top-nav-selected-unfocused-$$RES$$.9.png"/>
    <Label
      id="unfocusedTopLabel"
      translation="[36, 24]"
      width="150">
      <Font
          role="font" />
    </Label>
    <Label
      id="focusedBottomLabel"
      translation="[36, 24]"
      width="150"
      opacity="0">
      <Font
          role="font" />
    </Label>
  </children>
</component>
