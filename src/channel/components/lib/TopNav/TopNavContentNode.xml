<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "TopNavContentNode" extends="ContentNode">
  <interface>
    <field id="selected" type="boolean" value="false"/>
    <field id="selectedItemColor" type="color"/>
    <!--new text that can be appeneded to menu text. In case of FIFA, it is NEW badge-->
    <field id="subText" type="string" value="" />
  </interface>
</component>