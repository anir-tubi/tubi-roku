<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryVideoPlayer" extends="Group" >
  <script type="text/brightscript" uri="CategoryVideoPlayer.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="videoUrl" type="string" />
      <field id="trailerId" type="string" />
      <field id="hasFocus" type="boolean" />
      <field id="width" alias="VitgVideoPlayer.width" />
      <field id="height" alias="VitgVideoPlayer.height" />
      <field id="control" alias="VitgVideoPlayer.control" />

      <!-- resumePos is accepted in seconds -->
      <field id="resumePos" type="float" />

    <!-- OUTPUTS -->
      <field id="videoState" alias="VitgVideoPlayer.state" />

      <!-- nowPos is stored in ms -->
      <field id="nowPos" type="integer" />
  </interface>

  <children>
    <Video
      id="VitgVideoPlayer"
      visible="false"
      width="430"
      height="242"
      cgms = "3"
      enableUI="false" />
  </children>
</component>
