<?xml version="1.0" encoding="utf-8" ?>

<!--
 - SideNav Group
 -
 - This is the main side navigation of the app
 -->
<component name="SideNav" extends="Group">
  <script type="text/brightscript" uri="SideNav.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TimeUtils.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="width" type="float"/>

      <field id="opened" value="false" type="boolean"/>

      <!-- Should the sideNav display the Sign In menu item? -->
      <field id="displaySignIn" value="true" type="boolean"/>

      <!-- Should the sideNav display the Sign In menu item? -->
      <field id="displayKids" value="true" type="boolean"/>

      <!-- Should the sideNav display the Espanol menu item? -->
      <field id="displayEspanol" value="true" type="boolean"/>

      <!-- Should the sideNav display the Linear TV menu item? -->
      <field id="displayLinearTV" value="true" type="boolean"/>

      <!-- Should the sideNav display the Linear TV menu item? -->
      <field id="displayLinearEPG" value="true" type="boolean"/>

      <!-- Should the sideNav display the movies/TV menu items? -->
      <field id="displayMoviesTV" value="true" type="boolean"/>

      <!-- Should the sideNav display the channels menu item? -->
      <field id="displayChannels" value="true" type="boolean"/>

      <!-- The following are the strings associated with this UI element that is changed from the helper/controller file -->
      <field id="stringSignIn" type="string"/>

      <!-- Setting to false grays out the espanol item making it unselectable -->
      <field id="espanolItemTurnedOn" type="boolean"/>

      <!-- Setting to false grays out the LiveTV item making it unselectable -->
      <field id="linearEPGTurnedOn" type="boolean"/>

      <!-- Setting to false grays out the kids item making it unselectable -->
      <field id="kidsItemTurnedOn" value="true" type="boolean"/>

      <!-- Allowed values are those in constants.ui.modes -->
      <field id="uiMode" type="string"/>

      <!--The id of one of the menu items. If the menu item exists and is selectable, then itemSelected will be updated. -->
      <field id="itemRequested" type="string" alwaysNotify="true"/>

      <field id="selectedItemRequested" type="string" alwaysNotify="true"/>

      <!-- createMenuItems is used to create menu items on side nav, invoked from controller  -->
      <field id="createMenuItems" type="boolean"/>

    <!-- OUTPUT -->
      <!-- The sideNavContentNode for the side nav menu item that was selected. This field should not be observed, as
      the contents of the node can change frequently, even if the node itself remains the same. It can be checked for the
      current state of the node. -->
      <field id="itemSelected" type="node"/>

      <!-- The id of the menu item that was selected -->
      <field id="itemSelectedId" type="string" alwaysNotify="true"/>

      <!-- The id of the menu item that is associated with a screen that is currently active/visible. -->
      <field id="itemCurrentId" type="string" alwaysNotify="true"/>

      <!-- The focused position of the current menu list. -->
      <field id="focusedPosition" type="integer"/>

      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be observed by the SideNavHelper, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

  </interface>

  <children>
    <Poster
    id="sideNavBackground"
    width="405"
    height="1080"/>
    <LayoutGroup
        id="itemGroups"
        layoutDirection="vert"
        translation="[0,60]"
        itemSpacings="[1]">

      <Group>
        <MarkupList
          numRows="8"
          id="mainItemsSelected"
          itemSize="[397,70]"
          itemSpacing="[0,17]"
          vertFocusAnimationStyle="floatingFocus"
          focusFootprintBitmapUri="pkg:/images/sideNavItemComponent.9.png"
          focusBitmapUri="pkg:/images/sideNavItemComponent.9.png"
          drawFocusFeedbackOnTop="false"
          itemComponentName="SideNavIconComponent">
          <ContentNode id="MainContent-select" role="content" >
          </ContentNode>
        </MarkupList>
        <MarkupList
          numRows="8"
          id="mainItems"
          itemSize="[397,70]"
          itemSpacing="[0,17]"
          vertFocusAnimationStyle="floatingFocus"
          focusFootprintBitmapUri="pkg:/images/sideNavItemComponent.9.png"
          focusBitmapUri="pkg:/images/sideNavItemComponent.9.png"
          drawFocusFeedbackOnTop="false"
          itemComponentName="SideNavIconComponent">
          <ContentNode id="MainContent" role="content" >
          </ContentNode>
        </MarkupList>
      </Group>

    </LayoutGroup>
  </children>
</component>
