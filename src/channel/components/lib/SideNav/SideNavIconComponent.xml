<?xml version="1.0" encoding="utf-8" ?>
<component name="SideNavIconComponent" extends="Group" >
  <script type="text/brightscript" uri="SideNavIconComponent.brs" />
  <script type="text/brightscript" uri="../AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="active" value="false" type="boolean" alwaysNotify="true"/>
    <field id="height" type="float" alwaysNotify="true" />
    <field id="width" type="float"/>
  </interface>

  <children>
    <Group
      id="IconParent">
      <Poster
        id="Icon"
        translation="[36, 0]"
        loadSync="true"
        width="36"
        height="36"/>
      <Poster
        id="focusedIcon"
        translation="[36, 0]"
        loadSync="true"
        width="36"
        height="36"
        visible="false"
        opacity="0"/>
    </Group>

    <Label
      id="subTxt"
      vertAlign="center"
      horizAlign="left">
      <Font
        id="subtextFont"
        role="font"
        uri="pkg:/fonts/Vaud-Bold.ttf"
        size="20" />
    </Label>
    <LayoutGroup
      id="LabelParent"
      translation="[84, 3]"
      layoutDirection="horiz"
      itemSpacings="[12]"
      vertAlignment="custom">
      <Group>
        <Label
          id="Label"
          vertAlign="center"
          opacity="0">
          <Font
              id="Font"
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="34" />
        </Label>
        <Label
          id="focusedLabel"
          vertAlign="center"
          visible="false"
          opacity="0">
          <Font
              id="focusedFont"
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="34" />
        </Label>
      </Group>
   </LayoutGroup>
  </children>
</component>
