<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - EnhancedCaretButton 
 -
 - This component is same as CaretButton with few changes in background image, This is done as part of roku_player_control_ui_refresh_v2 experiment.
 - This file can be kept if we graduate variant2 & variant3. Else, we will remove it
 -
 -->
<component name="EnhancedCaretButton" extends="Group" >
  <script type="text/brightscript" uri="EnhancedCaretButton.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- Content expected for a item:
     -
     - title - The label text
     - checked - Holds a true/false value based on if the item is selected
     -
     -->
    <!-- INPUT-->
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <!-- Below field will be used if the component is used in a list component -->
    <field id="listHasFocus" type="boolean" />
    <!-- Below field will be used if the component is used in a grid component -->
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    
    <field id="width" type="float" alias="background.width" />
    <field id="height" type="float" alias="label.height, background.height, labelFocused.height" />

    <!-- OUTPUT-->
    <field id="calculatedWidth" type="float"/>
  </interface>

  <children>
    <Poster 
      id="background"
      uri="pkg:/images/pill_top_nav_$$RES$$.9.png"/>
    <LayoutGroup
      id="container"
      vertAlignment="center"
      translation="[36, 0]"
      itemSpacings="[15, 30]"
      layoutDirection="horiz">
        <Group>
          <Label
            id="label"
            text=""
            height="81"
            horizAlign="left"
            vertAlign="center">
            <Font
              role="font"/>
          </Label>
          <Label
            id="labelFocused"
            text=""
            opacity="0"
            height="81"
            horizAlign="left"
            vertAlign="center">
            <Font
              role="font"/>
          </Label>
        </Group>
        <Group>
          <Poster
            id="caret"
            width="36"
            height="36"
            uri="pkg:/images/caret.png"
            visible="false"/>
          <Poster
            id="caretFocused"
            width="36"
            height="36"
            uri="pkg:/images/caret.png"
            visible="false"/>  
        </Group>
    </LayoutGroup>
  </children>
</component>
