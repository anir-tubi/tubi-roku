<?xml version="1.0" encoding="utf-8" ?>
<component name="NotificationGroup" extends="Group" >

  <script type="text/brightscript" uri="NotificationGroup.brs" />

  <interface>
    <!-- INPUT -->
    <field id="blendColor" alias="notificationBorder.blendColor" />
    <field id="textColor" alias="notificationTitle.color" />
    <field id="text" alias="notificationTitle.text" />
  </interface>

  <children>
    <Poster
      id="notificationBorder"
      uri="pkg:/images/menu-focus-$$RES$$.9.png"
      height="57" />
    <LayoutGroup
      id="notificationLayout"
      layoutDirection="horiz"
      vertAlignment="center"
      itemSpacings="[6]"
      translation="[18,33]"
      horizAlignment="left">
      <Label
        id="notificationTitle"
        height="36"
        vertAlign="center">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="24" />
      </Label>
      <Poster
        id="asteriskIcon"
        height="33"
        width="33"
        uri="pkg:/images/asterisk.png"/>
    </LayoutGroup>
  </children>

</component>
