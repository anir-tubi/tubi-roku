<?xml version="1.0" encoding="utf-8"?>
<component name="Badge" extends="Group">
  <script type="text/brightscript" uri="Badge.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />

  <interface>
    <field id="backgroundUri" type="string" alias="BadgeBackground.uri" />
    <field id="backgroundColor" type="string" alias="BadgeBackground.blendColor" />
    <field id="borderUri" alias="badgeBorder.uri" />
    <field id="textColor" type="string" alias="BadgeText.color" />
    <field id="iconUri" type="string" />
    <field id="text" type="string" />
    <field id="width" type="float" alias="BadgeBackground.width, badgeBorder.width" />
    <field id="height" type="float" alias="BadgeBackground.height, badgeBorder.height" />
    <field id="badgeTextWidth" type="float" alias="BadgeText.width" />
    <field id="isSotBadge" type="boolean"  value="false" />
    <field id="showBackground" alias="BadgeBackground.visible, badgeBorder.visible" value="true" />
    <!-- This field is used to set the font style/size of the badge text when showBackground is
    false. Values can be any typographyConstants ids. -->
    <field id="badgeTextFont" type="string" />
    <field id="maxWidth" type="float" />
  </interface>

  <children>
    <Poster
      id="BadgeBackground"
      height="36"
      width="0"
      uri="pkg:/images/badge-background-$$RES$$.9.png" />
    <Poster
      id="badgeBorder"
      height="36"
      width="0"
      uri="pkg:/images/badge-border-light-$$RES$$.9.png" />
    <LayoutGroup
      id="BadgeInfoLayout"
      layoutDirection="horiz">
      <Poster
        id="BadgeIcon"
        height="21"
        width="0"
        loadDisplayMode="scaleToFit" />
      <Label
        id="BadgeText"
        height="24"
        vertAlign="center"
        ellipsizeOnBoundary="true"
        maxLines="1">
        <Font
          role="font" />
      </Label>
    </LayoutGroup>
  </children>
</component>