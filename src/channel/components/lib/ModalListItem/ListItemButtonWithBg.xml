<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ListItemButtonWithBg
 -
 - Items used in a MarkupGrid (like FilledButtonMarkupGrid) or RowList for showing modal buttons.
 -
 -->
<component name="ListItemButtonWithBg" extends="Group" >
  <script type="text/brightscript" uri="ListItemButtonWithBg.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean"/>
    <field id="focusPercent" type="float"/>
    <field id="width" type="float" alias="label.width,labelFocused.width" />
    <field id="height" type="float" alias="label.height,labelFocused.height" />
    <field id="calculatedWidth" type="float"/>
  </interface>

  <children>
    <Poster
      id="background"
      uri="pkg:/images/menu-focus-$$RES$$.9.png"
      opacity="1.0"
      height="72"
      width="285"/>

    <Group
      id="buttonTextParent"
      translation="[0,3]">
      <Label
        id="label"
        horizAlign="center"
        vertAlign="center"
        height="78">
        <Font
          id="labelFont"
          role="font"/>
      </Label>
      <Label
        id="labelFocused"
        horizAlign="center"
        vertAlign="center"
        opacity="0"
        height="78">
        <Font
          id="labelFocusedFont"
          role="font"/>
      </Label>
    </Group>
  </children>
</component>
