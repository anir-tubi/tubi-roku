<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ModalListItem
 -
 - Items used in a MarkupGrid (like FilledButtonMarkupGrid) or RowList for showing modal buttons.
 -
 -->
<component name="ModalListItem" extends="Group" >
  <script type="text/brightscript" uri="ModalListItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemContent" type="node" />
    <field id="gridHasFocus" type="boolean" alias="buttonTextFocused.visible"/>
    <field id="focusPercent" type="float" alias="buttonTextFocused.opacity"/>
    <field id="width" type="float" alias = "buttonText.width" />
    <field id="height" type="float" value="80.0" />
    <field id="calculatedWidth" type="float"/>
  </interface>

  <children>
    <Group
      id="buttonTextParent"
      translation="[44,1]">
      <Label
        id="buttonText"
        horizAlign="left"
        vertAlign="center"
        height="79">
        <Font
          role="font"
          size="33"
          uri="pkg:/fonts/Vaud-SemiBold.ttf" />
      </Label>
      <Label
        id="buttonTextFocused"
        horizAlign="left"
        vertAlign="center"
        height="79">
        <Font
          role="font"
          size="33"
          uri="pkg:/fonts/Vaud-SemiBold.ttf" />
      </Label>
    </Group>
  </children>
</component>
