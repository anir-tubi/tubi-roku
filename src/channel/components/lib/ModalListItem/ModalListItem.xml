<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - InstalledCategorySeasonListItem
 - This is a copy of the CategorySeasonListItem, only it is added to the installed pkg
 - and will not be able to be modified as part of the external component library.
 -
 - Items used in a ScrollingList for showing categories.  These
 - are labels which can wrap text and also display a cursor when
 - the scrollinglist has focus.
 -
 -->
<component name="ModalListItem" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/ModalListItem/ModalListItem.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="width" type="float" value="406.0" />
    <field id="height" type="float" value="80.0" />
  </interface>
  
  <children>
    <Label 
      id="buttonText" 
      horizAlign="left"
      vertAlign="center"
      width="322"
      height="79"
      translation="[44,1]"
      opacity="1.0"
      color="0xFFFFFFFF">
      <Font
      role="font"
      size="33"
      uri="pkg:/fonts/Vaud-SemiBold.ttf" />
    </Label>
  </children>
</component>
