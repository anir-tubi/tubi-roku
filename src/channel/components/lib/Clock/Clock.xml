<?xml version="1.0" encoding="utf-8" ?>
<component name="Clock" extends="Group" >
  <script type="text/brightscript" uri="Clock.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <!-- When display is changed, it will perform the operations that are needed to properly display or hide the guide. -->
    <field id="width" alias="clockBground.width, time.width" />
    <field id="height" alias="clockBground.height, time.height" />

    <!-- Setting the component's visblity will start or stop the timer, but this allows you to start and stop the timer w/o affecting the visibility. -->
    <!-- The available values for this field are the same a timer's control: start, stop, none -->
    <field id="control" alias="clockTimer.control" />

  </interface>

  <children>
    <Poster
      id="clockBground"
      uri="pkg:/images/time-patch.png"/>
    <Label
      id="time"
      height="18"
      vertAlign="center"
      horizAlign="center"
      translation="[0,2]"
      color="0x000000FF">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Bold.ttf"
        size="18"/>
    </Label>

    <Timer
      id="clockTimer" />
  </children>
</component>
