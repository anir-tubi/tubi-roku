<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryGridRowLabel" extends="Group">
  <script type="text/brightscript" uri="CategoryGridRowLabel.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- Incoming interface: populate children nodes with content values -->
      <field id="content" type="node"/>

      <!-- Don't think this is needed but cursor bot complained about removing it -->
      <field id="isFullyLoaded" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Poster
      id="SponsorPoster"
      width="112"
      height="0"
      translation="[0,0]"
      visible="false"
      opacity="0" />
    <Label
      id="CategoryName"
      width="1000"
      height="0"
      vertAlign="center"
      opacity="1.0" />
    <!--subText will be appended to the row label-->
    <Label
      id="subText"
      width="800"
      height="0"
      vertAlign="center"
      visible="false">
      <Font
        role="font"
        id="subTextFont"/>
    </Label>

    <LayoutGroup
      id="SponsoredBy"
      layoutDirection="horiz"
      itemSpacings="[12]"
      visible="false"
      opacity="0"
      vertAlignment="center"
      translation="[124,0]">
      <Label
        id="SponsoredByText"
        text=""
        vertAlign="center"
        width="0"
        height="0"
        opacity=".64">
        <Font
          id="SponsoredByTextFont"
          role="font"/>
      </Label>
      <Poster
        id="SponsoredByPoster"
        visible="false"/>
    </LayoutGroup>

  </children>
</component>
