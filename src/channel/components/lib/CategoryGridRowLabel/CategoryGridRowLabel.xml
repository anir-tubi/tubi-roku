<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryGridRowLabel" extends="Group">
  <script type="text/brightscript" uri="CategoryGridRowLabel.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- Incoming interface: populate children nodes with content values -->
      <field id="content" type="node"/>

      <!-- The number of the focus/current index.
        ::NOTE::If the component is set as the rowTitleComponentName of a RowList,
        then the focusIndex is set automatically and the currentindex field does not need to be set. -->
      <field id="currentIndex" type="integer"/>
  </interface>

  <children>
    <Poster
      id="SponsorPoster"
      width="112"
      height="0"
      translation="[0,0]"
      visible="false"
      opacity="0" />
    <Label
      id="CategoryName"
      height="36"
      width="1000"
      vertAlign="center"
      color="0xFFFFFFFF"
      opacity="1.0">
      <Font
        role="font"
        id="CategoryNameFont"
        uri="pkg:/fonts/Vaud-Bold.ttf"
        size="36" />
    </Label>
    <!--subText will be appended to the row label-->
    <Label
      id="subText"
      height="36"
      width="800"
      vertAlign="center"
      color="0xD7DAE0FF"
      visible="false"
      opacity="0.64">
      <Font
        role="font"
        id="subTextFont"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="24" />
    </Label>

    <LayoutGroup
      id="SponsoredBy"
      layoutDirection="horiz"
      itemSpacings="[12]"
      visible="false"
      opacity="0"
      vertAlignment="center"
      translation="[124,0]">
      <Label
        id="SponsoredByText"
        text=""
        vertAlign="center"
        width="0"
        height="0"
        opacity=".64">
        <Font
          id="SponsoredByTextFont"
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="24" />
      </Label>
      <Poster
        id="SponsoredByPoster"
        visible="false"/>
    </LayoutGroup>
    <LayoutGroup
      id="CategoryCount"
      layoutDirection="horiz"
      horizAlignment="right"
      translation="[1572,12]">
      <Label
        id="FocusIndex"
        text=""
        height="30"
        horizAlign="right">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>
      <Label
        id="ItemCount"
        text=""
        height="30"
        horizAlign="right">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>
    </LayoutGroup>

  </children>
</component>
