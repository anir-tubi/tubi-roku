<?xml version="1.0" encoding="utf-8" ?>
<!--
 - LabelItem
 -
 - Items used in a MarkupList which only displays the label/text
 -
 -->
<component name="LabelItem" extends="Group" >
  <script type="text/brightscript" uri="LabelItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT-->
    <field id="itemContent" type="node" />
    <field id="gridHasFocus" type="boolean" />
    <field id="itemHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
  </interface>

  <children>

    <Label
      id="label"
      width="278"
      height="56"
      horizAlign="left"
      vertAlign="center"
      translation="[15, 0]"
      opacity="1.0">
      <Font
        role="font"/>
    </Label>

    <Label
      id="focusedLabel"
      width="278"
      height="56"
      horizAlign="left"
      vertAlign="center"
      translation="[15, 0]"
      opacity="0.0">
      <Font
        role="font"/>
    </Label>

  </children>
</component>
