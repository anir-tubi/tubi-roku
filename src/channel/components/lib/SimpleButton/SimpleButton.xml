<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SimpleButton
 - A simple, stand alone button that changes width based on the length of the text, and
 - whose color and opacity change based on if it has focus or not.
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="SimpleButton" extends="Group" >
  <script type="text/brightscript" uri="SimpleButton.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>

    <!-- INPUTS -->
      <field id="color" type="String" value="0x9699A3"/>

      <!-- only set a width for fixed width buttons. -->
      <field id="width" type="integer" />

      <field id="height" alias="buttonBG.height"/>
      <field id="uri" alias="buttonBG.uri"/>
      <field id="fontSize" alias="labelFont.size"/>
      <field id="text" type="String" />
      <field id="unfocusedBackgroundOpacity" type="float" value="0.17"/>

    <!-- OUTPUTS -->
      <field id="selected" type="boolean" alwaysNotify="true" />

  </interface>

  <children>
    <Poster
      id="buttonBG"
      height="80"
      uri="pkg:/images/menu-focus-fhd.9.png"
      translation="[0,0]"/>
    <Label
      id="label"
      color="0xFFFFFF"
      opacity="1.0"
      height="80"
      horizAlign="center"
      vertAlign="center">
      <Font
        id="labelFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
  </children>
</component>
