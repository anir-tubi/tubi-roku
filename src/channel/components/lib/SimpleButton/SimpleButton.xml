<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SimpleButton
 - A simple, stand alone button that changes width based on the length of the text, and
 - whose color and opacity change based on if it has focus or not.
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="SimpleButton" extends="Group" >
  <script type="text/brightscript" uri="SimpleButton.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>

    <!-- INPUTS -->
      <field id="color" type="string"/>

      <!-- only set a width for fixed width buttons. -->
      <field id="width" type="integer" />

      <field id="height" alias="focus9Patch.height"/>
      <field id="uri" alias="focus9Patch.uri"/>
      <field id="notFilledBackgroundColor" alias="notFilledBackground.color"/>
      <field id="fontSize" alias="labelFont.size"/>
      <field id="isFilled" type="boolean" value="true" />
      <field id="text" type="String" />
      <field id="unfocusedBackgroundOpacity" type="float" value="0.17"/>

    <!-- OUTPUTS -->
      <field id="selected" type="boolean" alwaysNotify="true" />

  </interface>

  <children>
    <Rectangle
      id="notFilledBackground"
      height="80"
      translation="[0,0]"
      visible="false" />
    <Poster
      id="focus9Patch"
      height="80"
      uri="pkg:/images/menu-focus-$$RES$$.9.png"
      translation="[0,0]" />
    <Label
      id="label"
      opacity="1.0"
      height="80"
      horizAlign="center"
      vertAlign="center">
      <Font
        id="labelFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
  </children>
</component>
