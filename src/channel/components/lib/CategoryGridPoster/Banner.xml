<?xml version="1.0" encoding="utf-8" ?>
<component name="Banner" extends="Group" >
  <script type="text/brightscript" uri="Banner.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="focusPercent" type="float" />
    <field id="width" alias="poster.width, disclaimer.width" />
    <field id="height" alias="poster.height" />
    <field id="rowHasFocus" type="boolean" />
    <field id="itemHasFocus" type="boolean" />
  </interface>

  <children>
    <Poster
      id="poster"
      loadingBitmapUri="pkg:/images/placeholder.webp"
      failedBitmapUri="pkg:/images/placeholder.webp" />
    <Group 
      id="textGroup">
      <Label
        id="title"
        width="900"
        wrap="true"
        horizAlign="center">
        <Font
          role="font"/>
      </Label>

      <Label
        id="disclaimer"
        wrap="true"
        horizAlign="center">
        <Font
          role="font"/>
      </Label>
    </Group>
  </children>
</component>
