<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryGridPoster" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/CategoryGridPoster/CategoryGridPoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <field id="itemContent" type="node" />

    <!-- these are ignored but here for compatibility with ContentGrid -->
    <field id="width" alias="Poster.width" />
    <field id="height" alias="Poster.height" />
  </interface>

  <children>
    <Poster
     id="Poster"
     loadingBitmapUri = "pkg:/images/placeholder.jpg">
      <Rectangle
        id="ResumeProgressBar"
        height="6"
        width="0"
        visible="false"/>
    </Poster>
    <Label
      id="Title"
      color="0xFFFFFFFF"
      width="410"
      height="35"
      vertAlign="top"
      translation="[0,256]"
      visible="false">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27" />
    </Label>

  </children>
</component>
