<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryGridPoster" extends="Group" >
  <script type="text/brightscript" uri="CategoryGridPoster.brs" />
  <script type="text/brightscript" uri="../AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="../ContentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="rowListHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="width" alias="Poster.width" />
    <field id="height" alias="Poster.height" />
  </interface>

  <children>

    <LayoutGroup
      id="posterLayout"
      layoutDirection="vert"
      itemSpacings="[6]">
      <Poster
        id="Poster"
        loadingBitmapUri="pkg:/images/placeholder.jpg"
        failedBitmapUri="pkg:/images/placeholder.jpg">
        <LayoutGroup
          id="InnerLayout"
          layoutDirection="vert"
          itemSpacings="[0]">
            <Label
              id="InnerTitle"
              width="342"
              height="27"
              vertAlign="top"
              visible="false">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Bold.ttf"
                size="22" />
            </Label>
            <Label
              id="TimeRemaining"
              width="381"
              height="24"
              vertAlign="top"
              visible="false">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="16" />
            </Label>
            <Group>
              <Rectangle
                id="DurationBar"
                opacity=".2"
                height="6"
                width="0"
                visible="false"/>
              <Rectangle
                id="ResumeProgressBar"
                height="6"
                width="0"
                visible="false"/>
              </Group>
          </LayoutGroup>
      </Poster>
      <Label
        id="Title"
        width="380"
        height="36"
        vertAlign="center"
        visible="false">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="24" />
      </Label>
    </LayoutGroup>
    
    <Group id="badgeGroup"/>
  </children>
</component>
