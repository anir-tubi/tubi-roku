<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ContentController
 -
 - This is the primary controller of the application which will manage
 - CategoryScreen and DetailScreen.
 -
 - Scene Startup Sequence:
 -  1) This component is created and init() is run
 -  2) During ContentController.init(), the MetadataFetchTask is set to "RUN", creating its long-lived thread
 -     that will answer requests for metdata from the primary scene graph thread.
 -  3) The MetadataFetchTask sets a 'ready' field to "true" indicating that it is available
 -  4) This component dynamically creates the CategoryScreen which begins making metadata requests
 -
 -  This startup sequence will ensure that the OS-level thread for MetadataTaskThread is ready
 -  and we don't have race conditions when populating the CategoryScreen.
 -
 -->
<component name="ScreenStack" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/ScreenStack/ScreenStack.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- INPUTS -->
      <!-- add a screen to the top of the stack -->
      <field id="push" type="node" />

      <!-- remove the top-most screen from the stack -->
      <field id="pop" type="boolean" alwaysNotify="true" />

      <!-- keep the top x screens in the stack, removing all other screens from underneath them -->
      <field id="shrinkStack" type="integer" alwaysNotify="true" />

      <!-- remove all screens from the stack -->
      <field id="clearStack" type="boolean" alwaysNotify="true" />

      <!-- give focus to the top most screen in the stack -->
      <field id="focusCurrent" type="boolean" alwaysNotify="true" />

    <!-- OUTPUT -->
      <!-- true when there are no screens in the stack -->
      <field id="isEmpty" type="boolean" alwaysNotify="true" />

      <!-- the top most screen in the stack -->
      <field id="current" type="node" />
  </interface>
        
    <children />

</component>