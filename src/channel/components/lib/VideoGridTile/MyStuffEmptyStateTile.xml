<?xml version="1.0" encoding="utf-8"?>
<component name="MyStuffEmptyStateTile" extends="Group">
  <script type="text/brightscript" uri="MyStuffEmptyStateTile.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="width" alias="border.width" />
    <field id="height" alias="border.height" />
    <field id="itemHasFocus" type="boolean" />
    <field id="rowHasFocus" type="boolean" />
    <field id="rowListHasFocus" type="boolean" />
  </interface>

  <children>
    <Poster
      id="border"
      uri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png" />

    <LayoutGroup
      id="metadataGroup"
      layoutDirection="vert"
      itemSpacings="[15]">
      <Label
        id="title"
        maxLines="2"
        wrap="true"
        width="633" />
      <Label
        id="description"
        width="633"
        wrap="true"
        maxLines="3" />
    </LayoutGroup>

    <LayoutGroup
      id="sellingPointsGroup"
      layoutDirection="vert"
      horizAlignment="center">
      <Label
        id="noSubscriptionLabel"
        horizAlign="center" />
      <Label
        id="noCreditCardLabel"
        horizAlign="center" />
      <Label
        id="freeForeverLabel"
        horizAlign="center" />
    </LayoutGroup>

    <EnhancedButton
      height="105"
      id="signUpButton" />
  </children>
</component>