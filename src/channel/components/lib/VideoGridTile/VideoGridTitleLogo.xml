<?xml version="1.0" encoding="utf-8"?>
<component name="VideoGridTitleLogo" extends="Group">

  <script type="text/brightscript" uri="VideoGridTitleLogo.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />

  <interface>
    <field id="itemContent" type="node" alias="posterOverlay.itemContent" />
    <field id="width" alias="videoInGridGradient.width, posterOverlay.width" />
    <field id="height" alias="videoInGridGradient.height, posterOverlay.height" />
    <field id="itemHasFocus" type="boolean" alias="posterOverlay.itemHasFocus" />
    <field id="showContentPoster" type="boolean" value="true" alias="posterOverlay.showContentPoster" />
    <field id="containerIndex" type="integer" alias="posterOverlay.containerIndex" />
    <field id="billboardContainerIndex" type="integer" alias="posterOverlay.billboardContainerIndex" />
  </interface>

  <children>
    <Group
      id="tileLayout">
      <Poster
        id="videoInGridGradient"
        translation="[0, 1]"
        loadDisplayMode="scaleToFill"
        uri="pkg:/images/video_in_grid_gradient_$$RES$$.9.png" />

      <ExpandedTilePosterOverlay
        id="posterOverlay" />
    </Group>

  </children>
</component>