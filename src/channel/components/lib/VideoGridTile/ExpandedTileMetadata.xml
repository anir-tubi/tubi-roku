<?xml version="1.0" encoding="utf-8"?>
<component name="ExpandedTileMetadata" extends="Group">

  <script type="text/brightscript" uri="ExpandedTileMetadata.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/WidgetMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/SOTBadgeMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/VideoMetadataMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ComingSoonMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigLib.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/StatsigExperimentMixin.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="currentEpisode" type="node" />
    <field id="width" type="float" />
    <field id="hideTitle" type="boolean" value="true" />
    <field id="descriptionWidth" type="float" value="0" />
    <field id="variant" type="string" />
    <field id="layoutChanged" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <LayoutGroup
      id="metadataGroup"
      itemSpacings="[12]"
      horizAlignment="left">
      <LayoutGroup
        layoutDirection="horiz"
        id="sotTopLabelGroup"
        itemSpacings="[9]" />

      <LayoutGroup
        id="firstLineGroup"
        layoutDirection="horiz"
        itemSpacings="[12]"
        vertAlignment="center">
        <Poster
          id="channelLogo"
          width="40"
          height="40" />
        <LayoutGroup
          id="subHeadlinePrefixGroup"
          layoutDirection="horiz" />
        <Rectangle
          id="progressBarGroup"
          width="40"
          height="6"
          color="#00000000">
          <TubiProgressBar
            id="progressBar"
            width="40"
            height="6"
            pointerHeight="6"
            visible="false" />
        </Rectangle>
        <LayoutGroup
          id="subHeadlineSuffixGroup"
          layoutDirection="horiz" />
        <Badge
          id="sotBadge" />
        <Group
          id="Rating">
          <Poster
            id="RatingBackground"
            height="32"
            uri="pkg:/images/rounded-rect-rating_background_video_tile-$$RES$$.9.png"
            loadDisplayMode="scaleToFit"
            loadSync="true" />
          <Label
            id="RatingLabel"
            height="32"
            width="0"
            numLines="1"
            wrap="false"
            horizAlign="center"
            vertAlign="center">
            <Font
              role="font" />
          </Label>
        </Group>
        <Poster
          id="ClosedCaptionPoster"
          visible="false"
          uri="pkg:/images/icon-closed-caption.webp"
          height="36"
          width="36"
          loadDisplayMode="scaleToFit"
          loadSync="true" />
        <ExclusiveContentBadgeGroup
          id="exclusiveContentBadgeGroup"
          visible="false" />
      </LayoutGroup>

      <LayoutGroup
        id="secondLineGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        itemSpacings="[10]">
      </LayoutGroup>

      <Label
        id="description"
        maxLines="3"
        wrap="true">
        <Font
          id="RedesignDescriptionFont"
          role="font" />
      </Label>

    </LayoutGroup>

  </children>
</component>