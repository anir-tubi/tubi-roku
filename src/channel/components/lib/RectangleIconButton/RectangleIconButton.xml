<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - RectangleIconButton
 -
 - A stand alone button that displays an icon to the left of the label and resizes based on the
 - length of the label.
 - 
 -->
<component name="RectangleIconButton" extends="SimpleButton">
  <script type="text/brightscript" uri="RectangleIconButton.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="iconUri" type="string" alias="Icon.uri"/>
  </interface>

  <children>
    <Poster
      id="Icon"
      width="36"
      height="36"
      translation="[30,24]"
      visible="true"/>
  </children>
</component>
