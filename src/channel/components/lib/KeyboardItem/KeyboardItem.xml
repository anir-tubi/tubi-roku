<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - KeyboardItem
 -
 - These are the actual keyboard keys: numbers, letters, symbols, backspace
 -
 -->
<component name="KeyboardItem" extends="Rectangle" >
  <script type="text/brightscript" uri="pkg:/components/lib/KeyboardItem/KeyboardItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- Content expected for a KeyboardItem:
     -
     - title - The label text
     -
     -->
    <field id="content" type="node" />

    <field id="focusPercent" type="float" value="0.0"/>
    <field id="listHasFocus" type="boolean" value="false" />
  </interface>

  <children>
    <Label
     id="Text"
     height="80"
     width="60"
     color="0xFFFFFFFF"
     horizAlign="center"
     vertAlign="center"
     translation="[0,0]">
      <Font
       role="font"
       uri="pkg:/fonts/Vaud-SemiBold.ttf"
       size="37" />
    </Label>
  </children>
</component>
    
