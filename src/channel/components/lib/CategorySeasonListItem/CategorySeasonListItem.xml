<?xml version="1.0" encoding="utf-8" ?>
<!--
 - CategoryListItem
 -
 - Items used in a MarkupGrid (like FilledButtonMarkupGrid) or RowList for showing category names.
 -
 -->
<component name="CategorySeasonListItem" extends="Group" >
  <script type="text/brightscript" uri="CategorySeasonListItem.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="focusPercent" type="float" value="0.0"/>
    <field id="itemContent" type="node" />
    <field id="listHasFocus" type="boolean" value="false" />
    <field id="gridHasFocus" type="boolean" value="false" />
    <field id="rowListHasFocus" type="boolean" value="false" />
    <field id="width" type="float" value="425.0" />
    <field id="height" type="float" value="80.0" />
    <field id="totalCount" alias="categoryCountText.text" />
  </interface>

  <children>
    <Label
      id="categoryText"
      horizAlign="left"
      vertAlign="center"
      width="322"
      height="78"
      translation="[19,1]"
      opacity="1.0">
      <Font
      role="font"
      size="33"
      uri="pkg:/fonts/Vaud-SemiBold.ttf" />
    </Label>
    <Group
      id="categoryCountGroup"
      opacity="0.0"
      visible="false"
      translation="[361,16]">
      <Poster
        id="categoryCountBackground"
        width="48"
        height="48"
        uri="pkg:/images/count-background.png"
        translation="[0,0]"/>
      <Label
        id="categoryCountText"
        horizAlign="center"
        vertAlign="center"
        width="48"
        height="48"
        translation="[0,0]">
        <Font
        role="font"
        size="22"
        uri="pkg:/fonts/Vaud-SemiBold.ttf" />
      </Label>
    </Group>
  </children>
</component>
