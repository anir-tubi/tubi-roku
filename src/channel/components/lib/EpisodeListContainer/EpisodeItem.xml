<?xml version="1.0" encoding="utf-8"?>
<component name="EpisodeItem" extends="Group">

  <script type="text/brightscript" uri="EpisodeItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="itemContent" type="node" />
    <field id="width" type="float" />
  </interface>

  <children>
    <LayoutGroup
      id="mainLayout"
      itemSpacings="[15, 9]">

      <Group>
        <Poster
          id="thumbnail"
          width="520"
          height="292"
          loadDisplayMode="scaleToFill" />
        <Rectangle
          id="progressBarGroup"
          width="488"
          height="6"
          translation="[15, 274]"
          color="#00000000">

          <TubiProgressBar
            id="progressBar"
            width="488"
            height="6"
            pointerHeight="6"
            visible="false" />
        </Rectangle>
      </Group>

      <Label
        id="episodeTitle"
        width="520"
        wrap="true" />

      <LayoutGroup
        id="metadataRow"
        vertAlignment="center"
        layoutDirection="horiz"
        itemSpacings="[12]">
        <Label
          id="duration" />

        <RatingBadge
          id="ratingBadge" />

        <Poster
          id="subtitlesIcon"
          uri="pkg:/images/icon-closed-caption.webp"
          width="36"
          height="36"
          visible="false" />
      </LayoutGroup>

      <Label
        id="description"
        width="520"
        wrap="true" />
    </LayoutGroup>
  </children>

</component>
