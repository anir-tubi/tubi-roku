<?xml version="1.0" encoding="utf-8" ?> 
<component name="ToolsMenu" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/ToolsMenu/ToolsMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- read/write field -->
    <field id="signedIn" type="boolean" value="false" />
    
    <!-- read fields -->
    <field id="itemSelected" alias="Menu.itemSelected" />
    <field id="content" alias="Menu.content" />
    
    <field id="downButtonPressed" type="boolean" alwaysNotify="true" />
    
    <!-- set to true when the user has selected the "Search" button -->
    <field id="searchSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign in" button -->
    <field id="signInSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign Out" button -->
    <field id="signOutSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "About" button -->
    <field id="aboutSelected" type="boolean" alwaysNotify="true"/>
    
    <!-- set to true when the user has selected the "Privacy" button -->
    <field id="privacySelected" type="boolean" alwaysNotify="true"/>
    
    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" 
           type="stringarray" 
           value="[&quot;pkg:/images/art-blur-background.png&quot;]"
           alwaysNotify="true" />

    <!-- observed by HomeScreen for navigating between screens -->
    <field id="trackingUri" type="string"/>
    <field id="trackingCount" type="integer"/>
    
    
  </interface>

  <children>
    <ScrollingList
      id="Menu"
      layoutDirection="horiz"
      width="1760"
      height="500"
      visible="true"
      translation="[85,257]"
      itemSpacings="[10]"
      scrollWidth="1760"
      scrollHeight="500"
      itemComponentName="SignInPoster"/>
    
    <SignInPosterContentNode
      id="SearchSignInContent">
      <SignInPosterContentNode
        id="SearchMenuItem"
        title="Search" 
        description="Find movies and TV shows by title, search for cast members, genres and more."
        focusIconUrl="pkg:/images/icon-search-large.png"
        unfocusIconUrl="pkg:/images/icon-search-large.png"/>
      <SignInPosterContentNode
        id="SignInOutMenuItem"
        title="Sign in"
        description="Sign in to Tubi. Access your Queue and Continue Watching lists across your devices."
        focusIconUrl="pkg:/images/icon-sign-in-large.png"
        unfocusIconUrl="pkg:/images/icon-sign-in-large.png"/>
      <SignInPosterContentNode
        id="AboutMenuItem"
        title="About"
        description="View general information about Tubi including the version number of this app."
        focusIconUrl="pkg:/images/icon-about-large.png"
        unfocusIconUrl="pkg:/images/icon-about-large.png"/>
      <SignInPosterContentNode
        id="PrivacyMenuItem"
        title="Privacy"
        description="Review Tubi's privacy policy."
        focusIconUrl="pkg:/images/icon-privacy-large.png"
        unfocusIconUrl="pkg:/images/icon-privacy-large.png"/>
    </SignInPosterContentNode>
    
    <Label
      id="Description"
      text=""
      color="0xFFFFFFFF"
      width="870"
      height="80"
      wrap="true"
      horizAlign="center"
      translation="[525,709]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="30"/>
    </Label>
    <Group
      id="OnNowHint-Tools"
      visible="false">
      <Poster
        id="DownArrow-Tools"
        uri="pkg:/images/down-arrow.png"
        visible="true"
        width="47"
        height="47"
        translation="[880,913]"
        opacity="0.5"/>
      <Poster
        id="onNowIcon-Tools"
        uri="pkg:/images/icon-on-now.png"
        visible="true"
        width="115"
        height="55"
        translation="[935,908]"
        opacity="0.5"/>
    </Group>
  </children>
</component>
