<?xml version="1.0" encoding="utf-8" ?> 
<component name="ToolsMenu" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/ToolsMenu/ToolsMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="signedIn" type="boolean" value="false" />
    
    <!-- OUTPUTS -->
      <field id="searchSelected" type="boolean" alwaysNotify="true"/>
      <field id="signInSelected" type="boolean" alwaysNotify="true"/>
      <field id="settingsSelected" type="boolean" alwaysNotify="true"/>
      <field id="exitSelected" type="boolean" alwaysNotify="true"/>
      <field id="backButtonPressed" type="boolean" alwaysNotify="true"/>

      <!-- will be used to change the background images on the content controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />

      <!-- observed by HomeScreen for navigating between screens -->
      <field id="trackingUri" type="string" value="home/ott-toolbar"/>
      <field id="trackingCount" type="integer"/>
    
  </interface>

  <children>
    <Poster
      id="tubiLogo"
      height="45"
      width="103"
      opacity="0.5"
      uri="pkg:/images/logo-white-large.png"
      translation="[85,55]" />

    <LayoutGroup
      id="ToolbarHint"
      layoutDirection="horiz"
      vertAlignment="custom"
      opacity="0.5"
      translation="[837,58]">
      <Label
        text="PRESS"
        vertAlign="center"
        height="47"
        translation="[0,2]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
      <Poster
        uri="pkg:/images/back.png"
        width="47"
        height="47"/>
      <Label
        text="FOR HOME"
        vertAlign="center"
        height="47"
        translation="[0,2]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
    </LayoutGroup>


    <LayoutGroup
      horizAlignment="center"
      translation="[960,257]">
      <RowList
        id="Menu"
        visible="true"
        itemComponentName="SignInPoster"
        itemSize="[1760,400]"
        itemSpacing="[0,28]"
        numRows="1"
        rowSpacings="[0]"
        rowItemSize="[[430,400]]"
        rowItemSpacing="[[10,0]]"
        showRowLabel="[false]"
        showRowCounter="[false]"
        focusBitmapUri="pkg:/images/menu-focus-fhd.9.png"
        drawFocusFeedbackOnTop="false" >
        <ContentNode
          id="SearchSignInContent"
          role="content">
          <ContentNode
            id="SearchSignInContentRow">
            <ContentNode
              id="SearchMenuItem"
              title="Search"
              description="Find movies and TV shows by title, search for cast members, genres and more."
              HDGRIDPOSTERURL="pkg:/images/icon-search-large.png"/>
            <ContentNode
              id="SettingsMenuItem"
              title="Settings"
              description="Modify Parental Controls, Customize Closed Captions, View Privacy Policy and Learn About Tubi"
              HDGRIDPOSTERURL="pkg:/images/icon-settings-large.png"/>
            <ContentNode
              id="SignInMenuItem"
              title="Sign In"
              description="Sign in to Tubi. Access your Queue and Continue Watching lists across your devices."
              HDGRIDPOSTERURL="pkg:/images/icon-sign-in-large.png"/>
            <ContentNode
              id="ExitMenuItem"
              title="Exit Tubi"
              description="Exit Tubi"
              HDGRIDPOSTERURL="pkg:/images/icon-exit-large.png"/>
          </ContentNode>
        </ContentNode>
      </RowList>
    </LayoutGroup>
    <Label
      id="Description"
      text=""
      color="0xFFFFFFFF"
      width="870"
      height="80"
      wrap="true"
      horizAlign="center"
      translation="[525,709]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="30"/>
    </Label>
  </children>
</component>
