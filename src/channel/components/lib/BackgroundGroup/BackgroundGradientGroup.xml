<?xml version="1.0" encoding="utf-8" ?>

<!--
 - BackgroundGradientGroup
 -
 -->
<component name="BackgroundGradientGroup" extends="Group">
  <interface>
    <!-- Store the last animation that was triggered in case we need to stop it later-->
    <field id="lastAnimationName" type="string" />
    <field id="uri" alias="BackgroundGradient.uri" />
    <field id="gradientOpacity" alias="BackgroundGradient.opacity" />
    <field id="fadeInControl" alias="GradientFadeIn.control" />
    <field id="fadeOutControl" alias="GradientFadeOut.control" />
  </interface>

  <children>
    <Poster
      id="BackgroundGradient"
      width="1920"
      height="1080"
      translation="[0,0]"
      opacity="0.0"
      visible="true"
      loadSync="true" />
    <Animation
      id="GradientFadeIn"
      duration="0.9"
      easeFunction="inOutCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[0.0,1.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundGradient.opacity" />
    </Animation>
    <Animation
      id="GradientFadeOut"
      duration="0.9"
      easeFunction="inCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[1.0,0.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundGradient.opacity" />
    </Animation>
  </children>
</component>