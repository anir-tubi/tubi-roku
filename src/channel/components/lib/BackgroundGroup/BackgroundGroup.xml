<?xml version="1.0" encoding="utf-8" ?>

<!--
 - Background Group
 -
 - A group that handles any background transitions
 - As well as switching between the different background types - topright (category, episode screens), fullscreen (detail, search screens)
 -
 -->
<component name="BackgroundGroup" extends="Group">
  <script type="text/brightscript" uri="BackgroundGroup.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />

  <interface>
    <!-- INPUT -->
    <!-- backgroundInfo has the keys "type (string)" and "uriList (array)".
         type can be "topright", "fullscreen", "linear"
         uriList is an array of background image uris
         uriList is only meant to be used as of now for Content background images (usually in the top right corner of the screen). Used in Content screen like home, mystuff and details screen.
         For simplicity shouldRotateBackgrounds is set back to true when backgroundInfo is set
    -->
    <field id="backgroundInfo" type="assocarray" />
    <field id="kidsMode" type="boolean" />
    <!-- Controls whether the background will switch between background uris on a timed basis -->
    <field id="shouldRotateBackgrounds" type="bool" value="true" />
    <!--Tell the Background Group to hide or display the poster artwork-->
    <field id="posterVisible" type="boolean" value="true" />

    <field id="circularMaskColor" type="string" />
  </interface>

  <children>
    <Poster
      id="defaultBackground"
      width="1920"
      height="1080"/>

    <Group
      id="topRightContentPosterGroup">
      <BackgroundPosterGroup
        id="poster1"
        posterOpacity="0.0" />
      <BackgroundPosterGroup
        id="poster2"
        posterOpacity="1.0"/>
    </Group>

    <Group
      id="fullScreenPosterGradient"
      opacity="0">
      <Poster
        id="fullScreenPosterLeftGradient"
        width="1920"
        height="1080"/>
      <Poster
        id="fullScreenPosterBottomGradient"
        width="1920"
        height="1080"/>
    </Group>

    <Group
      id="adDisplayGradient"
      opacity="0">
      <Poster
        id="adDisplayLeftGradient"
        width="620"
        height="1080"/>
      <Poster
        id="adDisplayBottomGradient"
        translation="[0, 350]"
        width="1920"
        height="258"/>
    </Group>

    <Poster
      id="fullScreenPosterGradient2"
      opacity="0"
      width="1920"
      height="1080"/>

    <Poster
        id="posterGroupMask"
        width="1122"
        opacity="0"
        translation="[801, 0]"
        height="747"/>
    
    <Group
      id="circularMaskLayer"
      opacity="0">
      <!-- maskLayer10BlendColor2 is a vertical transparency/white gradient that will be colorized by the blend color. This works with maskLayer10 to make a vertical gradient of 2 differnt colors. maskLayer10BlendColor2 represents the bottom color of the gradient. -->
      <Poster
        id="maskLayer10BlendColor2"
        uri="pkg:/images/background-masks/mask-layer-1-0-blendColor2.webp"
        width="822"
        height="1080"/>
      <!-- maskLayer10 is a vertical transparency/white gradient that will be colorized by the blend color. This works with maskLayer10BlendColor2 to make a vertical gradient of 2 differnt colors. maskLayer10 represents the top color of the gradient. -->
      <Poster
        id="maskLayer10"
        uri="pkg:/images/background-masks/mask-layer-1-0-blendColor1.webp"
        width="822"
        height="1080"/>        
      <!-- maskLayer11BlendColor2 is a vertical transparency/white gradient that will be colorized by the blend color. This works with maskLayer11 to make a vertical gradient of 2 differnt colors. maskLayer11BlendColor2 represents the bottom color of the gradient. -->
      <Poster
        id="maskLayer11BlendColor2"
        uri="pkg:/images/background-masks/mask-layer-1-1-blendColor2.webp"
        translation="[822, 0]"
        width="266"
        height="1080"/>
      <!-- maskLayer11 is a vertical transparency/white gradient that will be colorized by the blend color. This works with maskLayer11BlendColor2 to make a vertical gradient of 2 differnt colors. maskLayer11 represents the top color of the gradient. -->
      <Poster
        id="maskLayer11"
        uri="pkg:/images/background-masks/mask-layer-1-1-blendColor1.webp"
        translation="[822, 0]"
        width="266"
        height="1080"/>
      <Poster
        id="maskLayer2"
        uri="pkg:/images/background-masks/mask-layer-2.webp"
        width="1920"
        height="1080"/> 
    </Group>
  </children>
</component>
