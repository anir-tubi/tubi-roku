<?xml version="1.0" encoding="utf-8" ?>

<!--
 - Grid Background
 -
 - Handles animations and layout for backgrounds on the category screen and episode screen
 -
 - Expect the ToprightBackground to have a structure like the following
 -
 - <ToprightBackground>
 -   <Group id="BackgroundImages">
 -     <Group>
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>
 -     </Group>   
 -
 -     <Group>  >>> We only expect to have multiple groups here when transitioning, as one fades in and the other fades out
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>
 -       <GridPoster>
 -         <Poster id="BackgroundPoster" />
 -         <Animation id="TransitionIn"><...Interpolators....></Animation>
 -         <Animation id="FadeInOnly"><...Interpolators....></Animation>
 -         <Animation id="TransitionOut"><...Interpolators....></Animation>
 -       </GridPoster>     
 -     </Group>
 -   </Group>
 -   <Poster id="BackgroundGradient">
 -     <Animation id="GradientFadeIn"><...Interpolators....></Animation>
 -     <Animation id="GradientFadeOut"><...Interpolators....></Animation>
 -   </Poster>
 - </ToprightBackground>
 - 
 -->
<component name="ToprightBackground" extends="Group">
  <interface />

  <children>
    <Group
      id="BackgroundImages" />
    <Poster
      id="BackgroundGradient"
      loadWidth="1920"
      width="1920"
      loadHeight="1080"
      height="1080"
      uri="pkg:/images/home-gradient-25.png"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]"
      opacity="1.0"
      visible="true" />
    <Animation
      id="GradientFadeIn"
      duration="0.9"
      easeFunction="inOutCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[0.0,1.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundGradient.opacity" />
    </Animation>    
    <Animation
      id="GradientFadeOut"
      duration="0.9"
      easeFunction="inCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[1.0,0.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundGradient.opacity" />
    </Animation>
  </children>
</component>