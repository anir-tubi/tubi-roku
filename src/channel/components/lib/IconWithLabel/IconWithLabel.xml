<?xml version="1.0" encoding="utf-8" ?>
<component name="IconWithLabel" extends="Group" >

  <script type="text/brightscript" uri="IconWithLabel.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="width" type="integer" alias="menuItemIcon.width"/>
    <field id="height" type="integer" alias="menuItemIcon.height"/>
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
  </interface>

  <children>
    <LayoutGroup
      horizAlignment="center"
      itemspacings="[27]"
      translation="[36, 0]">

      <Group
        id="IconParent" >
        <Poster
          id="menuItemIcon"
          height="72"
          width="72"/>
          <Poster
          id="menuItemIconFocused"
          opacity="0"
          height="72"
          width="72"/>
      </Group>

      <Label
        id="bottomItemText"
        visible="false" >
        <Font
          role="font"/>
      </Label>
    </LayoutGroup>
  </children>
</component>