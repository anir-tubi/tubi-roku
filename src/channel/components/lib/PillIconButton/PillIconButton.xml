<?xml version="1.0" encoding="utf-8" ?>
<!--
 - PillIconButton
 -
 - A pill shaped button that does not gain focus and displays an Icon to the right of a label with a background whose width will change based on the width of the text
 -
 -->
<component name="PillIconButton" extends="Group">

  <script type="text/brightscript" uri="PillIconButton.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="text" type="string" />

    <!-- indicates the icon to be used for the button. Possible values are:
     -   "left", "right", "up", "down", "checkmark", "about"
     -->
    <field id="icon" type="string" />
  </interface>

  <children>
    <Poster
      id="Background"
      width="127"
      height="60"
      uri="pkg:/images/live_news_button_fhd.9.png"
      blendColor="0x1C1F29ff"
      loadSync="true"
      visible="true" />
    <LayoutGroup
      id="OverlayGroup"
      translation="[12,12]"
      itemSpacings="[12]"
      layoutDirection="horiz">
      <Poster
        id="Icon"
        width="36"
        height="36"
        visible="true"/>
      <Label
        id="Title"
        width="0"
        height="44"
        vertAlign="center"
        color="0xFFFFFFFF">
        <Font
          id="TitleFont"
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="24" />
      </Label>
    </LayoutGroup>
  </children>

</component>
