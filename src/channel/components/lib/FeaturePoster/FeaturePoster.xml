<?xml version="1.0" encoding="utf-8" ?>
<!--
 - FeaturePoster
 -->
<component name="FeaturePoster" extends="Group">

  <script type="text/brightscript" uri="FeaturePoster.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" /> 
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemContent" type="node" />

    <!-- index ignored but here for compatibility -->
    <field id="index" type="integer" />

    <field id="width" alias="Background.width" />
    <field id="height" alias="Background.height" />

    <!-- used so the FeaturePoster load state can be identified at the same level as a regular poster -->
    <field id="loadStatus" type="string"  alias="Background.loadStatus"/>

  </interface>

  <children>
    <Poster
      id="Background"
      loadingBitmapUri="pkg:/images/placeholder-featured.jpg"
      failedBitmapUri="pkg:/images/placeholder-featured.jpg"
      width="430"
      height="242"
      translation="[0,0]" />

    <Label
      id="Title"
      width="410"
      height="35"
      vertAlign="top"
      translation="[0,237]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27" />
    </Label>
  </children>

</component>
