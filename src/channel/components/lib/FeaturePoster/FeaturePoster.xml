<?xml version="1.0" encoding="utf-8" ?>
<!--
 - FeaturePoster
 -
 - Item in a ContentGrid for the 16:9 aspect ratio
 -
 -->
<component name="FeaturePoster" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/FeaturePoster/FeaturePoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <field id="itemContent" type="node" />
    
    <!-- these are ignored but here for compatibility with ContentGrid -->
    <field id="index" type="integer" />
    <field id="width" type="float" />
    <field id="height" type="float" />

    <!-- used so the FeaturePoster load state can be identified at the same level as a regular poster -->
    <field id="loadStatus" type="string"  alias="Background.loadStatus"/>

    <field id="loadDisplayMode" alias="Background.loadDisplayMode" />
  </interface>

  <children>
    <Poster 
      id="Background" 
      loadingBitmapUri="pkg:/images/placeholder-featured.jpg"
      width="430"
      height="256"
      translation="[0,0]" />

    <Label
      id="Title"
      color="0xFFFFFFFF"
      width="410"
      height="35"
      vertAlign="top"
      translation="[0,270]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27" />
    </Label>
  </children>

</component>
