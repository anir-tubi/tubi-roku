Function init()
  topRef = m.top
  topRef.update({
    itemComponentName: "CaretButton"
    focusFootprintBitmapUri: "pkg:/images/transparent.png"
    focusBitmapUri: "pkg:/images/menu-focus-$$RES$$.9.png"
    vertFocusAnimationStyle: "floatingFocus"
    drawFocusFeedbackOnTop: false
  })
End Function
