<?xml version="1.0" encoding="utf-8" ?>
<component name="ConsentPreferenceItem" extends="Group">
  <script type="text/brightscript" uri="ConsentPreferenceItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <interface>
    <!-- INPUTS -->
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="height" type="float" />
  </interface>

  <children>
      <LayoutGroup
        id="contentSection"
        itemSpacings="[9]"
        translation="[30,0]">
        <!-- Removing the vertical translation and using dummy rectangle to provide top and bottom padding since bounding rect array grid calculation is not in sync when translation is used. -->
        <!-- This way we can follow one approach for both top and bottom padding, rather than using translation for top and rectangle for bottom padding. -->
        <Rectangle
          visible="false"
          id="topPadding"
          width="1"
          height="12"/>
        <Group>
          <Label
            id="title">
            <Font
              role="font"/>
          </Label>
          <Label
            opacity="0"
            id="titleFocused">
            <Font
              role="font"/>
          </Label>
        </Group>
        <LayoutGroup
          layoutDirection="horiz">
          <Group>
            <Label
              id="subTitle"
              wrap="true">
              <Font
                role="font"/>
            </Label>
            <Label
              opacity="0"
              id="subTitleFocused"
              wrap="true">
              <Font
                role="font"/>
            </Label>
          </Group>
          <Group>
            <Label
              id="toggleText"
              horizAlign="right">
              <Font
                role="font"/>
            </Label>
            <Label
              opacity="0"
              id="toggleTextFocused"
              horizAlign="right">
              <Font
                role="font"/>
            </Label>
          </Group>
        </LayoutGroup>
        <Rectangle
          visible="false"
          id="bottomPadding"
          width="1"
          height="12"/>
      </LayoutGroup>
  </children>
</component>