<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - Spinner
 -
 - This is a Rectangle with a spinner graphic vertically and horizontally centered
 -
 -->
<component name="Spinner" extends="Group" >
  <script type="text/brightscript" uri="Spinner.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>
    <!-- INPUT -->
      <field id="showBox" alias="SpinnerBox.visible" value="false"/>
      <field id="showShade" alias="Shade.visible" value="false"/>
      <field id="text"  alias="LoadingMessage.text"/>
      <field id="width" alias="Shade.width"/>
      <field id="height" alias="Shade.height"/>

      <!-- if 'modal' is true, keypresses are consumed, otherwise the are ignored -->
      <field id="modal" type="boolean" value="false"/>
      <field id="displayText" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Rectangle
      id="Shade"
      opacity="0.8"
      visible="false"
      color="0x191919FF"/>
    <Rectangle
      id="SpinnerBox"
      height="200"
      width="200"
      translation="[0,0]"
      visible="false"
      color="0x2C2C2CFF"/>

    <Group
      id="PosterOrMessage">
      <Poster
        id="SpinnerPoster"
        visible="true"
        scaleRotateCenter="[33,33]"
        uri="pkg:/images/spinner.png"
        height="66"
        width="66"
        loadWidth="66"
        loadHeight="66"/>
      <Label
        id="LoadingMessage"
        visible="false"
        height="66"
        width="66"
        horizAlign="center">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </Group>
    
    <Animation
      id="SpinnerAnimation"
      duration="2.0"
      repeat="true"
      easeFunction="linear">
      <FloatFieldInterpolator
        id="SpinnerRotationInterpolator"
        key="[1.0, 0.0]"
        keyValue="[0.0, 6.28]"
        fieldToInterp="SpinnerPoster.rotation"/>
    </Animation>
  </children>
</component>
