<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Spinner
 -
 - This is a Rectangle with a spinner graphic vertically and horizontally centered by default
 -
 -->
<component name="Spinner" extends="Group" >
  <script type="text/brightscript" uri="Spinner.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->
      <field id="showBox" alias="SpinnerBox.visible" value="false"/>
      <field id="showShade" alias="Shade.visible" value="true"/>
      <field id="showLoadingMessage" alias="LoadingMessage.visible" value="false"/>
      <field id="text"  alias="LoadingMessage.text"/>
      <field id="width" alias="Shade.width"/>
      <field id="height" alias="Shade.height"/>
      <!-- Allowed values currently are: "right", "left", "center" - assumed to be "center" -->
      <field id="horizAlign" type="String" value="center"/>
      <!-- Allowed values currently are: "top", "bottom", "center" - assumed to be "center" -->
      <field id="vertAlign" type="String" value="center"/>

      <!-- Spinner color -->
      <field id="blendColor" alias="SpinnerPoster.blendColor"/>

      <!-- if 'modal' is true, keypresses are consumed, otherwise they are ignored -->
      <field id="modal" type="boolean" value="false"/>
      <field id="displayText" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Rectangle
      id="Shade"
      opacity="0.8"/>
    <Rectangle
      id="SpinnerBox"
      height="200"
      width="200"
      translation="[0,0]"
      visible="false"/>
    <Group
      id="PosterOrMessage">
      <Poster
        id="SpinnerPoster"
        visible="true"
        scaleRotateCenter="[33,33]"
        uri="pkg:/images/spinner.png"
        height="66"
        width="66"
        loadWidth="66"
        loadHeight="66"/>
      <Label
        id="LoadingMessage"
        visible="false"
        height="30"
        width="66"
        horizAlign="center">
        <Font
          role="font"/>
      </Label>
    </Group>

    <Animation
      id="SpinnerAnimation"
      duration="2.0"
      repeat="true"
      easeFunction="linear">
      <FloatFieldInterpolator
        id="SpinnerRotationInterpolator"
        key="[1.0, 0.0]"
        keyValue="[0.0, 6.28]"
        fieldToInterp="SpinnerPoster.rotation"/>
    </Animation>
  </children>
</component>
