<?xml version="1.0" encoding="utf-8" ?>
<component name="SignInPoster" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/SignInPoster/SignInPoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <field id="content" type="node" />
    
    <!-- hide the progress bar when focus changes -->
    <field id="focusPercent" type="float" value="0.0"/>
    <field id="listHasFocus" type="boolean" value="false" />
  </interface>
  
  <children>
    <Rectangle
      id="Background"
      width="430"
      height="400"
      color="0x00000000"/>
    
    <Poster
      id="FocusedIcon"
      width="234"
      height="234"
      translation="[98,46]"
      opacity="0.0"/>
    
    <Poster
      id="UnfocusedIcon"
      width="234"
      height="234"
      translation="[98,46]"
      opacity="1.0"/>
    
    <Label
      id="ToolText"
      color="0xFFFFFFFF"
      horizAlign="center"
      translation="[0,288]"
      width="430"
      opacity="1.0">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
  </children>

</component>
