<?xml version="1.0" encoding="utf-8" ?>
<component name="ClosedCaptionAndAudioSelectionOverlay" extends="Group">
  <script type="text/brightscript" uri="ClosedCaptionAndAudioSelectionOverlay.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/ArrayUtils.brs" />

  <interface>
    <!-- INPUTS -->

    <!-- Holds the value from video node availableAudioTracks. This field will contain the array of audio tracks.  -->
    <field id="availableAudioTracks" type="array" value="[]"/>

    <!-- Holds the value from video node availableSubtitleTracks. This field will contain the array of closed caption tracks.  -->
    <field id="availableClosedCaptionTracks" type="array" value="[]"/>

    <!--
      - Holds the current subtitle track name that has been previously selected by the user either earlier during this session or during a previous playback session.
      - Please refer setInitialSubtitleTrack inside videoplayerscreen.brs where we are looping through the available subtitle tracks and matching it against the user saved subtitle track preference.
      - This string value will be used to set the check mark on the subtile track item within the overlay.
      - Sample availableSubtitleTracks=[{Description: "English", HasAccessibilityCaption: false, HasAccessibilityDescription: false, HasAccessibilitySign: false, Language: "eng", TrackName: "<dev_d_0>http://s.adrise.tv/0b37a162-bc11-4ed5-ac6b-07304ae72c95.srt"}]
      - currentSubtitleTrack will hold track eg. <dev_d_0>http://s.adrise.tv/0b37a162-bc11-4ed5-ac6b-07304ae72c95.srt
      - This field is used to show the check mark for the selected subtitle track
    -->
    <field id="currentSubtitleTrack" type="string" value="" />

    <!--
      - Holds the current audio track name that has been previously selected by the user either earlier during this session or during a previous playback session.
      - Please refer onAvailableAudioTracksChange inside videoplayerscreen.brs where we are looping through the available audio tracks and matching it against the user saved audio track preference.
      - This string value will be used to set the check mark on the audio track item within the overlay.
      - Sample availableAudioTracks=[{"language": "en", name: "English", "track": "dash/a-aac-main-2"}, {"language": "en", name: "English Audio Description", "track": "dash/a-aac-desc-2"}]
      - currentAudioTrack will hold dash/a-aac-main-2 or dash/a-aac-desc-2
    -->
    <field id="currentAudioTrack" type="string" value="" />

    <!-- Holds the value of the global captions mode. Possible values are "Instant replay", "When mute", "On", "Off"  -->
    <field id="globalCaptionMode" type="string"/>
    <field id="videoId" type="integer" />
    <!-- OUTPUTS -->

    <!-- Will be set when the user selects a closed captioning track. This will be eventually be piped to videonode.  -->
    <field id="subtitleTrack" type="string" value="" />

    <!--
      - Will be set when the user selects a audio track.
      - Sample availableAudioTracks=[{"language": "en", name: "English", "track": "dash/a-aac-main-2"}, {"language": "en", name: "English Audio Description", "track": "dash/a-aac-desc-2"}]
      - currentAudioTrack field will hold dash/a-aac-main-2 or dash/a-aac-desc-2
      - Observer inside videoplayerscreen.brs observing this field will set this value back to videoNode audio track field.
      - Which will result in the audio track being changed.
    -->
    <field id="audioTrack" type="string" value="" />
    <field id="wasBackButtonSelected" type="boolean" value="false" alwaysNotify="true" />
    <field id="globalCaptionChanged" type="string" alwaysNotify="true" />
    <field id="trackingEventInfo" type="assocarray" alwaysNotify="true" />

  </interface>
</component>
