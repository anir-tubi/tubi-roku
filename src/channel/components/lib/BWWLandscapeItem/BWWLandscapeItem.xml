<?xml version="1.0" encoding="utf-8"?>
<component name="BWWLandscapeItem" extends="Group">

  <script type="text/brightscript" uri="BWWLandscapeItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="itemContent" type="node" />
    <field id="focusPercent" type="float" />
    <field id="gridHasFocus" type="boolean" value="false" />
  </interface>

  <children>
    <Group
      id="posterContainer">
      <Poster
        id="thumbnail"
        width="519"
        height="291"
        loadDisplayMode="scaleToFill" />
      <Poster
        id="focusIndicator"
        width="519"
        height="291"
        uri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
        visible="false" />
    </Group>

    <LayoutGroup
      id="metadataSection"
      layoutDirection="vert"
      translation="[0, 303]"
      itemSpacings="[9, 12]">
      <Label
        id="contentTitle"
        width="519"
        wrap="true" />

      <LayoutGroup
        id="metadataRow"
        vertAlignment="center"
        layoutDirection="horiz"
        itemSpacings="[9, 9]">
        <Label
          id="metadata" />

        <Poster
          id="subtitlesIcon"
          uri="pkg:/images/icon-closed-caption.webp"
          width="36"
          height="36"
          visible="false" />

        <Group
          id="rating">
          <Poster
            id="ratingBackground"
            height="30"
            uri="pkg:/images/rating_background_video_tile_$$RES$$.9.png"
            loadDisplayMode="scaleToFit"
            loadSync="true" />
          <Label
            id="ratingLabel"
            height="30"
            width="0"
            numLines="1"
            wrap="false"
            horizAlign="center"
            vertAlign="center" />
        </Group>
      </LayoutGroup>

      <Label
        id="description"
        width="519"
        maxLines="2"
        wrap="true" />
    </LayoutGroup>
  </children>

</component>
