<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - KeyboardMenuItem
 -
 - These are menu items representing the choices of uppercase, lowercase, numbers, and symbols
 -
 -->
<component name="KeyboardMenuItem" extends="Label" >
  <script type="text/brightscript" uri="KeyboardMenuItem.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>
    <!-- hide the progress bar when focus changes -->
    <field id="focusPercent" type="float" value="0.0"/>
    
    <!-- Content expected for a KeyboardMenuItem:
     -
     - title - The label text
     -
     -->
    <field id="itemContent" type="node" />
    <field id="gridHasFocus" type="boolean"/>
  </interface>

  <children>
    <Font
      role="font"
      uri="pkg:/fonts/Vaud-SemiBold.ttf"
      size="43" />
  </children>
</component>
    
