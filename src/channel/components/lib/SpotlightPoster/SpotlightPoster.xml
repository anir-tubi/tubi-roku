<?xml version="1.0" encoding="utf-8" ?>
<component name="SpotlightPoster" extends="Group" >
  <script type="text/brightscript" uri="SpotlightPoster.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="focusPercent" type="float" />
    <field id="width" alias="poster.width" />
    <field id="height" alias="poster.height" />
    <field id="index" type="integer" />
    <field id="rowHasFocus" type="boolean" />
  </interface>

  <children>
      <Poster
        opacity="0.4"
        id="poster"
        loadingBitmapUri="pkg:/images/placeholder.webp"
        failedBitmapUri="pkg:/images/placeholder.webp" />
  </children>
</component>

