<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoPreviewPlayer" extends="Group" >
  <script type="text/brightscript" uri="VideoPreviewPlayer.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="../CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../AnimationMixin.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>

    <!-- INPUT -->
      <!-- Alias fields for the video node -->
      <field id="width" alias="VideoNode.width"/>
      <field id="height" alias="VideoNode.height"/>

      <field id="content" type="node"/>
      <field id="updateContent" type="boolean" alwaysNotify="true"/>

      <!-- pageInfoForAnalytics is the pageInfo of VideoPreview's parent screen -->
      <field id="pageInfoForAnalytics" type="assocarray" value="{}" />

      <!-- supports "play", "stop", "pause" -->
      <field id="control" type="string" value="none" alwaysNotify="true"/>

      <!-- Used to allow seeking the video player while still maintaining proper state tracking. Sets video player seek field to appropriate value and updates necessary state. `seek` field is time/double based and value specified should be in seconds -->
      <field id="seekTo" type="time" />

    <!-- OUTPUT -->

      <!-- Observing state interface helps to show/hide static poster background -->
      <field id="state" type="string" />

      <!-- Unix timestamp of the last time we finished playing back video with this player. If -1 then we are currently playing back. -->
      <field id="timestampOfLastVideoPlayback" type="integer" value="0" />

      <field id="position" alias="VideoNode.position"/>
      <field id="duration" alias="VideoNode.duration"/>
      <field id="bufferingStatus" alias="VideoNode.bufferingStatus" />
      <field id="isBufferingComplete" type="boolean" />
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1120"
      height="630"
      enableUI="false"
      cgms="3"
      enableTrickPlay="false"
      notificationInterval="1.0"
      visible="true" />

  </children>
</component>
