<?xml version="1.0" encoding="utf-8" ?>
<!--
 - PasswordEntryKeyboard
 - This component is used for password entry during sign-in and pin update flow.
 -->
<component name="PasswordEntryKeyboard" extends="Group">
  <script type="text/brightscript" uri="PasswordEntryKeyboard.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <interface>

    <!-- INPUTS -->
      <field id="text" type="string" alias="Keyboard.text" />
      <field id="voiceEnabled" type="boolean"/>
      <!-- Indicates whether default audio guide should be enabled/disabled when the component gains focus -->
      <field id="shouldMuteAudioGuideWhenFocused" type="boolean" value="false" />

    <!-- OUTPUTS -->
      <field id="buttonSelected" type="string" alwaysNotify="true" />
      <field id="audioGuideText" type="string"/>

  </interface>

  <children>

    <LayoutGroup
      layoutDirection="vert"
      horizAlignment="custom"
      vertAlignment="custom"
      translation="[250, -60]"
      itemSpacings="[20]">

      <DynamicKeyboard
        id="Keyboard" />

      <ButtonGroup
        id="buttonGroup"
        layoutDirection="horiz"
        itemSpacings="[39]"
        translation="[2,0]">

        <SimpleButton
          id="back"
          width="177"/>

        <SimpleButton
          id="continue"
          width="627"/>

        <SimpleButton
          id="showHidePassword"
          width="483"/>
      </ButtonGroup>
    </LayoutGroup>

    <Timer
      duration="0.1"
      id="focusDelayTimer" />
  </children>
</component>
