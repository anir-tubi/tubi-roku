<?xml version="1.0" encoding="utf-8" ?>
<!--
 - PasswordEntryKeyboard
 - This component is used for password entry during sign-in and pin update flow.
 -->
<component name="PasswordEntryKeyboard" extends="Group"  >
  <script type="text/brightscript" uri="PasswordEntryKeyboard.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <interface>

    <!-- INPUTS -->
      <field id="text" type="String" alias="Keyboard.text" />
      <field id="voiceEnabled" type="boolean"/>

    <!-- OUTPUTS -->
      <field id="buttonSelected" type="String" alwaysNotify="true" />

  </interface>

  <children>

    <LayoutGroup
      layoutDirection="vert"
      horizAlignment="custom"
      vertAlignment="custom"
      translation="[250, -60]"
      itemSpacings="[20]">

      <DynamicKeyboard
        id="Keyboard" />

      <ButtonGroup
        id="buttonGroup"
        layoutDirection="horiz"
        itemSpacings="[39]"
        translation="[2,0]">

        <SimpleButton
          id="back"
          color="0xF0F1F5"
          width="177"/>

        <SimpleButton
          id="continue"
          color="0xF0F1F5"
          width="627"/>

        <SimpleButton
          id="showHidePassword"
          color="0xF0F1F5"
          width="483"/>

      </ButtonGroup>

    </LayoutGroup>
  </children>
</component>
