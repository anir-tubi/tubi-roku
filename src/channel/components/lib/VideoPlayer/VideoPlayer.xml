<?xml version="1.0" encoding="utf-8" ?> 
<component name="VideoPlayer" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/VideoPlayer/VideoPlayer.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/VideoPlayer/VideoPlaylist.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />

  <interface>
    <!-- Set to true if the back button was pressed while the video player has focus -->
    <field id="backButtonPressed" type="boolean" value="false" alwaysNotify="true" />
    <field id="upButtonPressed" type="boolean" value="false" alwaysNotify="true" />
     
    <!-- Set to true if the skip trailer button was pressed -->
    <field id="skipTrailer" type="boolean" value="false" alwaysNotify="true" />

    <!-- the playlist parent content node -->
    <field id="playlist" type="node" />
    <field id="playlistIndex" type="integer" value="-1"/>
    <field id="seekPlaylist" type="intarray" value="-1" alwaysNotify="true"/>
    <field id="loopPlaylist" type="boolean" value="false"/>
    
    <!-- Alias fields for the video node -->
    <field id="content" alias="VideoNode.content"/>
    <field id="position" alias="VideoNode.position"/>
    <field id="state" type="string" />
    <field id="errorMsg" type="string" />

    <!-- Only support play and stop for simple external interface -->
    <field id="control" type="string" value="none" alwaysNotify="true"/>

    <!-- Video position for updates to history. This is only updated at historyFrequency interval -->
    <field id="historyPosition" type="integer" value="0" />

    <field id="creditsPosition" type="integer" alwaysNotify="true"/>

    <!-- interval in seconds for sending position data to the tracking server -->
    <field id="analyticsInterval" type="integer" value="0"/>

    <!-- WRITE-ONLY field which hides overlay and transport.  This is not a persistent state -->
    <field id="dock" type="boolean" value="false" alwaysNotify="true"/>
    <!-- READ-ONLY field which indicates the current state of the player with respect to being docked -->
    <field id="isDocked" type="boolean" value="false" />
    
    <field id="width" alias="VideoNode.width"/>
    <field id="height" alias="VideoNode.height"/>

    <!-- Enable/disable ads breaks.  This can be changed during playback in order to
      -  postpone midrolls when there is an overlay (e.g. EPG) that the user is
      -  interacting with and we don't want to interrupt
      -->
    <field id="enableAds" type="boolean" value="true"/>

    <!-- State that lets the player know how it is being used, so it can determine
      -  how it should do tracking.
      -  Allowed modes are:
      -  'normal'
      -  'trailer'
      -  'autoplay'
      -  'onnow-autoplay'
      -  'onnow-engaged'
      -  'onnow-docked'
      -->
    <field id="analyticsMode" type="string" value="normal" />

    <!-- The device id of the deeplink source device -->
    <field id="deeplinkSource" type="string" />

    <!--
      -
      - Ad playback interface to main Brightscript thread
      -
      -->

    <!--
      - Written to by the main brightscript thread.
      - Possible values:  init, fetching, noads, adspending, adsplaying, adsclosed
      -->
    <field id="adState" type="string" value=""/>
    <!--
      - Written to by the scene graph thread.
      - Possible values:  preroll, midroll, seek, play, stop
      -->
    <field id="adControl" type="string" value="" alwaysNotify="true"/>
    
    <!-- field for communicating playback position to the ad shim -->
    <field id="adPosition" type="int" />

    <field id="adProgress" type="integer" value="0" />

    <field id="loadingMessage" alias="LoadingMessage.text" />

    <!--
      - List of midrolls as time in seconds.  This will be written to by main brightscript thread.
      -->
    <field id="midrolls" type="intarray" value="[]" />

    <!-- force transport to display or hide -->
    <field id="showTransport" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1920"
      height="1080"
      translation="[0,0]"
      enableUI="false"
      enableTrickPlay="false"
      notificationInterval="0.5"
      visible="true" />

    <Group
      id="Loading"
      visible="false">
      <Rectangle
        id="LoadingBackground"
        color="0x000000FF"
        width="1920"
        height="1080"/>
      <Poster
        width="309"
        height="135"
        uri="pkg:/images/logo-white-xlarge.png"
        loadSync="true"
        translation="[810,382]"/>
      <Label
        id="LoadingMessage"
        height="64"
        width="1920"
        horizAlign="center"
        vertAlign="center"
        translation="[0,606]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="32"/>
      </Label>
      <TubiProgressBar
        id="LoadingProgressBar"
        width="750"
        progress="50"
        trackColor="0xFFFFFF14"
        translation="[584,696]"/>
    </Group>

    <Group
      id="AdHeadsUp"
      visible="false"
      opacity="1.0">
      <Poster
        id="AdHeadsUpGradient"
        width="1920"
        height="317"
        translation="[0,0]"
        uri="pkg:/images/ads-countdown-gradient.9.png"/>
      <Poster
        id="AdHeadsUpCircle"
        loadWidth="66"
        width="66"
        loadHeight="66"
        height="66"
        translation="[85,71]"
        uri="pkg:/images/circle.png"
        opacity="0.4">
      </Poster>
      <Label
        translation="[87,74]"
        width="66"
        height="66"
        horizAlign="center"
        vertAlign="center"
        text="AD">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="27"/>
      </Label>
      <LayoutGroup
        translation="[131,72]"
        layoutDirection="horiz">
        <Label
          height="66"
          vertAlign="center"
          color="0xff501aff"
          text="   break">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
        <Label
          id="AdHeadsUpText"
          height="66"
          vertAlign="center"
          translation="[131,72]"
          text="">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
      </LayoutGroup>
    </Group>

    <Group
      id="VideoOverlay"
      opacity="0.0">
      <Poster
        id="TransportGradient"
        width="1920"
        height="1080"
        translation="[0,0]"
        opacity="0.0"
        uri="pkg:/images/playback-gradient-fhd.9.png"/>
      <Poster
        id="PickerGradient"
        width="1920"
        height="1080"
        translation="[0,0]"
        opacity="0.0"
        uri="pkg:/images/browse-picker-gradient-fhd.9.png"/>
      <Poster
        uri="pkg:/images/back.png"
        width="47"
        height="47"
        translation="[822,58]"/>
      <Label
        text="PRESS BACK TO HIDE"
        translation="[870,61]"
        height="47"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
      <Label
        id="VideoOverlayTitle"
        translation="[84,147]"
        width="1311"
        ellipsizeOnBoundary="true"
        height="73"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="67" />
      </Label>
      <Label
        id="VideoOverlayEpisodeTitle"
        translation="[84,238]"
        width="1311"
        ellipsizeOnBoundary="true"
        height="46"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="36" />
      </Label>
    </Group>
    
    <Group
      id="HUD"
      visible="true"
      opacity="0.0" >
      
      <Group
        id="Picker"
        visible="true"
        opacity="0.0">
        <Poster
          uri="pkg:/images/down-arrow.png"
          width="47"
          height="47"
          translation="[76,521]"/>
        <Label
          text="PRESS DOWN TO HIDE"
          vertAlign="center"
          height="47"
          translation="[125,521]">
          <Font
             id="Vaud22px"
             role="font"
             uri="pkg:/fonts/Vaud-SemiBold.ttf"
             size="22" />
        </Label>
        <VideoPicker
          id="VideoPicker"
          translation="[0,616]"
          visible="true"/>
      </Group>

      <SpritePoster
        id="Thumbnail"
        width="342"
        height="192"
        spriteDirection="horiz"
        translation="[238,633]"/>
      
      <Group
        id="Transport"
        opacity="1.0">
        <Group
         id="LiveTVGroup"
         visible="false">
          <Poster
            id="OnNowBug"
            uri="pkg:/images/icon-on-now.png"
            width="115"
            height="55"
            translation="[85,961]"/>

          <Poster
            uri="pkg:/images/up-arrow.png"
            width="47"
            height="47"
            translation="[76,769]"/>
          <Label
            text="PRESS UP FOR MORE"
            vertAlign="center"
            height="47"
            translation="[125,769]">
            <Font
              id="Vaud22px"
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="22" />
          </Label>
        </Group>
      
      <TubiProgressBar
        id="ProgressBar"
        width="1752"
        trackColor="0xFFFFFF14"
        translation="[85,896]"/>

      <!-- Time -->
      <Label
        id="ElapsedLabel"
        text="00:00:00"
        width="500"
        translation="[74,848]" >
        <Font
          id="Vaud34px"
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="34" />
      </Label>
      <Label
        id="RemainingLabel"
        font="dictionary:Vaud34px"
        text="-00:00:00"
        width="500"
        translation="[1696,848]" />

     <!-- Transport buttons - Transport buttons must be in the order they appear on the screen (from left to right) -->
      <Group
        id="TransportButtons" >
        <TransportButton
          id="SkipTrailerButton"
          width="260"
          height="80"
          uri=""
          loadSync="false"
          translation="[85,949]" >
          <Label
            id="SkipTrailerButtonLabel"
            text="Skip Trailer"
            font="dictionary:Vaud34px"
            width="260"
            height="86"
            horizAlign="center"
            vertAlign="center" />
        </TransportButton>
        <TransportButton
          id="StartButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-to-start.png"
          loadSync="false"
          translation="[540,958]" />
        <TransportButton
          id="RewindButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-rew.png"
          loadSync="false"
          translation="[670,958]" />
        <TransportButton
          id="HopBackButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-rew-30s.png"
          loadSync="false"
          translation="[800,958]" />
        <!-- play/pause uri will update based on playing state of video -->
        <TransportButton
          id="PlayPauseButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-play.png"
          loadSync="false"
          translation="[930,958]" />
        <TransportButton
          id="HopForwardButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-fwd-30s.png"
          loadSync="false"
          translation="[1060,958]" />
        <TransportButton
          id="FastForwardButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-ffw.png"
          loadSync="false"
          translation="[1190,958]" />
        <TransportButton
          id="EndButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-to-end.png"
          loadSync="false"
          translation="[1320,958]" />
        <TransportButton
          id="ClosedCaption"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/cc-icon.png"
          loadSync="false"
          translation="[1697,958]" >
            <Poster
              id="CCRailOff"
              width="80"
              height="60"
              opacity="1.0"
              uri="pkg:/images/transport/sgplayer/cc-rail-off.png"
              loadSync="false"
              translation="[60,0]" />
            <Poster
              id="CCRailOn"
              width="80"
              height="60"
              opacity="0.0"
              uri="pkg:/images/transport/sgplayer/cc-rail-on.png"
              loadSync="false"
              translation="[60,0]" />
            <Poster
              id="CCNipple"
              width="60"
              height="60"
              uri="pkg:/images/transport/sgplayer/cc-nipple.png"
              loadSync="false"
              translation="[58,0]" />
        </TransportButton>
      </Group>

      <Poster
        id="ClosedCaptionDisabled"
        width="140"
        height="60"
        uri="pkg:/images/transport/sgplayer/cc-icon-disabled.png"
        loadSync="false"
        translation="[1697,958]"
        visible="false" />

      </Group>  <!-- Transport -->
    </Group>  <!-- HUD -->
    
    <!-- RAF needs a parent group with no other elements, otherwise it will use
      - the Group dimensions set by the other children and not scale appropriately.
      -->
    <Group
      id="RAFAdContainer"/>

    <AdsTask
      id="AdsTask" />

    <Timer
      id="ScrubTimer"
      duration="0.25"
      repeat="true" />

    <ConvivaTask
      id="ConvivaTask" />
  
  </children>
</component>
