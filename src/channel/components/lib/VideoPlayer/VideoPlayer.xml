<?xml version="1.0" encoding="utf-8" ?> 
<component name="VideoPlayer" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/VideoPlayer/VideoPlayer.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/VideoPlayer/VideoPlaylist.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/NodeHelpers.brs" />

  <interface>
    <!-- Set to true if the back button was pressed while the video player has focus -->
    <field id="backButtonPressed" type="boolean" value="false" alwaysNotify="true" />
    <field id="upButtonPressed" type="boolean" value="false" alwaysNotify="true" />
     
    <!-- Set to true if the skip trailer button was pressed -->
    <field id="skipTrailer" type="boolean" value="false" alwaysNotify="true" />

    <!-- the playlist parent content node -->
    <field id="playlist" type="node" />
    <field id="playlistIndex" type="integer" value="-1"/>
    <field id="seekPlaylist" type="intarray" value="-1" alwaysNotify="true"/>
    <field id="loopPlaylist" type="boolean" value="false"/>
    
    <!-- Alias fields for the video node -->
    <field id="content" alias="VideoNode.content"/>
    <field id="state" type="string" />
    <field id="position" alias="VideoNode.position"/>

    <!-- Only support play and stop for simple external interface -->
    <field id="control" type="string" value="none" alwaysNotify="true"/>

    <!-- Video position for updates to history. This is only updated at historyFrequency interval -->
    <field id="historyPosition" type="integer" value="0" />

    <!-- interval in seconds for sending position data to the tracking server -->
    <field id="analyticsInterval" type="integer" value="0"/>

    <!-- WRITE-ONLY field which hides overlay and transport.  This is not a persistent state -->
    <field id="dock" type="boolean" value="false" alwaysNotify="true"/>
    <!-- READ-ONLY field which indicates the current state of the player with respect to being docked -->
    <field id="isDocked" type="boolean" value="false" />
    
    <field id="width" alias="VideoNode.width"/>
    <field id="height" alias="VideoNode.height"/>

    <!-- Enable/disable ads breaks.  This can be changed during playback in order to
      -  postpone midrolls when there is an overlay (e.g. EPG) that the user is
      -  interacting with and we don't want to interrupt
      -->
    <field id="enableAds" type="boolean" value="true"/>

    <!-- State that lets the player know how it is being used, so it can determine
      -  how it should do tracking.
      -  Allowed modes are:
      -  'normal'
      -  'trailer'
      -  'onnow-autoplay'
      -  'onnow-engaged'
      -  'onnow-docked'
      -->
    <field id="analyticsMode" type="string" value="true" />

    <!--
      -
      - Ad playback interface to main Brightscript thread
      -
      -->

    <!--
      - Written to by the main brightscript thread.
      - Possible values:  init, fetching, noads, adspending, adsplaying, adsclosed
      -->
    <field id="adState" type="string" value=""/>
    <!--
      - Written to by the scene graph thread.
      - Possible values:  preroll, midroll, seek, play, stop
      -->
    <field id="adControl" type="string" value="" alwaysNotify="true"/>
    
    <!-- field for communicating playback position to the ad shim -->
    <field id="adPosition" type="int" />

    <!--
      - List of midrolls as time in seconds.  This will be written to by main brightscript thread.
      -->
    <field id="midrolls" type="intarray" value="[]" />

    <!-- force transport to display or hide -->
    <field id="showTransport" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1920"
      height="1080"
      translation="[0,0]"
      enableUI="false"
      enableTrickPlay="false"
      notificationInterval="1"
      visible="true" />

    <Group
      id="Loading"
      visible="false">
      <Poster
        id="BackgroundGradient"
        uri="pkg:/images/art-blur-background.png"
        width="1920"
        height="1080"
        loadSync="true"/>
      <LayoutGroup
        layoutDirection="horiz"
        translation="[88,69]">
        <Label
          height="64"
          vertAlign="center"
          color="0xff501aff"
          text="Loading">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
        <Label
          height="64"
          vertAlign="center"
          text=" &#xB7; Your title will begin shortly">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
      </LayoutGroup>
      <Spinner
        id="BufferSpinner"
        visible="false"
        width="1920"
        height="1080"/>
    </Group>

    <Group
      id="AdHeadsUp"
      visible="false"
      opacity="1.0">
      <Poster
        id="AdHeadsUpGradient"
        loadWidth="1920"
        width="1920"
        loadHidth="317"
        height="317"
        translation="[0,0]"
        uri="pkg:/images/ads-countdown-gradient.png"/>
      <Poster
        id="AdHeadsUpCircle"
        loadWidth="66"
        width="66"
        loadHeight="66"
        height="66"
        translation="[85,71]"
        uri="pkg:/images/circle.png"
        opacity="0.4">
      </Poster>
      <Label
        translation="[87,74]"
        width="66"
        height="66"
        horizAlign="center"
        vertAlign="center"
        text="AD">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="27"/>
      </Label>
      <LayoutGroup
        translation="[131,72]"
        layoutDirection="horiz">
        <Label
          height="66"
          vertAlign="center"
          color="0xff501aff"
          text="   break">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
        <Label
          id="AdHeadsUpText"
          height="66"
          vertAlign="center"
          translation="[131,72]"
          text="">
          <Font
            id="Vaud34px"
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="34"/>
        </Label>
      </LayoutGroup>
    </Group>

    <Group
      id="VideoOverlay"
      opacity="0.0">
      <Poster
        id="TransportGradient"
        width="1920"
        height="1080"
        translation="[0,0]"
        opacity="0.0"
        uri="pkg:/images/playback-gradient.png"/>
      <Poster
        id="PickerGradient"
        width="1920"
        height="1080"
        translation="[0,0]"
        opacity="0.0"
        uri="pkg:/images/browse-picker-gradient.png"/>
      <Poster
        uri="pkg:/images/back.png"
        width="47"
        height="47"
        translation="[822,58]"/>
      <Label
        text="PRESS BACK TO EXIT"
        translation="[870,61]"
        height="47"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
    </Group>
    
    <Group
      id="HUD"
      visible="true"
      opacity="0.0" >
      
      <Group
        id="Picker"
        visible="true"
        opacity="0.0">
        <Poster
          uri="pkg:/images/down-arrow.png"
          width="47"
          height="47"
          translation="[76,521]"/>
        <Label
          text="PRESS DOWN TO HIDE"
          vertAlign="center"
          height="47"
          translation="[125,521]">
          <Font
             id="Vaud22px"
             role="font"
             uri="pkg:/fonts/Vaud-SemiBold.ttf"
             size="22" />
        </Label>
        <VideoPicker
          id="VideoPicker"
          translation="[0,616]"
          visible="true"/>
      </Group>

      
      <Group
        id="Transport"
        opacity="1.0">
        <Group
         id="LiveTVGroup"
         visible="false">
          <Poster
            id="OnNowBug"
            uri="pkg:/images/icon-on-now.png"
            width="115"
            height="55"
            translation="[85,961]"/>

          <Poster
            uri="pkg:/images/up-arrow.png"
            width="47"
            height="47"
            translation="[76,769]"/>
          <Label
            text="PRESS UP FOR MORE"
            vertAlign="center"
            height="47"
            translation="[125,769]">
            <Font
              id="Vaud22px"
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="22" />
          </Label>
        </Group>
      
      <!--
        - ProgressBarBackground and ProgressBarForeground use 9-patch images which have
        - special undocumented handling (bugs?).  For manifest with ui_resolution=fhd, we
        - need to provide 2 resolutions: fhd and hd, where hd 0.75 the intended resolution.  For instance,
        - we expect the FHD hight to be 16 pixels so the hd source image height has to be 12 pixels.  Roku
        - wrongly applies a 1.5x scaling when ui_resolution=fhd and the screen is 720p.  SD resolutions are
        - not needed since 720p ui resolution is used and scaled down properly.
        -
        - $$RES$$ will be substituted by firmware for sd,hd,fhd as appropriate.  See r2d2_bitmaps to confirm
        - which file got loaded into vram.
        -
        - NOTE2: 9-patch images can't have width/height set below their native resolution (bitmapWidth/bitmapHeight)
        -        else the 9-patch logic does not get applied and you will just see stretched images.  Because of
        -        scaling wackiness, bitmapWidth or bitmapHeight may report half-pixel values.  It's best to not
        -        set a height explicitly.
        -->
      <Poster
        id="ProgressBarBackground"
        uri="pkg:/images/transport/sgplayer/$$RES$$/progress-background.9.png"
        width="1752"
        translation="[85,896]"/>
      <!-- ProgressBarForeground width will be set based on current position -->
      <Poster
        id="ProgressBarForeground"
        uri="pkg:/images/transport/sgplayer/$$RES$$/progress-foreground.9.png"
        translation="[85,896]"/>

      <!-- Time -->
      <Label
        id="ElapsedLabel"
        text="00:00:00"
        width="500"
        translation="[74,848]" >
        <Font
          id="Vaud34px"
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="34" />
      </Label>
      <Label
        id="RemainingLabel"
        font="dictionary:Vaud34px"
        text="-00:00:00"
        width="500"
        translation="[1696,848]" />

     <!-- Transport buttons - Transport buttons must be in the order they appear on the screen (from left to right) -->
      <Group
        id="TransportButtons" >
        <TransportButton
          id="SkipTrailerButton"
          width="260"
          height="80"
          uri=""
          unfocusedUri=""
          focusedUri=""
          loadSync="true"
          translation="[85,949]" >
          <Label
            id="SkipTrailerButtonLabel"
            text="Skip Trailer"
            font="dictionary:Vaud34px"
            width="260"
            height="86"
            horizAlign="center"
            vertAlign="center" />
        </TransportButton>
        <TransportButton
          id="StartButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-to-start.png"
          loadSync="true"
          translation="[540,958]" />
        <TransportButton
          id="RewindButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-rew.png"
          loadSync="true"
          translation="[670,958]" />
        <TransportButton
          id="HopBackButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-rew-30s.png"
          loadSync="true"
          translation="[800,958]" />
        <!-- play/pause uri will update based on playing state of video -->
        <TransportButton
          id="PlayPauseButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-play.png"
          loadSync="true"
          translation="[930,958]" />
        <TransportButton
          id="HopForwardButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-fwd-30s.png"
          loadSync="true"
          translation="[1060,958]" />
        <TransportButton
          id="FastForwardButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-ffw.png"
          loadSync="true"
          translation="[1190,958]" />
        <TransportButton
          id="EndButton"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/icon-to-end.png"
          loadSync="true"
          translation="[1320,958]" />
        <TransportButton
          id="ClosedCaption"
          width="60"
          height="60"
          uri="pkg:/images/transport/sgplayer/cc-icon.png"
          loadSync="true"
          translation="[1697,958]" >
            <Poster
              id="CCRailOff"
              width="80"
              height="60"
              opacity="1.0"
              uri="pkg:/images/transport/sgplayer/cc-rail-off.png"
              loadSync="true"
              translation="[60,0]" />
            <Poster
              id="CCRailOn"
              width="80"
              height="60"
              opacity="0.0"
              uri="pkg:/images/transport/sgplayer/cc-rail-on.png"
              loadSync="true"
              translation="[60,0]" />
            <Poster
              id="CCNipple"
              width="60"
              height="60"
              uri="pkg:/images/transport/sgplayer/cc-nipple.png"
              loadSync="true"
              translation="[58,0]" />
        </TransportButton>
      </Group>

      <Poster
        id="ClosedCaptionDisabled"
        width="140"
        height="60"
        uri="pkg:/images/transport/sgplayer/cc-icon-disabled.png"
        loadSync="true"
        translation="[1697,958]"
        visible="false" />

      </Group>  <!-- Transport -->
    </Group>  <!-- HUD -->
    
  <Timer
    id="ScrubTimer"
    duration="0.25"
    repeat="true" />

  <AuthTask
    id="VideoPlayerAuthTask" />
  
  </children>
</component>
