<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInButton
 -
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="SignInButton" extends="Group" >
  <script type="text/brightscript" uri="SignInButton.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>
    <!-- Content expected for a KeyboardMenuItem:
     -
     - title - The label text
     -
     -->
    <field id="itemContent" type="node" />
    <field id="content" type="node" />
    <field id="width" alias="Text.width" />
    <field id="height" alias="Text.height" />
  </interface>

  <children>
    <Label
      id="Text"
      text=""
      width="480"
      height="80"
      horizAlign="center"
      vertAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
  </children>
</component>
