<?xml version="1.0" encoding="utf-8"?>

<component name="RatingBadge" extends="Group">
  <script type="text/brightscript" uri="RatingBadge.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />

  <interface>
    <field id="rating" type="string" />
    <field id="badgeHeight" type="float" value="30" alias="ratingBackground.height, ratingLabel.height" />
    <field id="backgroundUri" type="string" value="pkg:/images/rating_background_video_tile_$$RES$$.9.png" alias="ratingBackground.uri" />
    <field id="backgroundBlendColor" type="string" alias="ratingBackground.blendColor" />
  </interface>

  <children>
    <Poster
      id="ratingBackground"
      loadDisplayMode="scaleToFit"
      loadSync="true" />
    <Label
      id="ratingLabel"
      width="0"
      numLines="1"
      wrap="false"
      horizAlign="center"
      vertAlign="center" />
  </children>
</component>
