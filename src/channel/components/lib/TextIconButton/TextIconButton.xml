<?xml version="1.0" encoding="utf-8" ?>
<component name="TextIconButton" extends="Group" >
  <script type="text/brightscript" uri="TextIconButton.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>

    <!-- INPUTS -->
      <field id="enabled" type="boolean" value="true"/>
      <!-- boolean indicates if the button is focused or not -->
      <field id="focusState" type="boolean" value="false"/>
      
      <field id="uri" type="String"/>
      <field id="text" type="String" />

      <field id="alwaysShowLabel" type="boolean"/>

      <field id="hasUnfocusedBackground" type="boolean"/>
      <field id="iconWidth" alias="ButtonIcon.width" />
      <field id="iconHeight" alias="ButtonIcon.height" />

    <!-- OUTPUTS -->
      <field id="selected" type="boolean" alwaysNotify="true" />

  </interface>

  <children>

    <Poster
      id="ButtonBG"
      height="72"
      uri="pkg:/images/pill_top_nav_$$RES$$.9.png"
      translation="[0,0]" />

    <LayoutGroup
      id="IconAndLabelGroup"
      layoutDirection="horiz"
      vertAlignment="center"
      horizAlignment="left"
      itemSpacings="[12]"
      translation="[18,36]">
      <Poster
        id="ButtonIcon"
        height="36"
        width="36"
        translation="[0,18]"/>
      <Label
        id="ButtonText"
        height="72"
        width="0"
        scale="[0,0]"
        vertAlign="center">
        <Font
          role="font"/>
      </Label>
    </LayoutGroup>

  </children>
</component>