<?xml version="1.0" encoding="utf-8" ?>
<!-- This is pill shared buttons on season menu on ymal part of the series detail page.-->
<component name="DetailHorizSeasonItem" extends="Group" >

  <script type="text/brightscript" uri="DetailHorizSeasonItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="focusPercent" type="float" />
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />

    <!-- OUTPUTS -->
    <!-- The width of the MenuText as calculated by boundingRect().width -->
    <field id="calculatedTextWidth" type="integer"/>

  </interface>

  <children>
    <Label
      id="MenuTextFocused"
      translation="[36,15]">
      <Font
        role="font"/>
    </Label>

    <Label
      id="MenuTextUnfocused"
      opacity="0.0"
      translation="[36,15]">
      <Font
        role="font"/>
    </Label>
  </children>
</component>