<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name="DetailMenuItemContentNode" extends="ContentNode">
  <interface>
    <!-- INPUTS -->
    <field id="iconUrl" type="string" value=""/>
    <field id="badgeText" type="string" value=""/>
    <field id="contentItemType" type="string" value=""/>
    <!-- Should the unfocused background be displayed? -->
    <field id="isUnfocusedFootprintEnabled" type="boolean" value="false"/>

    <!-- alignment of the item in the list. Accepted values are left and center -->
    <field id="align" type="string" value="left" />

    <!-- The button_value of the menu item that should be sent to analytics as part of a ButtonComponent -->
    <field id="analyticsButtonValue" type="string" value="" />

    <!--Primary buttons will always have icon and text on screen.
        For other non primary buttons, we only show icons and text will be displayed when users hover on it.-->
    <field id="isPrimaryButton" type="boolean" />
  </interface>
</component>