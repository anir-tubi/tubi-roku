<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "DetailMenuItemContentNode" extends="ContentNode">
  <interface>
    <!-- INPUTS -->
    <field id="iconUrl" type="string" value=""/>
    <field id="badgeText" type="string" value=""/>
    <!-- Should the unfocused background be displayed? -->
    <field id="isUnfocusedFootprintEnabled" type="boolean" value="false"/>

    <!-- alignment of the item in the list. Accepted values are left and center -->
    <field id="align" type="string" value="left" />
    <!-- The ID of the menu item that should be sent to the analytics -->
    <field id="analyticsId" type="string" value="" />
  </interface>
</component>