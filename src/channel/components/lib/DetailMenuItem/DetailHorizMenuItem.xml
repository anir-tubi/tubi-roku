<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailHorizMenuItem" extends="Group" >

  <script type="text/brightscript" uri="DetailHorizMenuItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="width" type="float" alias="menuItemBg.width,menuItemBgFocused.width" />
    <field id="height" type="float" alias="menuItemBg.height,menuItemBgFocused.height" />
    <field id="focusPercent" type="float" />
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />

    <!-- OUTPUTS -->
    <!-- The width of the DetailsMenuText as calculated by boundingRect().width -->
    <field id="calculatedTextWidth" type="integer"/>
  </interface>

  <children>
    <Poster
      id="menuItemBg"
      uri="pkg:/images/pill_button_$$RES$$.9.png"
      visible="false"
      loadSync="true"
      translation="[0,0]"/>
    <Poster
      id="menuItemBgFocused"
      loadSync="true"
      opacity="0"
      translation="[0,0]"/>

    <LayoutGroup
      horizAlignment="center"
      itemspacings="[48]"
      translation="[52,34]">

      <Group>
        <Poster
          id="menuItemIcon"
          height="36"
          width="36"
          loadSync="true" />

        <Poster
          opacity="0"
          id="menuItemIconFocused"
          height="36"
          width="36"
          loadSync="true" />
      </Group>

      <Label
        opacity="0"
        id="bottomItemText">
        <Font
          role="font"/>
      </Label>
    </LayoutGroup>

    <Label
      translation="[81, 32]"
      id="menuItemText">
      <Font
        role="font"/>
    </Label>

    <Label
      translation="[81, 32]"
      opacity="0"
      id="menuItemTextFocused">
      <Font
        role="font"/>
    </Label>

    <Group
      id="badge"
      opacity="0">
      <Poster
        id="badgeBackground"
        uri="pkg:/images/badge_$$RES$$.9.png"
        height="40"/>
      <Label
        vertAlign="center"
        height="40"
        id="badgeText">
        <Font
          role="font"/>
      </Label>
    </Group>

    <Group
      id="badgeFocused"
      opacity="0">
      <Poster
        id="badgeBackgroundFocused"
        uri="pkg:/images/badge_$$RES$$.9.png"
        height="40"/>
      <Label
        vertAlign="center"
        height="40"
        id="badgeTextFocused">
        <Font
          role="font"/>
      </Label>
    </Group>
  </children>
</component>
