<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailHorizMenuItem" extends="Group" >

  <script type="text/brightscript" uri="DetailHorizMenuItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="focusPercent" type="float" />
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />

    <!-- OUTPUTS -->
    <!-- The width of the DetailsMenuText as calculated by boundingRect().width -->
    <field id="calculatedTextWidth" type="integer"/>
  </interface>

  <children>
    <LayoutGroup
      horizAlignment="center"
      itemspacings="[48]"
      translation="[52,34]">

      <Poster
        id="MenuItemIcon"
        height="36"
        width="36"/>

      <Label
        opacity="0"
        id="bottomItemText">
        <Font
          role="font"/>
      </Label>
    </LayoutGroup>

    <Label
        translation="[81, 32]"
        id="MenuItemText">
      <Font
        role="font"/>
    </Label>
  </children>
</component>