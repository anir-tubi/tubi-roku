<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailMenuItem" extends="Rectangle" >
  <script type="text/brightscript" uri="DetailMenuItem.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->

    <!-- hide the progress bar when focus changes -->
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />

    <!-- Content expected for a DetailMenuItem:
     -
     - title - The label text
     - iconUrl - The icon uri
     - playstart/length - both of these need to be present and the
     -                    progress bar will be displayed
     -
     -->
    <field id="itemContent" type="node" />


    <!-- OUTPUTS -->
    <!-- The width of the DetailsMenuText as calculated by boundingRect().width -->
    <field id="calculatedTextWidth" type="integer"/>
    <!-- The width of the calculatedTextWidth plus the horizontal placement of the text -->
    <field id="calculatedWidth" type="integer"/>

    <!-- The padding from the left side of the item to the text. This is a fixed number as found in
         the x component of the DetailsMenuText translation -->
    <field id="leftTextPadding" type="integer"/>

    <!-- The minimum padding from the right side of the item to the text -->
    <field id="rightTextPadding" type="integer" value="20"/>

  </interface>

  <children>
    <Poster
      id="buttonBG"
      width="0"
      height="0"
      uri="pkg:/images/menu-focus-$$RES$$.9.png"
      visible="false"
      translation="[0,0]"/>

    <Group
      id="IconParent"
      translation="[24,19]">
      <Poster
        id="Icon"
        width="36"
        height="36"
        loadSync="true"/>
      <Poster
        id="IconFocused"
        width="36"
        height="36"
        loadSync="true"/>
     </Group>

    <Group
      translation="[72,0]"
      id="DetailsMenuTextParent">
      <Label
        id="DetailsMenuText"
        vertAlign="center"
        horizAlign="left"
        height="80"
        opacity="1.0">
        <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
      </Label>
      <Label
        id="DetailsMenuTextFocused"
        vertAlign="center"
        horizAlign="left"
        height="80"
        opacity="1.0">
        <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
      </Label>
    </Group>

    <Rectangle
      id="ResumeProgressBar"
      height="6"
      width="0"
      translation="[4,68]"
      visible="false" />
    <TextIcon
      id="badgeLabel"
      uri="pkg:/images/tag-rounded-rectangle-background-pull-$$RES$$.9.png"
      visible="false" />
  </children>
</component>
