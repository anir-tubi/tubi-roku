<?xml version="1.0" encoding="utf-8" ?>
<!-- 
  CountdownTimerUI
  The CountdownTimer is the UI representation of the countdown timer. It will display how many seconds are left.
  ::TODO:: EPG - when the EPG experiment gets graduated, consider placing the code/logic of the m.LinearCountdownTimer within this component so the ControlController has less code.
      Also consider moving the CountdownTimer component from the ContentController XMPL to the Linear Video Player Screen.
      During the experiment, the logic remains in the ContentController because the non-experiment has countdown logic at the ContentController level.
      We should share the countdown timer code where it currently resides until the experiment is over. Rename to CountdownTimer when a timer is placed in this component
 -->
<component name="CountdownTimerUI" extends="Group" >
  <script type="text/brightscript" uri="CountdownTimerUI.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />  
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>
    <!--INPUT-->
      <!-- The number of seconds to display in the countdown timer. -->
      <field id="seconds" type="integer"/>

      <!-- A way to tell the component to hide or display -->
      <field id="display" type="boolean" value="false"/>

    <!--OUTPUT-->
      <!-- The width of the UI element. Essentially the width of the background. -->
      <field id="width" type="float"/>

  </interface>
  <children> 
    <Group
      id="CountdownTimerParent"
      opacity="0">
      <Poster
        id="PlayerCountdownBground"
        width="210"
        height="41"
        opacity=".26"/>
      <LayoutGroup
        id="TextAndIconLayoutGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        translation="[20,23]"
        itemSpacings="[8]">
          <Poster
            id="FullscreenIcon"
            uri="pkg:/images/icon-fullscreen.png"
            width="20"
            height="22"
            loadDisplayMode="scaleToFit"
            loadSync="true"/>
          <Label
            id="CountdownText"
            width="0"
            color="0xFFFFFFFF">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="22" />
          </Label>
        </LayoutGroup>
      </Group>
  </children>
</component>
