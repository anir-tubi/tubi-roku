<?xml version="1.0" encoding="utf-8" ?>
<component name="CountdownTimer" extends="Group" >
  <script type="text/brightscript" uri="CountdownTimer.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!--INPUT-->
      <!-- The number of seconds to display in the countdown timer. -->
      <field id="seconds" type="integer" value="-1"/>

      <!-- The ID of the translation string within the translation JSON to be used to display the seconds. The translation needs to accept the parameter 'seconds'. -->
      <field id="secondsTranslationId" type="string" value=""/>

      <!-- If the size of the label should be different than this component's default, then set the typography ID. -->
      <field id="typographyLabelId" type="string"/>

      <!-- The background color of the countdown if something other than the default is desired -->
      <field id="bgcolor" type="string" alias="PlayerCountdownBground.blendColor"/>

      <!-- A way to tell the component to hide or display -->
      <field id="display" type="boolean" value="false"/>

      <!-- A way to tell the component to hide or display the fullscreen icon -->
      <field id="displayIcon" type="boolean" value="true"/>

    <!--OUTPUT-->
      <!-- The width of the UI element. Essentially the width of the background. -->
      <field id="width" type="float"/>

  </interface>
  <children>
    <Group
      id="CountdownTimerParent"
      opacity="0">
      <Poster
        id="PlayerCountdownBground"
        width="210"
        height="41"
        uri="pkg:/images/tab_short_component_alt_$$RES$$.9.png"/>
      <LayoutGroup
        id="TextAndIconLayoutGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        translation="[20,23]"
        itemSpacings="[8]">
          <Poster
            id="FullscreenIcon"
            uri="pkg:/images/icon-fullScreen.png"
            width="20"
            height="22"
            loadDisplayMode="scaleToFit"
            loadSync="true"/>
          <Label
            id="CountdownText"
            width="0">
            <Font
              role="font"/>
          </Label>
        </LayoutGroup>
      </Group>
  </children>
</component>
