<?xml version="1.0" encoding="utf-8" ?>
<!--
 - IconTitleSubtitleGroup
 -
 - Component that can be readily used to show
 - icon - header - subHeader format as in Registration Modal.
 -
 -->
<component name="IconTitleSubtitleGroup" extends="Group">

  <script type="text/brightscript" uri="IconTitleSubtitleGroup.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="header" alias="title.text" />
    <field id="headerColor" alias="title.color" />
    <field id="subHeader" alias="subHeader.text" />
    <field id="subHeaderColor" alias="subHeader.color" />
    <field id="sideIcon" alias="sideIcon.uri" />
  </interface>

  <children>
    <LayoutGroup
      id="iconTitleSubtitleGroup"
      layoutDirection="horiz"
      vertAlignment="center"
      translation="[0,0]"
      itemSpacings="[24]">

      <LayoutGroup
        layoutDirection="horiz"
        vertAlignment="center"
        itemSpacings="[-60]">
        <Poster
          id="sideIconBg"
          height="81"
          width="81"
          uri="pkg:/images/icon-circle-bg.webp"/>

        <Poster
          id="sideIcon"
          height="39"
          width="39"/>
      </LayoutGroup>

      <LayoutGroup
        id="titleSubtitleGroup"
        layoutDirection="vert"
        vertAlignment="center">

        <Label
          id="title"
          horizAlign="left"
          width="702">
          <Font
            role="font"/>
        </Label>

        <Label
          id="subHeader"
          horizAlign="left"
          width="702">
          <Font
            role="font"/>
        </Label>

      </LayoutGroup>

    </LayoutGroup>

  </children>
</component>