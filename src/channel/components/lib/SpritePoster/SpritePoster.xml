<?xml version="1.0" encoding="utf-8" ?>
<component name="SpritePoster" extends="Group">
  <script type="text/brightscript" uri="SpritePoster.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="spriteUrls" type="stringarray"/>
      <!-- number of sprites per sprite page -->
      <field id="numSprites" type="integer"/>
      <!-- The width of the thumbnails image as returned by the API -->
      <field id="thumbnailWidth" type="float" value="0.0"/>
      <!-- The height of the thumbnails image as returned by the API -->
      <field id="thumbnailHeight" type="float" value="0.0"/>

      <field id="rows" type="integer" value="1"/>
      <field id="columns" type="integer" value="-1" />

      <!-- Sprite dimensions to be applied to incoming file -->
      <field id="width" type="float" />
      <field id="height" type="float" />

      <!-- Sprite sheet direction: "horiz" or "vert" -->
      <field id="spriteDirection" type="string"/>

      <!-- Jump to the specified zero-index sprite -->
      <field id="jumpToSprite" type="integer" value="0"/>

      <field id="showBorder" type="boolean" value="false"/>
  </interface>
  <children>
    <Poster
      id="Poster"/>
    <!-- Based on testing, this will preload the image even if visible=false. This
         reduces the possibility of a thumbnail blank while the sprite sheet is
         loading -->
    <Poster
      id="Preload"
      visible="false"/>
    <Poster
      id="Preload2"
      visible="false"/>
    <Poster
      id="Border"
      translation="[-3,-3]"
      visible="false"
      uri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>  
  </children>
</component>