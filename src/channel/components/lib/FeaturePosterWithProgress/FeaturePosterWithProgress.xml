<?xml version="1.0" encoding="utf-8" ?>
<!--
 - FeaturePosterWithProgress
 -->
<component name="FeaturePosterWithProgress" extends="Group">

  <script type="text/brightscript" uri="FeaturePosterWithProgress.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  
  <interface>
    <field id="itemContent" alias="FeaturePoster.itemContent"/>
    <field id="index" alias="FeaturePoster.index"/>
    <field id="width" alias="FeaturePoster.width"/>
    <field id="height" alias="FeaturePoster.height"/>
    <field id="loadStatus" alias="FeaturePoster.loadStatus"/>
  </interface>

  <children>
    <FeaturePoster
      id="FeaturePoster"/>
    <Rectangle
      id="ProgressBar"
      height="6"
      width="0"
      visible="false"/>
  </children>

</component>
