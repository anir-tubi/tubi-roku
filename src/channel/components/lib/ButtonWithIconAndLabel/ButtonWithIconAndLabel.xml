<?xml version="1.0" encoding="utf-8" ?>
<!-- ButtonWithIconAndLabel component which draws Icon & Label inside poster, it can be used as button in a MarkupGrid -->
<component name="ButtonWithIconAndLabel" extends="Group" >
  <script type="text/brightscript" uri="ButtonWithIconAndLabel.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />

    <!-- OUTPUTS -->
    <field id="calculatedWidth" type="integer"/>
  </interface>

  <children>
    <Poster
      id="ButtonBG"
      width="0"
      height="72"
      uri="pkg:/images/menu-focus-$$RES$$.9.png"
      translation="[0,0]"/>

    <LayoutGroup
      id="IconAndLabelGroup"
      layoutDirection="horiz"
      vertAlignment="center"
      horizAlignment="left"
      itemSpacings="[12]"
      translation="[36,36]">
      <Poster
        id="ButtonIcon"
        height="36"
        width="36"
        translation="[0,18]"/>
      <Label
        id="ButtonText"
        height="72"
        vertAlign="center">
        <Font
          role="font"/>
      </Label>
    </LayoutGroup>

  </children>
</component>
