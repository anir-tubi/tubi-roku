<?xml version="1.0" encoding="utf-8" ?>
<component name="LinearTVCaptioningMenuItem" extends="Group">
  <script type="text/brightscript" uri="LinearTVCaptioningMenuItem.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->

    <!-- Content expected for a LinearTVCaptioningMenuItem:
     -
     - title - The label text
     - iconUrl - The icon uri
     -
     -->
    <field id="itemContent" type="node" />
    <field id="active" type="boolean" />
    <field id="focusPercent" type="float" />

  </interface>

  <children>
    <Poster
      id="Bground"
      uri="pkg://images/menu-focus-$$RES$$.9.png"
      width="225"
      height="72"
      loadSync="true"/>

    <Label
      id="unFocusedMenuText"
      translation="[36,0]"
      vertAlign="center"
      ellipsizeOnBoundary="true"
      width="135"
      height="72">
      <Font
        role="font"/>
    </Label>

    <Label
      id="MenuText"
      translation="[36,0]"
      vertAlign="center"
      horizAlign="left"
      ellipsizeOnBoundary="true"
      opacity="0.0"
      width="135"
      height="72">
      <Font
        role="font"/>
    </Label>

    <Poster
      id="EnabledIcon"
      width="36"
      height="33"
      translation="[174,21]"
      uri="pkg:/images/icon-checkmark.png"/>
    <Poster
      id="unfocusedEnabledIcon"
      width="36"
      height="33"
      translation="[174,21]"
      uri="pkg:/images/icon-checkmark.png"/>

  </children>
</component>
