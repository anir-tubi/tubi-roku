<?xml version="1.0" encoding="utf-8" ?>
<component name="GridPoster" extends="Group">
  <interface />
  <children>
    <Poster
      id="BackgroundPoster"
      loadWidth="1615"
      width="1615"
      loadHeight="909"
      height="909"
      uri="pkg:/images/grid-default-blurred.jpg"
      loadDisplayMode="scaleToZoom"
      translation="[305,0]"
      opacity="0.0"
      visible="true" />
    <Animation
      id="TransitionIn"
      duration="0.9"
      easeFunction="inOutCubic">
      <Vector2DFieldInterpolator
        id="TranslationInterpolator"
        key="[0.0,1.0]"
        keyValue="[[143, -91],[305,0]]"
        fieldToInterp="BackgroundPoster.translation" />
      <FloatFieldInterpolator
        id="ShrinkWidthInterpolator"
        key="[0.0,1.0]"
        keyValue="[1938, 1615]"
        fieldToInterp="BackgroundPoster.width" />
      <FloatFieldInterpolator
        id="ShrinkHeightInterpolator"
        key="[0.0,1.0]"
        keyValue="[1091, 909]"
        fieldToInterp="BackgroundPoster.height" />
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[0.0,1.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundPoster.opacity" />
    </Animation>
    <Animation
      id="FadeInOnly"
      duration="0.9"
      easeFunction="inOutCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[0.0,1.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundPoster.opacity" />
    </Animation>    
    <Animation
      id="TransitionOut"
      duration="0.9"
      easeFunction="outCubic">
      <FloatFieldInterpolator
        id="FadeInterpolator"
        key="[1.0,0.0]"
        keyValue="[0, 1]"
        fieldToInterp="BackgroundPoster.opacity" />
    </Animation>
  </children>
</component>