<?xml version="1.0" encoding="utf-8" ?>
<!--
 - NumberPad is key pad with numbers from 1 through 9 in 3 rows, and a fourth row
 - containing 0 and a button with a back icon
 -->
<component name="NumberPad" extends="Group">

  <script type="text/brightscript" uri="NumberPad.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>

    <!-- INPUT -->
      <!-- moveFocusToDelete is a boolean which helps to set the focus "back/delete" key on numberpad -->
      <field id="moveFocusToDelete" type="boolean" alwaysNotify="true"/>

    <!-- OUTPUT -->
      <field id="text" type="string" alias="keyboard.text" />
      <field id="audioGuideText" type="string"/>
  </interface>

  <children>
    <DynamicCustomKeyboard
      id="keyboard"
      translation="[0, -90]" />
  </children>
</component>
