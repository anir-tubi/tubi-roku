<?xml version="1.0" encoding="utf-8" ?>
<!--
 - NumberPadGridItem is used to populate the NumberPad component
 -->
<component name="NumberPadGridItem" extends="Group">

  <script type="text/brightscript" uri="NumberPadGridItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  
  <interface>
    <!-- INPUT -->
      <field id="itemContent" type="node" />
      <field id="itemHasFocus" type="boolean" alwaysNotify="true" />
      <field id="focusPercent" type="float" />
      <field id="gridHasFocus" type="boolean" />
  </interface>

  <children>
    <Rectangle
      id="NumberPadGridItemBg"
      width="159"
      height="96" />
    <Label
      id="NumberPadGridItemFgLabel"
      horizAlign="center"
      vertAlign="center"
      visible="true"
      width="159"
      height="96"
      translation="[0,6]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Bold.ttf"
        size="48"/>
      </Label>
    <Poster
      id="NumberPadGridItemFgPoster"
      uri="pkg://images/icon-delete.png"
      translation="[105,36]"
      visible="false" />
  </children>
</component>
