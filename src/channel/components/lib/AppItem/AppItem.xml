<?xml version="1.0" encoding="utf-8"?>
<component name="AppItem" extends="Group">

  <script type="text/brightscript" uri="AppItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="width" alias="background.width" />
    <field id="height" alias="background.height" />
  </interface>

  <children>
    <Poster
      id="background"
      uri="pkg:/images/poster-background-app-item-$$RES$$.9.png" />
    <LayoutGroup
      id="contentGroup"
      layoutDirection="vert"
      horizAlignment="center"
      vertAlignment="top"
      addItemSpacingAfterChild="false"
      itemSpacings="[27, 81]">
      <Poster
        id="logo"
        width="195"
        height="195" />
      <Label
        id="title"
        horizAlign="center" 
        vertAlign="center" />
    </LayoutGroup>
  </children>

</component>
