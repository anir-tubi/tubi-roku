<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelCategoryGridPoster" extends="Group" >
  <script type="text/brightscript" uri="ChannelCategoryGridPoster.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../ExperimentMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="itemContent" type="node" />
    <field id="width" alias="Poster.width" />
    <field id="height" alias="Poster.height" />
    <field id="focusPercent" type="float" />
    <field id="gridHasFocus" type="boolean" />
    <field id="itemHasFocus" type="boolean" />
  </interface>

  <children>
    <Rectangle
      id="PosterRect"/>
    <Poster
      opacity=".64"
      id="Poster"
      failedBitmapUri = "pkg:/images/placeholder-featured.jpg"
      loadingBitmapUri = "pkg:/images/placeholder-featured.jpg" />
    <Poster
      id="Logo"
      width="200"
      height="80" />
    <Label
      id="Title"
      numLines="2"
      wrap="true"
      ellipsizeOnBoundary="true"
      vertAlign="center"
      horizAlign="center"
      visible="false">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    <LayoutGroup
      id="SponsoredBy"
      layoutDirection="horiz"
      itemSpacings="[12]"
      visible="false">
      <Label
        id="SponsoredByText"
        text=""
        vertAlign="bottom"
        width="0"
        height="18">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="18" />
      </Label>
      <Poster
        id="SponsoredByPoster"
        visible="false"/>
    </LayoutGroup>

  </children>
</component>
