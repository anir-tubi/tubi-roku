<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelCategoryGridPoster" extends="Group" >
  <script type="text/brightscript" uri="pkg:/components/lib/ChannelCategoryGridPoster/ChannelCategoryGridPoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="width" alias="Poster.width" />
    <field id="height" alias="Poster.height" />
  </interface>

  <children>
    <Poster
     id="Poster"
     failedBitmapUri = "pkg:/images/placeholder-featured.jpg"
     loadingBitmapUri = "pkg:/images/placeholder-featured.jpg">
    </Poster>
    <Poster
     id="Logo"
     width="200"
     height="80">
    </Poster>
    <Label
      id="Title"
      numLines="2"
      wrap="true"
      color="0xFFFFFFFF"
      ellipsizeOnBoundary="true"
      vertAlign="center"
      horizAlign="center"
      visible="false">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>

  </children>
</component>
