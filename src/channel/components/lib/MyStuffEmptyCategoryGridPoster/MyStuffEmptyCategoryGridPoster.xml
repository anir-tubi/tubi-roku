<?xml version="1.0" encoding="utf-8" ?>
<component name="MyStuffEmptyCategoryGridPoster" extends="Rectangle" >

  <script type="text/brightscript" uri="MyStuffEmptyCategoryGridPoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->

      <!-- The title of the poster -->
      <field id="title" alias="Title.text" />
      <!-- The subtitle of the poster -->
      <field id="subtitle" alias="Subtitle.text" />
      <!-- The uri of the poster's icon -->
      <field id="iconUri" alias="icon.uri" />
  </interface>

  <children>
    <Group>
    <LayoutGroup
      id="myStuffLayout"
      layoutDirection="vert"
      horizAlignment="center"
      itemSpacings="[18]">
      <Poster
        id="Icon"
        width="84"
        height="84"
        />
      <Label
        id="Title"
        height="39"
        vertAlign="center">
        <Font
          role="font"/>
        </Label>
      <Label
        id="Subtitle"
        wrap="true"
        ellipsizeOnBoundary="true"
        width="1092"
        numLines="1"
        vertAlign="center"
        horizAlign="center">
        <Font
          role="font"/>
        </Label>
    </LayoutGroup>
    </Group>
  </children>
</component>
