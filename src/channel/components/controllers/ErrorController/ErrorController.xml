<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - ErrorController
 -
 -->
<component name="ErrorController" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ErrorController/ErrorController.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  
  <interface>
    <!--
      - error = {
      -   title: ...
      -   message: ...
      -   buttonText: ...
      - }
      -
      -->
    <field id="error" type="assocarray" />
    
    <field id="buttonSelected" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <!-- give something more than a grey background for the error modal -->
    <Poster
      id="ErrorBackground"
      loadSync="true"
      width="1920"
      height="1080"
      uri="pkg:/images/splash-fhd.png"/>

    <TrackingLoggingTask
      id="TrackingLoggingTask" />

  </children>

</component>
