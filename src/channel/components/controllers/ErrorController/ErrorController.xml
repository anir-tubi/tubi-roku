<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ErrorController
 -
 -->
<component name="ErrorController" extends="Group">
  <script type="text/brightscript" uri="ErrorController.brs" />
  <script type="text/brightscript" uri="../../screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>
    <!-- INPUT -->
    <!-- Display a connection error if this field is set-->
    <field id="connectionError" type="boolean" alwaysNotify="true"/>

    <!-- OUTPUT -->
    <field id="buttonSelected" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <!-- give something more than a grey background for the error modal -->
    <Poster
      id="ErrorBackground"
      loadSync="true"
      width="1920"
      height="1080"
      uri="pkg:/images/splash-{size}.jpg"/>

    <TrackingLoggingTask
      id="TrackingLoggingTask" />

  </children>

</component>
