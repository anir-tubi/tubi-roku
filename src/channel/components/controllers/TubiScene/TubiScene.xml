<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - TubiScene
 -
 - This the main scene that remotely loads the ContentController which in turn builds the CategoryScreen and the DetailsScreen, etc.
 - In order for remote loading of the scenegraph app to work, we have to sign the package, that is downloaded via the url in the
 - ComponentLibrary tag, with the same developer id as is used to create the Tubi app.
 -
 - Please see https://sdkdocs.roku.com/display/sdkdoc/ComponentLibrary for more info on remotely loading scenegraph components 
 -
 -
 - The ComponentLibary's uri field is populated in the build process.
 - The URI-TO-REPLACE value will be set to the value of remoteComponentDir in the 
 - settings section of default.yml when in production mode, and will be set to the local ip of the computer
 - doing the build when in dev mode. Change from production or dev mode by setting
 - the ROKU_PROFILE environment variable.
 -->
<component name="TubiScene" extends="Scene">

  <script type="text/brightscript" uri="TubiScene.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <children>

    <!-- Show a loading spinner only if it takes more than 3 seconds to load -->
      
    <ComponentLibrary
      id="TubiStarterLibrary"/>

    <ComponentLibrary
      id="TubiRemoteLibrary"/>
    
    <!-- startupScreens is the combination of poster and video which is shown before HomeScreen -->
    <Group id="startupScreens">
    
      <!-- animationLogo is the startup video played right after customSplashPoster is shown -->  
      <Video
        id="animationLogo"
        width="1920"
        height="1080"
        translation="[0,0]"
        enableUI="false"
        enableTrickPlay="false"
        visible="true" />
    
      <!-- customSplashTimer is used to show/hide the customSplashPoster -->
      <Timer
        id="customSplashTimer"
        duration="0.5"
        repeat="true" />
      
      <!-- customSplashPoster will be displayed after splash screen for min 1s and max 3s depends on animationLogo  -->  
      <Poster
        id="customSplashPoster"
        width="1920"
        height="1080"
        visible="true" />  
    </Group>
    
    <Spinner
      id="TubiSceneSpinner"
      opacity="0"
      width="1920"
      height="1080"/>
      
  </children>

</component>

