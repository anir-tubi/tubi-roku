<?xml version="1.0" encoding="utf-8" ?>
<!--
 - TubiScene
 -
 - This is the main scene that remotely loads the ContentController which in turn builds the HomeScreen and the DetailsScreen, etc.
 - In order for remote loading of the scenegraph app to work, we have to sign the package, that is downloaded via the url in the
 - ComponentLibrary tag, with the same developer id as is used to create the Tubi app.
 -
 - Please see https://sdkdocs.roku.com/display/sdkdoc/ComponentLibrary for more info on remotely loading scenegraph components
 -
 -
 - The ComponentLibrary's uri field is populated in main.brs from the value set on starterComponentsUrl in the appropriate environment's config yml.
 -->
<component name="TubiScene" extends="Scene">

  <script type="text/brightscript" uri="TubiScene.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />

  <interface>

    <!-- fadeOutCustomSplash is used to fadeOut the CustomSplashPoster -->
    <field id="fadeOutCustomSplash" type="boolean"/>

    <!-- fadeOutSpinner is used to fadeOut the TubiSceneSpinner -->
    <field id="fadeOutSpinner" type="boolean"/>

  </interface>

  <!-- suspendhandler will be set when app got suspended by pressing Home key or other Channel on remote -->
  <customization suspendhandler="customSuspend" />

  <!-- resumehandler will be set when app got resumed after suspended by user -->
  <customization resumehandler="customResume" />

  <children>

    <ComponentLibrary
      id="TubiStarterLibrary"/>

    <ComponentLibrary
      id="TubiRemoteLibrary"/>

   <Spinner
      id="TubiSceneSpinner"
      width="1920"
      opacity="0"
      height="1080"/>

    <Poster
      id="customSplashPoster"
      width="1920"
      height="1080"
      visible="true" />

  </children>

</component>
