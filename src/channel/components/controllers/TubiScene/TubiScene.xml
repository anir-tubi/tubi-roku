<?xml version="1.0" encoding="utf-8" ?>
<!--
 - TubiScene
 -
 - This is the main scene that remotely loads the ContentController which in turn builds the HomeScreen and the DetailsScreen, etc.
 - In order for remote loading of the scenegraph app to work, we have to sign the package, that is downloaded via the url in the
 - ComponentLibrary tag, with the same developer id as is used to create the Tubi app.
 -
 - Please see https://sdkdocs.roku.com/display/sdkdoc/ComponentLibrary for more info on remotely loading scenegraph components
 -
 -
 - The ComponentLibrary's uri field is populated in main.brs from the value set on starterComponentsUrl in the appropriate environment's config yml.
 -->
<component name="TubiScene" extends="Scene">

  <script type="text/brightscript" uri="TubiScene.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <!-- Includes the constants included in the base channel and kicks off the bootstrap process -->
    <field id="baseChannelConstants" type="assocarray" />

    <!-- the arguments that are passed into the app at startup, as an associative array -->
    <field id="startupArgs" type="assocarray"/>
    <field id="appStartTime" type="integer"/>

    <!-- Main thread listens for this and will make a call to roku continue watching endpoint. Below field will contain information related to the update or delete request.
          Below field is necessary due to a roku limitation that we need to make the api request from main thread due to a fact that they cannot retrieve channel token properly if it is made in component library.
          Sample value:
          {
          url: m.constants.urls.rokuContinueWatchingEndpoint
          options: {
            method: m.constants.reqTypes.post
            body: {} // Sample body - {"items":[{"contentId":"abc123","episodeId":"def123","lastInteractionTime":123456,"position":854,"duration":1678,"waitForNextEpisodeAvailability":true}]}
            headers: {}
          }
          requestType: "" string representing a unique value for the request. ex: postRokuContinueWatching
        }
    -->
    <field id="rokuContinueWatchingRequestInfo" type="assocarray" value="{}" alwaysNotify="true" />

    <!-- Main thread listens for this and will exit the app if set to true-->
    <field id="exitApp" type="boolean" value="false"/>

    <!-- disableInstantResume will be set to true when guest user tries to relaunch the app after 24hours after app got suspended by pressing home or by opening channel on remote -->
    <field id="disableInstantResume" type="boolean" value="false" alwaysNotify="true" />

    <field id="sendLogToServer" type="assocarray" alwaysNotify="true" />
  </interface>

  <!-- suspendhandler will be set when app got suspended by pressing Home key or other Channel on remote -->
  <customization suspendhandler="customSuspend" />

  <!-- resumehandler will be set when app got resumed after suspended by user -->
  <customization resumehandler="customResume" />

  <children>

    <RetryableComponentLibrary
      id="TubiStarterLibrary"
      timeoutDuration="30"
      retryDelayDuration="3"
      retryCount="3" />

    <RetryableComponentLibrary
      id="TubiRemoteLibrary"
      timeoutDuration="30"
      retryDelayDuration="3"
      retryCount="3"  />

    <Poster
      id="customSplashPoster"
      width="1920"
      height="1080"
      uri="pkg:/images/splash-$$RES$$.webp"
      visible="true" />

      <!-- startupScreens group has video node, which is shown before HomeScreen/Deeplinks -->
    <Group id="startupScreens" opacity="0.0">

      <!-- animationLogo is the startup video played right after customSplashPoster is shown -->
      <Video
        id="animationLogo"
        width="1920"
        height="1080"
        translation="[0,0]"
        enableUI="false"
        enableTrickPlay="false"
        visible="true" />

      <!-- customSplashTimer is used to show/hide the customSplashPoster -->
      <Timer
        id="customSplashTimer"
        duration="0.5"
        repeat="true" />
    </Group>
  </children>

</component>
