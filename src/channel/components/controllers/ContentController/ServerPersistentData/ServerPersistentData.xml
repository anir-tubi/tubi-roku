<?xml version="1.0" encoding="utf-8" ?>
<component name="ServerPersistentData" extends="Node">
  <interface>
    <!-- Holds the value of user preferred subtitle track. Sample Format: { "language": "EN" } -->
    <field id="subtitleTrack" type="assocarray" value="{}" />

    <!-- Holds the value of user preferred audio track. Sample Format: { "language": "en","role": "description" }. Where role can hold values description,main depending on if the track as audio description. -->
    <field id="audioTrack" type="assocarray" value="{}" />

    <!-- Holds the value if video preview is allowed or not. -->
    <field id="isVideoPreviewOn" type="boolean" value="true" />

    <!-- Holds the value if auto play is allowed or not. -->
    <field id="isAutoPlayTimerOn" type="boolean" value="true" />

    <!-- Holds the value if user liked a title. -->
    <field id="isLikeToastNotificationShown" type="boolean" value="false" />

    <!-- Holds the value if user disliked a title. -->
    <field id="isDisLikeToastNotificationShown" type="boolean" value="false" />

    <!-- Email isn't stored in the registry so we access it from here -->
    <field id="email" type="string" />

    <!-- parentalRating isn't stored in the registry so we access it from here -->
    <field id="parentalRating" type="integer" value="3" />

    <!-- hasPassword isn't stored in the registry so we access it from here -->
    <field id="hasPassword" type="boolean" value="false" />

    <!-- hasPreviouslyRegistered holds the boolean value whether this device is already registered on Tubi -->
    <field id="hasPreviouslyRegistered" type="boolean" value="false" />

    <!--isLinearBlocked holds the string value whether linear is blocked for the user-->
    <field id="isLinearBlocked" type="string" value="none" />

    <!-- birthday holds the string value of the user's birthday -->
    <field id="birthday" type="string" value="" />

  </interface>
</component>
