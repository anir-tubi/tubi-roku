<?xml version="1.0" encoding="utf-8" ?>
<component name="ServerPersistentData" extends="Node">
  <interface>
    <!-- Holds the value of user preferred audio track. Sample Format: { "language": "en","role": "description" }. Where role can hold values description,main depending on if the track as audio description. -->
    <field id="audioTrack" type="assocarray" value="{}" />

    <!-- Holds the value if video preview is allowed or not. -->
    <field id="isVideoPreviewOn" type="boolean" value="true" />

    <!-- Holds the value if user liked a title. -->
    <field id="isLikeToastNotificationShown" type="boolean" value="false" />

    <!-- Holds the value if user disliked a title. -->
    <field id="isDisLikeToastNotificationShown" type="boolean" value="false" />

    <!-- Holds the value of when we showed the roku continue watching prompt to user. -->
    <field id="lastRokuCwConsentPromptShownAt" type="integer" />

  </interface>
</component>
