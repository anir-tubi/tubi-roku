<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ContentController
 -
 - This is the primary controller of the application which will manage
 - CategoryScreen and DetailScreen.
 -
 - Scene Startup Sequence:
 -  1) This component is created and init() is run
 -  2) During ContentController.init(), the MetadataFetchTask is set to "RUN", creating its long-lived thread
 -     that will answer requests for metdata from the primary scene graph thread.
 -  3) The MetadataFetchTask sets a 'ready' field to "true" indicating that it is available
 -  4) This component dynamically creates the CategoryScreen which begins making metadata requests
 -
 -  This startup sequence will ensure that the OS-level thread for MetadataTaskThread is ready
 -  and we don't have race conditions when populating the CategoryScreen.
 -
 -->
<component name="ContentController" extends="Group">

  <script type="text/brightscript" uri="ContentController.brs" />
  <script type="text/brightscript" uri="CategoryDetailsScreenHelpers.brs" />
  <script type="text/brightscript" uri="ChannelGridScreenHelpers.brs" />
  <script type="text/brightscript" uri="DetailScreenHelpers.brs" />
  <script type="text/brightscript" uri="HomeScreenHelpers.brs" />
  <script type="text/brightscript" uri="SearchScreenHelpers.brs" />
  <script type="text/brightscript" uri="EPGScreenHelpers.brs" />
  <script type="text/brightscript" uri="InitialContentScreenHelpers.brs" />
  <script type="text/brightscript" uri="EpisodeScreenHelpers.brs" />
  <script type="text/brightscript" uri="SideNavHelpers.brs" />
  <script type="text/brightscript" uri="VideoHelpers.brs" />
  <script type="text/brightscript" uri="SettingsScreenHelpers.brs" />
  <script type="text/brightscript" uri="SignInHelpers.brs" />
  <script type="text/brightscript" uri="ScreenStackHelpers.brs" />
  <script type="text/brightscript" uri="LinearVideoPlayerScreenHelpers.brs" />
  <script type="text/brightscript" uri="AgeVerificationScreenHelpers.brs" />
  <script type="text/brightscript" uri="EPGScreenHelpers.brs" />
  <script type="text/brightscript" uri="TopNavHelpers.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/GeneralTaskModule.brs" />
  <script type="text/brightscript" uri="../../../source/lib/ApiUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/CmsApi.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TensorApi.brs" />
  <script type="text/brightscript" uri="../../../source/lib/UserDeviceApi.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiCache.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiAds.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />

  <interface>

    <!-- INPUTS -->
      <!-- the arguments that are passed into the app at startup, as an associative array -->
      <field id="startupArgs" type="assocarray"/>
      <field id="appStartTime" type="integer"/>

      <!-- any info that is passed into the channel via roInput/ECP while the channel is running
           can be deeplinks, transport controls, voice commands, etc. -->
      <field id="roInputInfo" type="assocarray"/>

      <!-- customSuspend will be set by scene's suspendhandler callback  -->
      <field id="customSuspend" type="assocarray" alwaysNotify="true"/>

      <!-- customResume will be set by scene's resumehandler callback  -->
      <field id="customResume" type="assocarray" alwaysNotify="true"/>

      <field id="reloadUserCategoriesResponse" type="assocarray"/>
      <field id="reloadMovieUserCategoriesResponse" type="assocarray"/>
      <field id="reloadTVUserCategoriesResponse" type="assocarray"/>
      <field id="reloadLinearTVUserCategoriesResponse" type="assocarray"/>
      <field id="reloadEspanolUserCategoriesResponse" type="assocarray"/>

      <field id="homescreenResponse" type="assocarray"/>
      <field id="moviescreenResponse" type="assocarray"/>
      <field id="tvscreenResponse" type="assocarray"/>
      <field id="espanolscreenResponse" type="assocarray"/>
      <field id="linearTVScreenResponse" type="assocarray"/>

      <field id="searchResponse" type="assocarray"/>

      <field id="transportVoiceRequest" type="assocarray"/>

      <!-- fadeInContentController will be set true once animation logo is finished during app launch -->
      <field id="fadeInContentController" type="boolean"/>

      <!-- Holds the information needed to populate a navigate_witin_page event. This info is usually set elsewhere by screens and
           observed by their helpers, but in rare cases, ContentController can set this associative array, which
           will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
    <field id="navigateWithinPageInfo" type="assocarray"/>

    <!-- OUTPUT -->
      <!-- Main thread listens for this and will exit the app if set to true-->
      <field id="exitApp" type="boolean" value="false"/>

      <field id="transportVoiceResponse" type="assocarray"/>

      <!-- removeStartUpScreens is used to remove the StartUpScreens(animationLogo) -->
      <field id="removeStartUpScreens" type="boolean" />

      <!-- disableInstantResume will be set to true when guest user tries to relaunch the app after 24hours after app got suspended by pressing home or by opening channel on remote -->
      <field id="disableInstantResume" type="boolean" value="false" alwaysNotify="true"/>

  </interface>

    <children>

     <Group
      id="uiGroup"
      opacity="0.0">

      <!--
        - This hides the loading screen that was in place by the Scene
        - before remote components have loaded
        -->
      <Rectangle
        id="ContentBackground"
        width="1920"
        height="1080"
        translation="[0,0]"/>

      <!-- All the children of this group exist only in a single instance -->
      <Group
        id="ContentGroup"
        visible="false">
        <!--  Group that contains the linear video player when it is not in its fullscreen state -->
        <Group
          id="LinearPlayerGroup"/>
        <!--Handles the background images -->
        <BackgroundGroup
          id="BackgroundGroup"/>
        <!--Handles the background sponsorship images when the current focused item is sponsored-->
        <SponsorshipBackgroundGroup
          id="SponsorshipBackgroundGroup"
          translation="[0,522]"/>

        <ScreenStack
          id="ScreenStack"/>

        <!--  Group that contains the linear video player when it is not in its fullscreen state, and when the player needs to be above the screen stack layer. -->
        <Group
          id="LinearPlayerGroupAboveScreenStack"/>

        <CountdownTimerUI
          id="LinearCountdownTimer"
          translation="[946,240]"/>

        <SideNav
          id="SideNav"
          translation="[-32,0]"
          width="338"/>
        <Clock
          id="clock"
          width="93"
          height="36"
          visible="false"
          translation="[1729,72]"/>
        <Group
          id="logoGroup">
          <Poster
            id="tubiLogo"
            height="45"
            width="103"
            uri="pkg:/images/logo-white-large.png"
            opacity="0.5"
            translation="[1719,60]"/>
          <Poster
            id="tubiKidsLogo"
            height="45"
            width="209"
            uri="pkg:/images/locale/en_US/logo-kids-white-large.png"
            translation="[1614,60]"
            opacity="1.0"
            visible="false"/>
          <Poster
            id="tubiEspanolLogo"
            height="78"
            width="322"
            uri="pkg:/images/logo-espanol-white-large.png"
            translation="[1503,60]"
            opacity="1.0"
            visible="false"/>
        </Group>
      </Group>

      <!-- Services -->

      <TrackingLoggingTask
        id="TrackingLoggingTask"/>

      <!-- The timer that is used to countdown when the minimized player goes fullscreen -->
      <Timer
       id="PlayerFullscreenCountdownTimer"
       duration="1"
       repeat="true"/>

      <!-- The timer that is used to check if guests are allowed to see the history of content. -->
      <Timer
       id="ResumeAllowedTimer"
       duration="300"
       repeat="true"/>

     <!-- DetailScreenLoadTimer is a timer used to check whether startup animation logo is finished playing -->
     <Timer
       id="DetailScreenLoadTimer"
       duration="0.5"
       repeat="true"/>

      <!-- Spinner primarily for sign-in/sign-out transitions -->
      <Spinner
        id="ContentControllerSpinner"
        visible="true"
        modal="true"
        width="1920"
        height="1080"/>

      <!-- Spinner to indicate loading of a linear video when it is not fullscreen -->
      <Spinner
        id="LinearVideoPlayerSpinner"
        translation="[1576,660]"
        showShade="false"
        displayText="false"
        width="266"
        height="66"
        horizAlign="right"
        vertAlign="bottom"
        visible="false"/>

   </Group>

    </children>

</component>
