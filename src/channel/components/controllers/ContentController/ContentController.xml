<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - ContentController
 -
 - This is the primary controller of the application which will manage
 - CategoryScreen and DetailScreen.
 -
 - Scene Startup Sequence:
 -  1) This component is created and init() is run
 -  2) During ContentController.init(), the MetadataFetchTask is set to "RUN", creating its long-lived thread
 -     that will answer requests for metdata from the primary scene graph thread.
 -  3) The MetadataFetchTask sets a 'ready' field to "true" indicating that it is available
 -  4) This component dynamically creates the CategoryScreen which begins making metadata requests
 -
 -  This startup sequence will ensure that the OS-level thread for MetadataTaskThread is ready
 -  and we don't have race conditions when populating the CategoryScreen.
 -
 -->
<component name="ContentController" extends="Group">

  <script type="text/brightscript" uri="ContentController.brs" />
  <script type="text/brightscript" uri="ChannelScreenHelpers.brs" />
  <script type="text/brightscript" uri="ChannelGridScreenHelpers.brs" />
  <script type="text/brightscript" uri="DetailScreenHelpers.brs" />
  <script type="text/brightscript" uri="HomeScreenHelpers.brs" />
  <script type="text/brightscript" uri="SearchScreenHelpers.brs" />
  <script type="text/brightscript" uri="EpisodeScreenHelpers.brs" />
  <script type="text/brightscript" uri="SideNavHelpers.brs" />
  <script type="text/brightscript" uri="VideoHelpers.brs" />
  <script type="text/brightscript" uri="SettingsScreenHelpers.brs" />
  <script type="text/brightscript" uri="SignInHelpers.brs" />
  <script type="text/brightscript" uri="ScreenStackHelpers.brs" />
  <script type="text/brightscript" uri="OnBoardingHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/GeneralTaskModule.brs" />
  <script type="text/brightscript" uri="../../../source/lib/CmsApi.brs" />
  <script type="text/brightscript" uri="../../screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="../../tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  
  <interface>
  
    <!-- INPUTS -->
      <!-- the arguments that are passed into the app at startup, as an associative array -->
      <field id="startupArgs" type="assocarray"/>
      <field id="appStartTime" type="integer"/>

      <!-- any info that is passed into the channel via roInput/ECP while the channel is running
           can be deeplinks, transport controls, voice commands, etc. -->
      <field id="roInputInfo" type="assocarray"/>

      <field id="reloadUserCategoriesResponse" type="assocarray" alwaysNotify="true"/>
      <field id="reloadMovieUserCategoriesResponse" type="assocarray" alwaysNotify="true"/>
      <field id="reloadTVUserCategoriesResponse" type="assocarray" alwaysNotify="true"/>

      <field id="homescreenResponse" type="assocarray" alwaysNotify="true"/>
      <field id="moviescreenResponse" type="assocarray" alwaysNotify="true"/>
      <field id="tvscreenResponse" type="assocarray" alwaysNotify="true"/>

      <!-- metadataFetchTask puts results on this field -->
      <field id="searchResponse" type="assocarray" alwaysNotify="true"/>
      
      <field id="transportVoiceRequest" type="assocarray" alwaysNotify="true"/>
      
      <!-- fadeInContentController will be set true once animation logo is finished during app launch -->
      <field id="fadeInContentController" type="boolean"/>
      
    <!-- OUTPUT -->
      <!-- Main thread listens for this and will exit the app if set to true-->
      <field id="exitApp" type="boolean" value="false"/>
      
      <field id="transportVoiceResponse" type="assocarray"/>
      
      <!-- removeStartUpScreens is used to remove the StartUpScreens(animationLogo) -->
      <field id="removeStartUpScreens" type="boolean" />  

  </interface>
        
    <children>
    
     <Group
      id="uiGroup"
      opacity="0.0">

      <!--
        - This hides the loading screen that was in place by the Scene
        - before remote components have loaded
        -->
      <Rectangle
        id="ContentBackground"
        width="1920"
        height="1080"
        translation="[0,0]"/>

      <!-- All the children of this group exist only in a single instance -->
      <Group
        id="ContentGroup"
        visible="false">
        <!--Handles the background images -->
        <BackgroundGroup
          id="BackgroundGroup"/>
        <ScreenStack
          id="ScreenStack"/>
        <SideNav
          id="SideNav"
          translation="[-66,0]"
          width="438"/>
        <Group 
          id="logoGroup">
          <Poster
            id="tubiLogo"
            height="45"
            width="103"
            uri="pkg:/images/logo-white-large.png"
            opacity="0.5"
            translation="[1732,60]"/>
          <Poster
            id="tubiKidsLogo"
            height="45"
            width="209"
            uri="pkg:/images/locale/en_US/logo-kids-white-large.png"
            translation="[1626,60]"
            opacity="1.0"
            visible="false"/>
        </Group>
      </Group>

      <!-- Services -->
      <MetadataFetchTask
        id="MetadataFetchTask"/>

      <TrackingLoggingTask
        id="TrackingLoggingTask"/>

      <Timer
       id="InactivityTimer"
       duration="10"
       repeat="true"/>
     
     <!-- DetailScreenLoadTimer is a timer used to check whether startup animation logo is finished playing -->    
     <Timer
       id="DetailScreenLoadTimer"
       duration="0.5"
       repeat="true"/>  

      <!-- Spinner primarily for sign-in/sign-out transitions -->
      <Spinner
        id="ContentControllerSpinner"
        visible="true"
        modal="true"
        width="1920"
        height="1080"/>
        
   </Group>   
   
    </children>

</component>

