<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - ContentController
 -
 - This is the primary controller of the application which will manage
 - CategoryScreen and DetailScreen.
 -
 - Scene Startup Sequence:
 -  1) This component is created and init() is run
 -  2) During ContentController.init(), the MetadataFetchTask is set to "RUN", creating its long-lived thread
 -     that will answer requests for metdata from the primary scene graph thread.
 -  3) The MetadataFetchTask sets a 'ready' field to "true" indicating that it is available
 -  4) This component dynamically creates the CategoryScreen which begins making metadata requests
 -
 -  This startup sequence will ensure that the OS-level thread for MetadataTaskThread is ready
 -  and we don't have race conditions when populating the CategoryScreen.
 -
 -->
<component name="ContentController" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ContentController.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ChannelScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/DetailScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/EpisodeScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ScreenStack.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  
  <interface>
    <!-- INPUTS -->
      <!-- Show the detail screen for the item indicated
        -
        - The node should have 2 fields set:
        -    id    - the content requested
        -    type  - the type of content: "series", "video", or "episode"
        - 2 optional fields should be set if the source is deeplink from another platform (ie. iphone, etc.)
        -    source  - the device id of the originating device
        -    nowPos  - the resume time sent along with deeplink
        -->
      <field id="deepLinkContent" type="node" alwaysNotify="true" />

      <!-- Interface for receiving Live TV content from the main Brightscript thread -->
      <field id="onNowContent" type="node" alwaysNotify="true"/>
    

    <!-- OUTPUT -->
      <!-- Main thread listens for this (in the ad shim) and will exit the app if set to true-->
      <field id="exitApp" type="boolean" value="false" />

  </interface>
        
    <children>
      <!--
        - This hides the loading screen that was in place by the Scene
        - before remote components have loaded
        -->
      <Rectangle
        id="ContentBackground"
        width="1920"
        height="1080"
        translation="[0,0]"/>

      <!-- Top-level NavigationGroup deals with just 2 experiences:
            1) the ContentGroup which contains HomeScreen, CategoryScreen, DetailScreen, etc.
            2) the SignInController
      -->
      <NavigationGroup
        id="RootTabGroup">

        <!-- All the children of this group share a background instance -->
        <Group
          id="ContentGroup"
          visible="false">
          <!--Handles the background images -->
          <BackgroundGroup
            id="BackgroundGroup"/>
          <VideoPlayer
            id="VideoPlayer"
            visible="false"/>
          <NavigationGroup
            id="ContentScreenStack"/>
        </Group>

      </NavigationGroup>
      
      <!-- Services -->
      <MetadataFetchTask
        id="MetadataFetchTask" />

      <TrackingLoggingTask
        id="TrackingLoggingTask" />
      
      <Timer
       id="AutohideTimer"/>

      <Timer
       id="InactivityTimer"
       duration="10"
       repeat="true"/>

      <!-- Spinner primarily for sign-in/sign-out transitions -->
      <Spinner
        id="ContentControllerSpinner"
        visible="false"
        modal="true"
        isDisabled="false"
        width="1920"
        height="1080"/>

    </children>

</component>

