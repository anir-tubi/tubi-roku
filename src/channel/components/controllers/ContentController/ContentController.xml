  <interface>

    <!-- INPUTS -->
    <!-- customSuspend will be set by scene's suspendhandler callback  -->
    <field id="customSuspend" type="assocarray" alwaysNotify="true" />

    <!-- customResume will be set by scene's resumehandler callback  -->
    <field id="customResume" type="assocarray" alwaysNotify="true" />

    <field id="transportVoiceRequest" type="assocarray" />

    <!-- fadeInContentController will be set true once animation logo is finished during app launch -->
    <field id="fadeInContentController" type="boolean" />

    <!-- Holds the information needed to populate a navigate_within_page event. This info is usually
    set elsewhere by screens and
           observed by their helpers, but in rare cases, ContentController can set this associative array,
    which
           will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
    <field id="navigateWithinPageInfo" type="assocarray" />

    <field id="isComponentLibFailedToLoad" type="boolean" value="false" />

    <!-- removeStartUpScreens is used to remove the StartUpScreens(animationLogo) -->
    <field id="removeStartUpScreens" type="boolean" />

    <!-- OUTPUT -->

  </interface>

  <children>
    <!-- uiGroup should be the only child of ContentController. All other components should be added
    in ContentControllerUI to allow us to load base dependencies before starting to make UI
    components -->
    <Group
      id="uiGroup"
      opacity="0.0" />
  </children>
