<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - ContentController
 -
 - This is the primary controller of the application which will manage
 - CategoryScreen and DetailScreen.
 -
 - Scene Startup Sequence:
 -  1) This component is created and init() is run
 -  2) During ContentController.init(), the MetadataFetchTask is set to "RUN", creating its long-lived thread
 -     that will answer requests for metdata from the primary scene graph thread.
 -  3) The MetadataFetchTask sets a 'ready' field to "true" indicating that it is available
 -  4) This component dynamically creates the CategoryScreen which begins making metadata requests
 -
 -  This startup sequence will ensure that the OS-level thread for MetadataTaskThread is ready
 -  and we don't have race conditions when populating the CategoryScreen.
 -
 -->
<component name="ContentController" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ContentController.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ChannelScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ChannelGridScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/DetailScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/HomeScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/SearchScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/EpisodeScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/SideNavHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/VideoHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/SettingsScreenHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/SignInHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ContentController/ScreenStackHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/Settings.brs" />
  <script type="text/brightscript" uri="pkg:/source/Constants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  
  <interface>
    <!-- INPUTS -->
      <!-- the arguments that are passed into the app at startup, as an associative array -->
      <field id="startupArgs" type="assocarray" />

      <!-- any info that is passed into the channel via roInput/ECP while the channel is running
           can be deeplinks, transport controls, voice commands, etc. -->
      <field id="roInputInfo" type="assocarray" />

      <field id="reloadUserCategoriesResponse" type="assocarray" alwaysNotify="true"/>

      <field id="homescreenResponse" type="assocarray" alwaysNotify="true"/>

      <!-- metadataFetchTask puts results on this field -->
      <field id="searchResponse" type="assocarray" alwaysNotify="true"/>

    <!-- OUTPUT -->
      <!-- Main thread listens for this (in the ad shim) and will exit the app if set to true-->
      <field id="exitApp" type="boolean" value="false" />

  </interface>
        
    <children>
      <!--
        - This hides the loading screen that was in place by the Scene
        - before remote components have loaded
        -->
      <Rectangle
        id="ContentBackground"
        width="1920"
        height="1080"
        translation="[0,0]"/>

      <!-- All the children of this group exist only in a single instance -->
      <Group
        id="ContentGroup"
        visible="false">
        <!--Handles the background images -->
        <BackgroundGroup
          id="BackgroundGroup"/>
        <VideoPlayer
          id="VideoPlayer"
          visible="false"/>
        <ScreenStack
          id="ScreenStack"/>
        <SideNav
          id="SideNav"
          translation="[-66,0]"
          width="438"/>
        <Group 
          id="logoGroup">
          <Poster
            id="tubiLogo"
            height="45"
            width="103"
            uri="pkg:/images/logo-white-large.png"
            opacity="0.5"
            translation="[1732,60]"/>
          <Poster
            id="tubiKidsLogo"
            height="45"
            width="209"
            uri="pkg:/images/logo-kids-white-large.png"
            translation="[1626,60]"
            opacity="1.0"
            visible="false"/>
        </Group>
      </Group>

      <!-- Services -->
      <MetadataFetchTask
        id="MetadataFetchTask"/>

      <TrackingLoggingTask
        id="TrackingLoggingTask"/>

      <Timer
       id="AutohideTimer"/>

      <Timer
       id="InactivityTimer"
       duration="10"
       repeat="true"/>

      <!-- Spinner primarily for sign-in/sign-out transitions -->
      <Spinner
        id="ContentControllerSpinner"
        visible="false"
        modal="true"
        isDisabled="false"
        width="1920"
        height="1080"/>

    </children>

</component>

