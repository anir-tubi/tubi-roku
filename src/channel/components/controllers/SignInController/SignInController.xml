<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInController
 -
 - This controller manages the workflow of authenticating a user or allowing a guest pass.
 -
 -->
<component name="SignInController" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/controllers/SignInController/SignInController.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ScreenStack.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />

  <interface>
    <!-- INPUT -->
      <field id="skipDisambiguationScreen" type="boolean" value="false"/>

      <!-- Set to true to reset sign-in screen flow -->
      <field id="show" type="boolean" value="false"/>
    
    <!-- OUTPUT -->
      <!-- Set to the final state of the sign-in process: 'guest', 'registered', 'signedin' -->
      <field id="state" type="string" />

      <!-- Back button pressed at the top of the sign in screen stack -->
      <field id="backPressed" type="boolean" value="false" alwaysNotify="true"/>
  </interface>
        
    <children>
      <Poster
        id="BackgroundGradient"
        uri="pkg:/images/art-blur-background.png"
        width="1920"
        loadWidth="1920"
        height="1080"
        loadHeight="1080"
        loadDisplayMode="scaleToZoom"
        loadSync="false"
        translation="[0,0]"/>

      <Group
       id="SignInScreenStack"/>
    </children>

</component>
