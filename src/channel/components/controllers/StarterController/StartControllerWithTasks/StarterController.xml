<?xml version="1.0" encoding="utf-8" ?>
<!--
 - StarterController (StartControllerWithTasks)
 -
 - This starter controller's main purpose is to determine which remote component file to load into the channel. This version loads additional dependencies needed to run an experiment. In order to run an experiment in the Starter component library you must set the useFullStarterController field to true in the default.yml file.
 -
 - Please see https://sdkdocs.roku.com/display/sdkdoc/ComponentLibrary for more info on remotely loading scenegraph components
 -
 -
 -->
<component name="StarterController" extends="BaseStarterController">
  <script type="text/brightscript" uri="StarterController.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/shared.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExternalConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeOffsetUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/GeneralTaskModule.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/localClientErrorConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
</component>
