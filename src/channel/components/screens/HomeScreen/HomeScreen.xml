<?xml version="1.0" encoding="utf-8" ?>
<!-- This 'screen' is used as a vertical view scroller, encompassing 3 views: 
-    The tools menu, the OnNow screen and the CategoryScreen 
-->

<component name="HomeScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen/HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- INPUTS -->
      <field id="signedIn" type="boolean" value="false" />
        
      <!-- TODO: Plumb this to OnNowOverlay when the play button is selected -->
      <field id="hideUI" type="boolean"/>
    
      <field id="onNowContent" alias="OnNow.content"/>
    
      <!-- setting this field to true causes the category screen to be navigated to -->
      <field id="showCategoryScreen" type="boolean" value="false" alwaysNotify="true"/>

    <!-- OUTPUT -->
      <field id="toolsMenuSelected" type="boolean" alwaysNotify="true"/>

      <!-- will be used to change the background images on the content controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />
      <field id="backgroundType" type="string" />

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- Same format as trackingPageInfo -->
      <field id="oldTrackingPageInfo" type="assocarray" />

      <!-- stores the component info of the component that was selected when navigating to a new screen. Looks like:
        {
          componentType: "category_component"    ' Corresponds to one of the page types in tubiTracking_getAnalyticsComponent() 
                                                 ' which mirrors the protos repo.
          componentValues: {}                    ' An assoc array with key/values that match the componentType as found in
                                                 ' tubiTracking_getAnalyticsComponent().
        }
      -->
      <field id="trackingComponentInfo" alias="CategoryScreen.trackingComponentInfo" />

      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be updated when CategoryScreen update their navigateWithinPageInfo fields,
           and will be subsequently passed to the contentController
           which will be responsible for sending navigate_within_page events.
      -->
      <field id="navigateWithinPageInfo" alias="CategoryScreen.navigateWithinPageInfo" />

      <!-- A trigger that informs the ContentController that the user is navigating within screens in the Homescreen -->
      <field id="navigateBetweenHomescreens" type="boolean" alwaysNotify="true" />
  </interface>
  
  <children>
    <Group
      id="HomeViews">
      <OnNow
        id="OnNow"
        visible="true"
        translation="[0,0]"/>
      
      <CategoryScreen
        id="CategoryScreen"
        translation="[0,392]"
        infoVisible="false"
        visible="true"
        opacity="0.2"/>
    </Group>
    
    <Poster
      id="tubiLogo"
      height="45"
      width="103"
      opacity="0.5"
      uri="pkg:/images/logo-white-large.png"
      translation="[85,55]" />
  </children>
</component>