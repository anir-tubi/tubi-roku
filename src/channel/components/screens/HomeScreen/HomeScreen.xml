<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="../../lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/ApiUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ThematicTakeoverMixin.brs" />

  <interface>
    <!-- INPUTS -->
    <!-- When the Helper receives valid ad campaign data from the server, it sets the new value to
    this field. Currently the array will contain at most 1 child/ad campaign.  -->
    <field id="adContent" type="array" />

    <!-- When the Helper receives valid category data from the server, it sets the new value to this
    field. -->
    <field id="content" alias="CategoryGridList.content" />

    <!-- Skin Ad content node to display a skin ad wrapper campaign on homescreen . -->
    <field id="skinAdContent" alias="CategoryGridList.skinAdContent" />

    <!-- Tells the ad carousel if it should stop or start automatically rotating -->
    <field id="allowCarouselAutoRotate" type="boolean" />

    <!-- The helper class will call this when the new content is ready to be displayed on the
    screen. -->
    <field id="contentUpdated" alwaysNotify="true" alias="CategoryGridList.contentUpdated" />

    <!-- The helper will set this when the new skin Ad content is ready to be displayed on the
    screen. -->
    <field id="skinAdContentUpdated" alias="CategoryGridList.skinAdContentUpdated" />

    <!-- The helper will set this when the ad content is ready to be displayed on the screen. Both
    contentFetchCompleted and skinAdContentUpdated have to be true before the screen can proceed to
    load which is communicated via setting of contentUpdated. -->
    <field id="adContentFetchCompleted" type="boolean" value="false" />

    <!-- The helper will set this when the content is ready to be displayed on the screen. Both
    contentFetchCompleted and skinAdContentUpdated have to be true before the screen can proceed to
    load which is communicated via setting of contentUpdated. -->
    <field id="contentFetchCompleted" type="boolean" value="false" />

    <!-- The focused position in the side nav when returning to this screen (0 = top/home) -->
    <field id="sideNavFocusedPosition" type="integer" value="-1" />

    <!-- The left_nav_section analytics value of the focused side nav item (e.g. "HOME", "MOVIES") -->
    <field id="sideNavLeftNavSection" type="string" />

    <!-- What kind of content is this homeScreen displaying: movies, tv, normal, espanol etc -->
    <field id="contentMode" alias="CategoryGridList.contentMode" />

    <!-- removes any existing content on the CategoryGridList! -->
    <field id="isLoading" type="boolean" />

    <!-- tells the rowList to re-populate the content because rows have been added/removed and that
    may affect the look of some rows that have different heights compared to other rows  -->
    <field id="repopulateContent" type="boolean" alias="CategoryGridList.repopulateContent" />

    <!-- expected to be category ids(continue_watching/queue) if new continue_watching/queue got
    added, helps to set focus to correct row -->
    <field id="rowAdded" type="string" alias="CategoryGridList.rowAdded" />

    <!-- expected to be category ids(continue_watching/queue) if new continue_watching/queue got
    removed, helps to set focus to correct row -->
    <field id="rowRemoved" type="string" alias="CategoryGridList.rowRemoved" />

    <!-- set to true if the user is signed in and we want to change the experience based on that -->
    <field id="signedIn" alias="CategoryGridList.signedIn" />

    <!-- Indicated whether to play/pause/stop video preview -->
    <field id="isVideoPreviewOn" type="boolean" value="true" />

    <!-- show/hide the category menu -->
    <field id="categoryMenuVisible" type="boolean" />

    <!-- Indicates if that when the server is contacted, it should indicate that the app is in
    kidsMode. -->
    <field id="shouldKidsModeBeSentToServer" type="boolean"
      alias="CategoryGridList.shouldKidsModeBeSentToServer" />

    <field id="jumpToRowItemByID" alias="CategoryGridList.jumpToRowItemByID" />

    <!-- If the screen is not enabled, then user should not be able to select anything -->
    <field id="enabled" type="boolean" alwaysNotify="true" />

    <!-- Triggers a reset of the ContentArea translation values in the case they were adjusted by
    VITG -->
    <field id="resetContentAreaValues" type="boolean" alwaysNotify="true" />

    <!-- The number that is used as how many more seconds until the linear video player will be
    going fullscreen -->
    <field id="fullscreenCountdown" type="integer" />

    <!-- kidsModeFeatureOn will be set based device countryCode -->
    <field id="kidsModeFeatureOn" type="boolean" />

    <!--Is
    KidsMode On-->
    <field id="kidsMode" alias="CategoryGridList.kidsMode" />

    <!-- Indicates if video tiles should be enabled for the current screen -->
    <field id="enableVideoTiles" type="boolean" alias="CategoryGridList.enableVideoTiles" />

    <!-- incoming metadata from GeneralTask
           type is node, so that it takes less time to send data from one file to another file when comparing
    to assocarray. HomeScreen processes this to apply thematic takeover themes before passing to CategoryGridList.
       -->
    <field id="batchResponse" type="node" />

    <!-- incoming response to show/update ads on the homescreen. Currently the array will contain at
    most 1 child/ad campaign.  -->
    <field id="batchAdResponse" type="array" />

    <!-- Ad impression updates are written by the helper to `adImpressionUpdates`.
      The helper assigns a new array value when updates are queued so the screen
      will be notified via the `adImpressionUpdates` field change. No separate
      boolean flag is required. -->

    <!-- This field is used to force remove focus from the rowlist. -->
    <field id="removeFocusFromRowList" type="boolean"
      alias="CategoryGridList.removeFocusFromRowList" />

    <!-- We have to create a field due to renderTracking events being async each itemComponent
    should be aware of what the mode was when it rendered. -->
    <field id="shouldTrackViewableImpressionEvent" type="boolean" value="true"
      alias="CategoryGridList.shouldTrackViewableImpressionEvent" />

    <!-- Will be set to true if we want to reset the grid position back to [0,0] -->
    <field id="resetGridPosition" alias="CategoryGridList.resetGridPosition" />

    <!-- Informs CategoryGridList add more content was appended to the category container during
    lazy loading. -->
    <field id="containerAppendMoreTilesStatus"
      alias="CategoryGridList.containerAppendMoreTilesStatus" />

    <!-- Informs CategoryGridList that more containers were added to screen. -->
    <field id="hasNewContainers" alias="CategoryGridList.hasNewContainers" />

    <!-- Possible values "none", "pending", "complete", "error", "finished". -->
    <!-- difference between complete and finished is that finished indicates current pagination
    request is completed where finished indicates completed loading all pages. -->
    <field id="containerPaginationStatus" type="string" value="none" />

    <!-- OUTPUTS -->
    <!-- Trigger the content to be loaded.  This field is used to delay
           the initial category content loading until after the stateful
           fields have been set (e.g. signedIn) -->
    <field id="loadAllCategories" type="boolean" value="false" alwaysNotify="true" />
    <!-- Same as loadAllCategories but indicates this was triggered via the refresh timer -->
    <field id="loadAllCategoriesViaRefreshTimer" type="boolean" value="false" alwaysNotify="true" />

    <!-- Triggered when the homescreen has lost focus -->
    <field id="focusLost" type="boolean" alwaysNotify="true" />

    <!-- Triggered when the ad has been in focus for awhile and needs to be reported. -->
    <field id="adTimerImpressionFire" type="boolean" value="false" alwaysNotify="true" />

    <field id="oldRowFocusedItem" alias="CategoryGridList.oldRowFocusedItem" />
    <field id="rowCurrFocusColumn" alias="CategoryGridList.rowCurrFocusColumn" />

    <field id="listCurrFocusRow" alias="CategoryGridList.listCurrFocusRow" />

    <field id="listScrollingStatus" alias="CategoryGridList.listScrollingStatus" />
    <field id="listScrollDirection" alias="CategoryGridList.listScrollDirection" />

    <!-- set to the contentNode of the CategoryGridList item which was clicked on -->
    <field id="contentSelected" type="node" />
    <field id="tileSelected" type="boolean" alwaysNotify="true" />

    <!-- set to the contentNode of the CategoryGridList item which was focused when
           the "play" input transport deeplink was triggered
      -->
    <field id="contentToPlay" type="node" />

    <!-- set to the tubi content of the item which was focused on. alwaysNotify is required. Most
    video content is always unique for the same content (b/c of the nature of
    resolveAbbreviatedContent()) so this param is not needed in that case, but the ad content does
    not call resolveAbbreviatedContent() and so is not unique each time it is created so this para
    is needed. -->
    <field id="contentFocused" type="node" alwaysNotify="true" />

    <!-- Boolean signal that fires after contentFocused is updated -->
    <field id="contentFocusedUpdated" type="boolean" alwaysNotify="true" />

    <!-- set to the tubi content of the new row container (row of contentFocused) which was focused
    on -->
    <field id="rowFocused" alias="CategoryGridList.rowFocused" />

    <!-- As the rowlist column changes, even during scrolling, this will get dispatched. During
    scrolling, each new focused column between the start and end scrolled columns will be dispatched
    as they begin to gain partial focus.  -->
    <field id="columnFocused" type="integer" value="-1" />

    <!-- content on the homescreen is loaded and spinner can be turned off -->
    <field id="contentReady" type="boolean" value="false" alwaysNotify="true" />

    <field id="cursorPosition" alias="CategoryGridList.cursorPosition" />

    <field id="currCategoryId" alias="CategoryGridList.currCategoryId" />

    <!-- Communicates that the homescreen has focused on a sponsored container/category/row.
      This may happen when the homescreen/categoryGridList is regaining focus, or it may
      happen when a user navigates through the grid until they focus on a sponsored row.
      Use a boolean instead of the actual node so that any changes to the node don't trigger
      additional callbacks unexpectedly. -->
    <field id="sponsoredRowFocused" type="boolean" alwaysNotify="true" />

    <!-- will be used to change the sponsored background images on the content controller -->
    <field id="sponsorshipBackground" type="string" alwaysNotify="true" />

    <!-- Communicates to the parent that the linear video player should be stopped -->
    <field id="stopLinearVideoPlayer" type="boolean" alwaysNotify="true" />

    <!-- Communicates to the parent that the video preview should be paused -->
    <field id="pauseVideoPreview" type="boolean" alwaysNotify="true" />

    <!-- Communicates to the parent that some of the containers has expired and to be loaded-->
    <field id="loadCategoryForIds" type="array" alwaysNotify="true" />

    <!-- Request to refresh ad impression pixels for ads that have become not visible -->
    <field id="requestAdPixelRefresh" type="boolean" alwaysNotify="true" />

    <!-- Communicates to the parent if the list has focus. -->
    <field id="listHasFocus" alias="CategoryGridList.listHasFocus" />

    <field id="currentFocusedItemBoundingRect"
      alias="CategoryGridList.currentFocusedItemBoundingRect" />
    <field id="inTransitCurrentFocusedItemBoundingRect"
      alias="CategoryGridList.inTransitCurrentFocusedItemBoundingRect" />

    <!-- Communicates to parent what was the last focused list was. -->
    <field id="lastFocusedList" alias="CategoryGridList.lastFocusedList" />

    <!-- Resets focus from PivotList to CategoryGridList (roku_pivots_v1_2 experiment - remove if experiment is not positive) -->
    <field id="focusCategoryGridList" type="boolean" alwaysNotify="true" />

    <field id="rowListTranslation" type="array" alwaysNotify="true" />
    <field id="contentAreaTranslation" type="array" alias="ContentAreaParent.translation" />

    <!-- DATA STORE (Anything defined below are not meant to be used as output or input fields which
    will triggered change events. ) -->
    <field id="personalizationId" type="string" alias="CategoryGridList.personalizationId" />
    <field id="adImpressionUpdates" type="array" />
    <field id="hubLockupAdUpdate" type="assocarray" alwaysNotify="true" />
    <!-- Holds the parsed AdContentNode for the active Sponsored Live Events Hero ad (uses titleImageUrl for brand logo URL) -->
    <field id="sponsoredLiveEventsHeroAdContent" type="node" />

    <!-- PIVOT LIST -->
    <!-- ServerPersistentData for PivotList CmsApi -->
    <field id="pivotServerPersistentData" type="node" alias="pivotList.serverPersistentData" />

    <!-- Controls pivot list visibility and data fetching -->
    <field id="showPivots" alias="pivotList.fetchData" />

    <!-- Selected pivot from the pivot list -->
    <field id="pivotSelected" alias="pivotList.pivotSelected" />

    <!-- Selected pivot content node -->
    <field id="pivotSelectedNode" alias="pivotList.pivotSelectedNode" />

    <!-- Focused pivot position [row, column] -->
    <field id="pivotFocused" alias="pivotList.pivotFocused" />

    <!-- Focused pivot content node -->
    <field id="pivotFocusedNode" alias="pivotList.pivotFocusedNode" />
  </interface>

  <children>
    <Poster
      id="containerBackgroundPoster"
      width="1920"
      height="1080"
      opacity="0.0"
      loadDisplayMode="scaleToFill" />
    <Poster
      id="hubFocusGradient"
      uri="pkg:/images/hub_container_focus_gradient.png"
      width="1920"
      height="1080"
      visible="false" />
    <Poster
      id="hubPeekGradient"
      uri="pkg:/images/hub_container_peek_gradient.png"
      width="1920"
      height="1080"
      visible="false" />
    <Group id="PageGroup">
      <MaskGroup
        id="pivotContentArea"
        translation="[0, 51]"
        maskOffset="[-54, 0]"
        maskUri="pkg:/images/pivot-row-mask-$$RES$$.png">
        <!-- Back button hint -->
        <BackHint
          opacity="0"
          id="backButtonHint" />
        <!-- Translation without back hint is 0 and with back hint is 234 -->
        <PivotList
          translation="[-54, 0]"
          focusXOffset="[54]"
          itemSize="[1920, 60]"
          id="pivotList" />
      </MaskGroup>
      <Group
        id="InfoPanelParent">
        <InfoPanel
          id="InfoPanel"
          maxHeight="387"
          width="960"
          translation="[0,102]"
          maxTitleLines="2" />
      </Group>

      <Group
        id="ContentAreaParent">
        <MaskGroup
          id="ContentArea"
          maskUri="pkg:/images/poster-mask.png"
          maskSize="[0,0]">
          <CategoryGridList
            id="CategoryGridList" />
        </MaskGroup>
      </Group>
    </Group>
    <Group
      id="adContentGroup" />
    <!-- For viewers that watch a REALLY long time, or just never close the app, force a refresh -->
    <Timer
      id="CategoryRefreshTimer"
      repeat="true" />

  </children>
</component>