<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="BaseScreen">


  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="../../lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/ApiUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FIFAMixin.brs" />

  <interface>
    <!-- INPUTS -->

      <!-- When the Helper receives valid category data from the server, it sets the new value to this field. -->
      <field id="content" alias="CategoryGridList.content" />

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" alias="CategoryGridList.contentUpdated" />

      <!-- What kind of content is this homeScreen displaying: movies, tv, normal, espanol etc -->
      <field id="contentMode" alias="CategoryGridList.contentMode" />

      <!-- removes any existing content on the CategoryGridList! -->
      <field id="isLoading" type="boolean" />

      <!-- should the top nav be displayed? -->
      <field id="enableTopNav" type="boolean" />

      <!-- tells the rowList to re-populate the content because rows have been added/removed and that may affect the look of some rows that have different heights compared to other rows  -->
      <field id="repopulateContent" type="boolean" alias="CategoryGridList.repopulateContent" />

      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got added, helps to set focus to correct row -->
      <field id="rowAdded" type="string" alias="CategoryGridList.rowAdded" />

      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got removed, helps to set focus to correct row -->
      <field id="rowRemoved" type="string" alias="CategoryGridList.rowRemoved" />

      <!-- set to true if the user is signed in and we want to change the experience based on that -->
      <field id="signedIn" alias="CategoryGridList.signedIn" />

      <!-- show/hide the category menu -->
      <field id="categoryMenuVisible" type="boolean"/>

      <!-- should the topNav refresh? -->
      <field id="refreshTopNav" type="boolean" alwaysNotify="true" />

      <!-- the id that top nav should treat as selected from a UI perspective -->
      <field id="topNavSelectedId" type="string" alias="topNav.selectedId" />

      <!-- Indicates if that when the server is contacted, it should indicate that the app is in kidsMode. -->
      <field id="shouldKidsModeBeSentToServer" type="boolean" alias="CategoryGridList.shouldKidsModeBeSentToServer"/>

      <!--LinearTV is allowed in topNav if parental control is set to adult.-->
      <field id="isLinearTVAllowedInTopNav" type="boolean"/>

      <field id="animateToCategory" alias="CategoryGridList.animateToCategory" />
      <field id="jumpToRowItemByID" alias="CategoryGridList.jumpToRowItemByID" />
      <field id="jumpToRowItem" alias="CategoryGridList.jumpToRowItem" />

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean"  alwaysNotify="true"/>

      <!-- Acts a circuit breaker in case categories are attempted to be fetched before categories are initially loaded -->
      <field id="canLoadCategories" type="boolean" />

      <!-- Triggers a reset of the ContentArea translation values in the case they were adjusted by VITG -->
      <field id="resetContentAreaValues" type="boolean" alwaysNotify="true" />

      <!-- parentalRating will be set based on global parentalRating updation -->
      <field id="parentalRating" type="integer" value="3"/>

      <!-- The number that is used as how many more seconds until the linear video player will be going fullscreen -->
      <field id="fullscreenCountdown" type="integer"/>

      <!-- kidsModeFeatureOn will be set based device countryCode -->
      <field id="kidsModeFeatureOn" type="boolean" />

      <!-- Used to control which component gains focus when the focusedChild callback runs.
           Accepted values are in constants.ui.homescreen.focusItems -->
      <field id="componentToFocus" type="string" />

      <!-- incoming metadata from GeneralTask
           type is node, so that it takes less time to send data from one file to another file when comparing to assocarray
       -->
      <field id="batchResponse" type="node" alias="CategoryGridList.categoryResponseInBatch" />

    <!-- OUTPUTS -->
      <!-- Trigger the content to be loaded.  This field is used to delay
           the initial category content loading until after the stateful
           fields have been set (e.g. signedIn) -->
      <field id="loadAllCategories" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Communicates an index to use as a starting point for fetch a batch of categories -->
      <field id="loadCategoriesIndex" type="integer" alias="CategoryGridList.loadCategoriesIndex"/>

      <!-- set to the contentNode of the CategoryGridList item which was clicked on -->
      <field id="contentSelected" type="node"/>

      <!-- set to the contentNode of the CategoryGridList item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node"/>

      <!-- set to the content node of the topNav item which was clicked on -->
      <field id="topNavItemSelected" type="node" alwaysNotify="true"/>

      <!-- set to the content node of the first item in the top nav since the back button was pressed -->
      <field id="topNavBackItemSelected" type="node" alwaysNotify="true"/>

      <!-- set to the tubi content of the item which was focused on -->
      <field id="contentFocused" type="node"/>

      <!-- set to the tubi content of the new row container (row of contentFocused) which was focused on -->
      <field id="rowFocused" alias="CategoryGridList.rowFocused"/>

      <!-- As the rowlist column changes, even during scrolling, this will get dispatched. During scrolling, each new focused column between the start and end scrolled columns will be dispatched as they begin to gain partial focus.  -->
      <field id="columnFocused" type="integer" value="-1"/>

      <field id="scrollingstatus" alias="CategoryGridList.scrollingstatus" />

      <!-- content on the homescreen is loaded and spinner can be turned off -->
      <field id="contentReady" type="boolean" value="false" alwaysNotify="true" />

      <field id="cursorPosition" alias="CategoryGridList.cursorPosition" />

      <field id="currCategoryId" alias="CategoryGridList.currCategoryId" />

      <field id="selectedPosition" alias="CategoryGridList.selectedPosition" />

      <!-- Communicates that the homescreen has focused on a sponsored container/category/row.
      This may happen when the homescreen/categoryGridList is regaining focus, or it may
      happen when a user navigates through the grid until they focus on a sponsored row.
      Use a boolean instead of the actual node so that any changes to the node don't trigger
      additional callbacks unexpectedly. -->
      <field id="sponsoredRowFocused" type="boolean" alwaysNotify="true" />

      <!-- will be used to change the sponsored background images on the content controller -->
      <field id="sponsorshipBackground" type="string" alwaysNotify="true" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.
      -->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- Indicates that a ComponentInteractionEvent should be fired because the TopNav
      has been toggled on or off -->
      <field id="topNavToggled" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Indicates that the user is pressing back or left from the top nav (with the assumed
      intention to navigate to the side nav, but homescreen doesn't know about side nav) -->
      <field id="navigatedAwayFromTopNav" type="boolean" alwaysNotify="true" />

      <!-- Communicates to the parent that the linear video player should be stopped -->
      <field id="stopLinearVideoPlayer" type="boolean" alwaysNotify="true" />

      <!-- Communicates to the parent that the video preview should be stopped -->
      <field id="stopVideoPreview" type="boolean" alwaysNotify="true"/>

      <!-- Communicates to the parent that the video preview should be paused -->
      <field id="pauseVideoPreview" type="boolean" alwaysNotify="true"/>

       <!--Communicates to the parent that some of the containers has expired and to be loaded-->
      <field id="loadCategoryForIds" type="array" alwaysNotify="true"/>

  </interface>

  <children>
    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[192,60]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>

    <TopNav
      id="topNav"
      visible="false"
      translation="[192,48]"/>

    <Group
      id="InfoPanelParent">
      <InfoPanel
        id="InfoPanel"
        translation="[192,168]"
        maxHeight="354"
        maxTitleLines="2"/>
    </Group>

    <MaskGroup
      id="ContentArea"
      maskUri="pkg:/images/poster-mask.png"
      maskSize="[0,0]"
      maskOffset="[0,317]"
      translation="[192,561]">
      <CategoryGridList
        id="CategoryGridList"/>
    </MaskGroup>


    <!-- For viewers that watch a REALLY long time, or just never close the app, force a refresh -->
    <Timer
      id="CategoryRefreshTimer"
      repeat="true"/>

    <Animation
      id="Fades">
      <!-- keyValues here are in relation to CategoryGridList.currFocusRow when less than 1.0 -->
      <FloatFieldInterpolator
        id="HintGroupFade"
        fieldToInterp="UpHintGroup.opacity"
        key="[0.0,1.0]"
        keyValue="[1.0,0.0]"/>
      <FloatFieldInterpolator
        id="InfoPanelFade"
        fieldToInterp="InfoPanel.opacity"
        key="[0.0,1.0]"
        keyValue="[0.0,1.0]"/>
    </Animation>
  </children>
</component>
