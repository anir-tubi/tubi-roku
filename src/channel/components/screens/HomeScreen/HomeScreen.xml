<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">


  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="../ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <interface>
    <!-- INPUTS -->
    
      <!-- When the Helper receives valid category data from the server, it sets the new value to this field. -->
      <field id="content" alias="CategoryGridList.content" />

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" alias="CategoryGridList.contentUpdated" />

      <!-- What kind of content is this homeScreen displaying: movies, tv, normal, espanol etc -->
      <field id="contentMode" alias="CategoryGridList.contentMode" />
      
      <!-- hides or shows the loading spinner and removes any existing content on the CategoryGridList! -->
      <field id="isLoading" type="boolean" />

      <!-- should the top nav be displayed? -->
      <field id="enableTopNav" type="boolean"/>

      <!-- tells the rowList to re-populate the content because rows have been added/removed and that may affect the look of some rows that have different heights compared to other rows  -->
      <field id="repopulateContent" type="boolean" alias="CategoryGridList.repopulateContent" />
      
      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got added, helps to set focus to correct row -->
      <field id="rowAdded" type="string" alias="CategoryGridList.rowAdded" />
      
      <!-- expected to be category ids(continue_waching/queue) if new continue_waching/queue got removed, helps to set focus to correct row -->
      <field id="rowRemoved" type="string" alias="CategoryGridList.rowRemoved" />

      <!-- set to true if the user is signed in and we want to change the experience based on that -->
      <field id="signedIn" type="boolean" value="false" />

      <!-- show/hide the category menu -->
      <field id="categoryMenuVisible" type="boolean"/>

      <!-- Indicates if that when the server is contacted, it should indcate that the app is in kidsMode. -->
      <field id="shouldKidsModeBeSentToServer" type="boolean" alias="CategoryGridList.shouldKidsModeBeSentToServer"/>

      <field id="animateToCategory" alias="CategoryGridList.animateToCategory" />
      <field id="jumpToRowItemByID" alias="CategoryGridList.jumpToRowItemByID" />
      <field id="jumpToRowItem" alias="CategoryGridList.jumpToRowItem" />

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean"  alwaysNotify="true"/>

      <!-- Acts a circuit breaker in case categories are attempted to be fetched before categories are initially loaded -->
      <field id="canLoadCategories" type="boolean" />

      <!-- Triggers a reset of the ContentArea translation values in the case they were adjusted by VITG -->
      <field id="resetContentAreaValues" type="boolean" alwaysNotify="true" />

      <!-- shouldFocusWhenPushed will be set true once animation logo is finished during app launch -->
      <field id="shouldFocusWhenPushed" type="boolean" value="true"/>
      
      <!-- parentalRating will be set based on global parentalRating updation -->
      <field id="parentalRating" type="integer" value="3"/>

      <!-- The number that is used as how many more seconds until the linear video player will be going fullscreen -->
      <field id="fullscreenCountdown" type="integer"/>
      
      <!-- kidsModeFeatureOn will be set based device countryCode -->
      <field id="kidsModeFeatureOn" type="boolean" />    

      <!-- The outside world telling the screen to focus onto the top nav -->
      <field id="focusOnTopNav" type="boolean" alwaysNotify="true"/>

    <!-- OUTPUTS -->
      <!-- will be used to change the background images on the content controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true"/>

      <!-- Trigger the content to be loaded.  This field is used to delay
           the initial category content loading until after the stateful
           fields have been set (e.g. signedIn) -->
      <field id="loadAllCategories" type="boolean" value="false" alwaysNotify="true"/>

      <!-- set to the tubi content id of the CategoryGridList item which was clicked on -->
      <field id="contentSelected" type="node"/>

      <!-- set to the tubi content id of the topNav item which was clicked on -->
      <field id="topNavItemSelected" type="node" alwaysNotify="true"/>

      <!-- set to the tubi content of the item which was focused on -->
      <field id="contentFocused" type="node"/>

      <!-- content on the homescreen is loaded and spinner can be turned off -->
      <field id="contentReady" type="boolean" alwaysNotify="true" />

      <field id="cursorPosition" alias="CategoryGridList.cursorPosition" />

      <field id="currCategoryId" alias="CategoryGridList.currCategoryId" />

      <field id="selectedPosition" alias="CategoryGridList.selectedPosition" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.
      -->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be observed by the Homescreen, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <!-- stores the component info of the component that was selected when navigating to a new screen. Looks like:
        {
          componentType: "category_component"    ' Corresponds to one of the page types in
                                                 ' tubiTracking_getAnalyticsComponent() 
                                                 ' which mirrors the protos repo.
          componentValues: {}                    ' An assoc array with key/values that match the componentType
                                                 ' as found in tubiTracking_getAnalyticsComponent().
        }
      -->
      <field id="trackingComponentInfo" type="assocarray" />

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           vaule is pushed to the stack.
       -->
      <field id="screenLevel" type="integer"/>

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />

      <!-- Is the screen focused on the top nav? -->
      <field id="topNavHasFocus" type="boolean" value="false" />
  </interface>

  <children>

    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[168,55]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>

    <TopNav id="topNav"
      visible="false"
      translation="[168,48]"/>

    <InfoPanel
      id="InfoPanel"
      translation="[168,133]"
      maxHeight="355"
      maxTitleLines="2"
      visible="true"/>

    <MaskGroup
      id="ContentArea"
      maskUri="pkg:/images/poster-mask.png"
      maskSize="[0,0]"
      maskOffset="[0,317]"
      translation="[168,592]">
      <CategoryGridList
        id="CategoryGridList"/>
    </MaskGroup>

    <!-- For viewers that watch a REALLY long time, or just never close the app, force a refresh -->
    <Timer
      id="CategoryRefreshTimer"
      repeat="true"/>
      
    <Animation
      id="Fades">
      <!-- keyValues here are in relation to CategorGridList.currFocusRow when less than 1.0 -->
      <FloatFieldInterpolator
        id="HintGroupFade"
        fieldToInterp="UpHintGroup.opacity"
        key="[0.0,1.0]"
        keyValue="[1.0,0.0]"/>
      <FloatFieldInterpolator
        id="InfoPanelFade"
        fieldToInterp="InfoPanel.opacity"
        key="[0.0,1.0]"
        keyValue="[0.0,1.0]"/>
    </Animation>
  </children>
</component>
