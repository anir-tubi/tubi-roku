<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Age verification screen allows user to enter a birthdate to confirm their age.
 - Age calculation and confirmation happens on the backend and is handled by
 - AgeVerificationHelpers.brs
 -->
<component name="SignUpAgeVerificationScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SignUpAgeVerificationScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />

  <interface>

    <!-- INPUT -->

    <!-- signInInfo field possible values are below
      signInInfo will have below keys when user signs up
      eg.
        {
          email : "test@tubi.tv",
          firstName : "test",
          emailType : "manual/pre_fill"
        )
        -->
      <field id="signInInfo" type="assocarray"/>

    <!-- OUTPUT -->

      <!-- event that occurs when a user selects the Start Watching button -->
      <field id="ageSubmitted" type="boolean" alwaysNotify="true" />

      <!-- event that occurs when a user selects the back button -->
      <field id="backButtonPressed" type="boolean" alwaysNotify="true" />

      <!-- the birthdate that the user has submitted. Should be in the form "YYYY-MM-DD" -->
      <field id="birthdate" type="string" />

  </interface>

  <children>
    <Group
      id="AgeVerificationPageText">
      <Label
        id="AgeVerificationPageHeader"
        horizAlign="left"
        width="1668"
        translation="[126,204]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>
      <Label
        id="AgeVerificationPageSubHeader"
        horizAlign="left"
        width="1668"
        translation="[126,300]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="33" />
      </Label>
    </Group>
    <Group
      id="AgeVerificationNumberPadGroup"
      translation="[126,375]">
      <NumberPad
        id="AgeVerificationNumberPad"
        />
      <SimpleButton
        translation="[0,434]"
        id="AgeVerificationStartButton"
        width="489"/>
    </Group>

    <Group
      id="AgeVerificationDateInfo"
      visible="false"
      translation="[890,496]">
      <LayoutGroup
        layoutDirection="horiz"
        itemSpacings="[12]">

          <Label
            id="AgeVerificationYearText"
            width="426"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="0.4"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="70"/>
          </Label>

        <Rectangle width="300">
          <Poster
            id="AgeVerificationYearBg"
            uri="pkg:/images/menu-focus-fhd.9.png"
            width="300"
            height="144"
            opacity="1.0"/>
          <Label
            id="AgeVerificationYearEntry"
            width="300"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="1.0"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="84"/>
          </Label>
          <Label
            id="AgeVerificationYear"
            width="300"
            horizAlign="center"
            opacity="0.4"
            translation="[0,168]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="33"/>
          </Label>
        </Rectangle>
      </LayoutGroup>
    </Group>

    <Group
      id="AgeVerificationAgeInfo"
      translation="[890,496]">
      <LayoutGroup
        layoutDirection="horiz"
        itemSpacings="[24]">

        <Label
          id="AgeVerificationAgePrefixLabel"
          height="144"
          vertAlign="center"
          opacity="0.4">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="70"/>
        </Label>

        <Poster
          id="AgeVerificationAgeBg"
          uri="pkg:/images/menu-focus-fhd.9.png"
          width="198"
          height="144">
          <Label
            id="AgeVerificationAgeEntry"
            width="198"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="1.0"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="84"/>
          </Label>
        </Poster>

        <Label
          id="AgeVerificationAgePostfixLabel"
          height="144"
          vertAlign="center"
          opacity="0.4">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="70" />
        </Label>
      </LayoutGroup>
    </Group>

    <Label
      id="AgeVerificationErrorPrompt"
      translation="[626,804]"
      width="1000"
      horizAlign="right"
      visible="false">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27" />
    </Label>
    <SimpleLabel
      id="AgeErrorPrompt"
      fontUri="pkg:/fonts/Vaud-Medium.ttf"
      fontSize="27"
      horizOrigin="center"
      translation="[1107, 663]"
      visible="false" />
    <SimpleLabel
      id="AgeWarningPrompt"
      fontUri="pkg:/fonts/Vaud-Medium.ttf"
      fontSize="27"
      horizOrigin="center"
      translation="[1227, 663]"
      visible="false" />
    <Label
      id="AgeVerificationInfoLabel"
      translation="[126,948]"
      numLines="2"
      wrap="true"
      width="1710"
      vertAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="25" />
    </Label>
  </children>
</component>
