<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInScreen
 -->
<component name="SignInScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SignInScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->

      <!-- roku account's email address  -->
      <field id="username" type="string" alias="email.text"/>

      <!-- set focus on keyboard; setFocusToPassword will be triggered when user selects back/re-enter password from Invalid Password modal -->
      <field id="setFocusToKeyboard" type="boolean" alwaysNotify="true"/>

      <!-- et focus back on password textfield  -->
      <field id="setFocusToPassword" type="boolean" alwaysNotify="true"/>

      <!-- A record of the user's signin info: i.e. email, firstname, gender, etc. -->
      <field id="signInInfo" type="assocarray"/>

    <!-- OUTPUT -->

      <!-- signInSelected is set to true when user selects signIn button, which redirects to Home Screen / Detail Screen -->
      <field id="signInSelected" type="assocarray"/>

      <!-- emailSelected is triggered when user selects email text box, which redirects to EmailEntry screen to enter different email -->
      <field id="emailSelected" type="boolean" alias="email.selected"/>

      <!-- forgotPasswordSelected is triggered when user selects the ForgotPassword button. -->
      <field id="forgotPasswordSelected" type="boolean" alwaysNotify="true"/>

  </interface>

  <children>

    <LayoutGroup
      id="signUpLayout"
      translation="[960, 117]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="center"
      itemSpacings="[21, 45, 18, 18, 33]">
      <Label
        id="pageHeading"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Label
        id="pageSubHeading"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="30"/>
      </Label>

      <TextEntryBox
        id="email"
        boxWidth="600"
        boxHeight="84"/>

      <TextEntryBox
        id="password"
        boxWidth="600"
        boxHeight="84"
        passwordMode="true"/>

      <Label
        id="passwordValidationMsg"
        width="600">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>


      <LayoutGroup
        id="buttonsGroup"
        layoutDirection="vert"
        vertAlignment="custom"
        horizAlignment="center"
        itemSpacings="[90, 130]">

        <SimpleButton
          id="continueBtn"
          width="408"/>

        <LayoutGroup
          id="newPasswordLayout"
          layoutDirection="horiz"
          horizAlignment="center"
          vertAlignment="center"
          itemSpacings="[12]">

          <Label
            id="newPasswordLabel">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>

          <Label
            id="newPasswordLink">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>

        </LayoutGroup>

        <ButtonGroup
          id="staticPageLinkGroup"
          layoutDirection="horiz"
          horizAlignment="center"
          vertAlignment="custom"
          itemSpacings="[96]">

          <SimpleButton
            id="termsBtn"
            unfocusedBackgroundOpacity="0"/>

          <SimpleButton
            id="ppBtn"
            unfocusedBackgroundOpacity="0"/>

          <SimpleButton
            id="YourPrivacyChoicesButton"
            unfocusedBackgroundOpacity="0"/>

        </ButtonGroup>

      </LayoutGroup>

    </LayoutGroup>

    <PasswordEntryKeyboard
      id="passwordEntryKeyboard"
      shouldMuteAudioGuideWhenFocused="true"
      translation="[0,1080]"/>

  </children>
</component>
