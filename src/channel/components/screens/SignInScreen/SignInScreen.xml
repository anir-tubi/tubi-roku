<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInScreen
 -->
<component name="SignInScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SignInScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <interface>
    <!-- INPUT -->
    
      <!-- roku account's email address  -->      
      <field id="username" type="string" alias="email.text"/>
      
      <!-- resetFocus will be triggered when user selects back/re-enter password from Invalid Password modal  -->
      <field id="resetFocus" type="boolean" alwaysNotify="true"/>

    <!-- OUTPUT -->
    
      <!-- signInSelected is set to true when user selects signIn button, which redirects to Home Screen / Detail Screen -->
      <field id="signInSelected" type="assocarray"/>
      
      <!-- staticPageSelected is triggered when user selects ToS/PP/DoNotSell button, which redirects to Settings Page -->
      <field id="staticPageSelected" type="String" alwaysNotify="true"/>

      <!-- emailSelected is triggered when user selects email text box, which redirects to EmailEntry screen to enter different email -->
      <field id="emailSelected" type="boolean" alias="email.selected"/>
      
  </interface>

  <children>

    <LayoutGroup 
      id="signUpLayout"
      translation="[0, 140]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="custom"
      itemSpacings="[20, 45, 17, 17, 20, 90, 130]">
      <Label
        id="pageHeading"
        color="0xFFFFFF"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Label
        id="pageSubHeading"
        color="0xFFFFFF"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="30" />
      </Label>  

      <TextEntryBox
        id="email"
        boxWidth="600"
        boxHeight="84"
        translation="[643,0]"/>

      <TextEntryBox
        id="password"
        boxWidth="600"
        boxHeight="84"
        translation="[643,0]"
        passwordMode="true"/>
        
      <Label
        id="passwordValidationMsg"
        translation="[670,0]"
        color="0xEB9C00"
        width="600">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>
      
      <SimpleButton
        translation="[756,0]"
        id="continueBtn"
        color="0x9699A3"
        width="408"/>
      
      <LayoutGroup 
        id="existingAccLayout"
        layoutDirection="horiz"
        horizAlignment="center"
        vertAlignment="center"
        translation="[960,0]"
        itemSpacings="[12]">
        
        <Label
          id="newPasswordLabel"
          color="#FFFFFF">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
        
        <Label
          id="newPasswordLink"
          color="#FFFFFF">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
        
      </LayoutGroup>
      
      <ButtonGroup 
        id="staticPageLinkGroup"
        layoutDirection="horiz"
        horizAlignment="center"
        translation="[960,0]"
        vertAlignment="custom"
        itemSpacings="[96]">

        <SimpleButton
          id="termsBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>
          
        <SimpleButton
          id="ppBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>
          
        <SimpleButton
          id="donotsellMyInfoBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>            
        
      </ButtonGroup>                    

    </LayoutGroup>

    <Group 
      id="keyboardGrp" 
      translation="[0,1080]">

      <Rectangle
        id="keyboardBackground"
        color="0x10141F"
        opacity="1.0"
        width="1920"
        height="600"/>

      <LayoutGroup 
        layoutDirection="vert"
        horizAlignment="custom"
        vertAlignment="custom"
        translation="[250, 20]"
        itemSpacings="[20]">

        <Keyboard 
          id="Keyboard"/>

            <ButtonGroup 
              id="buttonGroup"
              layoutDirection="horiz"
              itemSpacings="[35]"
              translation="[12,0]">

              <SimpleButton
                id="back"
                color="0xF0F1F5"
                width="180"/>

              <SimpleButton
                id="continue"
                color="0xF0F1F5"
                width="633"/>

              <SimpleButton
                id="showHidePassword"
                color="0xF0F1F5"
                width="490"/>

            </ButtonGroup>

      </LayoutGroup>

    </Group>

  </children>
</component>
