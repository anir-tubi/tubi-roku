<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInScreen
 -->
<component name="SignInScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SignInScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../ModalDialogs.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <interface>
    <!-- INPUT -->
    
      <!-- roku account's email address  -->      
      <field id="username" type="string" alias="email.text"/>
      
      <!-- resetFocus will be triggered when user selects back/re-enter password from Invalid Password modal  -->
      <field id="resetFocus" type="boolean" alwaysNotify="true"/>

    <!-- OUTPUT -->
    
      <!-- signInSelected is set to true when user selects signIn button, which redirects to Home Screen / Detail Screen -->
      <field id="signInSelected" type="assocarray"/>
      
      <!-- staticPageSelected is triggered when user selects ToS/PP/DoNotSell button, which redirects to Settings Page -->
      <field id="staticPageSelected" type="String" alwaysNotify="true"/>
      
  </interface>

  <children>
  
    <LayoutGroup 
      id="signUpLayout"
      translation="[0, 170]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="custom"
      itemSpacings="[75, 17, 17, 20, 90, 130]">
      <Label
        id="pageHeading"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>
      
      <Group 
        translation="[645,0]">
        <Rectangle
          id="emailBackground"
          width="630"
          height="84"
          opacity="0.17"
          color="0x9699A3"/>
        <Label
          id="email"
          horizAlign="left"
          width="600"
          height="84"
          translation="[20,0]"
          vertAlign="center">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
      </Group>

      <LayoutGroup
        id="passwordGroup"
        translation="[643,0]"
        layoutDirection="horiz"
        horizAlignment="custom"
        itemSpacings="[15]">
        <TextEntryBox
          id="password"
          boxWidth="629"
          boxHeight="84"
          passwordMode="true"/>
      </LayoutGroup>
        
      <Label
        id="passwordValidationMsg"
        translation="[670,0]"
        color="0xEB9C00"
        width="600">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="24" />
      </Label>
      
      <SimpleButton
        translation="[756,0]"
        id="continueBtn"
        color="0x9699A3"
        width="408"/>
      
      <LayoutGroup 
        id="existingAccLayout"
        layoutDirection="horiz"
        horizAlignment="center"
        vertAlignment="center"
        translation="[960,0]"
        itemSpacings="[12]">
        
        <Label
          id="existingAccLabel">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="24" />
        </Label>
        
        <Label
          id="forgotPasswordLink">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="24" />
        </Label>
        
      </LayoutGroup>
      
      <ButtonGroup 
        id="staticPageLinkGroup"
        layoutDirection="horiz"
        horizAlignment="center"
        translation="[960,0]"
        vertAlignment="custom"
        itemSpacings="[96]">

        <SimpleButton
          id="termsBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>
          
        <SimpleButton
          id="ppBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>
          
        <SimpleButton
          id="donotsellMyInfoBtn"
          color="0x10141F"
          unfocusedBackgroundOpacity="0"/>            
        
      </ButtonGroup>                    
    
    </LayoutGroup>
    
    <Group 
      id="keyboardGrp" 
      translation="[0,1080]">
    
      <Rectangle
        id="keyboardBackground"
        color="0x10141F"
        opacity="1.0"
        width="1920"
        height="600"/>
    
      <LayoutGroup 
        layoutDirection="vert"
        horizAlignment="custom"
        vertAlignment="custom"
        translation="[250, 20]"
        itemSpacings="[20]">
        
        <Keyboard 
          id="Keyboard"/>
          
            <ButtonGroup 
              id="buttonGroup"
              layoutDirection="horiz"
              itemSpacings="[35]"
              translation="[12,0]">

              <SimpleButton
                id="back"
                color="0xF0F1F5"
                width="180"/>
        
              <SimpleButton
                id="continue"
                color="0xF0F1F5"
                width="633"/>
              
              <SimpleButton
                id="showHidePassword"
                color="0xF0F1F5"
                width="490"/>
            
            </ButtonGroup>
        
      </LayoutGroup>
      
    </Group>
  
  </children>
</component>
