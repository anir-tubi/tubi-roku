<?xml version="1.0" encoding="utf-8" ?>
<!--
 - EmailInputScreen
 -->
<component name="EmailInputScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="EmailInputScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TimeUtils.brs" />

  <interface>

    <!-- INPUT -->
      <!-- when set to false, a message indicating that the user should enter a valid email appears -->
      <field id="isEmailValid" type="boolean" value="true" />

    <!-- OUTPUT -->

      <!-- continueSelected is triggered when user selects continue button, which checks email exists in database -->
      <field id="continueSelected" type="boolean" alwaysNotify="true" />

      <!-- email field will have user entered email and it will be set when user selects continue button -->
      <field id="email" type="string" />

      <!-- backButtonSelected is triggered when user selects back button on keyboard-->
      <field id="backButtonSelected" type="integer" alias="back.selected"/>

  </interface>

  <children>

    <Poster
      id="backButtonPoster"
      uri="pkg:/images/back_button.png"
      translation="[126,60]"
      width="170"
      height="72"/>
    <LayoutGroup
      id="emailLayout"
      translation="[0, 290]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="custom"
      itemSpacings="[30, 40, 10]">
      <Label
        id="pageHeading"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Group
        translation="[645,0]">
        <TextEditBox
          id="emailTextEditBox"
          width="630"
          height="84" />
      </Group>

      <Label
        id="emailValidationMsg"
        translation="[670,-5]"
        opacity="0.0"
        width="600">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="27" />
      </Label>

    </LayoutGroup>

    <Group
      id="keyboardGrp"
      translation="[0,470]">

      <LayoutGroup
        layoutDirection="vert"
        horizAlignment="custom"
        vertAlignment="custom"
        translation="[250, 20]"
        itemSpacings="[20]">

        <DynamicKeyboard
          id="Keyboard"/>

            <ButtonGroup
              id="buttonGroup"
              layoutDirection="horiz"
              itemSpacings="[39]"
              translation="[2,0]">

              <SimpleButton
                id="back"
                width="177"/>

              <SimpleButton
                id="continue"
                width="1149"/>

            </ButtonGroup>

      </LayoutGroup>

    </Group>

  </children>
</component>
