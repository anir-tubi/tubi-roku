<?xml version="1.0" encoding="utf-8" ?>
<!--
 - EmailInputScreen
 -->
<component name="EmailInputScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="EmailInputScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />

  <interface>

    <!-- OUTPUT -->

      <!-- continueSelected is triggered when user selects continue button, which checks email exists in database -->
      <field id="continueSelected" type="boolean" alwaysNotify="true"/>

      <!-- email field will have user entered email and it will be set when user selects continue button -->
      <field id="email" type="String"/>

     <!-- backButtonSelected is triggered when user selects back button on keyboard-->
      <field id="backButtonSelected" type="integer" alias="back.selected"/>

  </interface>

  <children>

    <LayoutGroup
      id="emailLayout"
      translation="[0, 290]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="custom"
      itemSpacings="[30, 40, 10]">
      <Label
        id="pageHeading"
        color="0xFFFFFF"
        horizAlign="center"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Group
        translation="[645,0]">
        <Rectangle
          id="emailBackground"
          width="630"
          height="84"
          opacity="0.17"
          color="0x9699A3"/>
        <Label
          id="email"
          color="0xFFFFFF"
          horizAlign="left"
          width="600"
          height="84"
          translation="[20,0]"
          vertAlign="center">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
      </Group>

      <Label
        id="emailValidationMsg"
        translation="[670,-5]"
        opacity="0.0"
        color="0xEB9C00"
        width="600">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="27" />
      </Label>

    </LayoutGroup>

    <Group
      id="keyboardGrp"
      translation="[0,550]">

      <Rectangle
        id="keyboardBackground"
        color="0x10141F"
        width="1920"
        height="600"/>

      <LayoutGroup
        layoutDirection="vert"
        horizAlignment="custom"
        vertAlignment="custom"
        translation="[250, 20]"
        itemSpacings="[20]">

        <Keyboard
          id="Keyboard"/>

            <ButtonGroup
              id="buttonGroup"
              layoutDirection="horiz"
              itemSpacings="[35]"
              translation="[12,0]">

              <SimpleButton
                id="back"
                color="0xF0F1F5"
                width="180"/>

              <SimpleButton
                id="continue"
                color="0xF0F1F5"
                width="1155"/>

            </ButtonGroup>

      </LayoutGroup>

    </Group>

  </children>
</component>
