          <Font
            role="font" />
        </Label>
        <Label
          id="AllEmptyUISubtitle"
          width="1536"
          maxLines="1"
          horizAlign="center"
          vertAlign="bottom">
          <Font
            role="font" />
        </Label>
        <Label
          id="AllEmptyUISubtitle2"
          width="1536"
          maxLines="3"
          wrap="true"
          horizAlign="center"
