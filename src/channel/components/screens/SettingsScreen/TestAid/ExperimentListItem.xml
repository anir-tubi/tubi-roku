<?xml version="1.0" encoding="utf-8"?>
<component name="ExperimentListItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="ExperimentListItem.brs" />

  <interface>
    <field id="itemContent" type="node" />
    <field id="itemHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="width" type="float" />
    <field id="height" type="float" alias="background.height" />
    <field id="gridHasFocus" type="boolean" />
  </interface>

  <children>
    <Rectangle
      id="background"
      color="0xFFFF00FF"
      opacity="0">
    </Rectangle>

    <LayoutGroup
      id="textContainer"
      translation="[20, 0]"
      layoutDirection="vert"
      itemSpacings="[4]">

      <Group>
        <Label
          id="label"
          text=""
          horizAlign="left">
        </Label>
        <ScrollingLabel
          id="labelFocused"
          text=""
          horizAlign="left"
          repeatCount="0"
          opacity="0">
          <Font
            role="font" />
        </ScrollingLabel>
      </Group>

      <Group>
        <Label
          id="subtitle"
          text=""
          horizAlign="left">
        </Label>
        <Label
          id="subtitleFocused"
          text=""
          horizAlign="left"
          opacity="0">
        </Label>
      </Group>

    </LayoutGroup>
  </children>
</component>