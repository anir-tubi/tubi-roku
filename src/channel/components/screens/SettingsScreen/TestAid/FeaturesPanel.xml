<?xml version="1.0" encoding="utf-8"?>
<component name="FeaturesPanel" extends="ListPanel">
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="FeaturesPanel.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="experimentsData" type="assocarray" alwaysNotify="true" />

    <!-- OUTPUTS -->
    <field id="closePanel" type="boolean" alwaysNotify="true" />
    <field id="experimentGroupSelected" type="assocarray" alwaysNotify="true" />

    <!-- Aliases for grid interaction -->
    <field id="content" alias="ExperimentsGrid.content" />
    <field id="itemSelected" alias="ExperimentsGrid.itemSelected" />
    <field id="itemFocused" alias="ExperimentsGrid.itemFocused" />
  </interface>

  <children>
    <Group
      id="ContentGroup"
      translation="[40,0]">
      <MarkupGrid
        id="ExperimentsGrid"
        translation="[0,20]"
        drawFocusFeedbackOnTop="false"
        fadeFocusFeedbackWhenAutoScrolling="true"
        numRows="8"
        numColumns="1"
        itemSize="[450,70]"
        itemSpacing="[0,24]"
        itemComponentName="ExperimentListItem"
        vertFocusAnimationStyle="fixedFocus">
      </MarkupGrid>
    </Group>
  </children>
</component>