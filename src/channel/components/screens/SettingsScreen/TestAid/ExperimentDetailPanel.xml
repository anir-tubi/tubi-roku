<?xml version="1.0" encoding="utf-8"?>
<component name="ExperimentDetailPanel" extends="ListPanel">
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigLib.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StatsigExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/StatsigExperimentMixin.brs" />
  <script type="text/brightscript" uri="ExperimentDetailPanel.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="experimentData" type="assocarray" alwaysNotify="true" />

    <!-- OUTPUTS -->
    <field id="closePanel" type="boolean" alwaysNotify="true" />
    <field id="groupSelected" type="assocarray" alwaysNotify="true" />
  </interface>

  <children>
    <Group
      id="contentGroup"
      translation="[40,0]">
      <Label
        id="experimentTitle"
        width="400"
        height="60"
        horizAlign="left"
        vertAlign="center">
        <Font
          role="font" />
      </Label>
      <Label
        id="variantsLabel"
        text="Variants:"
        translation="[0,60]"
        width="400"
        height="40"
        horizAlign="left"
        vertAlign="center">
        <Font
          role="font" />
      </Label>
      <MarkupGrid
        id="groupsGrid"
        translation="[0,100]"
        drawFocusFeedbackOnTop="false"
        fadeFocusFeedbackWhenAutoScrolling="true"
        numRows="8"
        numColumns="1"
        itemSize="[400,56]"
        itemSpacing="[0,4]"
        itemComponentName="GroupDetailItem"
        vertFocusAnimationStyle="fixedFocus">
      </MarkupGrid>
    </Group>
  </children>
</component>