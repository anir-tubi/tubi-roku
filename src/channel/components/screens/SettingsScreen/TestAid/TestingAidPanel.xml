<?xml version="1.0" encoding="utf-8" ?>
<component name="TestingAidPanel" extends="Panel" >
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="TestingAidPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/DevGridOverlay.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />

  <interface>
    <!-- INPUTS -->
      <field id="offset" alias="Offset.translation"/>
      <field id="isLoading" type="boolean"/>


    <!-- OUTPUTS -->
      <field id="appRestartRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Group
      id="Offset">

      <Group
        id="ContentGroup">
        <Label
          id="Title"
          text="Testing Aid Config"
          height="73"
          vertAlign="bottom">
          <Font
            role="font"/>
        </Label>

        <MarkupList
          id="testingAidMenu"
          numRows="12"
          itemSize="[560,80]"
          itemSpacing="[0,8]"
          itemComponentName="CheckButton"
          vertFocusAnimationStyle="floatingFocus"
          translation="[0,141]">
          <ContentNode
            id="SettingsMenuContent"
            role="content">
            <CheckButtonContentNode
              id="viewRegistry"
              title="View Registry"/>
            <CheckButtonContentNode
              id="clearRegistry"
              title="Clear Registry"/>
            <CheckButtonContentNode
              id="showEnabledExp"
              title="Show Current Experiments"/>
            <CheckButtonContentNode
              id="safeZone"
              title="Show/Hide Safe Zone Image"/>
            <CheckButtonContentNode
              id="overlay"
              title="Show/Hide Grid Overlay"/>
            <CheckButtonContentNode
              id="addProxy"
              title="Add/Remove Proxy"/>
          </ContentNode>
        </MarkupList>

        <Label
          id="infoArea"
          translation="[700,130]"
          numLines="10"
          width="450"
          truncateOnDelimiter="."
          wrap="true"
          height="1000">
          <Font
            role="font"/>
        </Label>
      </Group>

      <Spinner
        id="Spinner"
        visible="false"
        height="717"
        width="1034"
        translation="[0,0]"/>
    </Group>
  </children>
</component>
