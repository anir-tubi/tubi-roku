<?xml version="1.0" encoding="utf-8" ?> 
<component name="SettingsScreen" extends="Group" >
  <script type="text/brightscript" uri="SettingsScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />

  <interface>
    <!-- INPUTS -->

      <field id="parentalSettingUpdated" type="boolean" alwaysNotify="true"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean"  alwaysNotify="true"/>
      
      <!-- The outside can request an item to be selected. The ID of the button. -->
      <field id="itemRequested" type="string" alwaysNotify="true"/>
      <!-- associative array that will indocate if the user is signed in and if so, the aa will contain their info.  -->
      <field id="signInInfo" type="assocarray" alwaysNotify="true" />

      <!-- activationCompleted is accessed from SignInhelper once the activation is successful -->
      <field id="activationCompleted" type="boolean" value="false"/>
      
      <!-- actionAfterActivation value will be set when user tried any action before signIn/activation  
          this helps to do callback once the activation is completed
      -->
      <field id="actionAfterActivation" type="string"/>

    <!-- OUTPUTS -->
      <!-- triggers for upstream controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />
      
      <field id="showDeviceModal" type="boolean" alwaysNotify="true" />

      <field id="backButtonPressed" type="boolean" alwaysNotify="true"/>
      <field id="signOutSelected" type="boolean" alwaysNotify="true"/>
      <field id="signInSelected" type="boolean" alwaysNotify="true"/>
      <field id="parentalSettingSelected" type="integer" alwaysNotify="true"/>

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- Holds the information needed to populate a navigate_witin_page event. be passed to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           vaule is pushed to the stack.
       -->
      <field id="screenLevel" type="integer" />

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />
  </interface>

  <children>

    <Label 
      id="Title"
      height="73"
      translation="[168,230]">
      <Font
       role="font"
       uri="pkg:/fonts/Vaud-SemiBold.ttf"
       size="67" />
    </Label>


    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[168,55]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>

    <Poster
      id="leftChevron"
      uri="pkg:/images/left-chevron.png"
      width="15"
      height="27"
      translation="[85,496]"/>

    <PanelSet
      id="PanelSet"
      width="1920"
      height="550"
      translation="[148,414]"/>
  </children>
</component>
