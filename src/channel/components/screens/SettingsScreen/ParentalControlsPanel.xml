<?xml version="1.0" encoding="utf-8" ?>
<component name="ParentalControlsPanel" extends="Panel" >
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="ParentalControlsPanel.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- make a particular setting "checked" and focused -->
      <field id="selectItem" type="integer" alwaysNotify="true"/>
      <field id="offset" alias="Offset.translation"/>
      <field id="isLoading" type="boolean"/>


    <!-- OUTPUTS -->
      <field id="itemSelected" alias="ParentalControlsMenu.itemSelected" alwaysNotify="true"/>
      <field id="audioGuideText" type="string" alwaysNotify="true"/>
  </interface>

  <children>
    <Group
      id="Offset">

    <Group
      id="ContentGroup">
      <Label
        id="Title"
        height="73"
        vertAlign="bottom"
        translation="[25,0]">
        <Font
         role="font"
         uri="pkg:/fonts/Vaud-SemiBold.ttf"
         size="43" />
      </Label>

      <Label
        id="Instructions"
        width="890"
        wrap="true"
        vertAlign="bottom"
        translation="[25,143]">
        <Font
         role="font"
         uri="pkg:/fonts/Vaud-SemiBold.ttf"
         size="27" />
      </Label>

      <MarkupList
        id="ParentalControlsMenu"
        numRows="12"
        itemSize="[560,80]"
        itemSpacing="[0,8]"
        itemComponentName="CheckButton"
        vertFocusAnimationStyle="floatingFocus"
        translation="[25,347]">
        <ContentNode
          id="SettingsMenuContent"
          role="content">
          <CheckButtonContentNode
            id="LittleKids"/>
          <CheckButtonContentNode
            id="OlderKids"/>
          <CheckButtonContentNode
            id="Teens"/>
          <CheckButtonContentNode
            id="Adults"/>
        </ContentNode>
      </MarkupList>
    </Group>

    <Spinner
      id="Spinner"
      visible="false"
      height="717"
      width="1034"
      translation="[0,0]"/>
    </Group>
  </children>
</component>
