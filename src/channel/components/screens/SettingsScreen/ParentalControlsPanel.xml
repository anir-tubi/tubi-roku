<?xml version="1.0" encoding="utf-8" ?>
<component name="ParentalControlsPanel" extends="Panel" >
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="ParentalControlsPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs" />


  <interface>
    <!-- INPUTS -->
      <!-- make a particular setting "checked" and focused -->
      <field id="selectItem" type="integer" alwaysNotify="true"/>
      <field id="offset" alias="Offset.translation"/>
      <field id="isLoading" type="boolean"/>


    <!-- OUTPUTS -->
      <field id="itemSelected" type="integer" alwaysNotify="true"/>
      <field id="audioGuideText" type="string" alwaysNotify="true"/>
  </interface>

  <children>
    <Group
      id="Offset">

    <LayoutGroup
      id="ContentGroup"
      layoutDirection="vert"
      itemSpacings="[45]">
      <Label
        id="Title"
        height="73"
        vertAlign="bottom">
        <Font
         role="font"/>
      </Label>

      <Label
        id="Instructions"
        width="1002"
        wrap="true"
        vertAlign="bottom">
        <Font
         role="font"/>
      </Label>

      <MarkupList
        id="ParentalControlsMenu"
        numRows="12"
        itemSize="[560,80]"
        itemSpacing="[0,8]"
        itemComponentName="CheckButton"
        vertFocusAnimationStyle="floatingFocus">
        <ContentNode
          id="SettingsMenuContent"
          role="content">
          <CheckButtonContentNode
            id="LittleKids"/>
          <CheckButtonContentNode
            id="OlderKids"/>
          <CheckButtonContentNode
            id="Teens"/>
          <CheckButtonContentNode
            id="Adults"/>
        </ContentNode>
      </MarkupList>
    </LayoutGroup>

    <Spinner
      id="Spinner"
      visible="false"
      height="717"
      width="1034"
      translation="[0,0]"/>
    </Group>
  </children>
</component>
