<?xml version="1.0" encoding="utf-8" ?> 
<component name="AboutPanel" extends="Panel" >
  <script type="text/brightscript" uri="AboutPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <field id="titleOne" alias="TitleOne.text"/>
    <field id="textOne"  alias="TextOne.text"/>
    <field id="titleTwo" alias="TitleTwo.text"/>
    <field id="textTwoArray" type="array"/>
    <field id="offset" alias="Offset.translation"/>
  </interface>

  <children>
    <Group
      id="Offset">
      <LayoutGroup
        id="ContentGroup"
        layoutDirection="vert"
        itemSpacings="[15,80,15]">
        <Label 
          id="TitleOne">
          <Font
           role="font"/>
        </Label>
        <Label
          id="TextOne"
          width="1026"
          wrap="true">
          <Font
           role="font"/>
        </Label>
        <Label 
          id="TitleTwo">
          <Font
           role="font"/>
        </Label>
        <LayoutGroup
          id="TextTwoGroup"
          layoutDirection="vert"
          itemSpacings="[40]"/>
      </LayoutGroup>
    </Group>
  </children>
</component>
