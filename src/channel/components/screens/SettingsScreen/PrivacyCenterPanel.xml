<?xml version="1.0" encoding="utf-8" ?>
<component name="PrivacyCenterPanel" extends="Panel" >
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="PrivacyCenterPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <field id="consentSettings" type="assocarray"/>
    <field id="title" type="string" alias="heading.text"/>
    <field id="offset" alias="Offset.translation"/>
    
    <!-- Holds the true/false based on if the user is in adults mode and not in kids mode, and not in teens parental controls.  -->
    <field id="isAllowedToManageConsent" type="boolean" />

    <!-- OUTPUTS -->
    <field id="newConsentPreferences" type="assocarray" alias="managePreferences.selectedConsent" />
    <field id="selectedQrCodeSectionInfo" type="assocarray" alwaysNotify="true" />

    <!-- Holds the true/false based on if the user tried to navigate away from privacy center manage preferences.  -->
    <field id="didUserSelectSaveAndRestart" alias="saveAndContinueButton.selected" alwaysNotify="true" />

    <!-- Holds the true/false based on if the user selected manage privacy settings button.  -->
    <field id="didUserSelectManagePrivacySettingsButton" alias="managePrivacySettingsButton.selected" alwaysNotify="true" />
  </interface>

  <children>
    <Group
      id="Offset">
      <Group
        id="panelContentSection">
        <Label
          id="heading">
          <Font
            role="font"/>
        </Label>
        <Label
          id="viewPrivacySettingsHint"
          width="1176"
          visible="false"
          wrap="true"
          translation="[0, 75]">
          <Font
            role="font"/>
        </Label>
        <SimpleButton
          visible="false"
          translation="[0, 153]"
          id="managePrivacySettingsButton"
          width="369" />
        <ManagePreferences
          visible="false"
          id="managePreferences"
          bottomGradientUri="pkg:/images/list_overflow_bottom_gradient-settings.webp"
          translation="[0, 72]" />
        <SimpleButton
          id="saveAndContinueButton"
          visible="false"
          width="369" />
        <Label
          id="nonEditableModeWarningMessage"
          width="1176"
          wrap="true"
          translation="[0, 75]">
          <Font
            role="font"/>
        </Label>
        <FocusControlLayoutGroup
          id="qrCodeSections"
          itemSpacings="[40, 20]" />
      </Group>
    </Group>
  </children>
</component>
