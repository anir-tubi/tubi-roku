<?xml version="1.0" encoding="utf-8" ?> 
<component name="SettingsMenuPanel" extends="ListPanel" >
  <script type="text/brightscript" uri="SettingsMenuPanel.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- associative array that will indocate if the user is signed in and if so, the aa will contain their info.  -->
      <field id="signInInfo" type="assocarray" alwaysNotify="true" />

      <!-- Allowed values are those in constants.ui.modes -->
      <field id="uiMode" type="string"/>

    <!-- OUTPUTS -->
      <field id="content" alias="SettingsMenu.content"/>
      <field id="itemSelected" alias="SettingsMenu.itemSelected"/>
      <field id="itemFocused" alias="SettingsMenu.itemFocused"/>
      <field id="itemUnfocused" alias="SettingsMenu.itemUnfocused"/>
  </interface>

  <children>
    <Group
      id="SettingsMenuGroup">
      <MarkupGrid
        id="SettingsMenu"
        drawFocusFeedbackOnTop="false"
        numRows="12"
        itemSize="[470,80]"
        itemSpacing="[0,8]"
        numColumns="1"
        itemComponentName="DetailMenuItem"
        vertFocusAnimationStyle="floatingFocus">
        <ContentNode
          id="SettingsMenuContent"
          role="content">
          <DetailMenuItemContentNode
            id="ParentalControlsButton"
            iconUrl="pkg:/images/icon-parental.png" />
          <DetailMenuItemContentNode
            id="AboutButton"
            iconUrl="pkg:/images/icon-about.png" />
          <DetailMenuItemContentNode
            id="PrivacyPolicyButton"
            iconUrl="pkg:/images/icon-privacy.png" />
          <DetailMenuItemContentNode
            id="TermsOfServiceButton"
            iconUrl="pkg:/images/icon-terms.png" />
          <DetailMenuItemContentNode
            id="DoNotSellPolicyButton"
            iconUrl="pkg:/images/icon-dns.png" />
          <DetailMenuItemContentNode
            id="SignInOutButton"
            iconUrl="pkg:/images/icon-sign-in.png" />
        </ContentNode>
      </MarkupGrid>
    </Group>
  </children>
</component>
