<?xml version="1.0" encoding="utf-8"?>
<component name="SignOutProfilePanel" extends="Panel">
  <script type="text/brightscript" uri="SignOutProfilePanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />

  <interface>
    <field id="email" type="string" alias="Email.text" />
    <field id="title" alias="title.text" />
    <field id="offset" alias="Offset.translation" />
    <field id="avatarUrl" alias="Avatar.uri" />
    <field id="initial" alias="Avatar.text" />

    <field id="name" alias="Name.text" />
    <field id="description" alias="Description.text" />
    <field id="signOutText" alias="SignOutButton.text" />
    <field id="uiMode" type="string" />
    <field id="activationUrl" alias="QRCodeUrlString.text" />
    <field id="manageTitle" alias="ManageTitle.text" />
    <!-- parental rating will tell whether we add sign out button or not -->
    <field id="parentalRating" type="integer" alwaysNotify="true" />
    <field id="linkedAccountsLabel" alias="LinkedAccountsLabel.text" />
    <field id="linkedAccountsDescription" alias="LinkedAccountsDescription.text" />
    <field id="linkedAccounts" type="assocarray" />


    <!-- OUTPUTS -->
    <field id="signOutSelected" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Group
      id="Offset">
      <LayoutGroup
        layoutDirection="vert"
        horizAlignment="left"
        itemSpacings="[48,48,96,12,48,48]">
        <Label
          id="Title">
          <Font
            role="font" />
        </Label>

        <LayoutGroup
          layoutDirection="horiz"
          itemSpacings="[28]"
          vertAlignment="center">
          <ProfileIcon
            id="avatar"
            height="121"
            width="121" />
          <LayoutGroup
            id="NameEmailGroup"
            itemSpacings="[6]"
            vertAlignment="center"
            horizAlignment="left">
            <Label
              id="Name"
              height="38"
              vertAlign="bottom">
              <Font
                role="font" />
            </Label>

            <Label
              id="Email"
              height="27"
              vertAlign="bottom">
              <Font
                role="font" />
            </Label>
            <Poster
              id="TubiKidsLogo"
              visible="false"
              width="99"
              height="18"
              uri="pkg:/images/profile-kids-logo.png" />
          </LayoutGroup>
        </LayoutGroup>

        <LayoutGroup
          id="SignOutButtonLayoutGroup">
          <TextIconButton
            id="SignOutButton"
            alwaysShowLabel="true"
            uri="pkg:/images/sideNavExit.webp"
            bgUri="pkg:/images/menu-focus-$$RES$$.9.png"
            hasUnfocusedBackground="true"
            iconWidth="36"
            iconHeight="36" />
        </LayoutGroup>

        <LayoutGroup
          id="LinkedAccountsGroup"
          layoutDirection="vert"
          itemSpacings="[12,48]"
          horizAlignment="left"
          vertAlignment="center">
          <Label
            id="LinkedAccountsLabel"
            width="1176"
            maxLines="1">
            <Font
              role="font" />
          </Label>
          <Label
            id="LinkedAccountsDescription"
            width="1176"
            maxLines="2">
            <Font
              role="font" />
          </Label>

          <MarkupGrid
            id="LinkedAccountsGrid"
            drawFocusFeedback="false"
            itemComponentName="profileSideNavItem"
            itemSize="[200,84]"
            itemSpacing="[6,6]"
            numRows="2"
            numColumns="3">
          </MarkupGrid>

        </LayoutGroup>

        <LayoutGroup
          id="ManageTitleDescriptionGroup"
          layoutDirection="vert"
          itemSpacings="[12,48]"
          vertAlignment="center">
          <Label
            id="ManageTitle"
            width="1176"
            maxLines="1">
            <Font
              role="font" />
          </Label>
          <Label
            id="Description"
            width="1176"
            wrap="true"
            maxLines="2">
            <Font
              role="font" />
          </Label>

          <LayoutGroup
            layoutDirection="horiz"
            itemSpacings="[24]"
            vertAlignment="center">
            <Poster
              id="QrCodePoster"
              width="231"
              height="231"
              loadDisplayMode="scaleToFit"
              uri="pkg:/images/QRCode.png" />

            <Label
              id="QRCodeUrlString"
              width="362"
              height="56"
              maxLines="2"
              vertAlign="bottom">
              <Font
                role="font" />
            </Label>
          </LayoutGroup>
        </LayoutGroup>
      </LayoutGroup>
    </Group>
  </children>
</component>