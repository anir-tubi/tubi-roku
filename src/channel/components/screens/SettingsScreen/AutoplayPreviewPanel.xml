<?xml version="1.0" encoding="utf-8" ?>
<component name="AutoplayPreviewPanel" extends="Panel" >
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="AutoplayPreviewPanel.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
      <!-- make a particular setting "checked" and focused -->
      <field id="selectItem" type="integer" alwaysNotify="true"/>

      <!-- make a autoplayTimer setting "checked" and focused -->
      <field id="autoPlayTimerSelectItem" type="integer" alwaysNotify="true"/>

      <!-- Indicates whether the user is loggedIn or not -->
      <field id="isUserSignedIn" type="boolean"  value="false"/>

      <field id="offset" alias="Offset.translation"/>
      <field id="isLoading" type="boolean"/>

    <!-- OUTPUTS -->
      <field id="itemSelected" alias="AutoplayPreviewMenu.itemSelected"/>
      <field id="autoPlayTimerItemSelected" alias="AutoPlayTimerMenu.itemSelected"/>

       <!-- Holds the information needed to populate a component_interaction event. This will
           be observed by the contentController via epgScreenHelper
           which will be responsible for sending component_interaction events.
      -->
      <field id="componentInteractionInfo" type="assocarray"/>
      <field id="audioGuideText" type="string" alwaysNotify="true"/>
  </interface>

  <children>
    <Group
      id="Offset">
    <Group
      id="ContentGroup">
      <Label
        id="Title"
        height="73"
        vertAlign="bottom">
        <Font
         role="font"/>
      </Label>

      <Label
        id="Instructions"
        width="1176"
        wrap="true"
        vertAlign="bottom"
        translation="[0,143]">
        <Font
         role="font"/>
      </Label>

      <MarkupList
        id="AutoplayPreviewMenu"
        numRows="2"
        itemSize="[585,72]"
        itemSpacing="[0,8]"
        itemComponentName="CheckButton"
        vertFocusAnimationStyle="floatingFocus"
        translation="[0,246]">
        <ContentNode
          id="SettingsMenuContent"
          role="content">
          <CheckButtonContentNode
            id="On"/>
          <CheckButtonContentNode
            id="Off"/>
        </ContentNode>
      </MarkupList>
    </Group>

    <Group
      id="AutoPlayTimerContentGroup"
      visible="false">
      <Label
        id="AutoPlayTimerTitle"
        height="73"
        vertAlign="bottom">
        <Font
         role="font"/>
      </Label>

      <Label
        id="AutoPlayTimerInstructions"
        width="1176"
        wrap="true"
        vertAlign="bottom">
        <Font
         role="font"/>
      </Label>

      <MarkupList
        id="AutoPlayTimerMenu"
        numRows="2"
        itemSize="[585,72]"
        itemSpacing="[0,8]"
        itemComponentName="CheckButton"
        vertFocusAnimationStyle="floatingFocus"
        focusFootprintBitmapUri="pkg:/images/transparent.png"
        focusBitmapUri="pkg:/images/menu-focus-$$RES$$.9.png">
        <ContentNode
          id="AutoPlayTimerMenuContent"
          role="content">
        </ContentNode>
      </MarkupList>
    </Group>

    <Spinner
      id="Spinner"
      visible="false"
      height="717"
      width="1034"
      translation="[0,0]"/>
    </Group>
  </children>
</component>
