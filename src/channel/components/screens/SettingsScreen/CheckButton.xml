<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInButton
 -
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="CheckButton" extends="Group" >
  <script type="text/brightscript" uri="CheckButton.brs" />

  <interface>
    <!-- Content expected for a KeyboardMenuItem:
     -
     - title - The label text
     -
     -->
    <field id="itemContent" type="node" />
    <field id="content" type="node" />
    <field id="width" alias="Text.width" />
    <field id="height" alias="Text.height" />
  </interface>

  <children>
    <Label
      id="Text"
      text=""
      width="480"
      height="80"
      horizAlign="left"
      vertAlign="center"
      translation="[19,1]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
    <Poster
      id="Check"
      width="20"
      height="16"
      uri="pkg:/images/check.png"
      visible="false"
      translation="[511,28]"/>
  </children>
</component>
