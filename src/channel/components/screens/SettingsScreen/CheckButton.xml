<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInButton
 -
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="CheckButton" extends="Group" >
  <script type="text/brightscript" uri="CheckButton.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <!-- Content expected for a KeyboardMenuItem:
     -
     - title - The label text
     -
     -->
    <!-- INPUT-->
    <field id="itemContent" type="node"/>
    <field id="listHasFocus" type="boolean" />
    <field id="itemHasFocus" type="boolean" />
    <field id="focusPercent" type="float" />
    <field id="content" type="node" />
    <field id="width" type="float"/>
    <field id="height" type="float"/>

    <!-- OUTPUT-->
    <field id="calculatedWidth" type="float"/>
  </interface>

  <children>
    <LayoutGroup
      id="BtnLayout"
      translation="[30,40]"
      itemSpacings="[40]"
      vertAlignment="center"
      horizAlignment="left"
      layoutDirection="horiz">
      <Group>
        <Poster
          id="Check"
          width="20"
          height="16"
          uri="pkg:/images/check.png"
          visible="false"/>
        <Poster
          id="CheckFocused"
          width="20"
          height="16"
          uri="pkg:/images/check.png"
          visible="false"/>
      </Group>
      <Group>
        <Label
          id="Text"
          text=""
          height="80"
          horizAlign="left"
          vertAlign="center">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="33" />
        </Label>
        <Label
          id="TextFocused"
          text=""
          height="80"
          horizAlign="left"
          vertAlign="center">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="33" />
        </Label>
      </Group>
    </LayoutGroup>
  </children>
</component>
