<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Channel Detail Screen
 -
 - This is a screen that displays information for a single content "channel".
 -
 -->
<component name="CategoryDetailsScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="CategoryDetailsScreen.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="../../lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FIFAMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->
      <!-- content should be a single CategoryContentNode representing the channel/category node filled with multiple item content nodes -->
      <field id="content" type="node"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean"  alwaysNotify="true"/>

      <!-- Should the screen load the content. This is set immediately after the content changes indicating that it is safe to load the content.  -->
      <field id="shouldLoadContent" type="boolean" alwaysNotify="true"/>

      <!-- hides or shows the loading spinner -->
      <field id="isLoading" type="boolean" alias="ChannelDetailSpinner.visible" />

       <!-- tells which item should focus on categoryDetail screen if it's selected from view more -->
      <field id="jumpToItemFocused" type="integer" value="-1" />

      <!-- What is the previous page so it can be indicated on the call to action that is located on the top nav.
      -->
      <field id="callingPage" type="string"  alwaysNotify="true"/>

      <!-- categoryId is one of the categories/channels (eg. categories(queue, action etc) or channels(fox, aetv etc))  -->
      <!-- assigning this value helps to redirect the user to specific category/channel detailscreen once user signedIn via category/channel detailscreen -->
      <field id="categoryId" type="string"/>

    <!-- OUTPUT -->
      <!-- the content Id representing the item which was focused on -->
      <field id="contentFocusedId" type="string"/>
      
      <!-- the content node representing the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- set to the contentNode of the ChannelsVideoGrid content item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node" alwaysNotify="true"/>

      <!-- This field accomplishes 2 things:
              1. tells ContentController/CategoryDetailsScreenHelpers that the category metadata
                  for the categroy content is out of the cache window and should be updated
              2. user has scrolled down to an index where we need to load more contents.
              Please note: that it is important that alwaysNotify is set to true so we can communicate to the Helper when the cache is out of date. -->
      <field id="categoryBatchIndex" type="integer" alwaysNotify="true" />

      <!-- This field indicates that categorydetail page is fully loaded with all avialable contents or upto constants.performance.categoryGridList.finalLazyLoadSize-->
      <field id="isFullyLoaded" alias="pageTitleAndCounter.isFullyLoaded" />

      <!-- tells the ChannelScreenHelper to display SignIn Required modal-->
      <field id="signInRequired" type="boolean" alwaysNotify="true" />

      <!-- will be used to change the sponsored background images on the content controller -->
      <field id="sponsorshipBackground" type="string" alwaysNotify="true" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.
           Used when showing a series/episode page
      -->
      <field id="trackingLoadStartTime" type="integer" />

      <field id="backButtonPressed" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[192,55]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>

    <Poster
      id="leftChevron"
      uri="pkg:/images/left-chevron.png"
      width="15"
      height="27"
      translation="[90,528]"/>

    <InfoPanel
      id="ChannelsInfoPanel"
      mode="item"
      translation="[192,133]"
      maxHeight="355"
      maxTitleLines="2"
      visible="true" />
    <CategoryGridRowLabel
      translation="[192,540]"
      id="pageTitleAndCounter"/>
    <MarkupGrid
      id="ChannelsVideoGrid"
      itemSpacing="[16,16]"
      translation="[192,600]"
      itemComponentName="StarterGridItem"
      numRows="2"
      numColumns="6"
      fadeFocusFeedbackWhenAutoScrolling="true"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>

    <Spinner
      id="ChannelDetailSpinner"
      visible="false"
      width="1920"
      height="1080"
      translation="[0,0]"/>

  </children>
</component>
