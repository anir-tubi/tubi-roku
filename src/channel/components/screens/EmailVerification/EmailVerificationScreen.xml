<?xml version="1.0" encoding="utf-8" ?>
<!--
 - EmailVerificationScreen
 -->
<component name="EmailVerificationScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="EmailVerificationScreen.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../screens/ModalDialogs.brs" />
  <interface>
    <!-- INPUT -->

    <!-- roku account's email address  -->
    <field id="username" type="string" alias="email.text"/>

    <!-- OUTPUT -->
    <field id="selectedDifferentEmail" type="boolean" alwaysNotify="true"/>
    <field id="backButtonSelected" type="boolean" alwaysNotify="true"/>
    <field id="resendVerificationLink" type="boolean" alwaysNotify="true"/>
    <!-- "uid" is only used as a state store and is not intended to be observed  -->
    <field id="uid" type="string"/>
    <!-- "queryResponseError" is only used as a state store and is not intended to be observed  -->
    <field id="queryResponseError" type="integer" value="0"/>
  </interface>
  <children>
    <Poster
      id="backButtonPoster"
      uri="pkg:/images/back_button.png"
      translation="[126,60]"
      width="170"
      height="72"/>
    <LayoutGroup
      id="magicLinkLayout"
      translation="[336, 228]"
      layoutDirection="vert"
      vertAlignment="custom"
      horizAlignment="custom"
      itemSpacings="[20, 17, 17, 30]">
      <Poster
        id="emailNotificationPoster"
        uri="pkg:/images/email_notification.png"
        translation="[580,0]"
        width="100"
        height="100"/>
      <Label
        id="emailInboxText"
        horizAlign="center"
        vertAlign="bottom"
        color="0xFFFFFF"
        width="1248">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="48"/>
      </Label>
      <Label
        id="verificationLinkText"
        color="0xD7DAE0"
        horizAlign="center"
        width="1248"
        vertAlign="bottom">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="18"/>
      </Label>
      <Label
        id="email"
        color="0xFFFFFF"
        width="1248"
        horizAlign="center"
        vertAlign="bottom">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="36"/>
      </Label>
      <Label
        id="verificationHintText"
        width="1248"
        horizAlign="center"
        color="0xD7DAE0"
        vertAlign="bottom">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="18"/>
      </Label>
    </LayoutGroup>
    <MarkupList
      id="EmailVerificationMenu"
      numRows="10"
      translation="[740, 550]"
      itemSize="[480,80]"
      itemSpacing="[0,10]"
      itemComponentName="DetailMenuItem"
      vertFocusAnimationStyle="floatingFocus">
      <ContentNode
        id="EmailVerificationMenuContentNode"
        role="content">
        <DetailMenuItemContentNode
          id="resendVerificationLinkButton"
          iconUrl="" />
        <DetailMenuItemContentNode
          id="useDifferentEmailButton"
          iconUrl="" />
      </ContentNode>
    </MarkupList>
  </children>
   
</component>