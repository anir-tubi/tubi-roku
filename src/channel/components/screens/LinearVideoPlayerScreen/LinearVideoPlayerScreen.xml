<?xml version="1.0" encoding="utf-8" ?>
<component name="LinearVideoPlayerScreen" extends="BaseScreen" >
  <script type="text/brightscript" uri="LinearVideoPlayerScreen.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>

    <!-- INPUT -->
      <!-- Alias fields for the video node -->
      <field id="position" alias="VideoNode.position"/>

      <field id="width" alias="VideoNode.width"/>
      <field id="height" alias="VideoNode.height"/>
      <field id="disableScreensaver" alias="VideoNode.disableScreensaver" />

      <!-- New content has been added to the video player -->
      <field id="content" type="node"/>

      <field id="updateContent" type="boolean" alwaysNotify="true"/>

      <!-- originalContent stores the content as it is returned from CCS services. It used
           as a store, in case the linear video player needs to be restarted. -->
      <field id="originalContent" type="node"/>

      <!--Timegrid content updated in batches-->
      <field id="timeGridContent" type="node" alias="VideoOverlay.timeGridContent, VideoOverlayLite.timeGridContent"/>

      <!-- Content might be loading in batch. So render only when timeGridContent is set -->
      <field id="updateTimeGridContent" type="boolean" alwaysNotify="true" alias="VideoOverlay.updateTimeGridContent, VideoOverlayLite.updateTimeGridContent"/>

      <!-- Is the content of the EPG component loading? -->
      <field id="timeGridContentLoading" type="boolean" alwaysNotify="true" alias="VideoOverlay.timeGridContentLoading, VideoOverlayLite.timeGridContentLoading"/>

      <!-- content that is used to display a channel guide overlaid the video player -->
      <field id="channelsContent" type="node"/>

      <!-- Fields to pass through to AdsSSAITask -->
      <field id="pollUrlAA" alias="PlayerAdsSSAITask.pollUrlAA" />

      <!-- Indicator that the outside would like the overlay to appear (when it can) when the video starts to play or goes full screen -->
      <field id="allowTransportToAppear" value="false" type="boolean"/>

      <!-- Indicator that the outside would like the overlay to be closed -->
      <field id="closeTransport" type="boolean" alwaysNotify="true"/>

      <!-- Is video player currently in fullscreen? -->
      <field id="fullscreen" type="boolean" value="false" alwaysNotify="true"/>

      <!-- supports "play", "stop", "pause", "resume", "error" -->
      <field id="control" type="string" value="none" alwaysNotify="true"/>

      <!-- interval in seconds for sending position data to the tracking server -->
      <field id="analyticsInterval" type="integer" value="0"/>

      <!-- Message shown during ad loading and video loading -->
      <field id="loadingMessage" alias="LoadingMessage.text" />

      <!-- When this is set to true, then change LoadingMessage.text to reflect the propper message -->
      <field id="displayAdLoadingMessage" type="boolean" value="false" alwaysNotify="true"/>

      <!-- The id of the screen associated with this screen. Used to keep a record of the previous (home) screen with which has a close association: i.e. the linear screen is displayed as a minimized version on the previous screen. In the future, th previous screen may be other screens like the search screen, which may not necessarily have a close association with this linear screen -->
      <field id="associatedScreenID" type="string" value="" />

      <field id="displayVideoplayerBg" type="boolean" alwaysNotify="true" />

      <!-- This field is used to communicate to the video player to start back playing the video after signIn from EPG overlay -->
      <field id="waitingForRFI" type="boolean" value="false" />

      <!-- Holds the consent opt out status for all individual preferences like marketing,analytics etc. -->
      <field id="userConsentsOptOutStatus" type="assocarray" value="{}" alias="PlayerAdsSSAITask.userConsentsOptOutStatus" />

      <!-- Holds the tcf string value. -->
      <field id="tcfString" type="string" alias="PlayerAdsSSAITask.tcfString" />

    <!-- OUTPUT -->
      <!-- Set to true if the back button was pressed while the video player has focus -->
      <field id="backButtonPressed" type="boolean" value="false" alwaysNotify="true" />

      <!-- When this is called, then the helper should display the EPGScreen-->
      <field id="navigateToEPGScreen" alias="VideoOverlay.navigateToEPGScreen, VideoOverlayLite.navigateToEPGScreen"/>

      <field id="state" type="string" />

      <!-- Used to store the loading state. It should not be used as an observed field. -->
      <field id="loading" type="boolean" value="false"/>

      <!--When the user selects a new channel from the channel guide, this field is set-->
      <field id="channelSelected" type="node"/>

      <!--Since channelSelected will get updated everytime minsLeftTimer is run, to protect unwanted trigging of observer, this field is used-->
      <field id="ChannelSelectedUpdated" type="boolean" alwaysNotify="true" />

      <!-- Error message to be displayed to the user -->
      <field id="errorMsg" type="string" />

      <!-- Error message as told by the video node  -->
      <field id="videoErrorMsg" type="string" alias="VideoNode.errorMsg" />

      <!-- Error code as told by the video node  -->
      <field id="videoErrorCode" type="integer" alias="VideoNode.errorCode" />

      <!-- We observe the VideoNode state change and when the state = "error", the call back chain of events
           eventually sets VideoNode.control = "stop". Due to an idiosyncrasy in Roku behavior, this prevents
           the Youbora plugin from observing the error state on the video node, and so, we must manually trigger
           the Youbora plugin with the error info. The content controller observes this field and sends error info to Youbora.
      -->
      <field id="sendYouboraError" type="boolean" alwaysNotify="true" />

      <field id="sendVideoTrackingStart" type="boolean" alwaysNotify="true" />

       <!-- Pass through LinearVideoPlayerOverlay component events to LinearVideoPlayerScreen helper -->
      <field id="linearOverlayNavigateWithinPageInfo" alias="VideoOverlay.programGuideNavigateWithinPageInfo" />

      <!-- Pass through LinearVideoPlayerOverlay component events to LinearVideoPlayerScreen helper -->
      <field id="linearOverlayComponentInteractionInfo" alias="VideoOverlay.programGuidecomponentInteractionInfo" />

      <!-- holds the information of the screen the video is playing in.  This could be the linear video player
           screen or it could be the homescreen (playing as a minimized version). The format is the same as
           trackingPageInfo (see BaseScreen.xml)
      -->
      <field id="trackingPageContext" type="assocarray" />

      <field id="trackingLoggingEvent" type="assocarray" />

      <field id="contentIdToFocusOnLoadComplete" type="string" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.-->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- Timestamp of the last time we finished playing back video with this player. If -1 then we are currently playing back. -->
      <field id="timestampOfLastVideoPlayback" type="integer" value="0" />
      <field id="isDisplayingOverlay" alias="VideoOverlay.isDisplaying, VideoOverlayLite.isDisplaying" />
      <field id="linearOverlayLiteComponentInteractionInfo" alias="VideoOverlayLite.componentInteractionInfo" />
      <field id="globalCaptionMode" alias="VideoOverlayLite.globalCaptionMode, VideoNode.globalCaptionMode" />

      <!-- This field is used to expose the task to allow us to be able to communicate directly with the task from the contentController context regarding auth -->
      <field id="task" type="node" />
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1920"
      height="1080"
      translation="[0,0]"
      enableUI="false"
      cgms = "3"
      enableTrickPlay="false"
      visible="true" />

    <Group
      id="Loading"
      visible="false">
      <Rectangle
        id="LoadingBackground"
        width="1920"
        height="1080"/>

      <CrossFadePoster
        id="backgroundImage"
        width="1920"
        height="1080"
        visible="false"/>
      <Group
        id="logoGroup">
        <Poster
          id="tubiLogo"
          width="462"
          height="135"
          uri="pkg:/images/logo-xlarge.webp"
          loadSync="true"
          translation="[734,382]"/>
      </Group>

      <Label
        id="LoadingMessage"
        height="64"
        width="1920"
        horizAlign="center"
        vertAlign="center"
        translation="[0,606]">
        <Font
          role="font"/>
      </Label>
      <TubiProgressBar
        id="LoadingProgressBar"
        width="750"
        progress="50"
        translation="[584,696]"/>
    </Group>

    <LinearVideoPlayerScreenOverlay
      id="VideoOverlay"
      visible="false"/>

    <LinearVideoPlayerScreenOverlayLite
      id="VideoOverlayLite"
      visible="false"/>

    <AdsSSAITask
      id="PlayerAdsSSAITask" />

  </children>
</component>
