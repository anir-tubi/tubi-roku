<?xml version="1.0" encoding="utf-8" ?>
<component name="LinearOverlaySideNav" extends="Group" >
  <script type="text/brightscript" uri="LinearOverlaySideNav.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>

    <!-- INPUT -->
      <!-- Tell the side nav how it should appear ("closed", "openedAndInFocus", "openedAndNotInFocus"). When set to "openedAndInFocus", the side nav will gain focus. -->
      <field id="setOpenState" type="string"/>

      <!-- The ID of the button that should receive focus -->
      <field id="buttonToFocusID" type="string" alwaysNotify="true"/>

    <!-- OUTPUT -->
      <!-- The ID of the button that just receved focus -->
      <field id="focusedButtonID" type="string" alwaysNotify="true"/>

      <!-- The ID of the button that just got selected -->
      <field id="selectedButtonID" type="string" alwaysNotify="true"/>

  </interface>

  <children>
      <ButtonGroup
        id="sideNav"
        layoutDirection="vert"
        itemSpacings="[0]">
        <Button
          id="btnCC"
          focusFootprintBitmapUri=" "
          focusBitmapUri=" "
          iconUri=" "
          focusedIconUri=" ">
          <Poster
            id="btnCC_poster"
            width="30"
            height="24"
            translation="[0,6]"
            uri="pkg:/images/icon-subtitles.png"/>
          <Label
            id="btnCC_label"
            color="0xFFFFFFFF"
            height="36"
            opacity=".5"
            vertAlign="center"
            visible="false"
            translation="[45,0]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="24" />
          </Label>
        </Button>
        <Button
          id="btnBack"
          focusFootprintBitmapUri=" "
          focusBitmapUri=" "
          iconUri=" "
          focusedIconUri=" ">
          <Poster
            id="btnBack_poster"
            width="30"
            height="24"
            translation="[0,4]"
            uri="pkg:/images/icon-backToGuide.png"/>
          <Label
            id="btnBack_label"
            color="0xFFFFFFFF"
            height="36"
            opacity=".5"
            vertAlign="center"
            visible="false"
            translation="[45,0]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="24" />
          </Label>
        </Button>
      </ButtonGroup>
  </children>
</component>
