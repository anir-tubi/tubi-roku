<?xml version="1.0" encoding="utf-8" ?>
<component name="LinearVideoPlayerScreenOverlayLite" extends="Group" >
  <script type="text/brightscript" uri="LinearVideoPlayerScreenOverlayLite.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />

  <interface>
    <!-- INPUT -->
      <field id="updateAndShowComingUpInfo" type="boolean" alwaysNotify="true"/>
      <field id="showOverlay" type="boolean" alwaysNotify="true"/>
      <field id="hideOverlay" type="boolean" alwaysNotify="true"/>
      <field id="hideComingUpOverlay" type="boolean" alwaysNotify="true"/>
      <field id="hideClosedCaptionAudioTrackOverlay" type="boolean" alwaysNotify="true"/>

      <field id="increaseChannel" type="boolean" alwaysNotify="true"/>
      <field id="decreaseChannel" type="boolean" alwaysNotify="true"/>

      <field id="videoNode" type="node"/>
      <!-- Overlay needs to know the current playing video so it can update the EPG. -->
      <field id="currentLinearVideoContent" type="node" />
      <!--Timegrid content updated in batches-->
      <field id="timeGridContent" type="node" />
      <!-- Tell the overlay if the content of the EPG component is loading -->
      <field id="timeGridContentLoading" type="boolean" alwaysNotify="true" />
      <!-- Content might be loading in batch. So render only when timeGridContent is set -->
      <field id="updateTimeGridContent" type="boolean" alwaysNotify="true" />
    <!-- OUTPUT -->
      <!-- The state of the overlay being visible or not. -->
      <field id="isDisplaying" type="boolean" value="false"/>
      <!-- Tell when the overlay has reacted to a key press-->
      <field id="reactedToKeyPresss" type="boolean" alwaysNotify="true"/>
      <!-- Tell the screen to navigate to epg screen-->
      <field id="navigateToEPGScreen" type="boolean" alwaysNotify="true"/>
      <!--When the user selects a new channel from the epg channel guide, this field is set-->
      <field id="linearChannelToPlay" type="node"/>
      <!--Since LinearChannelToPlay will get updated everytime minsLeftTimer is run, to protect unwanted trigging of observer, this field is used-->
      <field id="linearChannelToPlayUpdated" type="boolean" alwaysNotify="true" />
      <field id="isClosedCaptionAudioOverlayShowing" type="boolean" />
      <field id="globalCaptionMode" type="string" />

      <field id="componentInteractionInfo" type="assocarray" />
      <field id="trackingComponentInfo" type="assocarray" />
  </interface>

  <children>
    <Group
      id="OverlayParent"
      opacity="0">

      <Poster
        id="TransportGradient"
        width="1920"
        height="1080"
        uri="pkg:/images/linearVideoPlayerOverlayBackground.png"/>

      <Group
        id="ChannelGroup">

        <Poster
          id="upArrow"
          width="48"
          height="48"
          translation="[96,72]"
          uri="pkg:/images/upArrow.png"/>

        <MarkupList
          id="ChannelList"
          numRows="1"
          itemSize="[585,51]"
          itemSpacing="[0,9]"
          itemComponentName="LabelItem"
          vertFocusAnimationStyle="floatingFocus"
          drawFocusFeedback="false"
          translation="[96,129]">
        </MarkupList>

        <Poster
          id="downArrow"
          width="48"
          height="48"
          translation="[96,174]"
          uri="pkg:/images/downArrow.png"/>

      </Group>

      <Poster
        id="tubiLogo"
        height="45"
        width="102"
        uri="pkg:/images/logo-white-large.png"
        translation="[1731,69]"/>

      <Group
        id="TransportGroup"
        translation="[96,534]">

        <LayoutGroup
          id="InfoPanelGroup"
          opacity="0.0"
          layoutDirection="vert"
          vertAlignment="bottom"
          translation="[0,282]">

          <InfoPanel
            id="InfoPanel"
            maxTitleLines="1"/>
        </LayoutGroup>

        <LayoutGroup
          id="ComingUpGroupInInfoPanel"
          opacity="0"
          layoutDirection="vert"
          vertAlignment="top"
          horizAlignment="right"
          itemSpacings="[16]"
          translation="[1728,168]">
          <Label
            id="ComingUpTimeInInfoPanel"
            opacity="0.5"
            horizAlign="right"
            width="582">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="28" />
          </Label>
          <Label
            id="ComingUpTitleInInfoPanel"
            horizAlign="right"
            width="582">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="36" />
          </Label>
        </LayoutGroup>

        <TubiProgressBar
          id="ProgressBar"
          width="1728"
          translation="[0,321]"/>

        <FilledButtonMarkupGrid
          id="ButtonList"
          translation="[0,387]"
          itemSize="[300,72]"
          itemComponentName="ButtonWithIconAndLabel"
          itemSpacing="[12, 0]"
          numRows="1"
          numColumns="2"
          vertFocusAnimationStyle="floatingFocus"/>

      </Group>

    </Group>

    <Group
      id="overlayComingUp"
      opacity="0">

      <Poster
        id="ComingUpGradient"
        width="1920"
        height="1080"
        uri="pkg:/images/gradient-coming-up.png"/>

      <LayoutGroup
        id="ComingUpGroup"
        layoutDirection="vert"
        vertAlignment="top"
        horizAlignment="right"
        itemSpacings="[15]"
        translation="[1824,900]">
        <Label
          id="ComingUpTime"
          opacity="0.5"
          horizAlign="right"
          width="582">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="28" />
        </Label>
        <Label
          id="ComingUpTitle"
          horizAlign="right"
          width="582">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="36" />
        </Label>
      </LayoutGroup>

    </Group>

    <Rectangle
      id="closedCaptionAndAudioSelectionOverlayGroup"
      opacity="0"
      width="1920"
      height="1080">
      <ClosedCaptionAndAudioSelectionOverlay
        translation="[1230,60]"
        id="closedCaptionAndAudioSelectionOverlay" />
    </Rectangle>

    <Timer
      id="showComingUpTimer"
      repeat="false"/>

    <Timer
      id="hideComingUpTimer"
      repeat="false"/>

  </children>
</component>
