<?xml version="1.0" encoding="utf-8" ?>
<component name="ForgotPasswordProcessingScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="ForgotPasswordProcessingScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs"/>
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->

      <!-- A record of the user's signin info: i.e. email, firstname, gender, etc. -->
      <field id="signInInfo" type="assocarray"/>

      <!-- roku account's email address  -->
      <field id="username" type="string" alias="email.text"/>

    <!-- OUTPUT -->

      <!-- selectedDifferentEmail is triggered when user selects the button that allows them to change the email address -->
      <field id="selectedDifferentEmail" type="boolean" alwaysNotify="true" />

      <!-- resendVerificationLink is triggered when user selects the button that will send a new instant link -->
      <field id="resendVerificationLink" type="boolean" alwaysNotify="true" />

      <!-- backButtonSelected is triggered when user selects the back button -->
      <field id="backButtonSelected" type="boolean" alwaysNotify="true"/>

      <!-- "queryResponseError" is only used as a state store and is not intended to be observed  -->
      <field id="queryResponseError" type="integer" value="0"/>

      <!-- "uid" is only used as a state store and is not intended to be observed  -->
      <field id="uid" type="string"/>

      <!-- "failureReason" is used to find the actual reason for signIn failure, it is used as value of message field in account event-->
      <field id="failureReason" type="string"/>
  </interface>

  <children>

    <Poster
      id="backButtonPoster"
      uri="pkg:/images/back_button.png"
      translation="[126,60]"
      width="171"
      height="72"/>

    <LayoutGroup
      id="pageLayout"
      translation="[960, 540]"
      layoutDirection="vert"
      vertAlignment="center"
      horizAlignment="center"
      itemSpacings="[36, 18, 18, 60, 30]">
      <Poster
        id="emailNotificationPoster"
        uri="pkg:/images/email_notification.webp"
        width="150"
        height="150"/>
      <Label
        id="pageHeading"
        horizAlign="center"
        width="1248">
        <Font
          role="font"/>
      </Label>

      <Label
        id="pageSubHeading"
        horizAlign="center"
        width="1920">
        <Font
          role="font"/>
      </Label>

      <Label
        id="email"
        width="1248"
        horizAlign="center"
        vertAlign="bottom">
        <Font
          role="font"/>
      </Label>

      <Label
        id="pageSubHeading2"
        horizAlign="center"
        width="1920">
        <Font
          role="font"/>
      </Label>

      <LayoutGroup
        id="buttonGroup"
        layoutDirection="vert"
        vertAlignment="top"
        horizAlignment="center"
        itemSpacings="[12]"/>
    </LayoutGroup>

  </children>
</component>
