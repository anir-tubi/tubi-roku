<?xml version="1.0" encoding="utf-8" ?>
<!--
 - MultiStyleDialogScreen
 -
 - A modal dialog with a brand purple gradient background,title, optional sub header underneath and
 - 1) multiple group of messages organized icon+message header+message sub header and buttons.
 - Or
 - 2) Just an image
 -
 -->
<component name="MultiStyleDialogScreen" extends="BaseDialogScreen">

  <script type="text/brightscript" uri="MultiStyleDialogScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->

      <!-- Bold header text -->
      <field id="header" alias="header.text"/>

      <field id="subHeader" alias="subHeader.text" />

      <!--Contains information to create a list of messages within the dialog, with each message having a header, subtext, and potentially an icon. The structure is an array of AA as elements: Each AA is formated as:
        {
          header: <string>, Header or Title of the message component within the dialog.
          subHeader:<string>,  Optional. If provided, a SubHeader will be displayed underneath the Title.
          iconUri:  <string>, Optional. If provided, icon will be displayed on left side of the message.
        }
        -->

      <field id="multiStyleMessage" type="array" />

      <!--instead of a multistyle message body, horizontally placed images will be shown-->
      <field id="imageUrls" type="stringarray" value="[]" />

      <!-- dimensions of the multistyle images. Please specify height and width for each imageUrl provided.
            imageDimensions = [[340, 450] [600, 233]...]-->
      <field id="imageDimensions" type="vector2darray" value="[]" />

      <!-- The text of buttons.  The button list will grow to the size of this array -->
      <field id="buttons" type="stringarray" value="[]" alwaysNotify="true"/>
  </interface>

  <children>
    <Rectangle
      id="shade"
      width="1920"
      height="1080"
      opacity="0.9"
      translation="[0,0]"/>

    <Rectangle
      id="dialogBox"
      width="744"
      height="1008"
      translation="[1154, 36]">

      <Poster
        id="mask"
        width="744"
        height="1008"
        uri="pkg:/images/sidepanel.webp"
        translation="[0, 0]"/>

      <LayoutGroup
        id="contentArea"
        layoutDirection="vert"
        horizAlignment="custom"
        translation="[0,100]"
        itemSpacings="[48,0,80]">

        <LayoutGroup
          layoutDirection="vert"
          translation="[48,0]"
          itemSpacings="[12]">

          <Label
            id="header"
            maxLines="2"
            wrap="true"
            width="615">
            <Font
              role="font"/>
          </Label>

          <Label
            id="subheader"
            wrap="true"
            maxLines="2"
            width="615">
            <Font
              role="font"/>
          </Label>
        </LayoutGroup>

        <LayoutGroup
          id="multiStyleLayout"
          visible="false"
          translation="[48,0]"
          itemSpacings="[68]" />

        <Group
          id="imagesSection"
          visible="false" />


        <FilledButtonMarkupGrid
          id="buttonList"
          translation="[48,0]"
          itemSize="[615,72]"
          itemComponentName="ListItemButtonWithBg"
          itemSpacing="[0,12]"
          numRows="2"
          numColumns="1"
          vertFocusAnimationStyle="floatingFocus"/>
      </LayoutGroup>
    </Rectangle>

  </children>
</component>
