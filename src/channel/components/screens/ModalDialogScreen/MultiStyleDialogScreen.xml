<?xml version="1.0" encoding="utf-8" ?>
<!--
 - MultiStyleDialogScreen
 -
 - A modal dialog with a brand purple gradient background,title, optional sub header underneath and
 - 1) multiple group of messages organized icon+message header+message sub header and buttons.
 - Or
 - 2) Just an image
 -
 -->
<component name="MultiStyleDialogScreen" extends="Group">

  <script type="text/brightscript" uri="MultiStyleDialogScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

  <interface>
    <!-- INPUT -->

      <!-- Bold header text -->
      <field id="header" alias="header.text"/>

      <field id="subHeader" alias="subHeader.text" />

      <!--Contains information to create a list of messages within the dialog, with each message having a header, subtext, and potentially an icon. The structure is an array of AA as elements: Each AA is formated as:
        {
          header: <string>, Header or Title of the message component within the dialog.
          subHeader:<string>,  Optional. If provided, a SubHeader will be displayed underneath the Title.
          iconUri:  <string>, Optional. If provided, icon will be displayed on left side of the message.
        }
        -->

      <field id="multiStyleMessage" type="array" />

      <!--instead of a multistyle message body, multiStyleImageUrl to be shown-->
      <field id="multiStyleImageUrl" type="string" />

      <!-- The text of buttons.  The button list will grow to the size of this array -->
      <field id="buttons" type="stringarray" value="[]" alwaysNotify="true"/>


    <!-- OUTPUT -->
      <!-- Set to the index into the 'buttons' array of a button which was selected -->
      <field id="buttonSelected" type="integer" alwaysNotify="true"/>

      <!-- set to "options" or "back" if either of those keys are pressed -->
      <field id="exitButton" type="string" alwaysNotify="true"/>

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           value is pushed to the stack.
       -->
      <field id="screenLevel" type="integer" />

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />

      <!-- Holds the information about what action should take when modal shown while resume after suspending -->
      <field id="instantResumeAction" type="string" />


  </interface>

  <children>
    <Rectangle
      id="shade"
      width="1920"
      height="1080"
      opacity="0.9"
      translation="[0,0]"/>

    <Rectangle
      id="dialogBox"
      width="678"
      height="474"
      translation="[1191, 48]">

      <Poster
        id="mask"
        width="678"
        height="894"
        uri="pkg:/images/gradient-reg-modal.webp"
        translation="[0, 0]"/>

      <LayoutGroup
        id="contentArea"
        layoutDirection="vert"
        horizAlignment="custom"
        translation="[0,48]"
        itemSpacings="[96,96]">

        <LayoutGroup
          layoutDirection="vert"
          translation="[48,48]"
          itemSpacings="[21]">

          <Label
            id="header"
            maxLines="2"
            wrap="true"
            width="582">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="48" />
          </Label>

          <Label
            id="subHeader"
            maxLines="2"
            width="582">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="27" />
          </Label>
        </LayoutGroup>

        <LayoutGroup
          id="multiStyleLayout"
          visible="false"
          translation="[48,0]"
          itemSpacings="[68]" />


        <FilledButtonMarkupGrid
          id="buttonList"
          translation="[48,0]"
          itemSize="[285,72]"
          itemComponentName="ListItemButtonWithBg"
          itemSpacing="[12,0]"
          numRows="1"
          numColumns="2"
          vertFocusAnimationStyle="floatingFocus"/>
      </LayoutGroup>
    </Rectangle>

  </children>
</component>
