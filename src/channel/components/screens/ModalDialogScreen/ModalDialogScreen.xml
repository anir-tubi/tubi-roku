<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ModalDialogScreen
 -
 - A modal dialog with a transparent background, title, message, and buttons.
 -
 -->
<component name="ModalDialogScreen" extends="Group" initialFocus="ButtonList">

  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogScreen/ModalDialogScreen.brs" />
  
  <interface>
    <!-- The text of buttons.  The button list will grow to the size of this array -->
    <field id="buttons" type="stringarray" value="[]" alwaysNotify="true"/>
    
    <!-- Set to the index into the 'buttons' array of a button which was selected -->
    <field id="buttonSelected" alias="ButtonList.itemSelected"/>
    
    <!-- Bold header text, single line -->
    <field id="title" alias="Title.text"/>
           
    <!-- Secondary message, multiple lines -->
    <field id="message" type="string" value=""/>
    
    <field id="scrollable" type="boolean" value="false"/>

    <!-- set to "options" or "back" if either of those keys are pressed -->
    <field id="exitButton" type="string" alwaysNotify="true"/>

  </interface>

  <children>
    <Rectangle
      id="Shade"
      color="0x191919FF"
      width="1920"
      height="1080"
      opacity="0.8"
      translation="[0,0]"/>
         
    <Rectangle
      id="DialogBox"
      color="0x2C2C2CFF" 
      width="960"
      height="540"
      translation="[480,270]">
      <LayoutGroup
        id="ContentArea"
        layoutDirection="vert"
        horizAlignment="custom"
        translation="[20,65]"
        itemSpacings="[60,36]">
        <Label
          id="Title"
          color="0xFFFFFFFF"
          width="763"
          translation="[44,0]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="43" />
        </Label>
        
        <Group
          id="MessageGroup"
          translation="[44,0]">
          <Label
            id="Message"
            color="0xFFFFFFFF"
            width="822"
            wrap="true"
            maxLines="6"
            translation="[0,0]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="27" />
          </Label>
          <Rectangle
            id="ScrollableBackground"
            color="0x191919FF"
            height="320"
            width="822">
            <ScrollableText
              id="ScrollableMessage"
              width="802"
              height="300"
              visible="false"
              translation="[10,10]">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="22" />
            </ScrollableText>
          </Rectangle>
        </Group>
        
        <InstalledScrollingList
          id="ButtonList"
          width="490"
          height="1080"
          layoutDirection="vert"
          itemComponentName="InstalledCategorySeasonListItem"
          itemSpacings="[6]">
        </InstalledScrollingList>
      </LayoutGroup>
    </Rectangle>

  </children>
</component>