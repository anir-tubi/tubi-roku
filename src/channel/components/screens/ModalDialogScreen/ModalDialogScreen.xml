<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ModalDialogScreen
 -
 - A modal dialog with a transparent background, title, message, and buttons.
 -
 -->
<component name="ModalDialogScreen" extends="BaseDialogScreen">

  <script type="text/brightscript" uri="ModalDialogScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->
      <!-- The text of buttons.  The button list will grow to the size of this array -->
      <field id="buttons" type="stringarray" value="[]" alwaysNotify="true"/>

      <!-- Bold header text, single line -->
      <field id="title" alias="Title.text"/>

      <!-- Secondary message, multiple lines -->
      <field id="message" type="string" value=""/>

      <field id="scrollable" type="boolean" value="false"/>

  </interface>

  <children>
    <Rectangle
      id="Shade"
      width="1920"
      height="1080"
      opacity="0.8"
      translation="[0,0]"/>
    <Rectangle
      id="DialogBox"
      width="960"
      height="540"
      translation="[480,270]">
      <LayoutGroup
        id="ContentArea"
        layoutDirection="vert"
        horizAlignment="custom"
        translation="[20,65]"
        itemSpacings="[50,36]">
        <Label
          id="Title"
          width="763"
          wrap="true"
          translation="[44,0]">
          <Font
            role="font"/>
        </Label>

        <Group
          id="MessageGroup"
          translation="[44,0]">
          <Label
            id="Message"
            width="822"
            wrap="true"
            maxLines="8"
            translation="[0,0]">
            <Font
              role="font"/>
          </Label>
          <Rectangle
            id="ScrollableBackground"
            height="320"
            width="822">
            <ScrollableText
              id="ScrollableMessage"
              width="802"
              height="300"
              visible="false"
              scrollbarThumbBitmapUri="pkg:/images/menu-disabled-focus-$$RES$$.9.png"
              translation="[10,10]">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-Medium.ttf"
                size="27" />
            </ScrollableText>
          </Rectangle>
        </Group>

        <FilledButtonMarkupGrid
          id="ButtonList"
          translation="[0,0]"
          itemSize="[475,80]"
          itemComponentName="ModalListItem"
          itemSpacing="[0,6]"
          numRows="3"
          numColumns="1"
          vertFocusAnimationStyle="floatingFocus"/>
      </LayoutGroup>
    </Rectangle>

  </children>
</component>
