<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen/DetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- The mode used by info panel, one of: 'category', 'item', 'movie', 'series', 'season', 'episode' -->
      <field id="mode" type="string" alias="DetailInfoPanel.mode" />

      <!-- Pass through signal to the info panel that the height/placement should be recalculated -->
      <field id="calculateInfoHeight" type="boolean" alias="DetailInfoPanel.calculateHeight" />

      <!-- The title displayed on the info panel -->
      <field id="title" type="string" alias="DetailInfoPanel.title" />

      <!-- The title of the episode displayed on the info panel, just below the series title-->
      <field id="episodeTitle" type="string" alias="DetailInfoPanel.episodeTitle" />

      <!-- An assoc array of key/values that populate the items in FirstLineGroup in the DetailInfoPanel -->
      <field id="lineOneData" type="assocarray" alias="DetailInfoPanel.lineOneData" />

      <!-- Array of strings of genres for the video -->
      <field id="genres" type="stringarray" alias="DetailInfoPanel.genres" />

      <!-- Description of the video displayed on the info panel -->
      <field id="description" type="string" alias="DetailInfoPanel.description" />

      <!-- Array of strings of directors -->
      <field id="directors" type="stringarray" alias="DetailInfoPanel.directors" />

      <!-- Array of strings of actors/actresses -->
      <field id="starring" type="stringarray" alias="DetailInfoPanel.starring" />

      <!-- Indicates if the video is an episode of a series -->
      <field id="isSeries" type="boolean" value="false" />

      <!-- Indicates if the video is in the user's bookmarks/queue -->
      <field id="isBookmark" type="boolean" value="false" />

      <!-- Indicates if the video is in the user's history -->
      <field id="isHistory" type="boolean" />

      <!-- Indicates if the video is in a channel -->
      <field id="isChannelItem" type="boolean" value="false" />

      <!-- The most recently watched point in the video for the user, ie. where the user will resume to -->
      <field id="resumePoint" type="integer" value="0" />

      <!-- Indicates if the content has a trailer -->
      <field id="hasTrailer" type="boolean" value="false" />

      <!-- keeps the uri used for user tracking -->
      <field id="trackingUri" type="string"  value="" />

      <!-- keeps the uri used for user tracking -->
      <field id="jumpToItem" type="integer" alias="Menu.jumpToItem" />

      <!-- used to update the text on the addToQueue button -->
      <field id="addToQueueTitle" type="string" value="Add to queue" alwaysNotify="true" />

      <!-- used to update the text on the removeQueue button -->
      <field id="removeQueueTitle" type="string" value="Remove from queue" alwaysNotify="true" />

      <!-- used to update the text on the removeHistory button -->
      <field id="removeHistoryTitle" type="string" value="Remove from history" alwaysNotify="true" />

      <!-- used to update the text on the channel button -->
      <field id="channelName" type="string" alwaysNotify="true" />

      <!-- informs the details screen if the content controller is waiting for a user category update from the server -->
      <field id="isWaitingForServerResponse" type="boolean" value="false" />

      <!-- hides or shows the loading spinner -->
      <field id="isLoading" type="boolean" alias="DetailSpinner.visible" />

      <!-- content to populated the RelatedGrid -->
      <field id="relatedContent" alias="RelatedGrid.content" />

      <field id="backgroundUriList" type="stringarray" alwaysNotify="true"/>

      <field id="content" type="node" />

    <!-- OUTPUTS -->

      <!-- set to true when the suer selects the 'Resume' menu button -->
      <field id="resumeSelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the suer selects the 'Play' menu button -->
      <field id="playSelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the user selects the 'Episode List' menu button -->
      <field id="episodeListSelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the user adds the title to their queue -->
      <field id="addToQueueSelected" type="boolean" alwaysNotify="true" />
      
      <!-- set to true when the user removes the title from their queue -->
      <field id="removeFromQueueSelected" type="boolean" alwaysNotify="true" />
      
      <!-- set to true when the user removes the title from their history -->
      <field id="removeFromHistorySelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the user wants to see the trailer for the content -->
      <field id="watchTrailerSelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the user wants to navigate to the channel details screen -->
      <field id="channelSelected" type="boolean" alwaysNotify="true" />

      <field id="relatedContentSelected" alias="RelatedGrid.itemSelected" />

      <field id="backButtonPressed" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- All the potential menu items, will be dynamically added or removed based on 'content' -->
    <DetailMenuItemContentNode
      id="ResumeMenuItem"
      title="Resume" 
      iconUrl="pkg:/images/icon-resume.png"/>
    <DetailMenuItemContentNode
      id="PlayMenuItem"
      title="Play"
      iconUrl="pkg:/images/icon-play.png" />
    <DetailMenuItemContentNode
      id="EpisodesMenuItem"
      title="Episodes list"
      iconUrl="pkg:/images/icon-all-episodes.png" />
    <DetailMenuItemContentNode
      id="AddQueueMenuItem"
      title="Add to queue"
      iconUrl="pkg:/images/icon-add-to-queue.png" />
    <DetailMenuItemContentNode
      id="RemoveQueueMenuItem"
      title="Remove from queue"
      iconUrl="pkg:/images/icon-remove-from-queue.png" />
    <DetailMenuItemContentNode
      id="RemoveHistoryMenuItem"
      title="Remove from history"
      iconUrl="pkg:/images/icon-remove-from-history.png" />
    <DetailMenuItemContentNode
      id="ChannelMenuItem"
      title=""
      iconUrl="pkg:/images/icon-channel.png" />
    <DetailMenuItemContentNode
      id="WatchTrailerMenuItem"
      title="Watch Trailer"
      iconUrl="pkg:/images/icon-trailer.png" />
  
    <Spinner
      id="DetailSpinner"
      visible="false"
      isDisabled="false"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    
    <Group
      id="AnimationGroup"
      translation="[0,0]">
      <InfoPanel
        id="DetailInfoPanel"
        mode="item"
        translation="[85,123]"
        maxHeight="498"
        maxTitleLines="2"
        visible="true" />

    <FilledButtonMarkupGrid
      id="Menu"
      translation="[60,656]"
      itemSize="[465,80]"
      itemComponentName="DetailMenuItem"
      itemSpacing="[0,8]"
      numRows="3"
      numColumns="1"
      vertFocusAnimationStyle="floatingFocus"/>

      <Group
        id="RelatedContentGroup"
        translation="[85,945]"
        visible="false"
        opacity="0.2">
        <CategoryGridRowLabel
          id="RelatedRowLabel"
          translation="[0,0]">
          <TubiContentNode
            role="content"
            title="You Might Also Like"/>
        </CategoryGridRowLabel>
        <PosterGrid
          id="RelatedGrid"
          itemSize="[1920,300]"
          numRows="1"
          basePosterSize="[210,300]"
          itemSpacing="[10,0]"
          fadeFocusFeedbackWhenAutoScrolling="true"
          horizFocusAnimationStyle="fixedFocus"
          focusBitmapUri="pkg:/images/selector-fhd.9.png"
          translation="[0,63]"/>
        <Label
          id="RelatedTitle"
          width="875"
          wrap="false"
          maxLines="1"
          color="0xFFFFFFFF"
          translation="[0,386]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
      </Group>
    </Group>
  </children>
</component>
