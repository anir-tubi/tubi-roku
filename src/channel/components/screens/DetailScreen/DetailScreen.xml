<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen/DetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/NodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />


  <interface>
    <!-- Full content of the item to show details for -->
    <field id="content" type="node" />
    
    <!-- Setting shortContent triggers a metadata fetch for the full details of the content item 
      - 
      - shortContent should have a minumum of:
      -     contentId - the content id
      -     type - "video", "series", "season", "category" (video may be an episode)
      - 
      -->
    <field id="shortContent" type="node" alwaysNotify="true"/>

    <!-- set to true when the suer selects the 'Play' menu button -->
    <field id="playSelected" type="boolean" alwaysNotify="true" />

    <!-- MetadataFetchTask response for single content -->
    <field id="contentDetailResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="" />

    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />    

    <!-- set to true when the suer selects the 'Resume' menu button -->
    <field id="resumeSelected" type="boolean" alwaysNotify="true" />
    
    <!-- set to true when the user selects the 'Episode List' menu button -->
    <field id="episodeListSelected" type="boolean" alwaysNotify="true" />
    
    <!-- set to true if the user is signed in and we want to change the experience based on that -->
    <field id="signedIn" type="boolean" value="false" />
    
    <!-- set to true if the user elected to sign in from the add to queue modal -->
    <field id="signInSelected" type="boolean" alwaysNotify="true"/>
    
    <!-- set to true when the user adds the title to their queue -->
    <field id="addToQueueSelected" type="boolean" alwaysNotify="true" />
    
    <!-- set to true when the user removes the title from their queue -->
    <field id="removeFromQueueSelected" type="boolean" alwaysNotify="true" />
    
    <!-- set to true when the user removes the title from their history -->
    <field id="removeFromHistorySelected" type="boolean" alwaysNotify="true" />

    <!-- set to true when the user wants to see the trailer for the content -->
    <field id="watchTrailerSelected" type="boolean" alwaysNotify="true" />

    <!-- Set the to current episode selection, when 'content' field is type 'series' -->
    <field id="episodeSelection" type="intarray" value="[-1,-1]" alwaysNotify="true"/>
    
    <!-- Set to true if the fetch of detailed metadata for the item in shortContent fails -->
    <field id="itemFailed" type="boolean" value="false" alwaysNotify="true"/>

    <!-- Set to false when we receive a deeplink and back to true once we've handled it -->
    <field id="deeplinkHandled" type="boolean" value="true" />

  </interface>

  <children>
    <!-- All the potential menu items, will be dynamically added or removed based on 'content' -->
    <DetailMenuItemContentNode
      id="ResumeMenuItem"
      title="Resume" 
      unfocusiconurl="pkg:/images/icon-resume.png"
      focusiconurl="pkg:/images/icon-resume.png"/>
    <DetailMenuItemContentNode
      id="PlayMenuItem"
      title="Play"
      unfocusiconurl="pkg:/images/icon-play.png"
      focusiconurl="pkg:/images/icon-play.png" />
    <DetailMenuItemContentNode
      id="EpisodesMenuItem"
      title="Episodes list"
      unfocusiconurl="pkg:/images/icon-all-episodes.png"
      focusiconurl="pkg:/images/icon-all-episodes.png" />
    <DetailMenuItemContentNode
      id="AddQueueMenuItem"
      title="Add to queue"
      unfocusiconurl="pkg:/images/icon-add-to-queue.png"
      focusiconurl="pkg:/images/icon-add-to-queue.png" />
    <DetailMenuItemContentNode
      id="RemoveQueueMenuItem"
      title="Remove from queue"
      unfocusiconurl="pkg:/images/icon-remove-from-queue.png"
      focusiconurl="pkg:/images/icon-remove-from-queue.png" />
    <DetailMenuItemContentNode
      id="RemoveHistoryMenuItem"
      title="Remove from history"
      unfocusiconurl="pkg:/images/icon-remove-from-history.png"
      focusiconurl="pkg:/images/icon-remove-from-history.png" />
    <DetailMenuItemContentNode
      id="WatchTrailerMenuItem"
      title="Watch Trailer"
      unfocusiconurl="pkg:/images/icon-trailer.png"
      focusiconurl="pkg:/images/icon-trailer.png" />
  
    <InfoPanel
      id="InfoPanel"
      mode="detail"
      translation="[85,123]"
      maxHeight="477"
      maxTitleLines="2"
      visible="true" />
  
    <ScrollingList
      id="Menu"
      width="465"
      height="352"
      itemSpacings="[8]"
      itemComponentName="DetailMenuItem"
      visible="false"
      translation="[60, 680]" />
    
    <AuthTask
      id="AuthTask" />
  </children>
</component>
