<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Age verification screen allows user to enter a birthdate to confirm their age.
 - Age calculation and confirmation happens on the backend and is handled by
 - AgeVerificationHelpers.brs
 -->
<component name="AgeVerificationScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="AgeVerificationScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />

  <interface>

    <!-- INPUT -->

      <!-- signInInfo field possible values are below

        case 1 : signInInfo will have below keys when user signs in, but the user does not have a valid age associated with their account yet.
          eg.
            {
              email : "test@tubi.tv",
              firstName : "test"
            )

        case 2:  signInInfo will have below keys when user signs up
          eg.
            {
              email : "test@tubi.tv",
              firstName : "test",
              emailType : "manual/pre_fill"
            )

        case 3: signInInfo will have below keys when signedIn user launches app and does not have a valid age associated with their account yet.
          eg.
            {
              email : "test@tubi.tv",
              firstName : "test"
            )
            -->
      <field id="signInInfo" type="assocarray"/>

      <!-- The uiMode before we come into this screen as designs call for us to switch the theme to the standard one when displaying this screen but we may need to switch back to the previous mode after we leave this screen -->
      <field id="previousUiMode" type="string"/>

    <!-- OUTPUT -->

      <!-- event that occurs when a user selects the Start Watching button -->
      <field id="ageSubmitted" type="boolean" alias="AgeVerificationStartButton.selected"/>

      <!-- event that occurs when a user selects the back button -->
      <field id="backButtonPressed" type="boolean" alwaysNotify="true"/>

      <!-- the birthdate that the user has submitted. Should be in the form "YYYY-MM-DD" -->
      <field id="birthdate" type="string" />

  </interface>

  <children>
    <Group
      id="AgeVerificationPageText">
      <Label
        id="AgeVerificationPageHeader"
        color="0xFFFFFF"
        horizAlign="left"
        width="1668"
        translation="[126,204]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>
      <Label
        id="AgeVerificationPageSubHeader"
        color="0xF0F1F5"
        opacity="0.8"
        horizAlign="left"
        width="1668"
        translation="[126,300]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="33" />
      </Label>
    </Group>
    <Group
      id="AgeVerificationNumberPadGroup"
      translation="[126,375]">
      <NumberPad
        id="AgeVerificationNumberPad"
        />
      <SimpleButton
        translation="[0,434]"
        id="AgeVerificationStartButton"
        color="0x9699A3"
        width="489"/>
    </Group>
    <Group
      id="AgeVericationDateInfo"
      translation="[890,496]">
      <LayoutGroup
        id="AgeVerificationUserDate"
        layoutDirection="horiz"
        itemSpacings="[12]">

          <Label
            id="AgeVerificationYearText"
            color="0xFFFFFF"
            width="426"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="0.4"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="70"/>
          </Label>


        <Rectangle
          width="300">
          <Poster
            id="AgeVerificationYearBg"
            uri="pkg:/images/menu-focus-fhd.9.png"
            width="300"
            height="144"
            opacity="1.0"/>
          <Label
            id="AgeVerificationYearEntryBack"
            color="0xFFFFFF"
            width="300"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="0.64"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="84"/>
          </Label>
          <Label
            id="AgeVerificationYearEntryFront"
            color="0x000000"
            width="300"
            height="144"
            horizAlign="center"
            vertAlign="center"
            opacity="1.0"
            translation="[0,9]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="84"/>
          </Label>
          <Label
            id="AgeVerificationYear"
            color="0xFFFFFF"
            width="300"
            horizAlign="center"
            opacity="0.4"
            translation="[0,168]">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="33"/>
          </Label>
        </Rectangle>
      </LayoutGroup>
    </Group>
    <Label
      id="AgeVericationErrorPrompt"
      translation="[0,804]"
