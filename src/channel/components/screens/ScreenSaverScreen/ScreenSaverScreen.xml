<?xml version="1.0" encoding="utf-8" ?>
<component name="ScreenSaverScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="ScreenSaverScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUTS -->
    <!-- Contains list of responses from the requested containers with each node having an `items` array field with the list of filtered items for that container -->
    <field id="containerResponses" type="nodearray"/>

    <!-- OUTPUTS -->
    <!-- communicates to ContentController that we want to close the screensaver. In the future will include info about the current item -->
    <field id="exitInfo" type="assocarray" />
  </interface>
  <children>
    <!-- used to preload images in advance -->
    <Poster
      id="preloadPoster"
      visible="false" />
    <Rectangle
      width="1920"
      height="1080"
      color="#000000FF" />
    <Poster
      id="poster"
      width="1920"
      height="1080"
      scaleRotateCenter="[960, 540]"
      opacity="0" />
    <Poster
      width="1260"
      height="1080"
      uri="pkg:/images/screensaver_title_gradient.webp" />
    <LayoutGroup
      id="titleLayoutGroup"
      layoutDirection="vert"
      itemSpacings="[12]"
      opacity="0"
      translation="[126, 846]">
      <SimpleLabel
        id="titleLabel"/>
      <SimpleLabel
        id="tagsLabel"/>
    </LayoutGroup>

    <!-- Can only have one animation for each item with animate() and in this case we need two due to the different durations -->
    <Animation
      id="zoomAnimation"
      easeFunction="outQuad">
      <Vector2DFieldInterpolator
        key="[0.0, 1.0]"
        keyValue="[[1.0, 1.0], [1.12, 1.12]]"
        fieldToInterp="poster.scale" />
    </Animation>

    <Timer
      id="slideTimer" />
  </children>
</component>
