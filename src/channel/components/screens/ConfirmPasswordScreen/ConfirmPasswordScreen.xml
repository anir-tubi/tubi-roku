<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ConfirmPasswordScreen
 -
 - Present the user with a form for entering email and password, then sign that user in.
 -->
<component name="ConfirmPasswordScreen" extends="Group">

  <script type="text/brightscript" uri="./ConfirmPasswordScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- INPUT -->
      <field id="message" alias="Message.text"/>
      <field id="buttonText" alias="SubmitButtonContent.title"/>
      <field id="isLoading" type="boolean" alias="Spinner.visible" />

    <!-- OUTPUT -->
      <field id="submitSelected" type="boolean" alwaysNotify="true"/>
      <field id="passwordText" alias="PasswordTextBox.text"/>

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           vaule is pushed to the stack.
       -->
      <field id="screenLevel" type="integer" />

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />
  </interface>

  <children>
    <Poster
      id="TubiLogo"
      height="45"
      width="103"
      opacity="0.5"
      uri="pkg:/images/logo-white-large.png"
      translation="[85,55]" />

    <!-- The keyboard: upper, lower, numbers, symbols -->
    <KeyboardGroup
      id="Keyboard"
      translation="[0,65]"/>

    <Label
      id="Message"
      horizAlign="center"
      wrap="true"
      width="1920"
      translation="[0,355]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="67" />
    </Label>
    
    <Group
      translation="[720,561]">
      <TextEntryBox
        id="PasswordTextBox"
        hint="Password"
        passwordMode="true"/>
      <Poster
        id="PasswordTextBoxFocus"
        uri="pkg:/images/selector-fhd.9.png"
        visible="false"
        translation="[-6,-6]"
        width="492"
        height="92"/>
    </Group>
      
    <Group
      translation="[720,651]">
      <Poster
        id="SubmitButtonFocus"
        uri="pkg:/images/menu-focus-fhd.9.png"
        width="480"
        height="80"
        translation="[0,0]"
        visible="false"/>
      <Poster
        id="SubmitButtonDisabledFocus"
        uri="pkg:/images/menu-disabled-focus-fhd.9.png"
        width="480"
        height="80"
        translation="[0,0]"
        visible="false"/>
      <SignInButton
        id="SubmitButton"
        translation="[0,0]">
        <ContentNode 
          id="SubmitButtonContent"
          role="content"/>
      </SignInButton>
    </Group>
   
    <Spinner
      id="Spinner"
      visible="false"
      isDisabled="false"
      showShade="true"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    
  </children>
</component>
