<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ConfirmPasswordScreen
 -
 - Present the user with a form for entering email and password, then sign that user in.
 -->
<component name="ConfirmPasswordScreen" extends="Group">

  <script type="text/brightscript" uri="ConfirmPasswordScreen.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <interface>
    <!-- INPUT -->
      <field id="message" alias="Message.text"/>
      <field id="subMessage" alias="subMessage.text"/>
      <field id="setUp" alias="setUp.text"/>
      <field id="visit" alias="visit.text"/>
      <field id="isLoading" type="boolean" alias="Spinner.visible" />

    <!-- OUTPUT -->
      <field id="submitSelected" type="boolean" alwaysNotify="true"/>
       <field id="backPressed" type="boolean" alwaysNotify="true"/>
      <field id="passwordText" alias="Keyboard.text"/>

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           vaule is pushed to the stack.
       -->
      <field id="screenLevel" type="integer" />

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />

      <!-- Holds the information of how to handle when the screen is active after instant resume. Valid values are restartApp, startChannel and "resumeChannel" -->
      <field id="instantResumeAction" type="string" value="startChannel" />
  </interface>

  <children>
    <LayoutGroup
      layoutDirection="vert"
      horizAlignment="center"
      vertAlignment="center"
      itemSpacings="[24, 51, 24, 10, 44]"
      translation="[960,585]">
      <Label
        id="Message"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="48" />
      </Label>

      <Label
        id="subMessage"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="48" />
      </Label>

      <TextEntryBox
        id="password"
        boxWidth="630"
        boxHeight="84"
        translation="[643,0]"
        passwordMode="true" />

      <Label
        id="setUp"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="24" />
      </Label>
      
      <Label
        id="visit"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="24" />
      </Label>

      <PasswordEntryKeyboard 
          id="passwordEntryKeyboard"
          translation="[0,1080]"/>

      </LayoutGroup>
   
    <Spinner
      id="Spinner"
      visible="false"
      showShade="true"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    
  </children>
</component>
