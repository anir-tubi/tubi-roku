<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ConfirmPasswordScreen
 -
 - Present the user with a form for entering email and password, then sign that user in.
 -->
<component name="ConfirmPasswordScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="ConfirmPasswordScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>

  <interface>
    <!-- INPUT -->
      <field id="message" alias="Message.text"/>
      <field id="setUp" alias="setUp.text"/>
      <field id="visit" alias="visit.text"/>
      <field id="isLoading" type="boolean" alias="Spinner.visible" />

    <!-- OUTPUT -->

      <field id="submitSelected" type="boolean" alwaysNotify="true"/>
      <field id="backPressed" type="boolean" alwaysNotify="true"/>
      <field id="passwordText" alias="Keyboard.text"/>
  </interface>

  <children>
    <LayoutGroup
      id="contentGroup"
      layoutDirection="vert"
      horizAlignment="center"
      vertAlignment="center"
      itemSpacings="[24, 51, 24, 10, 44]"
      translation="[960,585]">
      <Label
        id="Message"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"/>
      </Label>

      <TextEntryBox
        id="password"
        boxWidth="630"
        boxHeight="84"
        translation="[643,0]"
        passwordMode="true" />

      <Label
        id="setUp"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"/>
      </Label>

      <Label
        id="visit"
        horizAlign="center"
        wrap="true"
        width="1920">
        <Font
          role="font"/>
      </Label>

      <PasswordEntryKeyboard
        id="passwordEntryKeyboard"
        translation="[0,1080]"/>

      </LayoutGroup>

    <Spinner
      id="Spinner"
      visible="false"
      showShade="true"
      width="1920"
      height="1080"
      translation="[0,0]"/>

  </children>
</component>
