<?xml version="1.0" encoding="utf-8" ?>
<component name="EPGHomeScreen" extends="BaseScreen" >

  <script type="text/brightscript" uri="EPGHomeScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />

  <interface>
    <!-- INPUT -->

    <!--Timegrid content updated in batches-->
    <field id="timeGridContent" type="node" />

    <!-- Content might be loading in batch. So render only when timeGridContent is set -->
    <field id="updateTimeGridContent" type="boolean" alwaysNotify="true" />

    <!-- Is the content of the EPG Screen loading? -->
    <!-- This field is not currently being used by the screen (as the screen uses the loading indicator in ContentController) but is needed to ensure screens that load EPG content use the same interface and this field is part of that interface.-->
    <field id="timeGridContentLoading" type="boolean" alwaysNotify="true" />

    <!-- Not Used in EPGScreen. But this field is set in SideNav functions and without interface brightScript will throw error  -->
    <field id="enabled" type="boolean" alwaysNotify="true"/>


    <!--this field is used to reset the timeGrid linearChannelToPlay field in case of player error-->
    <field id="resetPlayerContent" type="boolean" alwaysNotify="true"/>

    <!--The the video and hide the video player-->
    <field id="refreshEPGScreenVideoPlay" type="boolean" alwaysNotify="true"/>

    <!-- The number that is used as how many more seconds until the linear video player will be going fullscreen -->
    <field id="fullscreenCountdown" type="integer" alias="InfoPanel.fullscreenCountdown"/>

    <field id="infoPanelVisible" alias="InfoPanel.visible" />

    <field id="jumpToRowItem" alias="programGuide.jumpToRowItem" />

    <field id="jumpToRowItemByID" alias="programGuide.jumpToLinearChannelID" />

    <field id="jumpToChannelItem" alias="programGuide.jumpToChannelItem" />

    <field id="contentIdToFocusOnLoadComplete" type="string" />

    <!-- OUTPUTS -->

    <field id="epgScreenOkPressed" type="boolean" alwaysNotify="true"/>

    <!--Channel Item Focused-->
    <field id="linearChannelFocused" type="node" />

    <!--Channel Item to play in EPG video player or linear video player-->
    <field id="linearChannelToPlay" type="node"/>

    <!-- content on the EPG Screen is loaded and spinner can be turned off -->
    <field id="contentReady" type="boolean" value="false" alwaysNotify="true" />

    <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.-->
    <field id="trackingLoadStartTime" type="integer" />

    <!-- Trigger the content to be loaded.   -->
    <field id="loadAllChannels" type="boolean" value="false" alwaysNotify="true"/>

    <!--observe the scrolling status of program Grid to stop/start count down timer-->
    <field id="scrollingStatus" type="boolean" alias="programGuide.scrollingStatus" />

    <!-- Pass through Program Guide component events to EpgScreen helper -->
    <field id="programGuideNavigateWithinPageInfo" alias="programGuide.navigateWithinPageInfo" />

    <!-- Pass through Program Guide component events to EpgScreen helper -->
    <field id="programGuidecomponentInteractionInfo" alias="programGuide.componentInteractionInfo" />

    <field id="channelLikeDislikeInfo" alias="programGuide.channelLikeDislikeInfo" />

  </interface>

  <children>

    <Group id="PageGroup">
      <Group
        id="infoPanelParent">
        <InfoPanel
          id="infoPanel"
          maxHeight="355"
          translation="[0,180]"
          maxTitleLines="2"
          visible="false"/>
      </Group>
      <ProgramGuide
        id="programGuide"
        translation="[0,510]"/>


    </Group>

    <Clock
      id="clock"
      width="93"
      height="36"
      visible="true"
      translation="[1729,72]"/>
    <!-- For viewers that watch a REALLY long time, or just never close the app, force a refresh -->
    <Timer
      id="channelRefreshTimer"
      repeat="true"/>

  </children>
</component>
