<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Category Detail Panel
 -
 - This is a panel that displays information for a single categoery - to the right of the category menu panel.
 -
 -->
<component name="CategoryDetailsPanel" extends="Panel">

  <script type="text/brightscript" uri="CategoryDetailsPanel.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/ArrayUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs"/>

  <interface>
    <!-- INPUT -->
      <field id="offset" alias="PageGroup.translation"/>


      <!-- Holds the information needed to populate a navigate_within_page event. This will
           be observed by the CategoryPanelListScreen, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <!-- Should the panel animate the infoPanel when focus is gained or lost? If not, then the transition will be immediate. -->
      <field id="shouldAnimateOnFocus" type="boolean" value="true"/>

      <!-- When set the panel should check if the content needs to be refreshed. -->
      <field id="checkOnRefreshed" type="boolean" value="true" alwaysNotify="true"/>

      <!-- "input" deeplink information with type = "transport" -->
      <field id="transportVoiceRequest" type="assocarray" alwaysNotify="true"/>

      <!-- content should be a single CategoryContentNode representing the channel/category node filled with multiple item content nodes -->
      <field id="content" type="node"/>

      <!-- Should the screen load the content. This is set immediately after the content changes indicating that it is safe to load the content.  -->
      <field id="shouldLoadContent" type="boolean" alwaysNotify="true"/>

      <!-- hides or shows the loading spinner -->
      <field id="isLoading" type="boolean" alias="ChannelDetailSpinner.visible" />

       <!-- tells which item should focus on categoryDetail screen -->
      <field id="jumpToItemFocused" type="integer" value="0" />

      <field id="jumpToItem" alias="ChannelsContentGrid.jumpToItem"/>

      <!-- categoryId is one of the categories/channels (eg. categories(queue, action etc) or channels(fox, aetv etc))  -->
      <!-- assigning this value helps to redirect the user to specific category/channel detailscreen once user signedIn via category/channel detailscreen -->
      <field id="categoryId" type="string"/>

    <!-- OUTPUT -->
      <!-- passes information eventually back to firmware to let it know if the "input" deeplink
           with type = transport was handled
      -->
      <field id="transportVoiceResponse" type="assocarray" alwaysNotify="true"/>

      <!-- the content node representing the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- set to the contentNode of the ChannelsContentGrid content item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node" alwaysNotify="true"/>

      <!-- This field accomplishes 2 things:
              1. tells ContentController/CategoryDetailsScreenHelpers that the category metadata
                  for the category content is out of the cache window and should be updated, value = 0
              2. user has scrolled down to an index where we need to load more contents.
              Please note: that it is important that alwaysNotify is set to true so we can communicate to the Helper when the cache is out of date, value > 0-->
      <field id="categoryBatchIndex" type="integer" alwaysNotify="true" />

      <!-- This field indicates that categorydetail page is fully loaded with all available contents or upto constants.performance.categoryGridList.finalLazyLoadSize-->
      <field id="isFullyLoaded" alias="pageTitleAndCounter.isFullyLoaded" />

      <!-- tells the ChannelScreenHelper to display SignIn Required modal-->
      <field id="signInRequired" type="boolean" alwaysNotify="true" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.
           Used when showing a series/episode page
      -->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- will be used to change the background images on the content controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true"/>

      <field id="backButtonPressed" type="boolean" alwaysNotify="true" />

      <field id="itemFocused" type="integer" alwaysNotify="true" />

      <!-- Keeps the information used for analytics tracking of this page - structure looks like:
        {
          pageType: "video_page"  corresponds to one of the page types in
                                  tubiTracking_getAnalyticsPage() which mirrors the protos repo.
          pageValues: {}          an assoc array with key/values that match the pageType as found in
                                  tubiTracking_getAnalyticsPage().
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />
      <field id="trackingComponentInfo" type="assocarray" />
  </interface>

  <children>

    <Group id="PageGroup">
      <Group id="PageAnimatedGroup">
        <InfoPanel
          id="ChannelsInfoPanel"
          mode="item"
          translation="[0,165]"
          maxHeight="355"
          maxTitleLines="2"
          opacity="0"/>
        <CategoryGridRowLabel
          translation="[0,540]"
          countTranslationXPos="1050"
          id="pageTitleAndCounter"/>
        <MarkupGrid
          id="ChannelsContentGrid"
          itemSpacing="[16,16]"
          translation="[0,600]"
          itemComponentName="StarterGridItem"
          numRows="3"
          numColumns="4"
          fadeFocusFeedbackWhenAutoScrolling="true"
          vertFocusAnimationStyle="fixedFocus"
          focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
      </Group>
      <Spinner
        id="ChannelDetailSpinner"
        visible="false"
        showShade="false"/>
    </Group>

  </children>
</component>
