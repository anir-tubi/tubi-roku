<component name="EventDetailsScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="EventDetailsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>
    <!-- INPUTS -->
      <!-- Holds the purple carpet container node. The data will be formatted in the same format as a content node passed to rowlist. It can have a single child or multiple childrens depending on how many items gets returned from backend. -->
      <field id="content" type="node" />

      <!-- id of the event or program for which we are displaying the details screen. -->
      <field id="eventId" type="string" />

      <field id="signedIn" alias="detailsPurpleCarpetRow.signedIn" value="false" />

      <field id="didUserSetReminderForEventContent" alias="detailsPurpleCarpetRow.didUserSetReminderForEventContent" />

      <field id="trackingLoadStartTime" type="integer" />

    <!-- OUTPUTS -->
      <field id="eventCtaListItemSelected" alias="detailsPurpleCarpetRow.ctaListItemSelected" alwaysNotify="true" />

      <!-- Content node of the selected item from the secondary events rowlist. Will be set when user selects on a rowlist item. -->
      <field id="itemSelected" type="node" />

      <field id="listContent" alias="detailsPurpleCarpetRow.listContent" />

      <field id="primaryEventContent" alias="detailsPurpleCarpetRow.primaryEventContent" />

      <field id="backButtonPressed" type="boolean" alwaysNotify="true" />

      <field id="purpleCarpetContent" alias="detailsPurpleCarpetRow.content" />
  </interface>

  <children>
    <Poster
      id="leftChevron"
      uri="pkg:/images/left-chevron.png"
      width="15"
      height="27"
      translation="[75,528]"/>
    <PurpleCarpetRow
      id="detailsPurpleCarpetRow"
      isContentDetailsView="true" />
  </children>
</component>