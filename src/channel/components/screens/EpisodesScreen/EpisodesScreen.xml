<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodesScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/EpisodesScreen/EpisodesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/NodeHelpers.brs" />
  
  <interface>
    <!-- Full content of the item to show details for -->
    <field id="content" type="node" />

    <!-- interface to tell the episode screen to focus a specific series episode;
         2d array describing the episode that needs to be focused with [seasonIndex, episodeIndex] -->
    <field id="episodeToFocus" alias="RowList.jumpToRowItem"/>

    <!-- Set to the content of the episode that was clicked on -->
    <field id="episodeSelected" alias="RowList.rowItemSelected"/>
    
    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" type="stringarray" alwaysNotify="true" /> 
    
    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/series/episodelist/" />
  </interface>

  <children>
    <InfoPanel
      id="InfoPanel"
      translation="[85,61]"
      maxHeight="511"
      mode="detail"
      visible="true" />
    
    <CommunicatingMarkupGrid
      id="EpisodeMenu"
      translation="[-425, 616]"
      itemSize="[425,80]"
      itemSpacing="[0,8]"
      numRows="5"
      numColumns="1"
      vertFocusAnimationStyle="fixedFocus"
      itemComponentName="CategorySeasonListItem" />

    <RowList
      id="RowList"
      translation="[85,552]"
      itemComponentName="FeaturePosterWithProgress"
      rowTitleComponentName="CategoryGridRowLabel"
      itemSize="[1835,364]"
      itemSpacing="[0,28]"
      numRows="2"
      rowSpacings="[28]"
      rowItemSize="[[430,242]]"
      rowItemSpacing="[[10,0]]"
      showRowLabel="[true]"
      showRowCounter="[false]"
      fadeFocusFeedbackWhenAutoScrolling="true"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/selector-fhd.9.png"/>

  </children>
</component>
