<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodesScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="EpisodesScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />

  <interface>
    <!-- INPUT -->
      <!-- Full content of the item to show details for -->
      <field id="content" type="node" />

      <!-- Explicitly tell the content to update by using this field -->
      <field id="updateContent" type="boolean" alwaysNotify="true" />

      <!-- interface to tell the episode screen to focus a specific series episode;
           2d array describing the episode that needs to be focused with [seasonIndex, episodeIndex] -->
      <field id="episodeToFocus" alias="RowList.jumpToRowItem" />

      <!-- Used to store state to determine if we should resume playback at a later time -->
      <field id="shouldResumePlayback" type="boolean" value="false" />

      <field id="playbackSource" type="assocArray"/>

    <!-- OUTPUT -->
      <field id="episodeFocused" alias="RowList.rowItemFocused" />

      <!-- Set to the content of the episode that was clicked on -->
      <!-- mirrors RowList.rowItemSelected, but EpisodeScreen interjects before sending it to the ContentController -->
      <field id="episodeSelected" type="vector2d" alwaysNotify="true" />

      <field id="backButtonPressed" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Poster
      id="leftChevron"
      uri="pkg:/images/left-chevron.png"
      width="15"
      height="27"
      translation="[75,528]"/>

    <Group id="PageGroup">
      <InfoPanel
        id="InfoPanel"
        translation="[0,130]"
        maxHeight="511"
        mode="detail"
        visible="true" />

      <CommunicatingMarkupGrid
        id="EpisodeMenu"
        translation="[0, 643]"
        itemSize="[425,80]"
        itemSpacing="[0,8]"
        numRows="4"
        numColumns="1"
        vertFocusAnimationStyle="fixedFocus"
        itemComponentName="CategorySeasonListItem" />

      <RowList
        id="RowList"
        translation="[0,594]"
        itemComponentName="FeaturePosterWithProgress"
        rowTitleComponentName="CategoryGridRowLabel"
        itemSpacing="[0,32]"
        numRows="2"
        rowSpacings="[32]"
        rowItemSpacing="[[16,0]]"
        showRowLabel="[true]"
        showRowCounter="[false]"
        fadeFocusFeedbackWhenAutoScrolling="true"
        rowFocusAnimationStyle="floatingFocus"
        vertFocusAnimationStyle="fixedFocus"
        focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
    </Group>
  </children>
</component>
