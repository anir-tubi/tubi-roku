       height="188"/>
      <Poster
       uri="pkg:/images/picto-history.png"
       width="183"
       height="182"/>
      <Poster
       uri="pkg:/images/picto-resume.png"
       width="291"
       height="161"/>
      <Poster
       uri="pkg:/images/picto-account-synchro.png"
       width="384"
       height="180"/>
    </LayoutGroup>
       
    <LayoutGroup
      itemSpacings="[188,154,159]"
      translation="[302,604]"
      layoutDirection="horiz">
