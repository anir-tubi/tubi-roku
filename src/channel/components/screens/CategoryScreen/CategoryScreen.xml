<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/CategoryScreen/CategoryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />

  <interface>
    <!-- MetadataFetchTask response for single category content -->
    <field id="categoryResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- MetadataFetchTask response for single category content -->
    <field id="categoryPreviewResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- MetadataFetchTask response for category list -->
    <field id="categoryListResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/home" alwaysNotify="false"/>
    <field id="trackingCount" type="integer" />

    <!-- will be populated with the full (unparsed) bookmark response -->
    <field id="bookmarks" type="string" />
    
    <!-- will be populated with the full (unparsed) history response -->
    <field id="history" type="string" />

    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" type="stringarray" />
    
    <!-- set to the tubi content id of the item which was clicked on -->
    <field id="contentSelected" type="node" alwaysNotify="true"/>

    <!-- set to true if the user is signed in and we want to change the experience based on that -->
    <field id="signedIn" type="boolean" value="false" />

    <field id="dirtyUserCategories" type="boolean" value="false" alwaysNotify="true"/>

    <field id="infoVisible" alias="StuffThatsInvisibleDuringLiveTV.visible"/>

    <field id="dockedVideoFrameVisible" alias="DockOverlay.visible"/>

    <field id="categoryMenuVisible" type="boolean"/>
    <field id="onNowHintVisible" alias="OnNowHint.visible"/>
    <field id="searchSignOutHintVisible" alias="SearchSignOutHint.visible"/>
    <field id="firstPosterLoaded" alias="CategoryGridList.firstPosterLoaded"/>

    <field id="cursorPosition" alias="CategoryGridList.cursorPosition" />
    <field id="cachedContent" alias="CategoryGridList.cachedContent" />

    <!-- When used as a child of container screen (ex. Homescreen),
         accounts for the other visible rows (ex. On Now, Tools) -->
    <field id="rowPlaceholder" type="integer" value="0"/>
  </interface>

  <children>

    <!-- Show a loading spinner only if it takes more than 3 seconds to load -->
    <Spinner
      id="LoadingSpinner"
      visible="true"
      width="1920"
      height="1080"/>

    <Group
      id="StuffThatsInvisibleDuringLiveTV">
      
      <Group
        id="UpHintGroup">
      <Group
        id="OnNowHint"
        visible="false">
        <Poster
          id="LiveUpTriangle"
          uri="pkg:/images/up-arrow.png"
          visible="true"
          width="47"
          height="47"
          translation="[881,57]"
          opacity="0.5"/>
        <Poster
          id="onNowIcon"
          uri="pkg:/images/icon-on-now.png"
          visible="true"
          width="115"
          height="55"
          translation="[929,55]"
          opacity="0.5"/>
      </Group>
      <Group
        id="SearchSignOutHint"
        opacity="0.5"
        visible="false">
        <Poster
          id="LiveUpTriangle"
          uri="pkg:/images/up-arrow.png"
          width="47"
          height="47"
          translation="[843,57]" />
        <Label
          id="AllChannels"
          text="SEARCH &amp; MORE"
          vertAlign="center"
          height="47"
          translation="[892,61]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </Group>
      </Group>
      <InfoPanel
        id="InfoPanel"
        translation="[85,163]"
        maxHeight="325"
        maxTitleLines="2"
        visible="true" />
      <Group
        id="DockOverlay"
        visible="false">
      <Poster
        id="DockedVideoFrame"
        uri="pkg:/images/selector-white-fhd.9.png"
        width="467"
        height="268"
        visible="true"
        translation="[1384,145]"/>
      <Poster
        id="DockedBackToCloseHint"
        uri="pkg:/images/back.png"
        width="47"
        height="47"
        translation="[1410,417]"
        opacity="0.5"/>
      <Label
        id="DockedBackToCloseText"
        text="PRESS BACK TO CLOSE"
        vertAlign="center"
        height="47"
        translation="[1459,421]"
        opacity="0.5">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
      </Group>
    </Group>


    <Group
      id="CategoryMenuAndGrid">

      <!-- Special category menu items. These will be merged with category list -->
      <ContentNode
        id="SpecialCategories">
        <!-- TubiContentNode here so it can contain the totalcount for the Info Panel -->
        <TubiContentNode
          id="ContinueWatching"
          type="category"
          title="Continue Watching"
          description="The Movies and TV Shows you have started watching can be found here"
          placeholderText="You haven't watched anything yet. The content you watch will appear here."
          slug="continue_watching" />
        <TubiContentNode
          id="MyQueue"
          type="category"
          title="My Queue"
          description="The Movies and TV Shows you have added to your Queue can be found here"
          placeholderText="You don’t have anything in your Queue yet. Get started by adding Movies and TV Shows that interest you to your Queue."
          slug="my_queue" />
      </ContentNode>

      <ScrollingList
        id="CategoryList"
        translation="[-380, 616]"
        width="425"
        height="440"
        scrollHeight="80"
        itemSpacings="[8]"
        itemComponentName="CategorySeasonListItem" />

      <MaskGroup
        id="ContentArea"
        maskUri="pkg:/images/poster-mask.png"
        maskSize="[0,0]"
        maskOffset="[1731,317]"
        translation="[85,553]">
        <CategoryGridList
          id="CategoryGridList"/>
      </MaskGroup>
    </Group>

    <!-- At request of backend, deferring these requests gives the backend time to
      - cache the responses
      -->
    <Timer
      id="CategoryPreloadTimer"
      duration="2.0"/>
    
  </children>
</component>
