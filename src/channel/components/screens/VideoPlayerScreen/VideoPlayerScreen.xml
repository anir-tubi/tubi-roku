          translation="[810,382]"/>
        <Poster
          id="tubiKidsLogo"
          width="632"
          height="135"
          uri="pkg:/images/locale/en_US/logo-kids-white-xlarge.png"
          loadSync="true"
          visible="false"
          translation="[648,382]"/>
        </Group>
      <Label
        id="LoadingMessage"
        height="64"
        width="1920"
        horizAlign="center"
        vertAlign="center"
        translation="[0,606]">
        <Font
