        width="750"
        progress="50"
        translation="[584,696]"/>
    </Group>

    <Spinner
      id="LoadingSpinner"
      visible="false"
      showShade="false"
      width="1920"
      height="1080"
      translation="[0,0]"/>  

    <Group
      id="AdHeadsUp"
      visible="false"
      opacity="1.0">
      <Group id="adHeadsUpGroup">
        <Poster
          id="AdHeadsUpGradient"
          width="1920"
          height="317"
          translation="[0,0]"
          uri="pkg:/images/ads-countdown-gradient.9.png"/>
        <Label
          id="AdHeadsUpText"
          translation="[0,72]"
          height="66"
          horizAlign="center"
          vertAlign="center">
          <Font
            role="font"/>
        </Label>
      </Group>
      <AdBreakStartsInOverlay translation="[81, 81]" id="adBreakStartsInOverlay" visible="false" />
    </Group>

    <Poster
      id="VideoBrowseWhileWatchingOverlay"
      width="1920"
      height="1080"
      opacity="0.0"
      translation="[0,0]"
      uri="pkg:/images/gradient-ymal.webp"/>

    <Poster
      id="VideoOverlay"
      width="1920"
      height="1080"
      opacity="0.0"
      translation="[0,0]"
      uri="pkg:/images/playback-gradient-$$RES$$.9.png"/>

    <Group
      id="TopOverlay"
      translation="[0, 80]"
      opacity="0.0">

      <LayoutGroup
        id="TitleGroup"
        layoutDirection="vert"
        vertAlignment="top"
        horizAlignment="left"
        itemSpacings="[6]"/>

      <IconWithLabel
        id="sendFeedBackButtonTopRight"
        visible="false"
