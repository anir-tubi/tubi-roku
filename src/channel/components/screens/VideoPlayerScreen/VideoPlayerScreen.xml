    <TextIconButton
      id="skipCuepointsTextIconButton"
      uri="pkg:/images/transport/sgplayer/icon-skip-intro-nonfocus.webp"
      hasUnfocusedBackground="true"
      iconWidth="36"
      iconHeight="36"
      alwaysShowLabel="false"
      visible="false"/>

    <Group
      id="ratingOverlay"
      translation="[0,0]"
      opacity="0.0">
