<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoPlayerScreen" extends="BaseScreen" >
  <script type="text/brightscript" uri="VideoPlayerScreen.brs" />
  <script type="text/brightscript" uri="VideoTransportHandling.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EventMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiAds.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/AdsUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/source/3rdparty/google/gam_utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Sentry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/PlayerLogLib.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnalyticsMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/PlayerStatsMixin.brs" />

  <interface>

    <!-- INPUT -->
      <!-- Alias fields for the video node -->
      <field id="width" alias="VideoNode.width"/>
      <field id="height" alias="VideoNode.height"/>
      <field id="videoSponsorExposureId" type="string"/>

      <!-- New content has been added to the video player -->
      <field id="content" type="node"/>
      <field id="updateContent" type="boolean" alwaysNotify="true"/>
      <field id="sprites" type="node"/>
      <field id="upNextContent" alias="UpNext.content"/>
      <field id="upNextUpdateContent" alias="UpNext.updateContent"/>
      <field id="isAutoPlayOff" alias="UpNext.isAutoPlayOff"/>

      <!-- Valid values "play", "pause", "resume", "stop" -->
      <field id="control" type="string" value="none" alwaysNotify="true"/>

      <!-- interval in seconds for sending position data to the tracking server -->
      <field id="analyticsInterval" type="integer" value="0"/>

      <!-- WRITE-ONLY field tells if the video player should change its appearance to be kid friendly or not and same will be used for sending in AdServer-->
      <field id="appMode" type="string" value="DEFAULT_MODE" />

      <!-- Enable/disable ads breaks.  This can be changed during playback in order to
        -  postpone midrolls when there is an overlay (e.g. EPG) that the user is
        -  interacting with and we don't want to interrupt
        -->
      <field id="enableAds" type="boolean" value="true"/>

      <!-- State that lets the player know how it is being used, so it can determine
        -  how it should do tracking.
        -  Allowed sources are:
        -  'unknown'
        -  'previews'
        -  'automatic'
        -  'deliberate'
        -->
      <field id="playbackSource" type="assocArray" value="{}" />

      <!--
        -
        - Ad playback interface to main Brightscript thread
        -
        -->

      <!--
        - Written to by AdsTask.
        - Possible values: init, fetching, noAds, adsPending, adsPlaying, adsClosed, adsCompleted
        -->
      <field id="adState" type="string" value=""/>


      <!--
        - When the rainmaker receives the Ad response, adFilled will be set using TubiAds
        -->
      <field id="filledAdData" type="assocarray" alwaysNotify="true"/>

      <!--
        - When the RAF changes the playback tracking state, this AA object is set]
        - Possible keys are adcount, adindex, duration, rendersequence, type
        - For an update set of keys, see where this object is set: TubiAds.tubiAds_adTrackingCallback
        @see https://developer.roku.com/docs/developer-program/advertising/integrating-roku-advertising-framework.md#tracking
        -->
      <field id="adTrackingObject" type="assocarray" alwaysNotify="true"/>


      <!--
        - When the RAF changes the playback tracking state, this AA object is set]
        - Possible keys are adprogress, adindex, ad, canvaslayers
        - For an update set of keys, see where this object is set: TubiAds.tubiAds_adBufferingCallback
        @see https://developer.roku.com/docs/developer-program/advertising/integrating-roku-advertising-framework.md#tracking
        -->
      <field id="adBufferingObject" type="assocarray" alwaysNotify="true"/>

      <!--
        - Written to by the scene graph thread.
        - Possible values:  preroll, midroll, seek, play, stop
        -->
      <field id="adControl" type="string" value="" alwaysNotify="true"/>

      <!-- Message shown during ad loading and video loading -->
      <field id="loadingMessage" alias="LoadingMessage.text" />

      <!-- When this is set to true, then change LoadingMessage.text to reflect the propper message -->
      <field id="displayAdLoadingMessage" type="boolean" value="false" alwaysNotify="true"/>

      <!-- isTrailer will be set true for trailers, otherwise false -->
      <field id="isTrailer" type="boolean" value="false"/>

      <!-- preferredSubtitleTrack will hold user previously selected subtitle track obtained from either device settings endpoint.  -->
      <!-- Sample: {"language": "EN"} -->
      <field id="preferredSubtitleTrack" type="assocarray" value="{}" />

      <!-- preferredAudioTrack will hold user previously selected track obtained from either device settings endpoint.  -->
      <!-- Sample: {"language": "en","role": "main"} -->
      <field id="preferredAudioTrack" type="assocarray" value="{}" />

      <!-- pauseAd response node will be set to this field -->
      <field id="pauseAdResponse" type="node" alwaysNotify="true"/>

       <!-- sendPendingPauseAdPixel will be set when user press home key from remote -->
      <field id="sendPendingPauseAdPixel" type="boolean" alwaysNotify="true"/>

      <!-- Holds the consent opt out status for all individual preferences like marketing,analytics etc. -->
      <field id="userConsentsOptOutStatus" type="assocarray" value="{}" />

      <!-- Holds the tcf string value. -->
      <field id="tcfString" type="string" />

      <!-- YMAL content to be displayed on YMAL Row inside player -->
      <field id="relatedContent" type="node" />

      <!-- boolean field which tells the YMAL content is updated -->
      <field id="updateRelatedContent" type="boolean" alwaysNotify="true"/>

      <!-- browseContent content to be displayed on Browse While Watching Row -->
      <field id="browseContent" type="node" />

      <!-- boolean field which tells the browseContent is updated -->
      <field id="updateBrowseContent" type="boolean" alwaysNotify="true"/>

      <!-- boolean field which can be set to true for showing the YMAL in full screen and set focus to YMAL -->
      <field id="showYMALInFullScreen" type="boolean" alwaysNotify="true"/>

      <!-- Used to allow seeking the video player while still maintaining proper state tracking. Sets video player seek field to appropriate value and updates necessary state. `seek` field is time/double based and value specified should be in seconds -->
      <field id="seekTo" type="time" />

      <!-- boolean field which can be set to true for showing the BrowseWhileWatching in full screen and set focus to BrowseWhileWatching -->
      <field id="showBrowseWhileWatchingInFullScreen" type="boolean" alwaysNotify="true"/>

      <!-- time taken to load player screen in milliseconds -->
      <field id="loadTime" type="integer"/>

      <!-- exitPlayer helps to find out when to fire playerExit event -->
      <field id="exitPlayer" type="boolean"/>

      <!-- exitReason helps to find out how the player screen got exited/closed -->
      <field id="exitReason" type="string"/>

      <!-- isAdultParentalLevel will be set to true if the user is at the adult parental level -->
      <field id="isAdultParentalLevel" type="boolean" value="false" />

    <!-- OUTPUT -->
      <!-- Set to true if the back button was pressed while the video player has focus -->
      <field id="backButtonPressed" type="boolean" value="false" alwaysNotify="true" />
      <field id="upButtonPressed" type="boolean" value="false" alwaysNotify="true" />

      <field id="isAutoPlayTimerOn" type="boolean" value="true" />

      <field id="showSignUpModal" type="boolean" alwaysNotify="true" />

      <field id="position" type="float"/>

      <!-- Set to true if the skip trailer button was pressed -->
      <field id="skipTrailer" type="boolean" value="false" alwaysNotify="true" />

      <!-- Set to true if the "go to end" button was pressed on the transport,
           acts as an event and holds state, so must be reset -->
      <field id="goToNext" type="boolean" value="false" />

      <field id="state" type="string" />

      <!-- Video position for updates to history. This is only updated at historyFrequency interval -->
      <field id="historyPosition" type="integer" value="0" />

      <!-- field for communicating playback position to the ad shim -->
      <field id="adPosition" type="float" />

      <field id="adProgress" type="integer" value="0" />

      <!-- Error message to be displayed to the user -->
      <field id="errorMsg" type="string" />

      <!-- Error message as told by the video node  -->
      <field id="videoErrorMsg" type="string" alias="VideoNode.errorMsg" />

      <!-- Error code as told by the video node  -->
      <field id="videoErrorCode" type="integer" alias="VideoNode.errorCode" />

      <!-- Pass through Up Next component events to video helper -->
      <field id="upNextNavigateWithinPageInfo" alias="UpNext.navigateWithinPageInfo" />

      <!-- Pass through Related component events to video helper -->
      <field id="relatedNavigateWithinPageInfo" type="assocarray"/>

      <!-- Used to set the autoplay_deliberate and autoplay_automatic analytics values
           for PlayProgressEvents and StartVideoEvents. Allowed values are "automatic", "deliberate" and "unknown"
           -->
      <field id="autoplayMode" type="string" />

      <!-- Autoplay this content when this field is set -->
      <field id="upNextContentToAutoplay" type="node" />

      <!-- set to the contentNode of the Related item which was focused when
           the ok button is pressed
      -->
      <field id="relatedContentToPlay" type="node" />

      <!-- set to true when the relatedContentToPlay field is updated -->
      <field id="relatedContentToPlayUpdated" type="boolean" alwaysNotify="true"/>

      <!-- set to the contentNode of the homescreen item which was focused when
           the ok button is pressed
      -->
      <field id="homescreenContentToPlay" type="node"/>

      <!-- set to true when the homescreenContentToPlay field is updated -->
      <field id="homescreenContentToPlayUpdated" type="boolean" alwaysNotify="true"/>

      <!-- streamingSegment will be set when streamingSegment of videoNode value changes -->
      <field id="segInfo" type="assocarray"/>

      <!-- Is set to true when the creditsCuepoint has been reached or surpassed.
           Fires every time that Video.position updates and position is >= to the creditsCuepoint
       -->
      <field id="upNextCuepointReached" type="boolean" alwaysNotify="true"/>

      <!-- We observe the VideoNode state change and when the state = "error", the call back chain of events
           eventually sets VideoNode.control = "stop". Due to an idiosyncrasy in Roku behavior, this prevents
           the Youbora plugin from observing the error state on the video node, and so, we must manually trigger
           the Youbora plugin with the error info. The content controller observes this field and sends error info to Youbora.
      -->
      <field id="sendYouboraError" type="boolean" alwaysNotify="true" />
      <field id="sendVideoTrackingStart" type="boolean" alwaysNotify="true" />

      <!-- Timestamp of the last time we finished playing back video with this player. If -1 then we are currently playing back. -->
      <field id="timestampOfLastVideoPlayback" type="integer" value="0" />

      <!-- current player position will be set as integer to videoPositionForPauseAdRequest when user pauses the video
           this is used in pause Ad request -->
      <field id="videoPositionForPauseAdRequest" type="integer" />

      <!-- this field is triggered when the user pauses the video. This will let the helper know to get the pauseAd overlay info.-->
      <field id="getPauseAd" type="boolean" alwaysNotify="true"/>

      <!-- pixelUrl to fire during pause ad -->
      <field id="sendPauseAdPixel" type="string" alwaysNotify="true"/>

      <field id="subtitleTrackSettings" type="assocarray" value="{}" />
      <field id="audioTrackSettings" type="assocarray" value="{}" />

      <!-- Set the like/dislike state: valid strings are constants.ui.likeDislikeStates.liked or constants.ui.likeDislikeStates.disliked - or it can be an empty string "" to signify none.   -->
      <field id="autoPlayLikeDislikeState" type="string" alwaysNotify="true"/>

      <!-- set to true when the user selects like button in the player -->
      <field id="autoPlayLikeRemoveLikeSelected" type="boolean" alwaysNotify="true" />

      <!-- set to true when the user selects disLike button in the player -->
      <field id="autoPlayDisLikeRemoveDislikeSelected" type="boolean" alwaysNotify="true" />

      <!-- This field is used to expose the task to allow us to be able to communicate directly with the task from the contentController context regarding auth -->
      <field id="task" type="node" />
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1920"
      height="1080"
      enableUI="false"
      cgms = "3"
      enableTrickPlay="false"
      visible="true" />

    <Group
      id="RemainingMinimizedGroup"
