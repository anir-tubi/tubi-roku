                role="font"/>
            </Label>
          </LayoutGroup>
          <Label
            id="descriptorDesc">
            <Font
              role="font"/>
          </Label>
        </LayoutGroup>
      </LayoutGroup>
    </Group>

    <Poster
      id="controlIcon"
      width="48"
      height="48"
      loadSync="true"
      translation="[936, 515]"
      opacity="0.0"/>
      
    <Group
      id="UpNextParent">
      <UpNext
        id="UpNext"
        opacity="0.0" />
    </Group>

    <Group
      id="BrowseWhileWatchingRow"/>

    <Rectangle
      id="closedCaptionAndAudioSelectionOverlayGroup"
      opacity="0"
      width="1920"
      height="1080">
      <ClosedCaptionAndAudioSelectionOverlay
        translation="[1170, 90]"
        id="closedCaptionAndAudioSelectionOverlay" />
    </Rectangle>

    <Rectangle
      id="sendFeedbackSelectionOverlayGroup"
      opacity="0"
      width="1920"
      height="1080">
      <PlayerSideOverlay
        id="sendFeedbackSelectionOverlay" />
    </Rectangle>

    <PauseAdOverlay
      id="PauseAdOverlay"
      opacity="0.0"/>

    <!-- RAF needs a parent group with no other elements, otherwise it will use
      - the Group dimensions set by the other children and not scale appropriately.
      -->
    <Group
      id="RAFAdContainer" />

    <AdsTask
      id="AdsTask" />

    <PlayerStatsOverlay
      id="playerStatsOverlay"
      translation="[700, 30]"
      opacity="0.0" />

    <Timer
      id="ScrubTimer"
      duration="0.25"
      repeat="true" />

    <Timer
      id="ratingOverlayTimer"
      duration="15"
      repeat="false" />

    <Timer
      id="screenTime"
      duration="5"
      repeat="true" />

    <Timer
      id="PauseAdOverlayTimer"
      duration="5"/>

  </children>
</component>
