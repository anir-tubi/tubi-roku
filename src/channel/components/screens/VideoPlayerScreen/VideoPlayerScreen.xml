          visible="false"
          translation="[608,382]"/>
        </Group>
      <Label
        id="LoadingMessage"
        height="64"
        width="1920"
        horizAlign="center"
        vertAlign="center"
        translation="[0,606]">
        <Font
          role="font"/>
      </Label>
      <TubiProgressBar
