        translation="[584,696]"/>
    </Group>

    <Group
      id="AdHeadsUp"
      visible="false"
      opacity="1.0">
      <Poster
        id="AdHeadsUpGradient"
        width="1920"
        height="317"
        translation="[0,0]"
        uri="pkg:/images/ads-countdown-gradient.9.png"/>
      <Label
        id="AdHeadsUpText"
        translation="[85,72]"
        height="66"
        horizAlign="center"
        vertAlign="center">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="34"/>
      </Label>
    </Group>

    <Group
      id="VideoOverlay"
      opacity="0.0">
      <Poster
        id="TransportGradient"
        width="1920"
        height="1080"
        translation="[0,0]"
        opacity="1.0"
        uri="pkg:/images/playback-gradient-fhd.9.png"/>
      <Poster
        uri="pkg:/images/back.png"
        width="29"
        height="47"
        translation="[831,58]"/>
      <Label
        id="BackLabel"
        translation="[870,61]"
        height="47"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
      <Label
        id="VideoOverlayTitle"
        translation="[84,147]"
        width="1311"
        ellipsizeOnBoundary="true"
        height="73"
        vertAlign="center">
        <Font
          id="Vaud22px"
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="67" />
      </Label>
      <Label
        id="VideoOverlayEpisodeTitle"
        translation="[84,238]"
        width="1311"
        ellipsizeOnBoundary="true"
        height="46"
        vertAlign="center">
        <Font
          id="Vaud22px"
