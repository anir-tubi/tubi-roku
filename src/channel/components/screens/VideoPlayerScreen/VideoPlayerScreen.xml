<?xml version="1.0" encoding="utf-8" ?> 
<component name="VideoPlayerScreen" extends="BaseScreen" >
  <script type="text/brightscript" uri="VideoPlayerScreen.brs" />
  <script type="text/brightscript" uri="VideoTransportHandling.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="../../../source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>
  
    <!-- INPUT -->
      <!-- Alias fields for the video node -->
      <field id="position" alias="VideoNode.position"/>
      <field id="width" alias="VideoNode.width"/>
      <field id="height" alias="VideoNode.height"/>

      <!-- New content has been added to the video player -->
      <field id="content" type="node"/>
      <field id="updateContent" type="boolean" alwaysNotify="true"/>
      <field id="sprites" type="node"/>
      <field id="upNextContent" alias="UpNext.content"/>
      <field id="upNextUpdateContent" alias="UpNext.updateContent"/>

      <!-- Only support "play" and "stop" for simple external interface -->
      <field id="control" type="string" value="none" alwaysNotify="true"/>
      
      <!-- interval in seconds for sending position data to the tracking server -->
      <field id="analyticsInterval" type="integer" value="0"/>

      <!-- WRITE-ONLY field tells if the video player should change its appearance to be kid friendly or not and same will be used for sending in AdServer-->
      <field id="appMode" type="string" value="DEFAULT_MODE" />

      <!-- Enable/disable ads breaks.  This can be changed during playback in order to
        -  postpone midrolls when there is an overlay (e.g. EPG) that the user is
        -  interacting with and we don't want to interrupt
        -->
      <field id="enableAds" type="boolean" value="true"/>

      <!-- State that lets the player know how it is being used, so it can determine
        -  how it should do tracking.
        -  Allowed modes are:
        -  'normal'
        -  'trailer'
        -  'autoplay'
        -->
      <field id="analyticsMode" type="string" value="normal" />

      <!--
        -
        - Ad playback interface to main Brightscript thread
        -
        -->

      <!--
        - Written to by the main brightscript thread.
        - Possible values:  init, fetching, noads, adspending, adsplaying, adsclosed
        -->
      <field id="adState" type="string" value=""/>

      <!--
        - Written to by the scene graph thread.
        - Possible values:  preroll, midroll, seek, play, stop
        -->
      <field id="adControl" type="string" value="" alwaysNotify="true"/>

      <!-- Message shown during ad loading and video loading -->
      <field id="loadingMessage" alias="LoadingMessage.text" />

      <!-- When this is set to true, then change LoadingMessage.text to reflect the propper message -->
      <field id="displayAdLoadingMessage" type="boolean" value="false" alwaysNotify="true"/>

      <!--
        - List of midrolls as time in seconds.  This will be written to by main brightscript thread.
        -->
      <field id="midrolls" type="intarray" value="[]" />


    <!-- OUTPUT -->
      <!-- Set to true if the back button was pressed while the video player has focus -->
      <field id="backButtonPressed" type="boolean" value="false" alwaysNotify="true" />
      <field id="upButtonPressed" type="boolean" value="false" alwaysNotify="true" />

      <!-- Set to true if the skip trailer button was pressed -->
      <field id="skipTrailer" type="boolean" value="false" alwaysNotify="true" />

      <!-- Set to true if the "go to end" button was pressed on the transport,
           acts as an event and holds state, so must be reset -->
      <field id="goToNext" type="boolean" value="false" alwaysNotify="true" />    

      <field id="state" type="string" />
      
      <!-- Video position for updates to history. This is only updated at historyFrequency interval -->
      <field id="historyPosition" type="integer" value="0" /> 

      <!-- field for communicating playback position to the ad shim -->
      <field id="adPosition" type="int" />

      <field id="adProgress" type="integer" value="0" />

      <!-- Error message to be displayed to the user -->
      <field id="errorMsg" type="string" />

      <!-- Error message as told by the video node  -->
      <field id="videoErrorMsg" type="string" alias="VideoNode.errorMsg" />   

      <!-- Error code as told by the video node  -->
      <field id="videoErrorCode" type="integer" alias="VideoNode.errorCode" />

      <!-- Pass through Up Next component events to video helper -->
      <field id="upNextNavigateWithinPageInfo" alias="UpNext.navigateWithinPageInfo" />

      <!-- Used to set the autoplay_deliberate and autoplay_automatic analytics values
           for PlayProgressEvents and StartVideoEvents. Allowed values are "automatic", "deliberate" and "none"
           -->
      <field id="autoplayMode" type="string" />

      <!-- Autoplay this content when this field is set -->
      <field id="upNextContentToAutoplay" type="node" />
      
      <!-- streamingSegment will be set when streamingSegment of videoNode value changes -->
      <field id="segInfo" type="assocarray"/>

      <!-- Is set to true when the creditsCuepoint has been reached or surpassed.
           Fires every time that Video.position updates and position is >= to the creditsCuepoint
       -->
      <field id="upNextCuepointReached" type="boolean" alwaysNotify="true"/>

      <!-- We observe the VideoNode state change and when the state = "error", the call back chain of events
           eventually sets VideoNode.control = "stop". Due to an idiosyncracy in Roku behavior, this prevents
           the Youbora plugin from observing the error state on the video node, and so, we must manually trigger
           the Youbora plugin with the error info. The content controller observes this field and sends error info to Youbora.
      -->
      <field id="sendYouboraError" type="boolean" alwaysNotify="true" />
      <field id="sendVideoTrackingStart" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Video
      id="VideoNode"
      width="1920"
      height="1080"
      translation="[0,0]"
      enableUI="false"
      cgms = "3"
