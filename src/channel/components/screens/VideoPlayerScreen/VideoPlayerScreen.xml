        id="RemainingMinimizedLabel"
        text="-00:00"
        translation="[6,6]"
        horizAlign="center"
        vertAlign="center"
        width="0">
        <Font
          role="font"/>
      </Label>
    </Group>

    <Group
      id="MinimizedAssets"
      translation="[1240,40]">
        <Poster
          id="VideoBorder"
          visible="false"
          uri="pkg:/images/selector-$$RES$$.9.png"/>
      </Group>

    <Group
      id="Loading"
      visible="false">
      <Rectangle
        id="LoadingBackground"
        color="0x000000FF"
        width="1920"
        height="1080"/>
      <Group
        id="logoGroup">
        <Poster
          id="tubiLogo"
          width="462"
          height="135"
          uri="pkg:/images/logo-xlarge.webp"
          loadSync="true"
          translation="[734,382]"/>
        <Poster
          id="tubiKidsLogo"
          width="726"
          height="135"
          uri="pkg:/images/logo-kids-xlarge.webp"
