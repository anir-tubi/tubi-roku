<?xml version="1.0" encoding="UTF-8"?>

<!--
  VideoTilesScreen - Base screen component for screens that support video tiles
  
  Extends BaseScreen and includes all required fields for video tiles functionality.
  Screens that need video tiles support should extend this instead of BaseScreen.
  
  Note: listCurrFocusRow and listScrollingStatus are synced from the RowList via
  sub-observers in initVideoTilesScreen(). No need to manually alias these fields.
-->

<component name="VideoTilesScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="VideoTilesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/CacheValidationMixin.brs" />

  <interface>
    <!-- Video Tiles Required Fields -->

    <!-- Communicates to the parent that the video preview should be paused -->
    <field id="pauseVideoPreview" type="boolean" alwaysNotify="true" />

    <!-- Enables video tiles mode for the screen -->
    <field id="enableVideoTiles" type="boolean" />

    <!-- Indicates if the list has focus -->
    <field id="listHasFocus" type="boolean" value="false" />

    <!-- Current focus row in the row list (override with alias in concrete screen) -->
    <field id="listCurrFocusRow" type="float" />

    <!-- Row list translation for video tiles positioning -->
    <field id="rowListTranslation" type="array" value="[0, 0]" alwaysNotify="true" />

    <!-- List scrolling status (override with alias in concrete screen) -->
    <field id="listScrollingStatus" type="boolean" value="false" />

    <!-- Current focus column for scroll tracking (calculated by mixin, not aliased) -->
    <field id="rowCurrFocusColumn" type="integer" value="-1" />

    <!-- List scroll direction (up, down, left, right, none) -->
    <field id="listScrollDirection" type="string" value="none" />

    <!-- Current focused item bounding rectangle -->
    <field id="currentFocusedItemBoundingRect" type="assocarray" />

    <!-- In-transit focused item bounding rectangle (for animations) -->
    <field id="inTransitCurrentFocusedItemBoundingRect" type="assocarray" />

    <!-- Current cursor position in the RowList [row, column] -->
    <field id="cursorPosition" type="array" />

    <!-- User sign-in status -->
    <field id="isSignedInUser" type="boolean" />

    <!-- UI mode (normal, kids, etc.) -->
    <field id="uiMode" type="string" />

    <!-- Whether kids mode is active (suppresses IFA in ad requests, container refresh) -->
    <field id="isKidsMode" type="boolean" value="false" />

    <!-- Communicates to parent what was the last focused list was. -->
    <field id="lastFocusedList" type="string" value="rowList" />

    <!-- Controls whether to track viewable impression events for the screen -->
    <field id="shouldTrackViewableImpressionEvent" type="boolean" />

    <!-- End Video Tiles Required Fields -->

    <!-- Common Screen Fields (shared by all VideoTilesScreen subclasses) -->

    <!-- Content node containing the screen's data -->
    <field id="content" type="node" />

    <!-- When true, screen is in loading state -->
    <field id="isLoading" type="boolean" />

    <!-- Set to the contentNode of the RowList item which was selected -->
    <field id="contentSelected" type="node" />
    <field id="tileSelected" type="boolean" alwaysNotify="true" />

    <!-- Set to the contentNode of the RowList item which was focused -->
    <field id="contentFocused" type="node" />

    <!-- Boolean signal that fires after contentFocused is updated -->
    <field id="contentFocusedUpdated" type="boolean" alwaysNotify="true" />

    <!-- Content is loaded and ready to display -->
    <field id="contentReady" type="boolean" value="false" alwaysNotify="true" />

    <!-- Content Refresh Fields -->

    <!-- Enables content-level refresh checking (top-level content expiry) -->
    <field id="enableContentRefresh" type="boolean" value="false" />

    <!-- Enables container-level refresh checking (individual container expiry) -->
    <field id="enableContainerRefresh" type="boolean" value="false" />

    <!-- App/collection ID passed as app_id param in container refresh requests -->
    <field id="containerRefreshAppId" type="string" />

    <!-- Signal fired when top-level content needs refresh -->
    <field id="refreshContent" type="boolean" alwaysNotify="true" />

    <!-- Signal fired with IDs of expired containers needing refresh -->
    <field id="expiredContainerIds" type="array" alwaysNotify="true" />

    <!-- Pagination: tracks when tiles are being appended to a container during horizontal lazy loading.
         Possible values: "none", "start", "complete" -->
    <field id="containerAppendMoreTilesStatus" type="string" value="none" />
  </interface>
</component>