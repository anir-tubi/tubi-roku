<?xml version="1.0" encoding="utf-8" ?>
<component name="RokuCWConsentScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="RokuCWConsentScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>
    <!-- OUTPUT -->
    <!-- Contains id of the selected button. Possible values accept,reject. -->
    <field id="buttonSelected" type="string" alwaysNotify="true" />

    <!-- backButtonSelected is triggered when user selects the back button -->
    <field id="backButtonSelected" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <Poster
      id="background"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    <LayoutGroup
      translation="[192, 126]"
      itemSpacings="[15, 48]" >
      <Label
        id="heading">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="72" />
      </Label>
      <Label
        id="subheading"
        width="780"
        wrap="true">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="33" />
      </Label>
      <FilledButtonMarkupGrid
        id="buttonList"
        itemSize="[384, 72]"
        itemComponentName="ListItemButtonWithBg"
        itemSpacing="[0, 12]"
        numRows="3"
        numColumns="1"
        vertFocusAnimationStyle="floatingFocus"/>
    </LayoutGroup>
    <Poster
      id="demoImage"
      uri="pkg:/images/roku_cw_demo_image.webp"
      width="837"
      height="588"
      translation="[1083, 297]" />
  </children>
</component>
