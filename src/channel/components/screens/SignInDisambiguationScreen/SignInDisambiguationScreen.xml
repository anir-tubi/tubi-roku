<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInDisambiguationScreen
 -
 -
 - The first screen of the sign-in flow, it asks whether the user wants to sign in or
 - use a guest pass to view content.
 -
 -->
<component name="SignInDisambiguationScreen" extends="Group" >

  <script type="text/brightscript" uri="pkg:/components/screens/SignInDisambiguationScreen/SignInDisambiguationScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Set to true if the user selected the sign in button -->
    <field id="signInButtonSelected" type="boolean" value="false" alwaysNotify="true"/>
    
    <!-- Set to true if the user selected the guest pass button -->
    <field id="guestPassButtonSelected" type="boolean" value="false" alwaysNotify="true"/>

    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/login-choice" />    
  </interface>

  <children>
    <Poster
      id="Logo"
      uri="pkg:/images/logo-white-large.png"
      width="206"
      height="90"
      loadSync="true"
      translation="[857,311]"/>
    
    <RotatingLabel
      id="Slogan"
      translation="[0,544]"
      texts="[&quot;The largest library of free TV shows and movies&quot;,&quot;Watch for free on any device&quot;,&quot;100% free. No credit card required!&quot;]"
      crossfadeDuration="1"
      displayDuration="5"
      width="1920"
      horizAlign="center">
      <Font
      id="Vaud43SemiBold"
      role="font"
      uri="pkg:/fonts/Vaud-SemiBold.ttf"
      size="43" />
    </RotatingLabel>
    
    <FilledButtonMarkupGrid
      id="SignInOrGuestButtons"
      translation="[450,720]"
      itemComponentName="SignInButton"
      itemSize="[480,80]"
      itemSpacing="[60,0]"
      numRows="1"
      numColumns="2">
      <ContentNode role="content">
        <ContentNode id="signin" title="Sign in or Register Free"/>
        <ContentNode id="guestpass" title="Guest Pass"/>
      </ContentNode>
    </FilledButtonMarkupGrid>
  </children>
</component>
