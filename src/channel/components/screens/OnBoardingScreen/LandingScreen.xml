<?xml version="1.0" encoding="utf-8" ?>
<!--
 - LandingScreen
 -->
<component name="LandingScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="LandingScreen.brs" />

  <interface>

    <!-- OUTPUT -->

      <!-- Set to true if the user presses Register or SignIn button and corresponding callback gets invoked -->
      <field id="registerOrSignInButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true if the user presses Continue as guest button and corresponding callback gets invoked -->
      <field id="guestButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

  </interface>

  <children>

    <LayoutGroup
      id="labelButtonGroup"
      translation="[129,129]"
      layoutDirection="vert"
      vertAlignment="top"
      itemSpacings="[29,50,44,44,53]">

      <Label
        id="pageHeading"
        horizAlign="left"
        wrap="true"
        numLines="2"
        width="1250">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Label
        id="pageDescription"
        horizAlign="left"
        color="#D81A79"
        width="900">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="36" />
      </Label>

      <LayoutGroup
        id="addtoYourListGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        itemSpacings="[24]">

        <Poster
          id="addtoYourListIcon"
          height="72"
          width="72"
          uri="pkg:/images/add-to-your-list.webp"/>

        <LayoutGroup
          id="addtoYourListLabelGroup"
          layoutDirection="vert"
          vertAlignment="center"
          itemSpacings="[12]">

          <Label
            id="addtoYourListLabel"
            horizAlign="left"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="24" />
          </Label>

          <Label
            id="addtoYourListBody"
            horizAlign="left"
            opacity="0.64"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="21" />
          </Label>

        </LayoutGroup>

      </LayoutGroup>

      <LayoutGroup
        id="saveYourProgressGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        itemSpacings="[24]">

        <Poster
          id="saveYourProgressIcon"
          height="72"
          width="72"
          uri="pkg:/images/save-your-progress.webp"/>

        <LayoutGroup
          id="saveYourProgressLabelGroup"
          layoutDirection="vert"
          vertAlignment="center"
          itemSpacings="[12]">

          <Label
            id="saveYourProgressLabel"
            horizAlign="left"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="24" />
          </Label>

          <Label
            id="saveYourProgressBody"
            horizAlign="left"
            opacity="0.64"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="21" />
          </Label>

        </LayoutGroup>

      </LayoutGroup>

      <LayoutGroup
        id="madeForYouGroup"
        layoutDirection="horiz"
        vertAlignment="center"
        itemSpacings="[24]">

        <Poster
          id="madeForYouIcon"
          height="72"
          width="72"
          uri="pkg:/images/made-for-you.webp"/>

        <LayoutGroup
          id="madeForYouLabelGroup"
          layoutDirection="vert"
          vertAlignment="center"
          itemSpacings="[12]">

          <Label
            id="madeForYouLabel"
            horizAlign="left"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Bold.ttf"
              size="24" />
          </Label>

          <Label
            id="madeForYouBody"
            horizAlign="left"
            opacity="0.64"
            width="700">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-Medium.ttf"
              size="21" />
          </Label>

        </LayoutGroup>

      </LayoutGroup>

      <CommunicatingMarkupGrid
        id="buttonList"
        itemSize="[450,96]"
        itemComponentName="ButtonWithBackground"
        itemSpacing="[0,9]"
        numRows="3"
        numColumns="1"
        vertFocusAnimationStyle="floatingFocus"/>

    </LayoutGroup>

  </children>
</component>
