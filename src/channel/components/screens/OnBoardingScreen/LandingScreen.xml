<?xml version="1.0" encoding="utf-8" ?>
<!--
 - "LandingScreen"
 -->
<component name="LandingScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="LandingScreen.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />

  <interface>

    <!-- OUTPUT -->
    
      <!-- Set to true if the user presses Register for Tubi button and corresponding callback gets invoked -->
      <field id="registerButtonPressed" type="boolean" value="false" alwaysNotify="true"/>
      
      <!-- Set to true if the user presses Continue as Guest button and corresponding callback gets invoked -->
      <field id="guestButtonPressed" type="boolean" value="false" alwaysNotify="true"/> 
      
  </interface>

  <children>
  
    <Poster
      id="landingBackground"
      width="1920"
      height="1080"
      translation="[0,0]"/>
        
    <Poster
      id="tubiLogo"
      height="45"
      width="103"
      uri="pkg:/images/logo-white-large.png"
      translation="[1732,60]"/>  
 
    <LayoutGroup
      id="labelButtonGroup"
      translation="[120,372]"
      layoutDirection="vert"
      vertAlignment="top"
      itemSpacings="[16,48]">

      <Label
        id="pageHeading"
        horizAlign="left"
        wrap="true"
        numLines="3"
        width="750">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="84" />
      </Label> 
      
      <Label
        id="pageDescription"
        horizAlign="left"
        wrap="true"
        numLines="2"        
        width="750">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
      
      <CommunicatingMarkupGrid
        id="buttonList"
        itemSize="[487,84]"
        itemComponentName="SignInButton"
        itemSpacing="[0,6]"
        numRows="3"
        numColumns="1"
        vertFocusAnimationStyle="floatingFocus"/>                   
        
    </LayoutGroup>    
  
  </children>
</component>
