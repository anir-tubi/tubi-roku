<?xml version="1.0" encoding="utf-8" ?>
<!--
 - OnBoardingScreen
 -->
<component name="OnBoardingScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="OnBoardingScreen.brs" />

  <interface>

    <!-- INPUT -->
      <!-- buttons to be displayed on the screen, expected values are onBoarding_next_button, onBoarding_skip_button, onBoarding_getStarted_button -->
      <field id="buttons" type="stringarray" value="[]"/>

      <!-- carouselIndex is an integer which helps to set the index of dotCarousel component -->
      <field id="carouselIndex" type="integer" alias="dotCarousel.carouselIndex"/>

      <field id="title" type="string" alias="pageHeading.text"/>

      <field id="description" type="string" alias="pageDescription.text"/>

    <!-- OUTPUT -->

      <!-- Set to true if the user presses Next button and corresponding callback gets invoked -->
      <field id="nextButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true if the user presses Skip button and corresponding callback gets invoked -->
      <field id="skipButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true if the user presses Get Started button and corresponding callback gets invoked -->
      <field id="getStartedButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true if the user presses back key from remote and corresponding callback gets invoked -->
      <field id="backKeyPressed" type="boolean" value="false" alwaysNotify="true"/>

  </interface>

  <children>

    <Poster
      id="onBoardingBackground"
      width="1920"
      height="1080"
      translation="[0,0]"/>

    <LayoutGroup
      id="labelButtonGroup"
      translation="[129,390]"
      layoutDirection="vert"
      vertAlignment="top"
      itemSpacings="[53,22,62]">

      <DotCarousel
        id="dotCarousel"
        totalDots="3"/>

      <Label
        id="pageHeading"
        horizAlign="left"
        wrap="true"
        numLines="2"
        width="1250">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="72" />
      </Label>

      <Label
        id="pageDescription"
        horizAlign="left"
        wrap="true"
        numLines="2"
        opacity="0.8"
        width="919">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </LayoutGroup>

    <CommunicatingMarkupGrid
      id="buttonList"
      itemSize="[450,96]"
      itemComponentName="ButtonWithBackground"
      itemSpacing="[0,9]"
      numRows="3"
      numColumns="1"
      vertFocusAnimationStyle="floatingFocus"
      translation="[126,750]"/>

  </children>
</component>
