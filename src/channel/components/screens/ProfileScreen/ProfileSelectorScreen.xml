<?xml version="1.0" encoding="utf-8"?>

<component name="ProfileSelectorScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="ProfileSelectorScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="content" type="node" />
    <!-- if true, user can not navigate back from WWP -->
    <field id="disableBack" type="boolean" value="false" />

    <!-- OUTPUTS -->
    <!-- set to the profile id of the profile which was selected -->
    <field id="profileSelected" type="string" alwaysNotify="true" />
    <field id="contentReady" type="boolean" value="false" />
  </interface>

  <children>
    <LayoutGroup
      id="profileScreenContentGroup"
      horizAlignment="center"
      vertAlignment="center"
      layoutDirection="vert"
      translation="[960, 540]"
      itemSpacings="[166,125]">

      <Label
        id="ProfileScreenTitle">
        <Font
          role="font" />
      </Label>

      <MarkupGrid
        id="ProfileMenu"
        itemSize="[240, 360]"
        itemSpacing="[80, 0]"
        rowHeights="[240]"
        columnWidths="[240]"
        columnSpacings="[100]"
        numColumns="4"
        numRows="1"
        focusBitmapUri="pkg:/images/avatar_focus_$$RES$$.9.png"
        focusFootprintBitmapUri="pkg:/images/transparent.png"
        drawFocusFeedbackOnTop="false"
        itemComponentName="ProfileMenuItem" />

      <SimpleButton
        id="ContinueGuestButton" />
    </LayoutGroup>
  </children>
</component>