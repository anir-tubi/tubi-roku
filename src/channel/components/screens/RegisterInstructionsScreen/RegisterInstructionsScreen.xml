<?xml version="1.0" encoding="utf-8" ?>
<!--
 - RegisterInstructionsScreen
 - 
 - Present the user with a registration code to register on tubi.tv
 -->
<component name="RegisterInstructionsScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/RegisterInstructionsScreen/RegisterInstructionsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- INPUT -->
      <field id="skipSignInOption" type="boolean" value="false"/>

    <!-- OUTPUT -->
      <!-- Set to true if the user has successfully registered -->
      <field id="registerSuccess" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true when the "Sign in via Email" button is selected -->
      <field id="signInButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true when the "Skip" button on the error modal is selected -->
      <field id="skipButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- keeps the uri used for user tracking -->
      <field id="trackingUri" type="string"  value="/login-choice/code" />
  </interface>

  <children>
    <Label
      translation="[0,107]"
      text="Register or Link Account"
      horizAlign="center"
      width="1920">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="67" />
    </Label>
    
    <Poster
      id="Link"
      width="96"
      height="96"
      uri="pkg:/images/icon-link.png"
      translation="[912,248]"/>
            
    <Label
      text="Register for free or sign in online at"
      translation="[0,420]"
      horizAlign="center"
      width="1920">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27"/>
    </Label> 
           
    <Label
      text="tubi.tv/activate"
      translation="[0,481]"
      horizAlign="center"
      width="1920"
      color="0xff501a">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="43"/>
    </Label> 
    
    <Label
      text="then enter the activation code below"
      translation="[0,548]"
      width="1920"
      horizAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27"/>
    </Label> 
           
    <Label
      id="RegistrationCode"
      text=""
      translation="[0,609]"
      width="1920"
      horizAlign="center"
      color="0xff501a">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="43"/>
    </Label> 
    
    <Label
      text="This screen will automatically refresh once your device is linked"
      translation="[0,678]"
      width="1920"
      horizAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="24"/>
    </Label>

    <ScrollingList
      id="Buttons"
      layoutDirection="horiz"
      translation="[432,776]"
      height="80"
      width="1046"
      itemComponentName="SignInButton"
      itemSpacings="[86]">
    </ScrollingList>
    
  </children>
</component>
