<?xml version="1.0" encoding="utf-8" ?>
<!--
 - RegisterInstructionsScreen
 - 
 - Present the user with a registration code to register on tubi.tv
 -->
<component name="RegisterInstructionsScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/RegisterInstructionsScreen/RegisterInstructionsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- INPUT -->
      <field id="skipSignInOption" type="boolean" value="false"/>

    <!-- OUTPUT -->
      <!-- Set to true if the user has successfully registered -->
      <field id="registerSuccess" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true when the "Sign in via Email" button is selected -->
      <field id="signInButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true when the "Skip" button on the error modal is selected -->
      <field id="skipButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- keeps the uri used for user tracking -->
      <field id="trackingUri" type="string"  value="/login-choice/code" />
  </interface>

