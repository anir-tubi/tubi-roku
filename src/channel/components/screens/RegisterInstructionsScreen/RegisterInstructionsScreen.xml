      <field id="signInButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Set to true when the "Skip" button on the error modal is selected -->
      <field id="skipButtonPressed" type="boolean" value="false" alwaysNotify="true"/>

      <!-- keeps the uri used for user tracking -->
      <field id="trackingUri" type="string"  value="/login-choice/code" />
  </interface>

