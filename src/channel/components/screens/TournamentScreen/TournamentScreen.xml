<?xml version="1.0" encoding="utf-8" ?>
<component name="TournamentScreen" extends="BaseScreen">


  <script type="text/brightscript" uri="TournamentScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/UserMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="../../lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/ApiUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/MathUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/FIFAMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/DeviceMixin.brs" />


  <interface>
    <!-- INPUTS -->

      <!-- When the Helper receives valid category data from the server, it sets the new value to this field. -->
      <field id="content" type="Node" />

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- Is this needed? removes any existing content on the category grid list and epgTimegrid.  -->
      <field id="isLoading" type="boolean" />

      <!-- set to true if the user is signed in and we want to change the experience based on that -->
      <field id="signedIn" alias="CategoryGridList.signedIn" />

      <!-- Indicated whether to play/pause/stop video preview -->
      <field id="isVideoPreviewOn" type="boolean" value="true" />

      <!-- should the topNav refresh? -->
      <field id="refreshTopNav" type="boolean" alwaysNotify="true" />

      <!-- the id that top nav should treat as selected from a UI perspective -->
      <field id="topNavSelectedId" type="string" alias="topNav.selectedId" />

      <!--LinearTV is allowed in topNav if parental control is set to adult.-->
      <field id="isLinearTVAllowedInTopNav" type="boolean"/>

      <field id="jumpToRowItem" alias="CategoryGridList.jumpToRowItem" />

      <!-- Used to control which component gains focus when the focusedChild callback runs.
            Accepted values are in constants.ui.tournamentScreen.focusItems -->
      <field id="componentToFocus" type="string" />

      <!-- The number that is used as how many more seconds until the linear video player will be going fullscreen -->
      <field id="fullscreenCountdown" type="integer"/>

      <!--FIFA tournament start on Nov19. Any day before that is preTournament.-->
      <field id="isPreTournament" type="boolean" alwaysNotify="true"/>

      <!-- Trigger the content to be loaded. -->
      <field id="reloadTournamentScreen" type="boolean" value="false" alwaysNotify="true"/>

      <!-- incoming metadata from GeneralTask
           type is node, so that it takes less time to send data from one file to another file when comparing to assocarray
       -->
      <field id="batchResponse" type="node" alias="CategoryGridList.categoryResponseInBatch" />

      <!-- tells the rowList to re-populate the content because rows have been added/removed and that may affect the look of some rows that have different heights compared to other rows  -->
      <field id="repopulateContent" type="boolean" alias="CategoryGridList.repopulateContent" />

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean" />

      <!--force a refresh of containers on instant resume because containers might be stale-->
      <field id="setForceRefreshCategoryContainers" type="boolean" alwaysNotify="true" />


    <!-- OUTPUTS -->

      <field id="tournamentScreenEPGOkPressed" type="boolean" alwaysNotify="true"/>

      <!--This field also uses constants.ui.tournamentScreen.focusItems but it will indicate which grid is in focus as oppose to ComponentToFocus-->
      <field id="focusedComponent" type="string" />

      <!--Channel Item Focused-->
      <field id="linearChannelFocused" type="node" />

      <!--Channel Item to play in EPG video player or linear video player-->
      <field id="linearChannelToPlay" type="node"/>

      <!--The the video and hide the video player-->
      <field id="refreshTournamentScreenVideoPlay" type="boolean" alwaysNotify="true"/>

      <!-- set to the contentNode of the CategoryGridList item which was clicked on -->
      <field id="contentSelected" type="node"/>

      <!-- set to the contentNode of the CategoryGridList item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node"/>

      <!-- set to the tubi content of the item which was focused on -->
      <field id="contentFocused" type="node"/>

      <!-- set to the content node of the topNav item which was clicked on -->
      <field id="topNavItemSelected" type="node" alwaysNotify="true"/>

      <!-- set to the content node of the first item in the top nav since the back button was pressed -->
      <field id="topNavBackItemSelected" type="node" alwaysNotify="true"/>

      <!-- Indicates that a ComponentInteractionEvent should be fired because the TopNav
      has been toggled on or off -->
      <field id="topNavToggled" type="boolean" value="false" alwaysNotify="true"/>

      <!-- Indicates that the user is pressing back or left from the top nav (with the assumed
      intention to navigate to the side nav, but homescreen doesn't know about side nav) -->
      <field id="navigatedAwayFromTopNav" type="boolean" alwaysNotify="true" />

      <!-- set to the tubi content of the new row container (row of contentFocused) which was focused on -->
      <field id="rowFocused" alias="CategoryGridList.rowFocused"/>

      <field id="cursorPosition" alias="CategoryGridList.cursorPosition" />

      <field id="currCategoryId" alias="CategoryGridList.currCategoryId" />

      <field id="selectedPosition" alias="CategoryGridList.selectedPosition" />

      <!-- let helper know that content is loaded and spinner can be turned off and pageLoad event can be dispatched. -->
      <field id="contentReady" type="boolean" value="false" alwaysNotify="true" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.-->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- Pass through Program Guide component events to EpgScreen helper -->
      <field id="programGuideNavigateWithinPageInfo" alias="programGuide.navigateWithinPageInfo" />

      <!-- Pass through Program Guide component events to EpgScreen helper -->
      <field id="programGuidecomponentInteractionInfo" alias="programGuide.componentInteractionInfo" />

      <field id="componentInteractionInfo" type="assocarray"/>

      <field id="EPGScrollingStatus" alias="programGuide.scrollingStatus"/>

      <!-- Communicates to the parent that the video preview should be stopped -->
      <field id="stopVideoPreview" type="boolean" alwaysNotify="true"/>

      <!-- Valid duration has expired on a container. So reload the container with ID -->
      <field id="reloadTournamentScreenContainerID" type="stringarray" alwaysNotify="true" />

      <!-- When the Helper receives valid category data from the server, it sets the new value to this field. -->
      <field id="categoryContent" alias="CategoryGridList.content" />

  </interface>

  <children>
    <Group id="PageGroup">
      <TopNav
        id="topNav"
        translation="[0,48]"/>

      <Group
        id="InfoPanelParent">
        <InfoPanel
          id="InfoPanel"
          translation="[0,165]"
          maxHeight="354"
          maxTitleLines="2"
          visible="false"/>
      </Group>

      <CategoryGridList
        id="categoryGridList"/>

      <ProgramGuide
        id="programGuide"/>
      <Rectangle
      id="mask"
      opacity="0.1"
      height="520"
      width="1740"
      translation="[-7,550]" />
    </Group>
    <Timer
      id="TournamentRefreshTimer"
      repeat="true"/>

    <Animation
      id="Fades">
      <!-- keyValues here are in relation to CategoryGridList.currFocusRow when less than 1.0 -->
      <FloatFieldInterpolator
        id="HintGroupFade"
        fieldToInterp="UpHintGroup.opacity"
        key="[0.0,1.0]"
        keyValue="[1.0,0.0]"/>
      <FloatFieldInterpolator
        id="InfoPanelFade"
        fieldToInterp="InfoPanel.opacity"
        key="[0.0,1.0]"
        keyValue="[0.0,1.0]"/>
    </Animation>
  </children>
</component>
