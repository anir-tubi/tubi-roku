<?xml version="1.0" encoding="utf-8" ?>
<component name="ConsentScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="ConsentScreen.brs" />

  <interface>
    <!-- INPUT -->
    <!-- Holds the value of initial consent screen description. -->
    <field id="description" alias="description.text"/>

    <!-- OUTPUT -->
    <!-- Contains id of the selected button. Possible values manage,accept,reject. -->
    <field id="buttonSelected" type="string" alwaysNotify="true" />
  </interface>

  <children>
    <Poster
      id="background"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    <LayoutGroup
      translation="[192, 126]"
      itemSpacings="[15, 48, 147]" >
      <Label
        id="heading">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="72" />
      </Label>
      <Label
        id="subheading">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="33" />
      </Label>
    </LayoutGroup>
    <Group
      id="focusableSection"
      translation="[192, 309]">
      
      <FilledButtonMarkupGrid
        id="buttonList"
        itemSize="[384, 72]"
        itemComponentName="ListItemButtonWithBg"
        itemSpacing="[0, 12]"
        numRows="3"
        numColumns="1"
        vertFocusAnimationStyle="floatingFocus"/>
      <Poster
        id="descriptionBackground"
        uri="pkg:/images/menu-focus-$$RES$$.9.png"
        width="1053"
        height="672"
        translation="[483, 0]" />
      <ScrollableText
        translation="[519, 24]"
        id="description"
        scrollbarThumbBitmapUri="pkg:/images/scrollbar-unfocused-$$RES$$.9.png"
        scrollbarTrackBitmapUri="pkg:/images/transparent.png"
        width="954"
        height="621">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </ScrollableText>
    </Group>
  </children>
</component>
