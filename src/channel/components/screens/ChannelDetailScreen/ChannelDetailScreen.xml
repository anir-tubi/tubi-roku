<?xml version="1.0" encoding="utf-8" ?>
<!--
 - Channel Detail Screen
 -
 - This is a screen that displays information for a single content "channel".
 -
 -->
<component name="ChannelDetailScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/ChannelDetailScreen/ChannelDetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/CacheValidationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />

  <interface>
    <!-- INPUT -->
      <!-- content should be a container content node with a single channel content node filled with multiple item content nodes -->
      <field id="content" type="node"/>

      <!-- Should the screen load the content. This is set immediately after the content changes indicating that it is safe to load the content.  -->
      <field id="shouldLoadContent" type="boolean" alwaysNotify="true"/>

      <!-- hides or shows the loading spinner -->
      <field id="isLoading" type="boolean" alias="ChannelDetailSpinner.visible" />

    <!-- OUTPUT -->
      <!-- the content node representing the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- will be used to change the background images on the content controller -->
      <field id="backgroundUriList" type="stringarray" alwaysNotify="true"/>

      <!-- tells ContentController/ChannelScreenHelpers that the category metadata
           for the channel content is out of the cache window and should be updated -->
      <field id="refreshChannel" type="boolean" alwaysNotify="true" />

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- stores the component info of the component that was selected when navigating to a new screen. Looks like:
        {
          componentType: "category_component"    ' Corresponds to one of the page types in tubiTracking_getAnalyticsComponent() 
                                                 ' which mirrors the protos repo.
          componentValues: {}                    ' An assoc array with key/values that match the componentType as found in
                                                 ' tubiTracking_getAnalyticsComponent().
        }
      -->
      <field id="trackingComponentInfo" type="assocarray" />

      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be observed by the Homescreen, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <!-- Holds a load time start value [returned from UpTime()] that can be used to determine how long the page took to load.
           Used when showing a series/episode page
      -->
      <field id="trackingLoadStartTime" type="integer" />

      <!-- What is the previous page so it can be indicated on the call to action that is located on the top nav.
      -->
      <field id="callingPage" type="string" />
  </interface>

  <children>
    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        translation="[85,85]">
        <Label
          text="PRESS"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
        <Poster
          uri="pkg:/images/back.png"
          width="47"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
      <Poster
      id="tubiLogo"
      height="45"
      width="103"
      opacity="0.5"
      uri="pkg:/images/logo-white-large.png"
      translation="[1732,60]" />
    </Group>
    <InfoPanel
      id="ChannelsInfoPanel"
      mode="category"
      translation="[85,167]"
      maxHeight="325"
      maxTitleLines="2"
      visible="true" />

    <Label
      translation="[85,520]"
      id="pageTitle">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    <MarkupGrid
      id="ChannelsVideoGrid"
      translation="[85,584]"
      itemComponentName="CategoryGridPoster"
      itemSize="[210,300]" 
      itemSpacing="[10,28]"
      numRows="2"   
      numColumns="8"
      fadeFocusFeedbackWhenAutoScrolling="true"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/selector-fhd.9.png"/>

    <Spinner
      id="ChannelDetailSpinner"
      visible="false"
      isDisabled="false"
      width="1920"
      height="1080"
      translation="[0,0]"/>

  </children>
</component>