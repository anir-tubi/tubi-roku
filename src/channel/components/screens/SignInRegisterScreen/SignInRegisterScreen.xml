<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInRegisterScreen
 -
 - Present the user with an option to register via the web site or enter
 - credentials directly.
 -
 -->

<component name="SignInRegisterScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/SignInRegisterScreen/SignInRegisterScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Set to true if the user selects the sign-in button -->
    <field id="signInButtonSelected" type="boolean" value="false" alwaysNotify="true"/>
    
    <!-- Set to true if the user selects the register button -->
    <field id="registerButtonSelected" type="boolean" value="false" alwaysNotify="true"/>

    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/login-choice/signin-or-online" />    
  </interface>

  <children>
    <Label
      translation="[0,188]"
      text="Sign in or Register for Free on Tubi"
      horizAlign="center"
      width="1920">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="67" />
    </Label>
    
    <LayoutGroup
      itemSpacings="[275]"
      translation="[514,416]"
      layoutDirection="horiz">
      <Poster
       uri="pkg:/images/picto-register.png"
       width="306"
       height="198"/>
      <LayoutGroup
        layoutDirection="vert">
        <Rectangle
         width="290"
         height="4"
         color="0x00000000"/>
        <Poster
         uri="pkg:/images/picto-sign-in.png"
         width="306"
         height="198"/>
      </LayoutGroup>
    </LayoutGroup>
       
    <ScrollingList
      id="SignInOrRegisterButtons"
      layoutDirection="horiz"
      translation="[432,720]"
      height="80"
      width="1046"
      itemComponentName="SignInButton"
      itemSpacings="[86]">
      <ContentNode role="content">
        <ContentNode id="register" title="Register or Link Account"/>
        <ContentNode id="signin" title="Sign in via Email"/>
      </ContentNode>
    </ScrollingList>
    
    <LayoutGroup
      translation="[432,837]"
      layoutDirection="horiz"
      itemSpacings="[86]"
      opacity="0.5">
     <Label
       text="Register for free at tubi.tv or sign in to an existing account"
       wrap="true"
       width="480">
       <Font
         role="font"
         uri="pkg:/fonts/Vaud-Medium.ttf"
         size="22"/>
     </Label>
     <Label
       text="Use your email and password for your existing account"
       wrap="true"
       width="480">
       <Font
         role="font"
         uri="pkg:/fonts/Vaud-Medium.ttf"
         size="22"/>
     </Label>
    </LayoutGroup>
    
  </children>
</component>
