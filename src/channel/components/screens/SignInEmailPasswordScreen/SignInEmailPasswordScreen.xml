<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SignInEmailPasswordScreen
 -
 - Present the user with a form for entering email and password, then sign that user in.
 -->
<component name="SignInEmailPasswordScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/SignInEmailPasswordScreen/SignInEmailPasswordScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Set to true if the user has successfully signed in -->
    <field id="signInSuccess" type="boolean" value="false" alwaysNotify="true"/>

    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/login-choice/email" />    
  </interface>

  <children>
    <Poster
      id="Background"
      uri="pkg:/images/non-blurred-default-background.jpg"
      width="1920"
      height="1080"
      loadSync="true"
      translation="[0,0]"/>

    <Poster
      id="BackgroundGradient"
      uri="pkg:/images/sign-in-gradient.png"
      width="1920"
      height="1080"
      loadSync="true"
      translation="[0,0]"/>
      
    <Label
      translation="[595,355]"
      text="Sign Into Tubi TV"
      horizAlign="center"
      width="731">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="67" />
    </Label>
    
    <Group
      id="FormGroup"
      translation="[720,528]">
      
      <TextEntryBox
        id="EmailTextBox"
        hint="Email"
        translation="[0,0]"/>  
      <Poster
        id="EmailTextBoxFocus"
        uri="pkg:/images/frame-glow-hd3.9.png"
        visible="false"
        translation="[-13,-13]"
        width="506"
        height="106"/>  
      
      <TextEntryBox
        id="PasswordTextBox"
        hint="Password"
        passwordMode="true"
        translation="[0,104]"/>
      <Poster
        id="PasswordTextBoxFocus"
        uri="pkg:/images/frame-glow-hd3.9.png"
        visible="false"
        translation="[-13,91]"
        width="506"
        height="106"/>  
      
      <Group>
        <Poster
          id="SignInButtonFocus"
          uri="pkg:/images/menu-focus.9.png"
          width="480"
          height="80"
          visible="false"
          translation="[0,216]"/>
        <Poster
          id="SignInButtonDisabledFocus"
          uri="pkg:/images/menu-disabled-focus.9.png"
          width="480"
          height="80"
          visible="false"
          translation="[0,216]"/>
        <SignInButton
          id="SignInButton"
          translation="[0,216]">
          <ContentNode role="content" title="Sign In"/>
        </SignInButton>
      </Group>
      
    </Group>
   
    <!-- The keyboard: upper, lower, numbers, symbols -->
    <KeyboardGroup
      id="Keyboard"
      translation="[0,-500]"
      visible="false"/>
    
    <Animation
      id="KeyboardAnimation"
      duration="0.25">
      <Vector2DFieldInterpolator
        id="KeyboardTranslationInterpolator"
        key="[0.0, 1.0]"
        keyValue="[[0,0],[0,0]]"
        fieldToInterp="Keyboard.translation"/>
    </Animation>
    
    <Rectangle
      id="SpinnerShade"
      color="0x191919FF"
      width="1920"
      height="1080"
      opacity="0.8"
      translation="[0,0]"
      visible="false">
      <Rectangle
        id="SpinnerBox"
        height="200"
        width="200"
        color="0x2C2C2CFF"
        translation="[860,440]">
        <Poster
          id="Spinner"
          scaleRotateCenter="[33,33]"
          uri="pkg:/images/spinner.png"
          height="66"
          width="66"
          translation="[69,70]"/>
      </Rectangle>
    </Rectangle>
    
    <Animation
      id="SpinnerAnimation"
      duration="2.0"
      repeat="true"
      easeFunction="linear">
      <FloatFieldInterpolator
        id="SpinnerRotationInterpolator"
        key="[1.0, 0.0]"
        keyValue="[0.0, 6.28]"
        fieldToInterp="Spinner.rotation"/>
    </Animation>
    
  </children>
</component>
