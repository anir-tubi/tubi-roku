<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TimeUtils.brs" />

  <interface>
    <!-- INPUT -->
      <field id="signedIn" type="boolean" alwaysNotify="true"/>

      <!-- When the Helper receives valid data from the server, it sets the new value to this field. -->
      <field id="content" type="node"/>

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean" alwaysNotify="true"/>

      <!-- Change the UI based on the value of this field. -->
      <field id="kidsModeEnabled" value="false" type="boolean"/>


    <!-- OUTPUT -->
      <!-- set to the tubi content id of the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- set to the contentNode of the search results grid item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node" alwaysNotify="true"/>

      <!-- The current text that the user has entered to search -->
      <field id="searchText" type="string" value="" alwaysNotify="true" />
  </interface>

  <children>
    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[192,60]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>
    <LayoutGroup
      id="leftSide"
      layoutDirection="vert"
      itemSpacings="[24, 12]"
      horizAlignment="left"
      vertAlignment="top"
      translation="[192,120]">
      <Label
        id="searchMenuText"
        vertAlign="bottom"
        width="550">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="48"/>
      </Label>
      <Label
        id="searchHintText"
        vertAlign="bottom">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27"/>
      </Label>
      <LayoutGroup
        id="kidsModeGroup"
        layoutDirection="horiz">
        <!--KidsModeMessageSpacer used to position the kids-mode text so it left aligns with the keyboard-->
        <Rectangle
          id="KidsModeMessageSpacer"
          visible="false"
          width="1"
          height="1"/>
        <Label
          id="KidsModeMessage"
          vertAlign="top"
          width="550"
          height="50">
            <Font
              role="font"
              uri="pkg:/fonts/Vaud-SemiBold.ttf"
              size="27"/>
        </Label>
      </LayoutGroup>
    </LayoutGroup>

    <!-- Live text entry box with a non-blinking "cursor" -->
    <Label
      id="SearchText"
      vertAlign="center"
      translation="[786, 436]"
      width="1114"
      height="64">
      <Font
        id="SearchTextFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="36"/>
    </Label>

    <InfoPanel
      id="SearchScreenInfoPanel"
      visible="false"
      translation="[192, 120]"/>
    <Group
      id="searchGroup"
      translation="[192, 414]">
      <DynamicCustomKeyboard
        id="Keyboard"
        translation="[0,-20]"/>
   </Group>

    <!--::NOTE:: Unfortunately this group cannot be located within a layoutGroup because when it is not in focus,
    the resultGrid is slightly too low and too far to the right. It has to do something to do with the custom focusBitmapUri.  -->
    <Group
      translation="[786, 496]"
      id="ResultArea">
      <MarkupGrid
        id="ResultGrid"
        itemComponentName="CategoryGridPoster"
        itemSize="[198,282]"
        itemSpacing="[12,12]"
        numRows="3"
        numColumns="5"
        fadeFocusFeedbackWhenAutoScrolling="true"
        vertFocusAnimationStyle="fixedFocus"
        focusBitmapUri="pkg:/images/selector-fhd.9.png"/>
      <Spinner
        id="spinner"
        visible="false"
        showShade="false"
        modal="true"
        displayText="true"
        width="1094"
        height="575"/>
      <Label
        id="NoResultsMessage"
        vertAlign="center"
        horizAlign="center"
        width="1094"
        height="575"
        lineSpacing="5"
        numLines="2"
        wrap="true"
        opacity=".5"
        visible="false">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </Group>
    <Timer
      id="searchDebounce"
      duration="0.5"/>
  </children>
</component>
