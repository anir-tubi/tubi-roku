<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/InfoPanelMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/EPGMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiNodeHelpers.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/CacheValidationMixin.brs" />

  <interface>
    <!-- INPUT -->
      <field id="signedIn" type="boolean" alwaysNotify="true"/>

      <!-- When the Helper receives valid autocomplete data from the server, it sets the new value to this field. -->
      <field id="autocompleteContent" type="assocarray"/>

      <!-- When the Helper receives valid data from the server, it sets the new value to this field. -->
      <field id="content" type="node"/>

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean" alwaysNotify="true"/>

      <!-- If the user is eligible for trending search contents if the user is in usa and parental controls is enabled. -->
      <field id="isUserEligibleForTrendingSearchContents" type="boolean" />

    <!-- OUTPUT -->
      <!-- set to the tubi content id of the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- set to the contentNode of the search results grid item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node" alwaysNotify="true"/>

      <!-- The last input device used that affected the value of the searchText field. -->
      <field id="inputDeviceLastUsedForSearch" type="string" value=""/>

      <!-- The current text that the user has entered to search -->
      <field id="searchText" type="string" value="" alwaysNotify="true" />

      <!-- The autocomplete text that the user has selected from the autocomplete sughgestion list -->
      <field id="autoCompleteSearchText" type="string" value="" alwaysNotify="true" />

      <!-- The current text that the user has entered to search -->
      <field id="isKidsModeAvailable" value="true" type="boolean" />

      <!-- We have to create a field due to renderTracking events being async each itemComponent should be aware of what the mode was when it rendered. -->
      <field id="shouldTrackViewableImpressionEvent" type="boolean" value="true" />
  </interface>

  <children>
    <Group id="PageGroup">
      <Group
        id="leftSide"
        translation="[0,132]">

        <Group
          translation="[0,0]"
          id="autocomplete">
          <Label
            id="autocompleteHeading"
            width="552">
            <Font
              role="font"/>
          </Label>
          <FilledButtonMarkupGrid
            translation="[0,42]"
            id="autocompleteMenu"
            itemSize="[441,66]"
            itemComponentName="DetailMenuItem"
            itemSpacing="[0,12]"
            numRows="4"
            numColumns="1"
            vertFocusAnimationStyle="floatingFocus"/>
        </Group>
      </Group>

      <!-- Live text entry box with a non-blinking "cursor" -->
      <InfoPanel
        id="SearchScreenInfoPanel"
        visible="false"
        maxHeight="387"
        translation="[0, 105]"/>
      <Group
        id="searchGroup"
        translation="[0, 414]">
        <DynamicCustomKeyboard
          id="Keyboard"
          translation="[0,-20]"/>
     </Group>


      <Group
        id="rightSide"
        translation="[594,0]">

          <Group
            id="rightSideTextGroup"
            translation="[0,132]">
            <LayoutGroup
              id="searchDirectionsGroup"
              itemSpacings="[24, 12]"
              horizAlignment="left"
              vertAlignment="top">
              <Label
                id="searchMenuText"
                vertAlign="bottom"
                width="1032">
                <Font
                  role="font"/>
              </Label>
              <Label
                id="searchHintText"
                vertAlign="bottom">
                <Font
                  role="font"/>
              </Label>
              <Group
                  id="voiceGroup"/>
              <LayoutGroup
                id="kidsModeGroup"
                layoutDirection="horiz">
                <Label
                  id="KidsModeMessage"
                  vertAlign="top"
                  width="552"
                  height="51">
                    <Font
                      role="font"/>
                </Label>
              </LayoutGroup>
            </LayoutGroup>

            <LayoutGroup
              id="searchResultsMessageContainer"
              itemSpacings="[12]"
              translation="[0, 90]">
              <Label
                id="noMatchingResultsMessage"
                visible="false">
                <Font
                  role="font"/>
              </Label>
              <Label
                id="trendingResultsHint"
                visible="false">
                <Font
                  role="font"/>
              </Label>
            </LayoutGroup>

          </Group>

        <!--::NOTE:: Unfortunately this group cannot be located within a layoutGroup because when it is not in focus,
        the resultGrid is slightly too low and too far to the right. It has to do something to do with the custom focusBitmapUri.  -->
        <Group
          translation="[0, 474]"
          id="ResultArea">

          <Group
            id="gridContainer">

            <LayoutGroup
              id="resultsContainer">

              <Label
                id="SearchText"
                vertAlign="center"
                width="1113"
                height="63">
                <Font
                  id="SearchTextFont"
                  role="font"/>
              </Label>

              <MarkupGrid
                id="ResultGrid"
                itemComponentName="StarterGridItem"
                itemSize="[198,282]"
                itemSpacing="[12,12]"
                numRows="2"
                numColumns="5"
                fadeFocusFeedbackWhenAutoScrolling="true"
                vertFocusAnimationStyle="fixedFocus"
                focusFootprintBlendColor="#FFFFFF00"
                focusFootprintBitmapUri= "pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
                focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
            </LayoutGroup>

            <LayoutGroup
              id="trendingSearchResultsContainer"
              translation="[0, 640]">
              <Label
                id="trendingSearchHeading"
                vertAlign="center"
                width="1113"
                height="63">
                <Font
                  id="SearchTextFont"
                  role="font"/>
              </Label>

              <MarkupGrid
                id="trendingSearchResultGrid"
                itemComponentName="StarterGridItem"
                itemSize="[198,282]"
                itemSpacing="[12,12]"
                numRows="2"
                numColumns="5"
                fadeFocusFeedbackWhenAutoScrolling="true"
                vertFocusAnimationStyle="fixedFocus"
                focusFootprintBlendColor="#FFFFFF00"
                focusFootprintBitmapUri= "pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
                focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
            </LayoutGroup>
          </Group>

          <Spinner
            id="spinner"
            visible="false"
            showShade="false"
            modal="true"
            displayText="true"
            width="1094"
            height="475"/>
          <Label
            id="NoResultsMessage"
            vertAlign="center"
            horizAlign="center"
            width="1094"
            height="575"
            lineSpacing="5"
            numLines="2"
            wrap="true"
            opacity=".5"
            visible="false">
            <Font
              role="font"/>
          </Label>
        </Group>
      </Group>

      <Timer
        id="searchDebounce"
        duration="0.5"/>
    </Group>
  </children>
</component>
