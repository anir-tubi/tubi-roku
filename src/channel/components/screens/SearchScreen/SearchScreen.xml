<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="Keyboard">

  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen/SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  <script type="text/brightscript" uri="pkg:/source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />

  <interface>
    <!-- INPUT -->
      <field id="signedIn" type="boolean" alwaysNotify="true"/>

      <!-- metadataFetchTask pusts results on this field -->
      <field id="searchResponse" type="assocarray" alwaysNotify="true"/>

    <!-- OUTPUT -->
      <!-- set to the tubi content id of the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- stores the component info of the component that was selected when navigating to a new screen. Looks like:
        {
          componentType: "category_component"    ' Corresponds to one of the page types in tubiTracking_getAnalyticsComponent() 
                                                 ' which mirrors the protos repo.
          componentValues: {}                    ' An assoc array with key/values that match the componentType as found in
                                                 ' tubiTracking_getAnalyticsComponent().
        }
      -->
      <field id="trackingComponentInfo" type="assocarray" />


      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be observed by the Homescreen, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />
  </interface>
  
  <children>
    <!-- The keyboard: upper, lower, numbers, symbols -->
    <KeyboardGroup
      id="Keyboard"
      translation="[0,65]"/>

    <!-- The search label and icon that appear when the keyboard goes off-screen -->
    <Rectangle
      id="SearchHint"
      translation="[850,38]"
      opacity="0.0"
      visible="true">
      <Poster
       id="SearchHintIcon" 
       uri="pkg:/images/up-arrow.png"
       translation="[0,13]"
       height="47"
       width="47"
       loadDisplayMode="scaleToZoom" />
    
      <Label
       id="SearchHintText"
       translation="[51,0]" 
       vertAlign="center"
       horizAlign="left" 
       height="80"
       text="SEARCH AGAIN">
        <Font
         role="font"
         uri="pkg:/fonts/Vaud-SemiBold.ttf"
         size="22" />
       
      </Label>
    </Rectangle>
    
    <!-- Live text entry box with a non-blinking "cursor" -->
    <LayoutGroup
      id="TextEntryGroup"
      layoutDirection="horiz"
      translation="[85,315]"
      itemSpacings="[2]">
      <Label
        id="SearchText"
        text=""
        vertAlign="center"
        height="74">
        <Font
        id="SearchTextFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"     
        size="67"/>
      </Label>
      <Rectangle
        id="Cursor"
        visible="false"
        height="70"
        width="2"/>
    </LayoutGroup>

    <!-- Infopanel visible once the results grid is focused -->
    <InfoPanel
      id="SearchInfoPanel"
      mode="item"
      translation="[85,160]"
      visible="true"
      opacity="0.0"
      maxHeight="370"/>
    
    <Group
      id="UpdatingMessage"
      translation="[85,409]"
      visible="false">
      <Spinner
        id="SearchSpinner"
        isDisabled="true"
        width="66"
        height="66"/>
      <Label
        id="SearchUpdatingText"
        text="Updating your results..."
        translation="[76,22]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </Group>
    
    <Group
      id="ResultArea"
      translation="[85,616]">
      <PosterGrid
        id="ResultGrid"
        basePosterSize="[210,300]"
        itemSpacing="[10,10]"
        numColumns="8"
        numRows="2"
        vertFocusAnimationStyle="fixedFocus"
        focusBitmapUri="pkg:/images/selector-fhd.9.png"/>
      <Label
        id="NoResultsMessage"
        text="No Search Results"
        vertAlign="center"
        width="1750"
        height="390"
        visible="false">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="34" />
      </Label>
    </Group>

    <Animation
      id="TextEntryAnimation"
      duration="0.25">
      <FloatFieldInterpolator
        id="TextEntryScaleInterpolator"
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.5]"
        fieldToInterp=""/>
      <FloatFieldInterpolator
        id="InfoPanelOpacityInterpolator"
        key="[0.0, 1.0]"
        fieldToInterp="SearchInfoPanel.opacity"/>
      <FloatFieldInterpolator
        id="SearchHintOpacityInterpolator"
        key="[0.0, 1.0]"
        fieldToInterp="SearchHint.opacity"/>
      <Vector2DFieldInterpolator
        id="TextEntryTranslationInterpolator"
        key="[0.0, 1.0]"
        keyValue="[[85,315],[85,570]]"
        fieldToInterp="TextEntryGroup.translation"/>
      <Vector2DFieldInterpolator
        id="KeyboardTranslationInterpolator"
        key="[0.0, 1.0]"
        keyValue="[[0,0],[0,0]]"
        fieldToInterp="Keyboard.translation"/>
    </Animation>

  </children>
</component>
