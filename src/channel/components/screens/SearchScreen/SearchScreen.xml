<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="Keyboard">

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../tasks/MetadataFetchTask/MetadataFetchTaskDTO.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiLanguageTranslate.brs" />
  
  <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />

  <interface>
    <!-- INPUT -->
      <field id="signedIn" type="boolean" alwaysNotify="true"/>

      <!-- When the Helper receives valid data from the server, it sets the new value to this field. -->
      <field id="content" type="node"/>

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean" alwaysNotify="true"/>
      
      <!-- Change the UI based on the value of this field. -->
      <field id="kidsModeEnabled" value="false" type="boolean"/>


    <!-- OUTPUT -->
      <!-- set to the tubi content id of the item which was clicked on -->
      <field id="contentSelected" type="node"/>

      <!-- Keeps the information used for user tracking - structure looks like:
        {
          pageType: "video_page"  'corresponds to one of the page types in tubiTracking_getAnalyticsPage() which mirrors the protos repo
          pageValues: {}          'an assoc array with key/values that match the pageType as found in tubiTracking_getAnalyticsPage()
        }
      -->
      <field id="trackingPageInfo" type="assocarray" />

      <!-- stores the component info of the component that was selected when navigating to a new screen. Looks like:
        {
          componentType: "category_component"    ' Corresponds to one of the page types in tubiTracking_getAnalyticsComponent() 
                                                 ' which mirrors the protos repo.
          componentValues: {}                    ' An assoc array with key/values that match the componentType as found in
                                                 ' tubiTracking_getAnalyticsComponent().
        }
      -->
      <field id="trackingComponentInfo" type="assocarray" />


      <!-- Holds the information needed to populate a navigate_witin_page event. This will
           be observed by the Homescreen, which will subsequently pass it to the contentController
           which will be responsible for sending navigate_within_page events.
           See tubiTracking_getAnalyticsEvent for the format of the navigate_within_page AA
      -->
      <field id="navigateWithinPageInfo" type="assocarray" />

      <!-- The current text that the user has entered to search -->
      <field id="searchText" type="string" value="" alwaysNotify="true" />

      <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />

      <!-- Holds the "level" of the screen relative to other screens.
           Screens with smaller screenLevel values cannot be stacked on top of screens with higher screenLevel values.
           Attempting to do this action will result in screens being removed from the stack before the screen with the lower
           vaule is pushed to the stack.
       -->
      <field id="screenLevel" type="integer" />

      <!-- If set to true, allows screens of the same type and same screenLevel to stack on top of each other  -->
      <field id="isStackable" type="boolean" value="false" />

  </interface>
  
  <children>
    <Group id="nav">
      <LayoutGroup
        id="ScreenNavigationHint"
        layoutDirection="horiz"
        vertAlignment="custom"
        opacity="0.5"
        itemSpacings="[9]"
        translation="[168,55]">
        <Poster
          uri="pkg:/images/back.png"
          width="29"
          height="47"/>
        <Label
          id="callToAction"
          vertAlign="center"
          height="47"
          translation="[0,2]">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="22" />
        </Label>
      </LayoutGroup>
    </Group>
    <LayoutGroup
        id="content"
        translation="[148,158]"
        layoutDirection="horiz"
        vertAlignment="top"
        horizAlignment="left"
        itemSpacings="[67]">
      <LayoutGroup
          id="leftSide"
          layoutDirection="vert"
          itemSpacings="[16]"
          horizAlignment="left"
          vertAlignment="top">
        

        <LayoutGroup
          id="kidsModeGroup"
          layoutDirection="horiz">
          <!--KidsModeMessageSpacer used to position the kids-mode text so it left aligns with the keyboard-->
          <Rectangle 
            id="KidsModeMessageSpacer"
            visible="false"
            width="20"
            height="1"/>  
          <Label
            id="KidsModeMessage"
            vertAlign="bottom"
            width="550"
            height="50">
              <Font
                role="font"
                uri="pkg:/fonts/Vaud-SemiBold.ttf"     
                size="27"/>
          </Label>
        </LayoutGroup>

        <MiniKeyboard
          id="Keyboard"
          showTextEditBox="false">
        </MiniKeyboard>
      </LayoutGroup>
      <!-- Live text entry box with a non-blinking "cursor" -->
      <Label  
        id="SearchText"
        vertAlign="center"
        width="1114"
        height="64">
        <Font
        id="SearchTextFont"
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"     
        size="43"/>
      </Label>
    </LayoutGroup>
  
    <!--::NOTE:: Unfortunately this group cannot be located within a layoutGroup because when it is not in focus, 
    the resultGrid is slightly too low and too far to the right. It has to do something to do with the custom focusBitmapUri.  -->
    <Group
      translation="[798, 244]"
      id="ResultArea">
      <PosterGrid
        id="ResultGrid"
        loadingBitmapUri = "pkg:/images/placeholder.jpg"
        basePosterSize="[198,282]"
        itemSpacing="[12,12]"
        numColumns="5"
        numRows="3"
        vertFocusAnimationStyle="fixedFocus"
        focusBitmapUri="pkg:/images/selector-fhd.9.png"/>
      <Spinner
        id="spinner"
        visible="false"
        showShade="false"
        modal="true"
        displayText="true"
        width="1094"
        height="575"/>
      <Label
        id="NoResultsMessage"
        vertAlign="center"
        horizAlign="center"
        width="1094"
        height="575"
        lineSpacing="5"
        numLines="2"
        wrap="true"
        opacity=".5"
        visible="false">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Medium.ttf"
          size="27" />
      </Label>
    </Group>
  </children>
</component>
