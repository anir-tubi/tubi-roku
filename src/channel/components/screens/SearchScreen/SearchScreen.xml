<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="BaseScreen">

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="../../lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="../../lib/FocusMixin.brs" />
  <script type="text/brightscript" uri="../../lib/UserMixin.brs" />
  <script type="text/brightscript" uri="../../lib/ContentMixin.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
  <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
  <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
  <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/TypographyMixin.brs"/>
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />

  <interface>
    <!-- INPUT -->
      <field id="signedIn" type="boolean" alwaysNotify="true"/>

      <!-- When the Helper receives valid data from the server, it sets the new value to this field. -->
      <field id="content" type="node"/>

      <!-- The helper class will call this when the new content is ready to be displayed on the screen. -->
      <field id="contentUpdated" type="boolean" alwaysNotify="true"/>

      <!-- If the screen is not enabled, then user should not be able to select anything -->
      <field id="enabled" type="boolean" alwaysNotify="true"/>

      <!-- If the user is eligible for trending search below experiment checks if the user is in us and parental controls is enabled and user is in the experiment. -->
      <field id="isUserEligibleForTrendingSearchBelowExperiment" type="boolean" />

    <!-- OUTPUT -->
      <!-- set to the tubi content id of the item which was clicked on -->
      <field id="contentSelected" type="node" alwaysNotify="true"/>

      <!-- set to the contentNode of the search results grid item which was focused when
           the "play" input transport deeplink was triggered
      -->
      <field id="contentToPlay" type="node" alwaysNotify="true"/>

      <!-- The current text that the user has entered to search -->
      <field id="searchText" type="string" value="" alwaysNotify="true" />
  </interface>

  <children>
    <Group id="PageGroup">
      <Group
        id="leftSide"
        translation="[0,120]">
        <LayoutGroup
          itemSpacings="[24, 12]"
          horizAlignment="left"
          vertAlignment="top">
          <Label
            id="searchMenuText"
            vertAlign="bottom"
            width="552">
            <Font
              role="font"/>
          </Label>
          <Label
            id="searchHintText"
            vertAlign="bottom">
            <Font
              role="font"/>
          </Label>
          <LayoutGroup
            id="kidsModeGroup"
            layoutDirection="horiz">
            <!--KidsModeMessageSpacer used to position the kids-mode text so it left aligns with the keyboard-->
            <Rectangle
              id="KidsModeMessageSpacer"
              visible="false"
              width="1"
              height="1"/>
            <Label
              id="KidsModeMessage"
              vertAlign="top"
              width="552"
              height="51">
                <Font
                  role="font"/>
            </Label>
          </LayoutGroup>
        </LayoutGroup>

        <LayoutGroup
          id="searchResultsMessageContainer"
          itemSpacings="[12]"
          translation="[0, 90]">
          <Label
            id="noMatchingResultsMessage"
            visible="false">
            <Font
              role="font"/>
          </Label>
          <Label
            id="trendingResultsHint"
            visible="false">
            <Font
              role="font"/>
          </Label>
        </LayoutGroup>
      </Group>

      <!-- Live text entry box with a non-blinking "cursor" -->
      <InfoPanel
        id="SearchScreenInfoPanel"
        visible="false"
        translation="[0, 120]"/>
      <Group
        id="searchGroup"
        translation="[0, 414]">
        <DynamicCustomKeyboard
          id="Keyboard"
          translation="[0,-20]"/>
     </Group>

      <!--::NOTE:: Unfortunately this group cannot be located within a layoutGroup because when it is not in focus,
      the resultGrid is slightly too low and too far to the right. It has to do something to do with the custom focusBitmapUri.  -->
      <Group
        translation="[594, 435]"
        id="ResultArea">

        <Group
          id="gridContainer">

          <LayoutGroup
            id="resultsContainer">

            <Label
              id="SearchText"
              vertAlign="center"
              width="1113"
              height="63">
              <Font
                id="SearchTextFont"
                role="font"/>
            </Label>

            <MarkupGrid
              id="ResultGrid"
              itemComponentName="StarterGridItem"
              itemSize="[198,282]"
              itemSpacing="[12,12]"
              numRows="2"
              numColumns="5"
              fadeFocusFeedbackWhenAutoScrolling="true"
              vertFocusAnimationStyle="fixedFocus"
              focusFootprintBlendColor="#FFFFFF00"
              focusFootprintBitmapUri= "pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
              focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
          </LayoutGroup>

          <LayoutGroup
            id="trendingSearchResultsContainer"
            translation="[0, 640]">
            <Label
              id="trendingSearchHeading"
              vertAlign="center"
              width="1113"
              height="63">
              <Font
                id="SearchTextFont"
                role="font"/>
            </Label>

            <MarkupGrid
              id="trendingSearchResultGrid"
              itemComponentName="StarterGridItem"
              itemSize="[198,282]"
              itemSpacing="[12,12]"
              numRows="2"
              numColumns="5"
              fadeFocusFeedbackWhenAutoScrolling="true"
              vertFocusAnimationStyle="fixedFocus"
              focusFootprintBlendColor="#FFFFFF00"
              focusFootprintBitmapUri= "pkg:/images/selectorRoundedCorners-$$RES$$.9.png"
              focusBitmapUri="pkg:/images/selectorRoundedCorners-$$RES$$.9.png"/>
          </LayoutGroup>
        </Group> 
        
        <Spinner
          id="spinner"
          visible="false"
          showShade="false"
          modal="true"
          displayText="true"
          width="1094"
          height="575"/>
        <Label
          id="NoResultsMessage"
          vertAlign="center"
          horizAlign="center"
          width="1094"
          height="575"
          lineSpacing="5"
          numLines="2"
          wrap="true"
          opacity=".5"
          visible="false">
          <Font
            role="font"/>
        </Label>
      </Group>

      <Timer
        id="searchDebounce"
        duration="0.5"/>
    </Group>
  </children>
</component>