<component name="OTPCGroupView" extends="Group">
    <interface>
        <field id="viewData" type="assocarray" onchange="onViewData" />
        <field id="groupDetail" type="assocarray" alwaysNotify="true" />
        <field id="isLeftPressed" type="boolean" alwaysNotify="true" />
        <field id="isRightPressed" type="boolean" alwaysNotify="true" />
        <field id="childIndex" type="integer" />
        <field id="itemFocus" type="boolean" alwaysNotify="true" />
        <field id="isFocus" type="boolean" onChange="setViewFocus" alwaysNotify="true" />
        <field id="isVendorFocus" type="string" onChange="setVendorViewFocus" alwaysNotify="true" />
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="itemFocused" type="node" alwaysNotify="true" />
        <field id="updateGroups" type="assocarray" alwaysNotify="true" onChange="onGroupUpdate" />
        <function name="onKeyDownClose" />
    </interface>

    <script type="text/brightscript" uri="../OTPreferenceCenter/OTPCGroupView.brs" />
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/style.brs"></script>

    <children>
        <Animation id="privacyAnimation" repeat="false" duration="0.2"
            easeFunction="linear">
            <Vector2DFieldInterpolator id="privacyInterpolator" key="[0.0, 1.0]"
                fieldToInterp="mainRect.translation" />
        </Animation>
        <Group translation="[50,120]" id="mainGroup">
            <Rectangle id="mainRect" height="1080" translation="[0,0]">
                <MarkupGrid
                    id="buttonList"
                    itemComponentName="OTButtonListView"
                    itemSize="[560, 60]"
                    itemSpacing="[0,0]"
                    numRows="5" vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false"
                    translation="[50,460]"
                />
                <Poster id="leftArrow" loadwidth="30" loadheight="30" width="30" height="30"
                    uri="pkg:/components/OTPublishersSDK/images/arrow_backward.png"
                    translation="[1220,50]" visible="false" />
                <LayoutGroup id="titleLayout" layoutDirection="vert" vertAlignment="top"
                    translation="[50,150]">
                    <Label id="heading" font="font:LargeBoldSystemFont" width="600" text=""
                        maxLines="3"
                        wrap="true" scale="[0.0,0.0]" />
                    <MarkupGrid
                        id="buttonsListGrp"
                        itemComponentName="OTButtonListView"
                        itemSize="[560, 0]"
                        itemSpacing="[0, 0]"
                        numColumns="1"
                        numRows="2"
                        vertFocusAnimationStyle="floatingFocus"
                        drawFocusFeedback="false"
                        translation="[0,0]"
                    />
                    <Label id="normalDescription" font="font:SmallSystemFont" width="600" text=""
                        wrap="true" scale="[0.0,0.0]" />
                    <Rectangle id="IabIllustrationsRec" scale="[0.0,0.0]">
                    </Rectangle >
                    <LayoutGroup id="policyLinkRec" layoutDirection="vert" vertAlignment="top">
                        <Label id="policyLinkText" font="font:SmallSystemFont" text="" wrap="true"
                            visible="false" />
                        <Poster id="qrCodeImg" width="0" height="0" uri="" loadSync="true"
                            loadDisplayMode="scaleToFit" visible="false" />
                    </LayoutGroup>
                    <MarkupGrid
                        id="vendorbuttonList"
                        itemComponentName="OTButtonListView"
                        itemSize="[560, 0]"
                        itemSpacing="[0, 15]"
                        numRows="2"
                        vertFocusAnimationStyle="floatingFocus"
                        drawFocusFeedback="false"
                        translation="[0,0]"
                    />
                    <Label id="sunGrpHeading" font="font:MediumBoldSystemFont" width="600" text=""
                        height="50" vertAlign="bottom" wrap="true" scale="[0.0,0.0]" />
                    <MarkupGrid
                        id="subGrpListGrp"
                        itemComponentName="OTButtonListView"
                        itemSize="[560, 0]"
                        itemSpacing="[0, 0]"
                        numRows="12"
                        vertFocusAnimationStyle="floatingFocus"
                        drawFocusFeedback="false"
                        translation="[0,0]"
                    />
                    <Label id="descriptionLegal" font="font:SmallSystemFont" width="600" text=""
                        wrap="true" scale="[0.0,0.0]" />
                </LayoutGroup>
            </Rectangle>
        </Group>
        <Rectangle id="actionRect" width="1000" height="120" translation="[45,600]">
            <MarkupGrid
                id="actionButtonList"
                itemComponentName="OTButtonListView"
                itemSize="[560, 60]"
                itemSpacing="[30, 0]"
                numRows="1"
                numColumns="3"
                vertFocusAnimationStyle="floatingFocus"
                drawFocusFeedback="false"
                translation="[60,30]"
            />
        </Rectangle>
    </children>
</component>