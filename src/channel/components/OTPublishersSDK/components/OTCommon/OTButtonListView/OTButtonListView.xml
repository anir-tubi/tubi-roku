<?xml version="1.0" encoding="utf-8" ?>
<component name="OTButtonListView" extends="Group">
	<interface>
		<field id="itemContent" type="node" onChange="itemContentChanged" />
		<field id="focusPercent" type="float" onChange="updateFocus"
			alwaysNotify="true" />
		<field id="gridHasFocus" type="boolean" alwaysNotify="true" />
		<field id="width" type="float" alwaysNotify="true" />
		<field id="height" type="float" alwaysNotify="true" />
		<field id="index" type="float" alwaysNotify="true" />
		<field id="status" type="string"  />
		<field id="isunFocused" type="boolean"  />
		<field id="arrowIndication" type="string"  />
	</interface>
	<script type="text/brightscript" uri="../../OTCommon/OTButtonListView/OTButtonListView.brs" />
	<script type="text/brightscript" uri="../OTUtilities/vendor.helper.brs" />
	<script type="text/brightscript" uri="../OTUtilities/utils.brs" />
	<children>
		<Group>
			<Rectangle id="border" width="484" height="60" color="0x000000" translation="[0,0]" opacity="0.3" />
			<Rectangle id="seletedBg" width="450" height="56"
				translation="[0,0]" Color="0x00ff00" >
			</Rectangle>
			<Poster id="btnImg" loadwidth="30" loadheight="30" width="30" height="30" uri="pkg:/components/OTPublishersSDK/images/button.png" visible="false" translation="[0,10]"/>
			<Poster id="filterImg" loadwidth="30" loadheight="30" width="30" height="30" uri="pkg:/components/OTPublishersSDK/images/filter.png" visible="false" translation="[0,15]"/>
			<Label id="itemText" width="300" height="60"  horizAlign="left" vertAlign="center" translation="[10,0]" wrap="true" maxLines="2" visible="true"/>
			<Label id="additionalText" width="300" horizAlign="left" vertAlign="center" translation="[10,0]" wrap="true" visible="true"/>
			<Poster id="leftArrow" loadwidth="30" loadheight="30" width="30" height="30" uri="pkg:/components/OTPublishersSDK/images/arrow_backward.png" visible="false" translation="[0,0]"/>
			<Rectangle id="statusRec" translation="[0,0]">
				<Label id="statusText" width="120" height="60"  horizAlign="right" vertAlign="center" visible="false" font="font:SmallestSystemFont" translation="[0,0]" maxLines="2" wrap="true"/>
				<Poster id="statusImage" loadwidth="30" loadheight="30" width="30" height="30" uri="" visible="false" scale="[0,0]" translation="[80,15]"/>
				<Poster id="rightArrow" loadwidth="30" loadheight="30" width="30" height="30" uri="pkg:/components/OTPublishersSDK/images/arrow_forward.png" visible="false" translation="[90,15]"/>
			</Rectangle>
		</Group>
	</children>
</component>
