<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "PauseAdsContentNode" extends="ContentNode">
  <interface>
    <field id="requestId" type="string" />
    <field id="mediaUrl" type="string" />
    <field id="startPixels" type="stringarray" />
    <field id="impTrackingPixels" type="stringarray" />
    <field id="endPixels" type="stringarray" />
    <field id="notUsedPixels" type="stringarray" />
    <field id="errorPixels" type="stringarray" />
  </interface>
</component>
