<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name="TubiContentNode" extends="ContentNode">
  <interface>
    <field id="type" type="string" />
    <field id="gridItemType" type="string" />
    <field id="isOriginal" type="boolean" />
    <field id="parentType" type="string" />
    <field id="parentTitle" type="string" />
    <field id="parentId" type="string" />
    <field id="parentHistoryId" type="string" />
    <field id="landscape" type="string" />
    <field id="portrait" type="string" />
    <field id="genres" type="stringarray" />
    <field id="rokuGenres" type="stringarray" />
    <field id="hasSubtitles" type="boolean" />
    <field id="hasAudioDescription" type="boolean" />
    <field id="language" type="string" />
    <field id="pubid" type="string" />
    <field id="country" type="string" />
    <field id="backgrounds" type="stringarray" />
    <field id="titleImageUrl" type="string" />
    <field id="cuepoints" type="array" />
    <field id="slug" type="string" />
    <field id="bookmarkId" type="string" />
    <field id="seriesId" type="string" />
    <field id="nowPos" type="int" />
    <field id="historyId" type="string" />
    <field id="currentEpisodeId" type="string" />
    <field id="isTrailer" type="boolean" value="false" />
    <field id="hasTrailer" type="boolean" value="false" />
    <field id="trailerInfo" type="assocarray" />
    <field id="deeplinkType" type="string" />
    <field id="videoPreviewUrl" type="string" />
    <field id="releaseDate" type="string" />
    <!--This is sportsEvent data and so  added dynamically
    <field id="roundGroupInfo" type="string" />-->

    <field id="needsLogin" type="boolean"  value="false"/>
    <!--Not intended to be used as stand alone. This field only represents reason of locking if needsLogin = true-->
    <field id="loginReason" type="string" />

    <field id="hasVideoResources" type="boolean" />

    <!-- tracking info to be used specifically by youbora. The names of the keys of this AA will be under: constants.thirdParty.youbora.trackingKeys -->
    <field id="youboraTracking" type="assocarray" value="{}"/>

    <!-- true if the content is child directed content (CDC) -->
    <field id="isCdc" type="boolean" />

    <!-- descriptors are "ratings descriptors", used to display additional information about TV ratings, eg. [{"code": "L","description": "Coarse or crude language"}, {"code": "R","description": "Violence"}] -->
    <field id="descriptors" type="array" />
    <!-- descriptorCode value is taken from descriptor array eg. "L V"-->
    <field id="descriptorCode" type="string" />
    <!-- descriptorDescription value is taken from descriptor array eg. "Coarse or crude language, Violence"-->
    <field id="descriptorDescription" type="string" />
    <field id="creditCuePoints" type="assocarray" />

    <!-- these will come in for paginated responses -->
    <field id="totalCount" type="int" value="-1"/>

    <!-- used to deliver focus indices to EpisodeScreen RowList row item counter -->
    <field id="focusIndex" type="integer" value="-1"/>

    <!-- for related content items displayed on the detail screen -->
    <field id="relatedContent" type="node" />

    <field id="thumbnailUrls" type="stringarray" />
    <field id="thumbnailSpan" type="integer" />
    <field id="thumbnailSize" type="intarray"/>
    <field id="thumbnailRows" type="integer"/>
    <field id="thumbnailColumns" type="integer"/>

    <!-- channels feature -->
    <field id="inlineLogoUri" type="string" />
    <field id="channelId" type="string" />
    <field id="channelName" type="string" />

    <!-- individual stream resources -->
    <field id="videoResources" type="array"/>

    <field id="isRecurring" type="boolean"/>

    <!-- the current drm type -->
    <field id="drmType" type="string"/>

    <!-- the current codec, it will be inserted in client logs when playback fails -->
    <field id="codec" type="string"/>

    <!-- the current resolution, it will be inserted in client logs when playback fails -->
    <field id="resolution" type="string"/>

    <!-- the current VideoResource index, it helps to play the video in order -->
    <field id="currentVideoResourceIndex" type="vector2d" value="[0,0]"/>

    <!-- the hdcp_version as returned by cms/content API. example: "hdcp_v1" -->
    <field id="hdcpVersion" type="string"/>

    <!-- availability_ends: eg. "2019-03-31T00:00:00Z" -->
    <field id="availabilityEnds" type="string"/>

    <!-- air_datetime: eg. "2019-09-24T14:15:22Z" -->
    <field id="airDateTime" type="string"/>

    <!-- if UpTime(0) > validUntil, then refetch metadata for this content -->
    <field id="validUntil" type="integer"/>

    <!-- State of channel program: none, loading, partial, loaded -->
    <field id="state" type="string" value="none" />

    <!-- This field is dynamically added to content before playing.
      possible values are enum: constants.player.playbackOrigin:
        deeplink
        ap_auto
        ap_select
        container
        ymal
        search

    <field id="adParam" type="assocArray" />-->

    <field id="playerType" type="string" />

    <!-- ID of a preview. It is used to send for analytic events -->
    <field id="previewId" type="string" />

  </interface>
</component>
