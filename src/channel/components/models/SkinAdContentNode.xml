<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "SkinAdContentNode" extends="AdContentNode">
  <interface>

    <!-- The background color to be displayed on the homescreen when the app is sponsored  -->
    <field id="bgColor" type="string"/>

    <!-- The string that should be displayed before the title or titleImage (logo)  -->
    <field id="titlePrefix" type="string"/>

    <!-- The string that represents the text that is below the description. Usually this text instructs the user what to do with the QR code.  -->
    <field id="subDescription" type="string"/>

    <!-- url of the QR code -->
    <field id="qrCodeUrl" type="string"/>

  </interface>
</component>
