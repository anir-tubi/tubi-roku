<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "TubiSponsorImagesNode" extends="ContentNode">
  <interface>
    <field id="brandLogo" type="string" />
    <field id="brandGraphic" type="string" />
    <!-- Thematic takeover ad ID for pixel tracking -->
    <field id="thematicTakeoverId" type="string" />
    <!-- An array of impression pixels -->
    <field id="pixels" type="array" />
  </interface>
</component>
