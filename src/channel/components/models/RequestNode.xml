<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name="RequestNode" extends="ContentNode">
  <interface>
    <!-- input field is an associative array containing all the items passed to
         GeneralTask.makeRequest() except the callbacks.
    -->
    <field id="input" type="assocarray" />

    <!-- The status of the request node: i.e. created, canceled, error, success -->
    <field id="status" type="string" value="created"/>

    <!-- retries field tells how many times the api should retry if is fails -->
    <field id="retries" type="integer" value="3"/>

    <!-- API Retry request will be made after a delay. this delay logic is decided based on backoffFactor & pause fields. -->
    <field id="backoffFactor" type="float" value="1.5"/>

    <!-- api retry will happen after a sleep of below mentioned time -->
    <field id="pause" type="integer" value="1000"/>
  </interface>
</component>
