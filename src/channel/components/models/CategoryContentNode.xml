<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "CategoryContentNode" extends="ContentNode">
  <interface>
    <!-- inherited field id="id" type="string";  category id as sent from the server -->
    <field id="type" type="string"/>

    <!-- these will come in for paginated responses -->
    <field id="totalCount" type="int" value="-1"/>

    <!-- json sources for CategoryGridList -->
    <field id="json" type="string" />

    <!-- if the category is nested under a "complex" category in the matrix API -->
    <field id="parentId" type="string" />

    <!-- currently focused item index to communicate to CategoryGridRowLabel -->
    <field id="focusIndex" type="integer" value="-1"/>

    <!-- State of category children: none, loading, partial, loaded -->
    <field id="state" type="string" value="none"/>

    <!-- One of the gridItemTypes in constants (ie. "portrait", "landscape").
         Indicates which type of content will be shown in this category row.
     -->
    <field id="gridItemType" type="string" />

    <!-- A logo that will be displayed for channels -->
    <field id="logoUri" type="string" />

    <!-- A thumbnail that will be displayed as the background of channel and category containers -->
    <field id="thumbnail" type="string" />

    <field id="slug" type="string" />

    <!-- if UpTime(0) > validUntil, then refetch metadata for this container/category. We have 2 special values of 0 which indicates it will be refreshed always and -1 which indicates content does not need to be refreshed ever. -->
    <field id="validUntil" type="integer"/>

    <!-- TubiSponsorImagesNode object that include sponsor images and screen specific pixel info. -->
    <field id="sponsorImages" type="node"/>

    <!-- Sponsor Exposure ID to send to rainmaker when playing the video. -->
    <field id="sponsorExp" type="string"/>

    <field id="subtext" type="string" />

    <field id="ads" type="node" />

    <field id="relatedTo" type="node" />

    <!-- UI customization data for child content (e.g. SOT badge labels) -->
    <field id="child_ui_customization" type="assocarray" />
  </interface>
</component>
