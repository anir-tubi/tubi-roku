<?xml version="1.0" encoding="utf-8" ?>
<!-- Extend the ContentNode so we can add some custom fields -->
<component name = "DeeplinkContentNode" extends="ContentNode">
  <interface>
    <!-- inherited field id="id" type="string";  content id, as received from deeplink parameter,
       - series id not yet prefixed with 0
     -->

    <!-- where the deeplink came from, ie. "iphone", "android", etc.-->
    <field id="source" type="string" />

    <!-- use to associate deeplinks with marketing campaigns - filled by the "entry" deeplink parameter -->
    <field id="campaign" type="string" />

    <!-- type of campaign -->
    <field id="medium" type="string" />

    <!-- internal content type -->
    <field id="type" type="string" />

    <!-- where the deeplink will resume from -->
    <field id="nowPos" type="int" />

    <!-- movie, episode, series, season as dictated by roku's deeplink api-->
    <field id="deeplinkType" type="string" />

    <!-- the device id of the source device in the case of "casting" from iOS -->
    <field id="sourceDeviceId" type="string" />
  </interface>
</component>
