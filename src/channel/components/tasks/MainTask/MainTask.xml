<?xml version="1.0" encoding="utf-8" ?>
<!--
 - MainTask
 -
 - Since we are not able to update code in main.brs we use this task to handle code that would have normally run there
 -
 -->
<component name="MainTask" extends="Task">
  <script type="text/brightscript" uri="MainTask.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <!-- INPUTS -->
    <!-- At minimum should have {type: <<REQUEST_TYPE>>} additional keys can be included if more information is needed for the request -->
    <field id="request" type="assocarray" />

    <!-- OUTPUT -->
    <!-- Combination of roHdmiStatus and roCECStatus hdmi checks to know if we're ok to playback video -->
    <field id="isHdmiStatusOk" type="boolean" />

    <!-- The amount of time before the screensaver will start playing in. Value is in seconds -->
    <field id="screensaverTimeout" type="integer" />

    <!-- Will contain information related to the low memory event. -->
    <field id="lowMemoryEventInfo" type="assocarray" />
  </interface>
</component>
