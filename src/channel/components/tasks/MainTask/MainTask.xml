<?xml version="1.0" encoding="utf-8" ?>
<!--
 - MainTask
 -
 - Since we are not able to update code in main.brs we use this task to handle code that would have normally run there
 -
 -->
<component name="MainTask" extends="Task">
  <script type="text/brightscript" uri="MainTask.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/GlobalMixin.brs" />

  <interface>
    <!-- INPUTS -->
    <field id="transportVoiceResponse" type="assocarray"/>

    <!-- OUTPUT -->
    <!-- Combination of roHdmiStatus and roCECStatus hdmi checks to know if we're ok to playback video -->
    <field id="isHdmiStatusOk" type="boolean" />

    <!-- any info that is passed into the channel via roInput/ECP while the channel is running
    can be deeplinks, transport controls, voice commands, etc. -->
    <field id="roInputInfo" type="assocarray" />
  </interface>
</component>
