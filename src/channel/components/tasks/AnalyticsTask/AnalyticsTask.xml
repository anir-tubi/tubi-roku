<?xml version="1.0" encoding="utf-8" ?>
<!--
 - AnalyticsTask
 -
 - This task makes requests to the analytics API and can be included in Starter Component Package
 - To add it in Starter Component package, include AnalyticsTask.xml & AnalyticsTask.rs in buildStarter function of gulpfile.js
 -
 -->
<component name="AnalyticsTask" extends="Task">

    <script type="text/brightscript" uri="AnalyticsTask.brs" />

    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/StringUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiLanguageTranslate.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

    <interface>
      <!-- INPUT -->
        <field id="constants" type="assocArray" />
        <field id="experimentTracking" type="assocArray" />
     <!-- OUTPUT -->
        <field id="analyticsResponse" type="boolean" />
    </interface>

</component>
