<component name="AdsSSAITask" extends="Task">
    <script type="text/brightscript" uri="AdsSSAITask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiAds.brs" />
    <script type="text/brightscript" uri="../../../source/lib/YoSpaceId3s.brs" />
