<?xml version="1.0" encoding="utf-8" ?>
<!--
 - AdsTask
 -
 -->
<component name="AdsSSAITask" extends="Task">
    <script type="text/brightscript" uri="AdsSSAITask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiTracking.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiAds.brs" />
    <script type="text/brightscript" uri="../../../source/lib/YoSpaceId3s.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/rodash/rodash.cat.brs" />

    <interface>
      <!-- INPUT -->
        <!-- The url used to poll for ad metadata. This is provided in the hls manifest by yospace. -->
        <field id="pollUrl" type="string" />

        <!-- The current position of the video as provided by the video player -->
        <field id="videoPosition" type="float" />

        <!-- id3 tags are metadata included in the stream itself about the current video segment that is playing.
             These are used by yospace to indicate when ad content or ad filler video is playing.
        -->
        <field id="id3Tags" type="assocarray" />

        <field id="content" type="node" />
        <field id="updateContent" type="boolean" />
        <field id="videoIsFullscreen" type="boolean" />
        <field id="exit" type="boolean" />

        <!-- tells the task that the linear playback has been stopped -->
        <field id="playbackStopped" type="boolean" alwaysNotify="true" />

        <!-- This field is used strictly to hold external state, as there was no other good
             place to store it. It is not used internal to this task.
         -->
        <field id="manifestAttempts" type="integer" value="0" />

      <!-- OUTPUT -->
        <!-- updated video resources with urls that include ad params needed by yospace to fetch ads from
             rainmaker.
        -->
        <field id="videoResourcesWithAdParams" type="array" />

        <!-- indicates if the video is currently playing ads as indicated by yospace id3 tags -->
        <field id="isPlayingAds" type="boolean" value="false" />

        <!-- due to ad filler behavior isPlayingAdFiller changes values frequently and cannot be
             relied on to be 100% accurate at all times. Please be careful if using outside of AdsSSAITask
        -->
        <field id="isPlayingAdFiller" type="boolean" value="false" />
    </interface>
</component>
