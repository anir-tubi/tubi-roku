<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - MetadataFetchTask
 -
 - This is a long-lived task which will multiplex handling
 - of many HTTP requests simultaneously.  We want many
 - requests to happen in parallel but we don't want to
 - let the thread count to get out of control nor incur
 - the overhead of spinning up a new thread for each
 - metadata HTTP request. 
 -
 --> 
<component name="MetadataFetchTask" extends="Task">
    <script type="text/brightscript" uri="MetadataFetchTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/CmsApi.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
    
    <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />

    <interface>
      <!-- INPUT -->
        <!--
         - Single request - see MetadataFetchTaskDTO.brs for structure
         -->
        <field id="request" type="assocarray" alwaysNotify="true"/>
      
        <!--
         - Batch request - see MetadataFetchTaskDTO.brs for structure
         -->
        <field id="batchRequest" type="assocarray" alwaysNotify="true"/>

        <!-- 
         - Cancel an outstanding request - see MetadataFetchTaskDTO.brs for structure
         -->
        <field id="cancel" type="assocarray" alwaysNotify="true"/>
    </interface>
</component>
