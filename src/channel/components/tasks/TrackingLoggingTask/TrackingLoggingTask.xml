<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - AuthTask
 -
 - Retrieve the auth info, which may be stored and might be refreshed from the auth server.
 -
 --> 
<component name="TrackingLoggingTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/TrackingLoggingTask/TrackingLoggingTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiTracking.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!--
        -
        - The trackEvent field should have the following form:
        - {
        -   trackType: <node to receive content>
        -   value: dynamic, depends on the eventType
        -   ctx: dynamic, depends on the eventType
        -   extraCtx: dynamic, depends on the eventType
        - }
        -
        - for more info on trackEvent values, please see:
        - https://tubitv.atlassian.net/wiki/pages/viewpage.action?spaceKey=EC&title=Analytics+Events
        -->
        <field id="trackEvent" type="assocarray" alwaysNotify="true"/>


        <!--
        -
        - The logMsg field should have the following form:
        - {
        -   message: string, the message to be logged
        -   level: string, the type of debug, must be one of "debug", "error", "info", "warn"
        -   serverType: string, a string specified as one that is in TubiLogger().logConsts
        -   subtype: string, a small string used to differentiate log messages
        - }
        -
        -->      
        <field id="logMsg" type="assocarray" alwaysNotify="true"/>
      

      <!-- OUTPUT -->
        <!-- Set to true once the task thread is running and input fields are being observed -->
        <field id="ready" type="boolean" value="false" />
    </interface>
</component>
