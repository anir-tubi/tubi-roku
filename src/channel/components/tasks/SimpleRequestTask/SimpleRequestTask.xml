<?xml version="1.0" encoding="utf-8" ?>
<!--
 - SimpleRequestTask
 -
 - This is a task to make an HTTP request, the result body of which will be stored in a field on this object
 -
 -->
<component name="SimpleRequestTask" extends="Task">
    <script type="text/brightscript" uri="SimpleRequestTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/rta/typeUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!-- URI to request -->
        <field id="uri" type="uri"/>

        <!-- Optional node and field to set the response on.  If not set, SimpleRequestTask.response will be set -->
        <field id="node" type="node" />
        <field id="field" type="string" value="" />

      <!-- OUTPUT -->
        <!-- Set to the response body if SimpleRequestTask.node and SimpleRequestTask.field were not set -->
        <field id="response" type="string" />
    </interface>
</component>
