<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInTask
 -
 - This is a short-lived task for exchanging credentials for an access token.
 -
 --> 
<component name="SignInTask" extends="Task">
    <script type="text/brightscript" uri="SignInTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <field id="email" type="string" />
        <field id="password" type="string" />

      <!-- OUTPUT -->
        <!-- Set on sucess or failure to:
        -   {
        -     code: <integer http response code>
        -     data: <http response body>
        -     failReason: <string failure reason from roUrlEvent.GetFailureReason()>
        -   }
        -->
        <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
