<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - UpNextTask
 -
 - This is a task to get releated content or recommended alternatives to show at the end of a title
 -
 --> 
<component name="UpNextTask" extends="Task">
    <script type="text/brightscript" uri="UpNextTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!--
        - Expect the request to contain:
        -   {
        -     contentId:
        -     categoryId:
        -     kidsMode: 
        -   }
        -
        -->
        <field id="request" type="assocarray"/>
      
      <!-- OUTPUT -->
        <!-- Set to the parsed TubiContentNode on success -->
        <field id="response" type="node" />
      
        <!-- Set when an error occurs to:
        -   {
        -     code: <integer http response code>
        -     data: <http response body>
        -     failReason: <string failure reason from roUrlEvent.GetFailureReason()>
        -   }
        -->
        <field id="error" type="assocarray" />
    </interface>
</component>
