<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - RegistrationTask
 -
 - This is a short-lived task for invoking registration-oriented API calls.
 - Callers should set the frequency and expiration and:
 -   1) observe 'code' to detect the registration code having been generated
 -   2) observe 'response' to check when code changes state to "registered"
 -   3) observe 'state' to detect if the task exists upon reaching the expiration time
 -
 --> 
<component name="RegistrationCodeTask" extends="Task">
    <script type="text/brightscript" uri="RegistrationCodeTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!-- Set the poll frequency for registration code status updates -->
        <field id="frequency" type="int" value="2000" alwaysNotify="true" />

        <!-- Set the number of consecutive polling failures before we stop polling -->
        <field id="maxConsecPollFailures" type="int" value="30" />
      
        <!-- Set the expiration time in seconds after which the task will stop polling status -->
        <field id="expiration" type="int" value="600" alwaysNotify="false" />
      
        <!-- Set this to true in order to cancel the polling loop and exit the thread function -->
        <field id="cancel" type="boolean" value="false" alwaysNotify="true" />


      <!-- OUTPUT -->
        <!-- once the registration code has been generated, it will be stored here -->
        <field id="code" type="string" value="" alwaysNotify="true" />
      
        <!-- Set to the response body of the status call. -->
        <field id="response" type="assocarray" alwaysNotify="true" />
      
        <!-- Set to communicate to the screen that an error as occured. Value should indicate what type of error occurred -->
        <field id="error" type="string" alwaysNotify="true" />
    </interface>
</component>
