<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - AuthTask
 -
 - Retrieve the auth info, which may be stored and might be refreshed from the auth server.
 -
 --> 
<component name="AuthTask" extends="Task">
    <script type="text/brightscript" uri="AuthTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiBookmarks.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiNodeHelpers.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!-- Content for queue and history changes with fields:
        -
        -    addToQueue:
        -        content.id
        -        content.type
        -
        -    removeFromQueue:
        -        content.id
        -        content.bookmarkId
        -
        -    removeFromHistory:
        -        content.id
        -        content.historyId
        -
        -    updateHistory:
        -        content.id
        -        content.type
        -        content.parentId (only necessary if content is episode in a series)
        -->
        <field id="content" type="node" />

        <!-- updateHistory:
         -       Seconds since start of content to store in history
         -->
        <field id="nowPos" type="integer" />

        <!-- updateParentalSetting -->
        <field id="password" type="string"/>

        <field id="parentalSetting" type="integer"/>

        <field id="externalAuthInfo" type="assocarray"/>

        <field id="isKidsMode" type="boolean" />

      <!-- OUTPUT -->
        <!-- execInitializeUserData, execAuthRefresh, execSignOut, updateHistory:
        -        auth info blob from Auth.getAuthInfo(), or invalid if signed out
        -->
        <field id="authInfo" type="assocarray" alwaysNotify="true" />

        <!-- execAuthRefresh:
        -        auth info blob from Auth.getAuthInfo(), or invalid if signed out
        -->
        <field id="authInfoRefreshed" type="assocarray" alwaysNotify="true" />


        <field id="userInfo" type="assocarray" alwaysNotify="true" />

        <!-- number of days since the unix epoch when the device first opened Tubi -->
        <field id="firstVisit" type="integer" />

        <!-- execInitializeUserData, execSignOut:
        -        BookmarkContentNode tree of bookmarks
        -->
        <field id="bookmarks" type="node" />

        <!-- execInitializeUserData, execSignOut:
        -        HistoryContentNode tree of history
        -->
        <field id="history" type="node" />

        <!-- addBookmarkResult:
        -        Result of request as:
        -        {
        -          code: <integer http response code>
        -          bookmarkId: <bookmark id>
        -          failReason: <string from roUrlEvent.GetFailureReason()>
        -        }
        -->
        <field id="addBookmarkResult" type="assocarray" alwaysNotify="true" />

        <!-- removeFromQueue, removeFromHistory:
        -        Result of request as:
        -        {
        -          code: <integer http response code>
        -          data: <http response body>
        -        }
        -->
        <field id="result" type="assocarray" alwaysNotify="true" />
      
        <!-- updateHistory:
        -        History response with structure:
        -        {
        -          historyId: <id of the history entry>
        -          parentHistoryId: <id of the series, only set if content episodic>
        -        }
        -->
        <field id="historyResult" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
