<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - ChannelsCategoriesMetadataTask
 -
 - This is a task to get channels and catgories for the app
 -
 --> 
<component name="ChannelsCategoriesMetadataTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/ChannelsCategoriesMetadataTask/ChannelsCategoriesMetadataTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/CmsApi.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiExperiments.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/ExperimentMixin.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
      <!-- Should the channels be displayed? If not, show the categories? -->
        <field id="displayChannels" value="true" type="boolean" />

        <field id="cancelRequest" value="true" type="boolean" alwaysNotify="true" />
        <field id="kidsMode" value="false" type="boolean"/>

      <!-- OUTPUT -->
        <!-- Set to the content response -->
        <field id="response" type="node" />
      
        <!-- Set when an error occurs to:
        -   {
        -     code: <integer http response code>
        -     data: <http response body>
        -     failReason: <string failure reason from roUrlEvent.GetFailureReason()>
        -   }
        -->
        <field id="error" type="assocarray" />

        <!-- Send info back to contentController context that the request has been cancelled and new task can be created -->
        <field id="canceled" type="boolean" alwaysNotify="true" />
    </interface>
</component>
