<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - DetailMetadataTask
 -
 - This is a task to get detail metadata 
 -
 --> 
<component name="DetailMetadataTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/DetailMetadataTask/DetailMetadataTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/TubiMetadataTranslate.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />

    <interface>
      <!-- INPUT -->
        <!-- Content node to get a fully parsed TubiContentNode for.
        - Only contentFragment.id is expected to be populated.  All other fields are ignored.
        -->
        <field id="contentFragment" type="node"/>
      

      <!-- OUTPUT -->
        <!-- Set to the parsed TubiContentNode on success -->
        <field id="response" type="node" />
      
        <!-- Set when an error occurs to:
        -   {
        -     code: <integer http response code>
        -     data: <http response body>
        -     failReason: <string failure reason from roUrlEvent.GetFailureReason()>
        -   }
        -->
        <field id="error" type="assocarray" />
    </interface>
</component>
