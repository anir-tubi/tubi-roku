<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - DetailMetadataTask
 -
 - This is a task to get detail metadata 
 -
 --> 
<component name="DetailMetadataTask" extends="Task">
    <script type="text/brightscript" uri="DetailMetadataTask.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Log.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Request.brs" />
    <script type="text/brightscript" uri="../../../source/lib/Auth.brs" />
    <script type="text/brightscript" uri="../../../source/lib/CmsApi.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiMetadataTranslate.brs" />
    <script type="text/brightscript" uri="../../../source/3rdparty/roku/generalUtils.brs" />
    
    <script type="text/brightscript" uri="../../lib/ExperimentMixin.brs" />
    <script type="text/brightscript" uri="../../../source/lib/TubiExperiments.brs" />

    <interface>
      <!-- INPUT -->
        <!-- Set to
         - {
         -   contentId: <id of the content to fetch (0-prefixed for series)>
         -   getRelated: <boolean, should we also get the related content at this time>
         -   getThumbnails: <boolean, indicates whether we should get the seeking thumbnails>
         - }
         -->
        <field id="request" type="assocarray" />
      

      <!-- OUTPUT -->
        <!-- Set to the content response -->
        <field id="response" type="node" />
      
        <!-- Set when an content response error occurs to:
        -   {
        -     code: <integer http response code>
        -     data: <http response body>
        -     failReason: <string failure reason from roUrlEvent.GetFailureReason()>
        -   }
        -->
        <field id="error" type="assocarray" />

        <!-- Set to the thumbnails/sprites response - a TubiContentNode with thumbnails fields populated -->
        <field id="thumbnailsResponse" type="node" />
    </interface>
</component>
