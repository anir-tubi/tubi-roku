<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - TestScene
 -
 - Wrapper for testing components in an isolated scene
 -->
<component name="TestScene" extends="Scene">
  <script type="text/brightscript" >
  <![CDATA[
Function OnKeyEvent(key, press)
  if press
    m.top.keypress = key
  end if
  ' always consume the keypress
  return true
End Function
  ]]> 
  </script>
  <interface>
    <!-- Captured key presses (press = "true") will be exposed here -->
    <field id="keypress" type="string" alwaysNotify="true"/>
  </interface>
  <children>
    <!-- Add support for Roku Advanced Layout Editor -->
    <TrackerTask
      id="TrackerTask"/>
  </children>
</component>
