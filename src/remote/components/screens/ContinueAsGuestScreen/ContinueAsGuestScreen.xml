      height="1080"
      translation="[0,0]"/>

    <Poster
      id="BackgroundGradient"
      uri="pkg:/images/sign-in-gradient.png"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    
    <Label
      translation="[595,188]"
      text="Sign in to access"
      horizAlign="center"
      width="731">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="67" />
    </Label>
    
    <LayoutGroup
      itemSpacings="[140,145,105]"
      translation="[220,386]"
      layoutDirection="horiz">
      <Poster
       uri="pkg:/images/picto-queue.png"
       width="316"
       height="188"/>
      <Poster
       uri="pkg:/images/picto-history.png"
       width="183"
       height="182"/>
      <Poster
       uri="pkg:/images/picto-resume.png"
       width="291"
       height="161"/>
      <Poster
       uri="pkg:/images/picto-account-synchro.png"
       width="384"
       height="180"/>
