<?xml version="1.0" encoding="utf-8" ?> 
<component name="DetailMenuItem" extends="Rectangle" >
  <script type="text/brightscript" uri="libpkg:/components/lib/DetailMenuItem/DetailMenuItem.brs" />
  <script type="text/brightscript" uri="libpkg:/source/lib/Log.brs" />

  <interface>
    <!-- hide the progress bar when focus changes -->
    <field id="focusPercent" alias="ResumeProgressBar.opacity" value="0.0"/>
    
    <!-- Content expected for a DetailMenuItem:
     -
     - title - The label text
     - url - The icon uri
     - playstart/length - both of these need to be present and the
     -                    progress bar will be displayed
     -
     -->
    <field id="content" type="node" />
    <field id="listHasFocus" type="boolean" value="false" />
  </interface>
  
  <children>
    <Poster
     id="FocusedIcon" 
     translation="[22,20]"
     loadWidth="40"
     loadHeight="40"
     loadDisplayMode="scaleToZoom" 
     opacity="0.0"/>
    
    <Poster
     id="UnfocusedIcon" 
     translation="[22,20]"
     loadWidth="40"
     loadHeight="40"
     loadDisplayMode="scaleToZoom" 
     opacity="1.0"/>
    
    <Label
     id="FocusedText"
     translation="[72,0]" 
     vertAlign="center"
     horizAlign="left" 
     height="80"
     opacity="0.0">
      <Font
       role="font"
       uri="pkg:/fonts/Vaud-SemiBold.ttf"
       size="33" />
    </Label>
    <Label
     id="UnfocusedText"
     translation="[72,0]" 
     vertAlign="center"
     horizAlign="left" 
     height="80"
     opacity="1.0">
      <Font
       role="font"
       uri="pkg:/fonts/Vaud-SemiBold.ttf"
       size="33" />
    </Label>
    
    <Rectangle 
      id="ResumeProgressBar"
      height="6"
      width="0"
      translation="[4,68]"
      visible="false" />
  </children>
</component>
