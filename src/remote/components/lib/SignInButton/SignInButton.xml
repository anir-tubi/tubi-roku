<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInButton
 -
 - This component is used for all 480x80 buttons within the sign-in flow.
 -
 -->
<component name="SignInButton" extends="Rectangle" >
  <script type="text/brightscript" uri="libpkg:/components/lib/SignInButton/SignInButton.brs" />
  <script type="text/brightscript" uri="libpkg:/source/lib/Log.brs" />

  <interface>
    <!-- hide the progress bar when focus changes -->
    <field id="focusPercent" type="float" value="0.0"/>
    
    <!-- Content expected for a KeyboardMenuItem:
     -
     - title - The label text
     -
     -->
    <field id="content" type="node" />
    <field id="listHasFocus" type="boolean" value="false" />
  </interface>

  <children>
    <Label
      id="focusedText"
      text=""
      width="480"
      height="80"
      horizAlign="center"
      vertAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
    <Label
      id="unfocusedText"
      text=""
      width="480"
      height="80"
      horizAlign="center"
      vertAlign="center"
      opacity="0.0">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="33" />
    </Label>
  </children>
</component>
