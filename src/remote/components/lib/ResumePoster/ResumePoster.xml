<?xml version="1.0" encoding="utf-8" ?>
<component name="ResumePoster" extends="Group" >
  <script type="text/brightscript" uri="libpkg:/components/lib/ResumePoster/ResumePoster.brs" />
  <script type="text/brightscript" uri="libpkg:/source/lib/Log.brs" />

  <interface>
    <field id="itemContent" type="node" />

    <!-- these are ignored but here for compatibility with ContentGrid -->
    <field id="index" type="integer" />
    <field id="width" alias="Poster.width" />
    <field id="height" alias="Poster.height" />
  </interface>

  <children>
    <Poster
     id="Poster"
     width="210"
     height="300"
     visible="true"
     loadDisplayMode = "scaleToZoom"
     loadingBitmapUri = "pkg:/images/placeholder.jpg"
     translation="[0,0]">
      <Rectangle
        id="ResumeProgressBar"
        height="6"
        width="0"
        visible="false"/>
    </Poster>

  </children>
</component>