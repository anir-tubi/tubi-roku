<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInController
 -
 - This controller manages the workflow of authenticating a user or allowing a guest pass.
 -
 -->
<component name="SignInController" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/controllers/SignInController/SignInController.brs" />
  <script type="text/brightscript" uri="pkg:/components/controllers/ScreenStack.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- Set to 'true' when a user has chosen to use a guest pass -->
    <field id="guestPass" type="boolean" value="false" alwaysNotify="true"/>
    
    <!-- Set to 'true' when an existing user has signed with credentials successfully -->
    <field id="signedIn" type="boolean" value="false" alwaysNotify="true"/>
    
    <!-- Set to 'true' when a user has newly registered from the site -->
    <field id="registered" type="boolean" value="false" alwaysNotify="true"/>
  </interface>
        
    <children>
      <Group
       id="ScreenStack"/>
    </children>

</component>
