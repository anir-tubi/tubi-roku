<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - SignInTask
 -
 - This is a short-lived task for exchanging credentials for an access token.
 -
 --> 
<component name="SignInTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/SignInTask/SignInTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/RequestQueue.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />

    <interface>
      <!-- Inputs -->
      <field id="email" type="string" />
      <field id="password" type="string" />
      
      <!-- Set to the response body -->
      <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
