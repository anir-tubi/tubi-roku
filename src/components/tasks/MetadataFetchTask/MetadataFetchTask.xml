<?xml version="1.0" encoding="utf-8" ?> 
<!--
 - MetadataFetchTask
 -
 - This is a long-lived task which will multiplex handling
 - of many HTTP requests simultaneously.  We want many
 - requests to happen in parallel but we don't want to
 - let the thread count to get out of control nor incur
 - the overhead of spinning up a new thread for each
 - metadata HTTP request. 
 -
 --> 
<component name="MetadataFetchTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/MetadataFetchTask.brs" />
    <script type="text/brightscript" uri="pkg:/components/tasks/MetadataFetchTask/TranslateMetadata.brs" />
    <script type="text/brightscript" uri="pkg:/source/3rdparty/roku/generalUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/RequestQueue.brs" />

    <interface>
      <!--
       -
       - The request param should have the following form:
       - {
       -   node: <node to receive content>
       -   field: <field name on which to receive response>
       -   url: <url to fetch>
       -   options: <options to pass to createAsyncHTTPRequest>
       -   name: <name to pass to createAsyncHTTPRequest>
       - }
       -
       -->
      <field id="request" type="assocarray" alwaysNotify="true"/>
      
      <!-- 
       -
       - Cancel an outstanding request that matches the node and
       - field passed in.
       - 
       - Expected format:
       - {
       -   node: <node to receive content>
       -   field: <field name on which to receive response>
       - }
       -        
       -->
      <field id="cancel" type="assocarray" alwaysNotify="true"/>
      
      <!-- Notify that the thread loop is up and listening
       - for requests
      -->
      <field id="ready" type="boolean" value="false" />
    </interface>
</component>
