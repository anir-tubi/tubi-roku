<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen/DetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Full content of the item to show details for -->
    <field id="content" type="node" />
    
    <!-- Setting shortContent triggers a metadata fetch for the full details of the content item 
      - 
      - shortContent should have a minumum of:
      -     contentId - the content id
      -     type - "video", "series", "season", "category" (video may be an episode)
      - 
      -->
    <field id="shortContent" type="node" />

    <!-- Set to the selected movie or episode which should be played -->
    <field id="playContent" type="node" alwaysNotify="true" />

    <!-- Set to the selected movie or episode which should be resumed -->
    <field id="resumeContent" type="node" alwaysNotify="true" />
  </interface>

  <children>
    <!-- All the potential menu items, will be dynamically added or removed based on 'content' -->
    <ContentNode
      id="ResumeMenuItem"
      title="Resume" 
      url="pkg:/images/icon-resume.png"
      playstart="20"
      length="120"/>
    <ContentNode
      id="PlayMenuItem"
      title="Play"
      url="pkg:/images/icon-play.png" />
    <ContentNode
      id="EpisodesMenuItem"
      title="Episodes list"
      url="pkg:/images/icon-all-episodes.png" />
    <ContentNode
      id="AddQueueMenuItem"
      title="Add to queue"
      url="pkg:/images/icon-add-to-queue.png" />
    <ContentNode
      id="RemoveQueueMenuItem"
      title="Remove from queue"
      url="pkg:/images/icon-remove-from-queue.png" />
    <ContentNode
      id="RemoveHistoryMenuItem"
      title="Remove from history"
      url="pkg:/images/icon-remove-from-history.png" />

    <Poster
      id="HeroBackground"
      loadWidth="1920"
      loadHeight="1080"
      uri=""
      loadDisplayMode="scaleToZoom"
      translation="[0,0]"/>
    
    <Poster
      id="HeroShade"
      loadWidth="1920"
      loadHeight="1080"
      loadDisplayMode="scaleToZoom"
      uri="pkg:/images/detail-mask-480x270.png"
      translation="[0,0]"/>
    
    <!-- These are in a layout group together because this menu should float up -->
    <LayoutGroup
      translation="[40,61]"
      itemSpacings="[50]">
      <LayoutGroup
        layoutDirection="horiz">
      <!-- Since we can't translate items in a LayoutGroup we have to put a rectangle here to
        - push the InfoPanel over
        -->
      <Rectangle
        width="45"
        height="10"
        color="0x00000000"/>
      <InfoPanel
        id="InfoPanel"
        mode="detail"
        visible="true"/>
      </LayoutGroup>
    
      <ScrollingList
        id="Menu"
        width="465"
        height="500"
        itemSpacings="[8]"
        itemComponentName="DetailMenuItem"
        focusBitmapUri="pkg:/images/menu-focus.png"
        visible="false"
        translation="[0, 0]">
      </ScrollingList>
    </LayoutGroup>
    
  </children>
</component>
