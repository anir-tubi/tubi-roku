<?xml version="1.0" encoding="utf-8" ?>
<!--
 - RegisterInstructionsScreen
 - 
 - Present the user with a registration code to register on tubi.tv
 -->
<component name="RegisterInstructionsScreen" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/screens/RegisterInstructionsScreen/RegisterInstructionsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Set to true if the user has successfully registered -->
    <field id="registerSuccess" type="boolean" value="false" alwaysNotify="true"/>
  </interface>

  <children>
    <Poster
      id="Background"
      uri="pkg:/images/background-sign-in.png"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    
    <Poster
      id="Circle1"
      uri="pkg:/images/1.png"
      width="100"
      height="100"
      translation="[910,126]"/>
    
    <Label
      text="Register or sign in online at"
      translation="[0,260]"
      horizAlign="center"
      width="1920">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27"/>
    </Label> 
           
    <Label
      text="www.tubitv.com/activate"
      translation="[0,321]"
      horizAlign="center"
      width="1920"
      color="0xff9933">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Semibold.ttf"
        size="43"/>
    </Label> 
    
    <Poster
      id="Circle2"
      uri="pkg:/images/2.png"
      width="100"
      height="100"
      translation="[910,465]"/>
    
    <Label
      text="When asked, enter the activation code below"
      translation="[0,596]"
      width="1920"
      horizAlign="center">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27"/>
    </Label> 
           
    <Label
      id="RegistrationCode"
      text=""
      translation="[0,657]"
      width="1920"
      horizAlign="center"
      color="0xff9933">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Semibold.ttf"
        size="43"/>
    </Label> 
    
    <ScrollingList
      id="RefreshButtons"
      layoutDirection="horiz"
      translation="[720,816]"
      height="80"
      width="986"
      focusBitmapUri="pkg:/images/menu-focus.9.png"
      itemComponentName="SignInButton"
      itemSpacings="[26]">
      <ContentNode role="content">
        <ContentNode id="refresh" title="Refresh Code"/>
      </ContentNode>
    </ScrollingList>
    
    <Label
      text="This screen will automatically refresh once your device is linked"
      translation="[0,936]"
      width="1920"
      horizAlign="center"
      opacity="0.5">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="22"/>
    </Label> 
    
  </children>
</component>