<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodesScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/EpisodesScreen/EpisodesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Full content of the item to show details for -->
    <field id="content" type="node" />

    <!-- Set to the content of the episode that was clicked on -->
    <field id="episodeSelected" type="intarray" alwaysNotify="true"/>
  </interface>

  <children>
    <!-- background to hide the detail screen -->
    <Poster
      id="HeroBackground"
      loadWidth="1920"
      loadHeight="1080"
      uri="pkg:/images/background-not-on-selection.jpg"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]"/>
    
    <Poster
      id="HeroShade"
      loadWidth="1920"
      loadHeight="1080"
      loadDisplayMode="scaleToZoom"
      uri="pkg:/images/detail-mask-480x270.png"
      translation="[0,0]"/>
    
    <InfoPanel
      id="InfoPanel"
      translation="[85,61]"
      mode="detail"
      visible="true" />
    
    <ScrollingList
      id="Menu"
      translation="[65, 424]"
      width="440"
      height="616"
      itemSpacings="[9]"
      itemComponentName="CategorySeasonListItem"
      visible="false"
      focusBitmapUri="pkg:/images/menu-focus.png"/>

    <ContentGrid
      id="EpisodeGrid"
      scrollWidth="1196"
      width="1395"
      height="612"
      numRows="2"
      fillDirection="W"
      visible="false"
      translation="[525,423]"
      itemSize="[524,295]"
      itemSpacing="[20,20]"
      itemComponentName="FeaturePoster" />
    
  </children>
</component>
