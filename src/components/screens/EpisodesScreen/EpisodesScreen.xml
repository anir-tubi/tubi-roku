<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodesScreen" extends="Group" initialFocus="Menu" >

  <script type="text/brightscript" uri="pkg:/components/screens/EpisodesScreen/EpisodesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- Full content of the item to show details for -->
    <field id="content" type="node" />

    <!-- Set to the content of the episode that was clicked on -->
    <field id="episodeSelected" type="intarray" alwaysNotify="true"/>
    
    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" type="stringarray" alwaysNotify="true" /> 
    
    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/series/episodelist/" />
  </interface>

  <children>
    <InfoPanel
      id="InfoPanel"
      translation="[85,61]"
      mode="detail"
      visible="true" />
    
    <ScrollingList
      id="Menu"
      translation="[65, 424]"
      width="440"
      height="616"
      itemSpacings="[9]"
      itemComponentName="CategorySeasonListItem"
      visible="false"
      focusBitmapUri="pkg:/images/menu-focus.png"/>

    <ContentGrid
      id="EpisodeGrid"
      scrollWidth="1196"
      width="1395"
      height="612"
      numRows="2"
      fillDirection="W"
      visible="false"
      translation="[525,423]"
      itemSize="[524,295]"
      itemSpacing="[20,20]"
      itemComponentName="FeaturePoster" />
    
  </children>
</component>
