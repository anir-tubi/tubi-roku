<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryScreen" extends="Group" initialFocus="CategoryList">

  <script type="text/brightscript" uri="pkg:/components/screens/CategoryScreen/CategoryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- The only content expected by the CategoryScreen is the
    - initial fetch of categories and single category content.  All
    - subsequent category data should be gotten from requests
    - for each category individually
    -
    - Content should be structured as:
    -
    - <ContentNode>
    -   <ContentNode title="category1" />
    -   <ContentNode title="category2">
    -     <ContentNode title="item1" />
    -     <ContentNode title="item2" />
    -   </ContentNode>
    -   <ContentNode title="category3" />
    - </ContentNode>
    -
    -->
    <field id="content" type="node" />
    
    <!-- set to the tubi content id of the item which was clicked on -->
    <field id="contentSelected" type="node" alwaysNotify="true"/>
  </interface>

  <children>
    <Poster
      id="HeroBackground"
      uri=""
      loadWidth="1920"
      loadHeight="1080"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]"/>
    
    <Poster
      id="HeroShade"
      loadWidth="1920"
      loadHeight="1080"
      uri="pkg:/images/grid-gradient.png" 
      translation="[0,0]"/>
    
    <ScrollingList
      id="CategoryList"
      translation="[40, 422]"
      width="445"
      height="617"
      visible="true" 
      itemSpacings="[0]"
      itemComponentName="CategoryListItem"
      focusBitmapUri="pkg:/images/menu-focus.png"/>
    
    <InfoPanel
      id="InfoPanel"
      translation="[82,59]"
      visible="true" />
    
    <Group
      translation="[525,424]" >
    <!-- TODO(Chris): How do we trigger feature vs. poster grid -->
      
      <ContentGrid
       id="FeatureGrid"
       numRows="3"
       width="1455"
       height="693"
       itemSize="[392,196]"
       itemSpacing="[10,10]"
       itemComponentName="FeaturePoster"
       fillDirection="W"
       visible="false" 
       translation="[0,0]"/>
    <ContentGrid
      id="PosterGrid"
      numRows="2"
      width="1310"
      height="610"
      itemSize="[210,300]"
      itemSpacing="[10,10]"
      itemComponentName="ContentGridItem"
      fillDirection="W"
      visible="true"
      translation="[0,0]"/>
      <LabelList 
       id="FakeLabelList"/>
    </Group>
    
  </children>
</component>
