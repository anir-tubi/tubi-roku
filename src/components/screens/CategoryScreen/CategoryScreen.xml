<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryScreen" extends="Group" initialFocus="CategoryList">

  <script type="text/brightscript" uri="pkg:/components/screens/CategoryScreen/CategoryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Request.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Auth.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/TubiBookmarks.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/AnimationMixin.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ErrorModalDialog.brs" />
  
  <interface>
    <!-- The only content expected by the CategoryScreen is the
    - initial fetch of categories and single category content.  All
    - subsequent category data should be gotten from requests
    - for each category individually
    -
    - Content should be structured as:
    -
    - <ContentNode>
    -   <ContentNode title="category1" />
    -   <ContentNode title="category2">
    -     <ContentNode title="item1" />
    -     <ContentNode title="item2" />
    -   </ContentNode>
    -   <ContentNode title="category3" />
    - </ContentNode>
    -
    -->
    <field id="content" type="node" />

    <!-- MetadataFetchTask response for single category content -->
    <field id="categoryResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- MetadataFetchTask response for single category content -->
    <field id="categoryPreviewResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- MetadataFetchTask response for category list -->
    <field id="categoryListResponse" type="assocarray" alwaysNotify="true"/>
    
    <!-- keeps the uri used for user tracking -->
    <field id="trackingUri" type="string"  value="/home" alwaysNotify="true"/>

    <!-- will be populated with the full (unparsed) bookmark response -->
    <field id="bookmarks" type="string" />
    
    <!-- will be populated with the full (unparsed) history response -->
    <field id="history" type="string" />

    <!-- will be used to change the background images on the content controller -->
    <field id="backgroundUriList" type="stringarray" alwaysNotify="true" />
    
    <!-- set to the tubi content id of the item which was clicked on -->
    <field id="contentSelected" type="node" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Search" button -->
    <field id="searchSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign In" button -->
    <field id="signInSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign Out" button -->
    <field id="signOutSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "About" button -->
    <field id="aboutSelected" type="boolean" alwaysNotify="true"/>
    
    <!-- set to true when the user has selected the "Privacy" button -->
    <field id="privacySelected" type="boolean" alwaysNotify="true"/>
    
    <!-- set to true if the user is signed in and we want to change the experience based on that -->
    <field id="signedIn" type="boolean" value="false" />
    
    <field id="dirtyUserCategories" type="boolean" value="false" alwaysNotify="true"/>
  </interface>

  <children>

  <MaskGroup
    translation="[0,0]"
    maskUri="pkg:/images/poster-mask-pixel.png"
    maskSize="[0,1080]"
    maskOffset="[1840,0]">


      <!-- Special category menu items. These will be merged with category list -->
      <ContentNode
        id="SpecialCategories">
        <!-- TubiContentNode here so it can contain the totalcount for the Info Panel -->
        <TubiContentNode
          id="ContinueWatching"
          type="category"
          title="Continue Watching"
          description="The Movies and TV Shows you have started watching can be found here"
          placeholderText="You haven't watched anything yet. The content you watch will appear here."
          slug="continue_watching" />
        <TubiContentNode
          id="MyQueue"
          type="category"
          title="My Queue"
          description="The Movies and TV Shows you have added to your Queue can be found here"
          placeholderText="You don’t have anything in your Queue yet. Get started by adding Movies and TV Shows that interest you to your Queue."
          slug="my_queue" />
        <TubiContentNode
          id="SearchSignIn"
          title="Search &amp; Sign In"
          description="Find titles on TubiTV, Sign In and more."/>
        <TubiContentNode
          id="SearchSignOut"
          title="Search &amp; Sign Out"
          description="Find titles on TubiTV, Sign Out and more."/>
      </ContentNode>

      <ContentNode
        id="SearchSignInContent">
        <ContentNode
          id="SearchMenuItem"
          title="Search" 
          description="Search Tubi TV using the name of a Movie or TV Show. You can also search by Actor Name or Keyword"
          hdgridposterurl="pkg:/images/icon-search-large.png"/>
        <ContentNode
          id="SignInMenuItem"
          title="Sign In"
          description="Sign In to Tubi TV. Access your Queue and View History across your devices"
          hdgridposterurl="pkg:/images/icon-sign-in-large.png" />
        <ContentNode
          id="SignOutMenuItem"
          title="Sign Out"
          description="Sign Out of Tubi TV"
          hdgridposterurl="pkg:/images/icon-sign-in-large.png" />
        <ContentNode
          id="AboutMenuItem"
          title="About Tubi TV"
          description="View general information about Tubi TV including the version number of this app"
          hdgridposterurl="pkg:/images/icon-about-large.png" />
        <ContentNode
          id="PrivacyMenuItem"
          title="Privacy"
          description="Review Tubi TV's privacy policy"
          hdgridposterurl="pkg:/images/icon-privacy-large.png" />
      </ContentNode>

      <ScrollingList
        id="CategoryList"
        translation="[-380, 640]"
        width="425"
        height="440"
        scrollHeight="80"
        itemSpacings="[8]"
        itemComponentName="CategorySeasonListItem"
        focusBitmapUri="pkg:/images/menu-focus.png"/>

      <InfoPanel
        id="InfoPanel"
        translation="[85,229]"
        maxHeight="577"
        visible="true" />

      <Group
        id="ContentArea"
        translation="[85,588]" >
        <CategoryGridList
          id="CategoryGridList"/>
      </Group>
    </MaskGroup>

    <Poster
      id="tubiLogo"
      height="43"
      width="149"
      uri="pkg:/images/logo.png"
      translation="[1688,969]" />
    
    <AuthTask
      id="CategoryAuthTask" />

    <!-- At request of backend, deferring these requests gives the backend time to
      - cache the responses
      -->
    <Timer
      id="CategoryPreloadTimer"
      duration="2.0"/>
    
    <Spinner
      id="Spinner"
      width="1920"
      height="1080"
      visible="true"
      translation="[0,0]"/>
    
  </children>
</component>
