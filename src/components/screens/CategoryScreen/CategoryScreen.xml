<?xml version="1.0" encoding="utf-8" ?>
<component name="CategoryScreen" extends="Group" initialFocus="CategoryList">

  <script type="text/brightscript" uri="pkg:/components/screens/CategoryScreen/CategoryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- The only content expected by the CategoryScreen is the
    - initial fetch of categories and single category content.  All
    - subsequent category data should be gotten from requests
    - for each category individually
    -
    - Content should be structured as:
    -
    - <ContentNode>
    -   <ContentNode title="category1" />
    -   <ContentNode title="category2">
    -     <ContentNode title="item1" />
    -     <ContentNode title="item2" />
    -   </ContentNode>
    -   <ContentNode title="category3" />
    - </ContentNode>
    -
    -->
    <field id="content" type="node" />
    
    <!-- set to the tubi content id of the item which was clicked on -->
    <field id="contentSelected" type="node" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Search" button -->
    <field id="searchSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign In" button -->
    <field id="signInSelected" type="boolean" alwaysNotify="true"/>

    <!-- set to true when the user has selected the "Sign In" button -->
    <field id="aboutSelected" type="boolean" alwaysNotify="true"/>
  </interface>

  <children>
    <!-- Special category menu items. These will be merged with category list -->
    <ContentNode
      id="SpecialCategories">
      <ContentNode
        id="RecentlyViewed"
        title="Recently Viewed"
        description=""/>
      <ContentNode
        id="MyQueue"
        title="My Queue"
        description=""/>
      <ContentNode
        id="SearchSignIn"
        title="Search &amp; Sign In"
        description="Find titles on TubiTV, Sign In and more."/>
    </ContentNode>

    <Poster
      id="HeroBackground"
      uri=""
      loadWidth="1920"
      loadHeight="1080"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]"/>
    
    <Poster
      id="HeroShade"
      loadWidth="1920"
      loadHeight="1080"
      uri="pkg:/images/grid-gradient.png" 
      translation="[0,0]"/>
    
    <ScrollingList
      id="CategoryList"
      translation="[41, 423]"
      width="445"
      height="616"
      visible="true" 
      itemSpacings="[0]"
      itemComponentName="CategoryListItem"
      focusBitmapUri="pkg:/images/menu-focus.png">

    </ScrollingList>
    
    <InfoPanel
      id="InfoPanel"
      translation="[85,59]"
      visible="true" />
    
    <Group
      id="ContentArea"
      translation="[525,423]" >
    <!-- TODO(Chris): How do we trigger feature vs. poster grid -->
      
      <ContentGrid
       id="FeatureGrid"
       numRows="3"
       width="1196"
       height="608"
       itemSize="[392,196]"
       itemSpacing="[10,10]"
       itemComponentName="FeaturePoster"
       fillDirection="W"
       visible="false" 
       translation="[0,0]"/>
    <ContentGrid
      id="PosterGrid"
      numRows="2"
      width="1310"
      height="610"
      itemSize="[210,300]"
      itemSpacing="[10,10]"
      itemComponentName="ContentGridItem"
      fillDirection="W"
      visible="true"
      translation="[0,0]"/>

    <!-- Shown when Search & Sign In special category is selected -->
    <!-- TODO(Chris): Rename the DetailMenuItem since it is reused -->
    <ScrollingList
      id="SearchSignInList"
      width="465"
      height="250"
      itemSpacings="[4]"
      itemComponentName="DetailMenuItem"
      focusBitmapUri="pkg:/images/menu-focus.png"
      visible="false">
      <ContentNode
        role="content">
        <ContentNode
          id="SearchMenuItem"
          title="Search" 
          url="pkg:/images/icon-search.png"/>
        <ContentNode
          id="SignInMenuItem"
          title="Sign In"
          url="pkg:/images/icon-sign-in.png" />
        <ContentNode
          id="AboutMenuItem"
          title="About Tubi TV"
          url="pkg:/images/icon-about.png" />
      </ContentNode>
    </ScrollingList>

    </Group>
    
  </children>
</component>
