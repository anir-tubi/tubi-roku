<?xml version="1.0" encoding="utf-8" ?>
<!--
 - ModalDialogScreen
 -
 - A modal dialog with a transparent background, title, message, and buttons.
 -
 -->
<component name="ModalDialogScreen" extends="Group" initialFocus="ButtonList">

  <script type="text/brightscript" uri="pkg:/components/screens/ModalDialogScreen/ModalDialogScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- The text of buttons.  The button list will grow to the size of this array -->
    <field id="buttons" type="stringarray" value="[]" alwaysNotify="true"/>
    
    <!-- Set to the index into the 'buttons' array of a button which was selected -->
    <field id="buttonSelected" alias="ButtonList.itemSelected"/>
    
    <!-- Bold header text, single line -->
    <field id="title" alias="Title.text"/>
           
    <!-- Secondary message, multiple lines -->
    <field id="message" alias="Message.text"/>

  </interface>

  <children>
    <Rectangle
      id="Shade"
      color="0x191919FF"
      width="1920"
      height="1080"
      opacity="0.8"
      translation="[0,0]"/>
         
    <Rectangle
      id="DialogBox"
      color="0x2C2C2CFF" 
      width="960"
      height="540"
      translation="[480,270]">
      <LayoutGroup
        id="ContentArea"
        translation="[69,65]"
        itemSpacings="[60,36]">
        <Label
          id="Title"
          width="763">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-SemiBold.ttf"
            size="43" />
        </Label>
        
        <Label
          id="Message"
          width="763"
          wrap="true"
          maxLines="4">
          <Font
            role="font"
            uri="pkg:/fonts/Vaud-Medium.ttf"
            size="27" />
        </Label>
        
        <ScrollingList
          id="ButtonList"
          width="490"
          height="1080"
          layoutDirection="vert"
          focusBitmapUri="pkg:/images/menu-focus.9.png"
          itemComponentName="CategorySeasonListItem"
          itemSpacings="[6]">
        </ScrollingList>
      </LayoutGroup>
    </Rectangle>

  </children>
</component>