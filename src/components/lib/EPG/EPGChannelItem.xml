<component name="EPGChannelItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/EPG/EPGChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/PlaylistMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!--
      -
      - Structured like:
      -  <CN id="LiveChannel1" title="LC1">
      -    <CN id="Content1"/>
      -    <CN id="Content2"/>
      -  </CN>
      -
      -->
    <field id="content" type="node"/>
    <field id="focusPercent" type="float"/>
  </interface>
  <children>
    <!-- One rect is static sized, the rest are added based on channel playlist -->
    <Rectangle
      width="210"
      height="80">
      <Label
        id="ChannelName"
        width="210"
        height="80"
        color="0x000000FF"
        horizAlign="center"
        vertAlign="center">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-Bold.ttf"
          size="27" />
      </Label>
    </Rectangle>
    
    <Font
      id="VaudSemiBold27"
      uri="pkg:/fonts/Vaud-SemiBold.ttf"
      size="27"/>
    <Group
      id="Timeslots"
      translation="[212,0]"/>
    
    <Rectangle
      id="CurrentMarker"
      width="0"
      height="80"
      color="0xFF9933FF"
      opacity="0.4"
      visible="false"/>
    
    
  </children>
</component>
