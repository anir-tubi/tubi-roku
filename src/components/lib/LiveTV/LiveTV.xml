<?xml version="1.0" encoding="utf-8" ?> 
<component name="LiveTV" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/LiveTV/LiveTV.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/PlaylistMixin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- read-only: the current content playlistfor live tv 
      -
      - Structured like:
      -  <CN>
      -    <CN id="LiveChannel1">
      -      <CN id="Content1"/>
      -      <CN id="Content2"/>
      -    </CN>
      -    <CN id="LiveChannel2">
      -      <CN id="Content9"/>
      -      <CN id="Content10"/>
      -    </CN>
      -  </CN>
      -
      -->
    <field id="content" type="node" alwaysNotify="true"/>

    <!-- "Watch Now" button was selected -->
    <field id="watchNowSelected" type="boolean" alwaysNotify="true"/>

    <!-- event for when a channel from the EPG has been selected to play -->
    <field id="allChannelsSelected" type="boolean" alwaysNotify="true"/>
    
    <!-- private fields -->
    <!-- receive the live tv metadata from metadata fetch task -->
    <field id="liveTVPlaylistResponse" type="assocarray" alwaysNotify="true"/>
    <field id="liveTVDetailResponse" type="assocarray" alwaysNotify="true"/>
  </interface>

  <children>
    <Poster
      id="LiveTVGradient"
      uri="pkg:/images/live-tv-gradient.png"
      width="1920"
      height="1080"
      translation="[0,0]"/>
    <LayoutGroup
      id="CurrentlyPlayingGroup"
      layoutDirection="horiz"
      vertAlignment="top"
      itemSpacings="[59]"
      translation="[85,476]">
      <Poster
        id="DVDPoster"
        width="210"
        height="300"/>
      <InfoPanel
        id="Info"
        mode="item"
        maxHeight="300"/>
    </LayoutGroup>
    <!-- TODO(Chris): SignInButton is 480px wide when the spec calls for 430.  Rather than defining a new component, we
      -               should try to consolidate all the text buttons into a single component and force sizes from ScrollingList -->
    <ScrollingList
      id="WatchOrTuneMenu"
      layoutDirection="horiz"
      translation="[525,832]"
      height="80"
      width="970"
      focusBitmapUri="pkg:/images/menu-focus.9.png"
      itemComponentName="SignInButton"
      itemSpacings="[10]">
      <ContentNode role="content">
        <ContentNode id="watchnow" title="Watch Now"/>
        <ContentNode id="allchannels" title="All Channels"/>
      </ContentNode>
    </ScrollingList>
    
    <Group
     id="SearchSignOutHint">
      <Poster
        id="LiveUpTriangle"
        uri="pkg:/images/up-arrow.png"
        visible="true"
        width="15"
        height="10"
        translation="[953,60]"/>
      <Label
        id="AllChannels"
        text="SEARCH &amp; MORE"
        horizAlign="center"
        vertAlign="center"
        width="1920"
        height="40"
        translation="[0,75]">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="22" />
      </Label>
    </Group>
    
    <Poster
      uri="pkg:/images/icon-on-now.png"
      width="115"
      height="55"
      translation="[133,853]"/>
    
  </children>
</component>
    
