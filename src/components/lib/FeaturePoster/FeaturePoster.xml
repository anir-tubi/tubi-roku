<?xml version="1.0" encoding="utf-8" ?>
<!--
 - FeaturePoster
 -
 - Item in a ContentGrid for the 16:9 aspect ratio
 -
 -->
<component name="FeaturePoster" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/FeaturePoster/FeaturePoster.brs" />

  <interface>
    <field id="itemContent" type="node" />
    
    <!-- these are ignored but here for compatibility with ContentGrid -->
    <field id="index" type="integer" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>

  <children>
    <Poster 
      id="Background" 
      loadingBitmapUri="pkg:/images/loading_feature.png"
      width="392"
      height="196"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]" />

    <Poster
      id="TitleShade"
      uri="pkg:/images/rectangle-53.png"
      width="392"
      height="65"
      translation="[0,155]"/>

    <Label
      id="Title"
      width="323.6"
      height="50.4"
      vertAlign="bottom"
      translation="[24.3,145]">
      <Font
        role="font"
        uri="pkg:/fonts/OpenSans-Regular.ttf"
        size="31" />
    </Label>
  </children>

</component>
