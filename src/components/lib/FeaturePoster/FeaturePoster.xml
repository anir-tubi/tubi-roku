<?xml version="1.0" encoding="utf-8" ?>
<!--
 - FeaturePoster
 -
 - Item in a ContentGrid for the 16:9 aspect ratio
 -
 -->
<component name="FeaturePoster" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/FeaturePoster/FeaturePoster.brs" />

  <interface>
    <field id="itemContent" type="node" />
    
    <!-- these are ignored but here for compatibility with ContentGrid -->
    <field id="index" type="integer" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>

  <children>
    <Poster 
      id="Background" 
      loadingBitmapUri="pkg:/images/placeholder-featured.png"
      width="560"
      height="280"
      loadDisplayMode="scaleToZoom"
      translation="[0,0]" />

    <Poster
      id="TitleShade"
      uri="pkg:/images/feature-gradient-square.png"
      width="560"
      height="140"
      translation="[0,140]"/>

    <Label
      id="Title"
      width="560"
      height="50"
      vertAlign="bottom"
      translation="[19,220]">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-Medium.ttf"
        size="27" />
    </Label>
  </children>

</component>
