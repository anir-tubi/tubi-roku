        color="0xFF9933FF" >
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>
      <Label
        id="ItemCount"
        text=""
        height="40"
        horizAlign="right">
        <Font
          role="font"
          uri="pkg:/fonts/Vaud-SemiBold.ttf"
          size="27" />
      </Label>
    </LayoutGroup>

    <Spinner
