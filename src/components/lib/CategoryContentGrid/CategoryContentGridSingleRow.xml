    <field id="focusPercent" type="float" value="0.0"/>
    <field id="listHasFocus" type="boolean" value="false" />
    <field id="content" type="node" alwaysNotify="true"/>
    
    <!-- Outgoing interface proxying the internal ContentGrid -->
    <field id="itemSelected" type="node" alwaysNotify="true"/>
    <field id="itemFocused" type="node" alwaysNotify="true"/>
    <field id="cursorPosition" type="intarray" value="[-1,-1]"/>
    <field id="cursorIndex" type="integer" value="-1"/>
  </interface>
  
  <children>
