        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    <Label
      id="UnfocusedCategoryName"
      height="40"
      width="1000"
      translation="[0,0]"
      color="0xFFFFFFFF"
      opacity="1.0">
      <Font
        role="font"
        uri="pkg:/fonts/Vaud-SemiBold.ttf"
        size="34" />
    </Label>
    </Group>
    
    <LayoutGroup
      id="CategoryCount"
      layoutDirection="horiz"
      horizAlignment="right"
      translation="[1755,10]">
      <Label
        id="FocusIndex"
        text=""
        height="40"
