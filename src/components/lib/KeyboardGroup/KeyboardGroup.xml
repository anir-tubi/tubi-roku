      id="SymbolMenu"
      width="502"
      height="80"
      visible="true" 
      itemSpacings="[2]"
      itemComponentName="KeyboardMenuItem"
      focusBitmapUri="pkg:/images/menu-focus.9.png"
      translation="[709,65]"
      layoutDirection="horiz">
