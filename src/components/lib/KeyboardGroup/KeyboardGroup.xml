<?xml version="1.0" encoding="utf-8" ?>
<!--
 - KeyboardGroup
 -
 - This is a custom keyboard widget whose interface is somewhat like
 - the Keyboard node provided by Roku.  Rather than emitting keypresses
 - and expecting the parent to contstruct the string, it is managed
 - internally and the parent can just listen to changes in the 'text'
 - field to update any related presentation widget.
 -
 -->
<component name="KeyboardGroup" extends="Group">

  <script type="text/brightscript" uri="pkg:/components/lib/KeyboardGroup/KeyboardGroup.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!-- 
      - The text that is manipulated by the keyboard. This can be written to so the
      - keyboard can be seeded with a value from elsewhere. 
      -->
    <field id="text" type="string" value="" alwaysNotify="true" />
    
    <!-- The maximum number of characters before keypresses are ignored -->
    <field id="maxLength" type="int" value="128" />
  </interface>
  
  <children>
    
