<?xml version="1.0" encoding="utf-8" ?>

<!--
 - Background Group
 -
 - A group that handles any background transitions
 - As well as switching between the different background types - grid (category, episode screens), details (detail, search screens)
 -
 -->
<component name="BackgroundGroup" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/BackgroundGroup/BackgroundGroup.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />
  
  <interface>
    <!-- newBackgroundType can be "grid", "details" -->
    <field id="newBackgroundType" type="string" alwaysNotify="true" />

    <!-- used to set the uri for the background image -->
    <field id="backgroundUri" type="string" />
  </interface>

  <children />
</component>
