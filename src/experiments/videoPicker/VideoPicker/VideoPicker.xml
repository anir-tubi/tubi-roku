<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoPicker" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/lib/VideoPicker/VideoPicker.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Log.brs" />

  <interface>
    <!--
      - OUTPUTS
      -->

    <!-- updated to indicate a user has changed the content they are watching: [<playlist>,<episode>] -->
    <field id="contentFocused" type="int" value="0"/>
    
    <!-- if the user presses "OK" for the current content item, this event will be raised -->
    <field id="contentSelected" type="int" alwaysNotify="true" />
   
    <!-- used for analytics tracking - the number of times a user selects left/right while the video picker is showing -->
    <field id="navigations" type="int" />
    
    <!--
      - INPUTS
      -->
    
    <!-- expect content to be a playlist node -->
    <field id="content" type="node"/>
    <!-- sets the overlay to show the playlist/content at the indicated index. -->
    <field id="jumpToIndex" type="int" alwaysNotify="true"/>

  </interface>  

  <children>
    <RowList
      id="Grid"
      itemComponentName="VideoPickerPoster"
      itemSize="[1920,404]"
      focusXOffset="85"
      numRows="1"
      rowItemSize="[[430,242]]"
      rowItemSpacing="[[10,0]]"
      showRowLabel="[false]"
      showRowCounter="[false]"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/selector-fhd.9.png"/>
  </children>
</component>
