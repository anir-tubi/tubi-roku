{
  "compilerOptions": {
    "outDir": "./build",
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "target": "ES2018",
    "module": "commonjs",
    "sourceMap": true,
    "declaration": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "lib": [
      "ES2018"
    ]
  },
  "ts-node": {
    "transpileOnly": true
  }
}