<component name="OTVLGroupView" extends="Group">
    <interface>
        <field id="viewData" type="assocarray" onchange="onViewData" />
        <field id="groupDetail" type="assocarray" alwaysNotify="true" />
        <field id="isLeftPressed" type="boolean" alwaysNotify="true" />
        <field id="isRightPressed" type="boolean" alwaysNotify="true" />
        <field id="childIndex" type="integer" />
        <field id="itemFocus" type="boolean" alwaysNotify="true" />
        <field id="isFocus" type="boolean" onChange="setViewFocus" alwaysNotify="true" />
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="itemFocused" type="node" alwaysNotify="true" />
        <field id="updateGroups" type="assocarray" alwaysNotify="true" onChange="onGroupUpdate" />
        <function name="onKeyDownClose" />
    </interface>

    <script type="text/brightscript" uri="../OTVendorList/OTVLGroupView.brs" />
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/style.brs"></script>
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/consentLI.brs"></script>
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/scroll.brs"></script>
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/vendor.helper.brs"></script>
    <script type="text/brightscript" uri="../../components/OTCommon/OTUtilities/utils.brs"></script>


    <children>
        <Group translation="[0,120]" id="mainGroup">
            <Rectangle id="mainRect" height="1080" translation="[0,0]">
                <Rectangle id="leftSection" translation="[0,0]">
                    <Rectangle id="innerLeftSection" translation="[0,0]">
                        <MarkupGrid
                            id="buttonList"
                            itemComponentName="OTButtonListView"
                            itemSize="[560, 60]"
                            itemSpacing="[0,0]"
                            numRows="5" vertFocusAnimationStyle="floatingFocus"
                            drawFocusFeedback="false"
                            translation="[50,460]"
                        />
                        <Rectangle id="VertLine" width="3" height="150" color="0xffffff"
                            visible="false" />
                    </Rectangle>
                </Rectangle>

                <Rectangle id="rightSection" height="700" translation="[50,150]">
                    <Rectangle id="descriptionRec">
                        <LayoutGroup id="description" layoutDirection="vert" vertAlignment="top"
                            itemSpacings="[10]" visible="false" />
                        <Rectangle id="scrollThumb" width="10" height="150" color="0xffffff"
                            translation="[0,0]" opacity="0.3" visible="false" />
                    </Rectangle>
                    <Rectangle id="innerRightSection" translation="[0,0]">
                        <LayoutGroup id="titleLayout" layoutDirection="vert" vertAlignment="top"
                            translation="[50,150]" itemSpacings="[20]">
                            <Rectangle>
                                <Label id="heading" font="font:LargeBoldSystemFont" width="600"
                                    text="" maxLines="3" wrap="true" scale="[0.0,0.0]" />
                            </Rectangle>
                            <MarkupGrid
                                id="buttonsListGrp"
                                itemComponentName="OTButtonListView"
                                itemSize="[560, 0]"
                                itemSpacing="[0, 15]"
                                numColumns="1"
                                numRows="4"
                                vertFocusAnimationStyle="floatingFocus"
                                drawFocusFeedback="false"
                                translation="[0,0]"
                            />
                            <Rectangle>
                                <Rectangle id="horzLine" width="150" height="3" color="0xffffff"
                                    visible="false" />
                            </Rectangle>
                            <MarkupGrid
                                id="subGrpListGrp"
                                itemComponentName="OTButtonListView"
                                itemSize="[560, 0]"
                                itemSpacing="[0, 15]"
                                numRows="6"
                                vertFocusAnimationStyle="floatingFocus"
                                drawFocusFeedback="false"
                                translation="[0,0]"
                            />
                        </LayoutGroup>
                    </Rectangle>
                </Rectangle>
            </Rectangle>
        </Group>
        <Rectangle id="actionRect" width="1000" height="120" translation="[45,600]">
            <MarkupGrid
                id="actionButtonList"
                itemComponentName="OTButtonListView"
                itemSize="[560, 60]"
                itemSpacing="[30, 0]"
                numRows="1"
                numColumns="3"
                vertFocusAnimationStyle="floatingFocus"
                drawFocusFeedback="false"
                translation="[50,30]"
            />
        </Rectangle>
    </children>
</component>