{
  "rootDir": "./src/channel",
  "plugins": [
    "@rokucommunity/bslint",
    "brighterscript-xml-plugin"
  ],
  "files": [
    "manifest",
    "source/**/*.*",
    "components/**/*.*",
    "images/**/*.*",
    "locale/**/*.*",
    "fonts/**/*.*",
    "!components/controllers/TubiScene/TrackerTask.xml",
    "!components/controllers/StarterController/simple/StarterController.xml",
    "!components/OTPublishersSDK/**/*.*"
  ],
  "diagnosticFilters": [
    {
      "codes": [
        1090
      ]
    },
    "source/tests/**",
    "source/tests/rooibos/rooibosDist.brs",
    "source/rooibosFunctionMap.brs",
    "source/3rdparty/rodash/rodash.cat.brs",
    "components/tasks/BrazeTask/BrazeSDK.brs"
  ]
}
